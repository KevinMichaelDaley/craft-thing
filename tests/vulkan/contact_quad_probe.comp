#version 450
#extension GL_GOOGLE_include_directive : require
#include "rigid_body.glsl"
const bool CONTACT_PIXEL_ONLY=true;
uint contact_dynamic_iterations=0u;
uint contact_axis_invocations=0u;
#define DC_CONTACT_PROFILE 1
#define DC_CONTACT_POLYGON_CAPACITY BODY_VERTEX_CAPACITY
#include "contact_geometry.glsl"
#include "contact_geometry_reference.glsl"
layout(local_size_x=128) in;
layout(set=0,binding=0,std430) buffer Results {uint results[];};
uint pixel_word_at(uint index) {return 0u;}
Polygon quad(vec2 low,float angle,float size) {
    Polygon p=cell_polygon(vec2(0));
    for(uint v=0u;v<4u;v++) p.vertices[v]=low+body_rotate(p.vertices[v]*size,angle);
    return p;
}
Polygon rectangle(vec2 low,vec2 size) {
    Polygon p=cell_polygon(low);
    for(uint vertex=0u;vertex<4u;vertex++) p.vertices[vertex]=low+(p.vertices[vertex]-low)*size;
    return p;
}
bool matches_reference(Polygon a,Polygon b,uint id,uint family) {
    vec2 n,rn;float d,rd;
    bool expected=reference_polygon_contact(a,b,rn,rd);
    bool actual=polygon_contact(a,b,n,d);
    bool bounded=actual==expected;
    if(actual!=expected) atomicAdd(results[17],1u);
    if(actual&&expected) {
        atomicMax(results[19],floatBitsToUint(max(abs(n.x-rn.x),abs(n.y-rn.y))));
        atomicMax(results[20],floatBitsToUint(abs(d-rd)));
        bool same_normal=all(equal(floatBitsToUint(n),floatBitsToUint(rn)));
        if(max(abs(n.x-rn.x),abs(n.y-rn.y))>.001&&atomicCompSwap(results[23],0u,id+1u)==0u) {
            results[24]=family;results[25]=floatBitsToUint(n.x);results[26]=floatBitsToUint(n.y);
            results[27]=floatBitsToUint(rn.x);results[28]=floatBitsToUint(rn.y);
            results[29]=floatBitsToUint(d);results[30]=floatBitsToUint(rd);
        }
        /* Offsets reach 512 cells, where opposite SAT axes can differ by a
         * few float ULPs. A different normal is valid only when both axes
         * have tied depth and its witnesses remain on their support planes. */
        const float geometry_limit=2.0/8192.0;
        bool aligned=max(abs(n.x-rn.x),abs(n.y-rn.y))<.001;
        vec2 an=reference_project_polygon(a,-n),bn=reference_project_polygon(b,n);
        float positive=reference_project_polygon(b,n).y-reference_project_polygon(a,n).x;
        float negative=reference_project_polygon(a,n).y-reference_project_polygon(b,n).x;
        float axis_depth=max(0.,min(positive,negative));
        bounded=bounded&&abs(length(n)-1.)<.001&&abs(length(rn)-1.)<.001&&dot(n,rn)>-.05&&
            abs(d-rd)<=geometry_limit&&abs(d-axis_depth)<=geometry_limit;
        vec2 pa,pb,ra,rb;uint fa,fb,rfa,rfb;
        reference_contact_witnesses(a,b,rn,ra,rb,rfa,rfb);
        contact_witnesses(a,b,n,pa,pb,fa,fb);
        if(fa!=rfa||fb!=rfb) {
            atomicAdd(results[18],1u);
            if(atomicCompSwap(results[31],0u,id+1u)==0u) {
                results[32]=family;results[33]=fa;results[34]=fb;
                results[35]=rfa;results[36]=rfb;
                results[37]=floatBitsToUint(n.x);results[38]=floatBitsToUint(rn.x);
            }
        }
        atomicMax(results[21],floatBitsToUint(max(abs(pa.x-ra.x),abs(pa.y-ra.y))));
        atomicMax(results[22],floatBitsToUint(max(abs(pb.x-rb.x),abs(pb.y-rb.y))));
        bounded=bounded&&abs(dot(pa,-n)-an.y)<=geometry_limit&&abs(dot(pb,n)-bn.y)<=geometry_limit;
        if(aligned) bounded=bounded&&fa==rfa&&fb==rfb&&
            max(abs(pa.x-ra.x),abs(pa.y-ra.y))<=geometry_limit&&
            max(abs(pb.x-rb.x),abs(pb.y-rb.y))<=geometry_limit;
    }
    return bounded;
}
void main() {
    for(uint id=gl_GlobalInvocationID.x;id<32768u;id+=128u) {
        float angle=float(id%31u)*.103;
        Polygon a=quad(vec2(-.375,.125),angle,.5+float(id%5u)*.25);
        vec2 low=vec2(int((id/31u)%17u)-8,int((id/527u)%17u)-8)*.25;
        Polygon b=quad(low,float((id/7u)%29u)*-.117,.75);
        contact_dynamic_iterations=0u;
        atomicAdd(results[0],uint(!matches_reference(a,b,id,0u)));atomicAdd(results[1],1u);
        atomicMax(results[2],contact_dynamic_iterations);
        a.count=5u;
        for(uint vertex=0u;vertex<5u;vertex++) {
            float phase=float(vertex)*1.2566370614359172+angle;
            a.vertices[vertex]=vec2(-.375,.125)+vec2(cos(phase),sin(phase));
        }
        atomicAdd(results[3],uint(!matches_reference(a,b,id,1u)));atomicAdd(results[4],1u);
        vec2 offset=vec2(float(int((id/1024u)%3u)-1)*256.,float(int((id/256u)%3u)-1)*512.);
        a=quad(offset+vec2(-.375,.125),angle,.5+float(id%5u)*.25);
        b=rectangle(offset+low+vec2(float(id%11u)/65536.),
            vec2(float(4096u+id%65000u)/65536.,float(4096u+(id*7u)%65000u)/65536.));
        contact_axis_invocations=0u;
        atomicAdd(results[5],uint(!matches_reference(a,b,id,2u)));atomicAdd(results[6],1u);
        atomicMax(results[7],contact_axis_invocations);
        a=rectangle(offset+vec2(-.375,.125),vec2(.75,.625));contact_axis_invocations=0u;
        atomicAdd(results[8],uint(!matches_reference(a,b,id,3u)));atomicAdd(results[9],1u);
        atomicMax(results[10],contact_axis_invocations);
        a=quad(offset+vec2(-.375,.125),angle,.5+float(id%5u)*.25);
        b=cell_polygon(offset+low);contact_axis_invocations=0u;
        atomicAdd(results[11],uint(!matches_reference(a,b,id,4u)));atomicAdd(results[12],1u);
        atomicMax(results[13],contact_axis_invocations);
        a=cell_polygon(offset+vec2(-.375,.125));contact_axis_invocations=0u;
        atomicAdd(results[14],uint(!matches_reference(a,b,id,5u)));atomicAdd(results[15],1u);
        atomicMax(results[16],contact_axis_invocations);
    }
}
