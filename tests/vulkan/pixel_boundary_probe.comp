#version 450
#extension GL_GOOGLE_include_directive : require
#include "rigid_body.glsl"
const bool CONTACT_PIXEL_ONLY=true;
#include "contact_geometry.glsl"
layout(local_size_x=128) in;
layout(set=0,binding=4,std430) buffer Storage {Body bodies[BODY_CAPACITY];uint data[];};
layout(set=0,binding=0,std430) buffer Results {uint results[];};
uint reads=0u;
uint pixel_word_at(uint index) {reads++;return data[index-BODY_STORAGE_WORDS];}
#include "rigid_clip.glsl"
#include "rigid_shape.glsl"
#include "rigid_clip_reference.glsl"
bool reference_boundary(Body b,uint p) {
    if(pixel_piece_material(b,p)==0u) return false;
    ivec2 cell=pixel_piece_cell(b,p);
    return pixel_material(b,cell)!=0u&&(pixel_material(b,cell+ivec2(-1,0))==0u||
        pixel_material(b,cell+ivec2(1,0))==0u||pixel_material(b,cell+ivec2(0,-1))==0u||
        pixel_material(b,cell+ivec2(0,1))==0u);
}
void main() {
    Body body=bodies[0];
    for(uint piece=gl_LocalInvocationIndex;piece<1024u;piece+=128u) {
        bool expected=reference_boundary(body,piece);
        reads=0u;
        bool actual=pixel_boundary(body,piece);uint cost=reads;
        if(actual!=expected) atomicAdd(results[0],1u);
        if(pixel_piece_material(body,piece)!=0u) {
            uvec2 local=uvec2(piece%16u,(piece%256u)/16u);
            if(all(greaterThan(local,uvec2(0)))&&all(lessThan(local,uvec2(15))))
                atomicMax(results[1],cost);
            else atomicMax(results[3],cost);
        }
        if(piece<pixel_tile_count(body)*256u) {
            vec2 reference[4];
            for(uint v=0u;v<4u;v++) reference[v]=vec2(3.25,-1.75)+piece_vertex(body,piece,v);
            reads=0u;Polygon polygon=body_polygon(body,piece,vec2(3.25,-1.75));
            atomicMax(results[4],reads);
            for(uint v=0u;v<4u;v++) if(any(notEqual(floatBitsToUint(reference[v]),floatBitsToUint(polygon.vertices[v])))) atomicAdd(results[5],1u);
            vec2 middle=body.center+body_rotate(vec2(pixel_piece_cell(body,piece))+.5-body.center,body.angle);
            for(int y=-1;y<=1;y++) for(int x=-1;x<=1;x++) for(uint f=0u;f<2u;f++) {
                ivec2 cell=ivec2(floor(middle))+ivec2(x,y);float fraction=f==0u?1.:.37;
                vec2 expected_center,actual_center;
                float expected_volume=reference_cell_volume(body,piece,cell,fraction,expected_center);
                reads=0u;float actual_volume=body_cell_volume(body,piece,cell,fraction,actual_center);
                atomicMax(results[8],reads);
                if(floatBitsToUint(actual_volume)!=floatBitsToUint(expected_volume)||
                   any(notEqual(floatBitsToUint(actual_center),floatBitsToUint(expected_center)))) atomicAdd(results[9],1u);
                vec2 start=vec2(cell)+vec2(.125,.25),stop=start+vec2(.75,.5);
                float expected_face=reference_face_coverage(body,piece,start,stop);
                reads=0u;float actual_face=body_face_coverage(body,piece,start,stop);
                atomicMax(results[10],reads);
                if(floatBitsToUint(actual_face)!=floatBitsToUint(expected_face)) atomicAdd(results[11],1u);
                bool expected_overlap=reference_piece_cell_overlap(body,piece,cell);
                reads=0u;bool actual_overlap=piece_cell_overlap(body,piece,cell);
                atomicMax(results[13],reads);
                if(actual_overlap!=expected_overlap) atomicAdd(results[14],1u);
                atomicAdd(results[12],1u);
            }
        }
        atomicAdd(results[2],1u);
    }
    for(uint word=gl_LocalInvocationIndex;word<pixel_tile_count(body)*32u;word+=128u) {
        reads=0u;uint mask=pixel_boundary_mask(body,word),cost=reads,expected=0u;
        for(uint bit=0u;bit<8u;bit++) if(reference_boundary(body,word*8u+bit)) expected|=1u<<(bit*4u);
        if(mask!=expected) atomicAdd(results[6],1u);
        atomicMax(results[7],cost);
    }
}
