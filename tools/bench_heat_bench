#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
frames=${1:-1000}
if [[ ! $frames =~ ^[0-9]+$ ]] || ((frames<1000||frames>100000)); then
    echo 'Expected 1000..100000 complete displayed frames per run' >&2
    exit 2
fi
tools/with-vulkan make -j8 build/dungeoncraft_quarter_native
root=$(mktemp -d build/heat_bench_measurements_XXXXXX)
failed=0
for scenario in dry pour; do
    for repetition in 1 2; do
        world="$root/${scenario}_${repetition}"
        mkdir "$world"
        log="$root/${scenario}_${repetition}.log"
        environment=(env -u DC_BENCHMARK_AIR_BRUSH -u DC_BENCHMARK_WATER_POUR -u DC_FRAME_TIMINGS
            SDL_VIDEODRIVER=wayland DC_VK_VALIDATE=0 VK_INSTANCE_LAYERS= VK_LAYER_ENABLES=)
        if [[ $scenario == pour ]]; then environment+=(DC_BENCHMARK_WATER_POUR=140,188,3); fi
        result=0
        "${environment[@]}" \
            tools/with-vulkan ./build/dungeoncraft_quarter_native --heat-bench \
            --world-dir "$world" --benchmark-frames "$frames" \
            --benchmark-capture "$root/${scenario}_${repetition}.bmp" > "$log" 2>&1 || result=$?
        cat "$log"
        if ((result!=0)); then
            failed=1
            if ! rg -q '^Displayed full frame' "$log"; then exit "$result"; fi
        fi
    done
done
echo "Heat bench display evidence: $root"
exit "$failed"
