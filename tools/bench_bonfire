#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
frames=${1:-1000}
if [[ ! $frames =~ ^[0-9]+$ ]] || ((frames<1000||frames>100000)); then
    echo 'Expected 1000..100000 complete displayed frames per run' >&2
    exit 2
fi
source tools/smoke_profile
tools/with-vulkan make -j8 build/dungeoncraft_quarter_native
root=$(mktemp -d build/bonfire_measurements_XXXXXX)
failed=0
for scenario in dry wet; do
    x=160
    if [[ $scenario == wet ]]; then x=352; fi
    for repetition in 1 2; do
        world="$root/${scenario}_${repetition}"
        mkdir "$world"
        log="$root/${scenario}_${repetition}.log"
        result=0
        env -u DC_BENCHMARK_AIR_BRUSH -u DC_BENCHMARK_WATER_POUR \
            SDL_VIDEODRIVER=wayland DC_VK_VALIDATE=0 VK_INSTANCE_LAYERS= VK_LAYER_ENABLES= \
            DC_BENCHMARK_HEAT_PROBE="$x,208,0" \
            tools/with-vulkan ./build/dungeoncraft_quarter_native --bonfire \
            --world-dir "$world" --benchmark-frames "$frames" \
            --benchmark-capture "$root/${scenario}_${repetition}.bmp" > "$log" 2>&1 || result=$?
        cat "$log"
        if ((result!=0)); then failed=1; fi
    done
done
echo "Bonfire display evidence: $root"
exit "$failed"
