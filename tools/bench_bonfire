#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
frames=${1:-1000}
if [[ ! $frames =~ ^[0-9]+$ ]] || ((frames<1000||frames>100000)); then
    echo 'Expected 1000..100000 complete displayed frames per run' >&2
    exit 2
fi
source tools/smoke_profile
tools/with-vulkan make -j8 build/dungeoncraft_quarter_native
root=$(mktemp -d build/bonfire_measurements_XXXXXX)
failed=0
# Both pits ignite autonomously in each run; never inject a benchmark heater.
for repetition in 1 2; do
    world="$root/autonomous_$repetition"
    mkdir "$world"
    log="$root/autonomous_$repetition.log"
    result=0
    env -u DC_BENCHMARK_AIR_BRUSH -u DC_BENCHMARK_WATER_POUR -u DC_BENCHMARK_HEAT_PROBE \
        SDL_VIDEODRIVER=wayland DC_FULLSCREEN=1 DC_VK_VALIDATE=0 VK_INSTANCE_LAYERS= VK_LAYER_ENABLES= \
        timeout --signal=INT --kill-after=3s 120s tools/with-vulkan \
        ./build/dungeoncraft_quarter_native --bonfire \
        --world-dir "$world" --benchmark-frames "$frames" \
        --benchmark-capture "$root/autonomous_$repetition.bmp" > "$log" 2>&1 || result=$?
    cat "$log"
    if ((result!=0)); then failed=1; fi
done
echo "Bonfire display evidence: $root"
exit "$failed"
