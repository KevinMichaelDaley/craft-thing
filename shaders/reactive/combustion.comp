}
void burn(ivec2 position,uint gas_at,inout Gas gas,inout float admitted,inout float source_temperature,inout uint sources) {
    uint at=atlas(position);if(at==0xffffffffu||target(position)!=gas_at) return;
    uvec2 handle=Handles(uvec2(root[6],root[7])).values[at];
    burn_entry(position,gas_at,handle,1u,0u,0u,gas,admitted,source_temperature,sources);
}
#ifdef FR_BODY_REACTIONS
ivec2 body_parcel_cell(Body body,uint piece) {
    BodyQuad quad;if(!body_pixel_quad(body,piece,quad)) return ivec2(-1);
    return ivec2(floor(vec2(body.x_fp,body.y_fp)/65536.+.25*(quad.a+quad.b+quad.c+quad.d)));
}
void choose_body_target(uint index) {
    if(index>=root[2]) return;
    Words e=Words(reactive_entry_address(uvec2(root[4],root[5]),index));if(e.words[FR_ENTRY_OWNER]!=2u) return;
    Words scratch=Words(uvec2(root[FR_ARENA_THERMAL_SCRATCH],root[FR_ARENA_THERMAL_SCRATCH+1u]));
    uint target_word=index*12u+5u;scratch.words[target_word]=0xffffffffu;
    uint slot=runtime_body_find(e.words[FR_ENTRY_OWNER+1u]);if(slot>=BODY_CAPACITY) return;
    Body body=body_thermal_grid(DC_BODY(slot));if(!pixel_body(body)) return;
    uint piece=pixel_piece_at(body,ivec2(e.words[FR_ENTRY_OWNER+3u],e.words[FR_ENTRY_OWNER+4u]));
    uvec2 h=fr_body_reactive_handle(body,slot,piece);if(h.x!=index||h.y!=e.words[FR_ENTRY_GENERATION]) return;
    uint s=FR_ENTRY_STATE,m=e.words[s];
    if((m==7u||m==8u||m==9u||m==11u||m==12u)&&
       (e.words[s+9u]|e.words[s+10u]|e.words[s+FR_STATE_COATING_REMAINDERS]|
        e.words[s+13u]|e.words[s+14u]|e.words[s+15u]|e.words[s+16u])==0u&&
       (e.words[s+11u]|e.words[s+12u])!=0u) atomicOr(hud[DC_BODY_ASH_DISPATCH_WORD],1u);
    ivec2 p=body_parcel_cell(body,piece);float best=-1.;uint chosen=0xffffffffu;
    float capacity=solid_capacity(e),bulk=capacity>0.?uintBitsToFloat(e.words[s+17u])/capacity:0.;
    uint profile=e.words[s+9u]==0u&&e.words[s+10u]>0u?12u:m;
    bool bound_film=e.words[s+FR_STATE_COATING_OIL]>0u&&
        e.words[s+FR_STATE_COATING_JELLY]>0u&&
        e.words[s+FR_STATE_COATING_OXIDIZER]>0u;
    float reaction_power=fr_surface_reaction_power(uintBitsToFloat(scratch.words[index*12u+6u]),0.,uintBitsToFloat(params.seconds));
    float skin=0.;
    for(uint d=0u;d<8u;d++) {
        ivec2 direction=body_directions[d];
        ivec2 q=p+direction;uint at=atlas(q);if(!reaction_receiver(at)) continue;
        if(d>=4u&&!body_corner_reachable(p,direction)) continue;
        Gas gas=local_gas(at);float mass=gas_mass(gas);
        if(bound_film&&cells[at].y>0u&&best<0.) {best=0.;chosen=at;}
        if(mass<=0.||gas.geometry.y<=0.) continue;
        float supply=max(gas.species.x,0.);
        if(supply>best) {best=supply;chosen=at;}
        float gas_cap=gas_capacity(gas),gas_temperature=gas_cap>0.?gas_internal(gas)/gas_cap:bulk;
        float speed=length(gas.dynamics.zw)/mass,density=mass*1000./max(gas.geometry.x,.000001);
        float face=float(FR_THERMAL_GAMEPLAY_FACE_METERS)*(d<4u?1.:.5);
        float reynolds=density*speed*face*face/float(FR_COMBUSTION_AIR_VISCOSITY);
        float nusselt=2.+.6*sqrt(max(reynolds,0.))*pow(float(FR_COMBUSTION_AIR_PRANDTL),1./3.);
        float convection=nusselt*gas_air_conductivity(.5*(bulk+gas_temperature))*face;
        /* The hottest exposed face can ignite even when a different face owns
         * the oxygen reservation. Read all gas here, before any reaction writes. */
        float ambient=float(FR_THERMAL_AMBIENT_K),ambient_square=ambient*ambient,gas_square=gas_temperature*gas_temperature;
        float surroundings=sqrt(sqrt(mix(ambient_square*ambient_square,gas_square*gas_square,flame_emissivity(gas))));
        skin=max(skin,fr_thermal_exposed_surface_K(bulk,gas_temperature,
            coefficient(profile,6u)*float(FR_THERMAL_FACE_AREA/FR_THERMAL_CORE_DISTANCE)*(d<4u?1.:.5),convection,
            uintBitsToFloat(scratch.words[index*12u+10u]),uintBitsToFloat(scratch.words[index*12u+11u])+reaction_power,surroundings));
    }
    scratch.words[index*12u+9u]=floatBitsToUint(skin>0.?skin:bulk);
    scratch.words[index*12u+6u]=floatBitsToUint(reaction_power);
    scratch.words[target_word]=chosen;
    if(e.words[FR_ENTRY_STATE+10u]>0u&&e.words[FR_ENTRY_STATE+9u]==0u) {
        if(chosen!=0xffffffffu) {atomicAdd(hud[22],1u);Gas gas=local_gas(chosen);float mass=gas_mass(gas);
            if(gas.species.x>0.) atomicAdd(hud[23],1u);
            atomicMax(hud[27],floatBitsToUint(max(gas.species.x,0.)));}
        if(all(greaterThanEqual(p,ivec2(0)))&&all(lessThan(p,ivec2(params.width,params.height)))&&
