    burn_coating(entry,gas,admitted,source_temperature,sources);
    corrode_entry(entry,owner,at,geometry_word,geometry_nibble,gas);
    uint coating_remainders=entry.words[s+FR_STATE_COATING_REMAINDERS];
    if((entry.words[s+14u]|entry.words[s+15u]|entry.words[s+16u]|
        ((coating_remainders>>FR_COATING_JELLY_REM_SHIFT)&FR_COATING_REM_MASK)|
        ((coating_remainders>>FR_COATING_JELLY_FUEL_REM_SHIFT)&FR_COATING_FUEL_REM_MASK))!=0u) return;
    bool char_stage=wood_fuel==0u;uint fuel=char_stage?entry.words[s+10u]:wood_fuel;
    if(owner==2u&&char_stage&&fuel>0u) atomicAdd(hud[25],1u);
    uint profile=char_stage?12u:m;
    float base=((float(wood_fuel)+float(entry.words[s+11u]))*coefficient(m,5u)+
        float(entry.words[s+10u])*coefficient(12u,5u)+float(entry.words[s+12u])*coefficient(3u,5u))/65536.;
    if(m!=7u&&m!=8u&&m!=9u&&m!=11u&&m!=12u) return;
    if(fuel==0u) {
#ifdef FR_BODY_REACTIONS
        if(owner==2u) Words(uvec2(root[FR_ARENA_THERMAL_SCRATCH],root[FR_ARENA_THERMAL_SCRATCH+1u])).words[handle.x*12u+6u]=0u;
#endif
        if(entry.words[s+FR_STATE_COATING_OIL]!=0u||
           (coating_remainders&FR_COATING_REM_MASK)!=0u) return;
        if(owner==1u) loose_ash(position,at,handle,entry,gas);return;
    }
    if(base<=0.) return;
    float energy=uintBitsToFloat(entry.words[s+17u]),
        bulk_temperature=fr_char_mixture_temperature(energy,base,float(entry.words[s+10u])/65536.),
        temperature=bulk_temperature;
    float wet_capacity=float(entry.words[s+8u])*coefficient(m,19u);
    float wet=wet_capacity>0.?clamp(float(entry.words[s+12u])/wet_capacity,0.,1.):0.;
    float mass=dot(gas.species,vec4(1))+gas.dynamics.x;
    float oxygen=mass>0.?gas.species.x/mass:0.;
#ifdef FR_BODY_REACTIONS
    if(owner==2u) {
        Words cache=Words(uvec2(root[FR_ARENA_THERMAL_SCRATCH],root[FR_ARENA_THERMAL_SCRATCH+1u]));
        temperature=uintBitsToFloat(cache.words[handle.x*12u+9u]);
        if(!char_stage) atomicMax(hud[29],floatBitsToUint(max(temperature,0.)));
        uint origin=(entry.words[s+4u]-1u)&4095u,x=origin%64u,y=origin/64u,category=0xffffffffu;
        if(y==26u&&(x<28u||x>35u)) category=0u;
        if(y>=16u&&y<=18u) category=1u;
        if(y>=21u&&y<=23u) category=x<32u?2u:3u;
        if(category<4u) atomicMax(hud[(position.x>=320?14u:8u)+category],floatBitsToUint(max(temperature,0.)));
