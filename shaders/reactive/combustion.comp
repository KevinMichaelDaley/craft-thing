/* Each parcel chooses one neighboring gas cell. The owning gas invocation
 * gathers face and open-corner surfaces, reserving shared oxygen locally before commit.
 * There is no field scan, atomic float race or global flame capacity. */
void evaporate_entry(Words entry,inout Gas gas) {
    uint s=FR_ENTRY_STATE,water=entry.words[s+12u];
    if(water==0u) {entry.words[s+FR_STATE_EVAPORATION_FRACTION]=0u;return;}
    float dt=uintBitsToFloat(params.seconds),capacity=solid_capacity(entry),gas_cap=gas_capacity(gas);
    if(dt<=0.||capacity<=0.||gas_cap<=0.||gas.geometry.x<=0.||gas.geometry.y<=0.) return;
    Words model=Words(params.model_address);
    float vapor_R=uintBitsToFloat(model.words[3u]),vapor_cv=uintBitsToFloat(model.words[8u]);
    float ambient_density=uintBitsToFloat(model.words[11u]);
    if(vapor_R<=0.||vapor_cv<=0.||ambient_density<=0.) return;
    float temperature=(uintBitsToFloat(entry.words[s+17u])+uintBitsToFloat(entry.words[s+25u])+
        uintBitsToFloat(entry.words[s+26u]))/capacity;
    if(temperature<=0.) return;
    float oxygen_fraction=uintBitsToFloat(model.words[13u]);
    float air_R=oxygen_fraction*uintBitsToFloat(model.words[0u])+
        (1.-oxygen_fraction)*uintBitsToFloat(model.words[1u]);
    float exponent=float(FR_THERMAL_WATER_LATENT_KJ_PER_KG)/vapor_R*
        (1./float(FR_THERMAL_WATER_BOIL_K)-1./temperature);
    float saturated=ambient_density*air_R*float(FR_THERMAL_AMBIENT_K)*
        exp(exponent)*gas.geometry.x/(vapor_R*temperature);
    float deficit=max(0.,saturated-gas.species.w);
    float rate=float(FR_THERMAL_VAPOR_DIFFUSIVITY_M2_PER_S)/
        float(FR_THERMAL_GAMEPLAY_FACE_METERS*FR_THERMAL_GAMEPLAY_FACE_METERS);
    float previous=uintBitsToFloat(entry.words[s+FR_STATE_EVAPORATION_FRACTION]);
    float requested=min(deficit*65536.,previous+deficit*65536.*rate*dt);
    if(isnan(requested)||isinf(requested)||requested<0.) return;
    uint whole=uint(floor(min(requested,float(min(water,16777215u)))));
    float fraction=requested-floor(requested);
    float offset=float(FR_THERMAL_WATER_LATENT_KJ_PER_KG)+
        (coefficient(3u,5u)-vapor_cv-vapor_R)*float(FR_THERMAL_WATER_BOIL_K);
    float per_kg=offset+vapor_cv*temperature;
    float energy=uintBitsToFloat(entry.words[s+17u])+uintBitsToFloat(entry.words[s+25u])+
        uintBitsToFloat(entry.words[s+26u]);
