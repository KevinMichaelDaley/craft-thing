    float wet_capacity=float(entry.words[s+8u])*coefficient(m,19u);
    float wet=wet_capacity>0.?clamp(float(entry.words[s+12u])/wet_capacity,0.,1.):0.;
    float mass=dot(gas.species,vec4(1))+gas.dynamics.x;
    float oxygen=mass>0.?gas.species.x/mass:0.;
    float dt=uintBitsToFloat(params.seconds),dry=1.-wet;
    float threshold=uintBitsToFloat(entry.words[s+20u]);
    if(threshold==0.) threshold=ignition_threshold(entry.words[s+4u],entry.words[s+5u]);
    float rate=temperature>=coefficient(profile,7u)?coefficient(profile,8u)*
        (dry*dry+wet*coefficient(profile,22u))*(1.+uintBitsToFloat(entry.words[s+18u])*(coefficient(profile,20u)-1.))*
        clamp((oxygen-.12)/(.21-.12),0.,1.):0.;
