    return Words(params.unused.zw).words[32u+(at/4096u)*8u+4u];
}
void terrain_changed() {
    if((params.unused.z|params.unused.w)!=0u) atomicOr(Words(params.unused.zw).words[20u],1u);
}
Gas local_gas(uint at) {
    bool alternate=params.sparse!=0u&&(Words(params.gates_address).words[at]&8u)!=0u;
    return GasField(alternate?params.alternate_address:params.world_address).values[at];
