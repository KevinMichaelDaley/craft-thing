    uint flags=entry.words[s+1u];
    bool viable=temperature>=coefficient(profile,7u)&&oxygen>.12&&wet<.8;
    if(!viable) flags&=~2u;else if(integral>=threshold) flags|=2u;
    entry.words[s+20u]=floatBitsToUint(threshold);entry.words[s+21u]=floatBitsToUint(integral);
    entry.words[s+1u]=flags;
    if(!viable||(flags&2u)==0u) return;
    float demand=coefficient(profile,12u);
    float oxygen_fp=max(0.,gas.species.x)*65536.;
    float requested=float(entry.words[s+8u])*coefficient(profile,31u)*dt*dry*dry+uintBitsToFloat(entry.words[s+27u]);
    entry.words[s+27u]=floatBitsToUint(min(requested-floor(requested),.99999994));
    uint reacted=uint(floor(min(min(float(fuel),requested),oxygen_fp/demand)));
    float used=float(reacted)*demand;if(reacted==0u||used>oxygen_fp) return;
    uint initial=uint(round(float(entry.words[s+8u])*coefficient(profile,9u))),consumed=initial>=fuel?initial-fuel:0u;
    uvec3 products=solid_products(consumed+reacted,profile)-solid_products(consumed,profile);
    uint char_mass=products.x,ash=products.y,soot=products.z;
    float exhaust=float(reacted-char_mass-ash-soot)+used;
    float heat=(float(reacted)*coefficient(profile,11u)-float(soot)*float(FR_COMBUSTION_AIRBORNE_ENERGY))/65536.;
    admitted+=heat;source_temperature=max(source_temperature,temperature);sources|=1u;
    float removed=float(reacted)/65536.*coefficient(profile,5u)*temperature;
    float retained=float(char_mass)/65536.*coefficient(12u,5u)*temperature;
    /* Ash remains finite in the parcel until the loose-residue publication
     * stage admits its physical particle; no product is discarded here. */
    retained+=float(ash)/65536.*coefficient(m,5u)*temperature;
    if(char_stage) entry.words[s+10u]=fuel-reacted+char_mass;
    else {entry.words[s+9u]=fuel-reacted;entry.words[s+10u]+=char_mass;}
