    whole=uint(floor(min(float(whole),max(0.,energy-max(.000001,energy*.000001))*65536./per_kg)));
    if(whole>0u) {
        float mass=float(whole)/65536.;
        entry.words[s+12u]=water-whole;
        add_energy(entry,-mass*per_kg);
