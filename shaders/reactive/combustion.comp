        float(coating_remainders&FR_COATING_REM_MASK)/float(FR_COATING_MASS_DEN);
    float coverage=min(1.,oil_mass/max(1.,float(entry.words[s+FR_STATE_DRY_MASS])));
    rate*=1.+coverage*max(0.,coefficient(FR_COATING_OIL_MATERIAL,FR_PROFILE_OIL_HAZARD_WORD)-1.);
