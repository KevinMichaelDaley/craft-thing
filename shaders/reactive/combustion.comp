                uint piece=pixel_piece_at(nb,nq);
                uvec2 nh=fr_body_reactive_handle(nb,slot,piece);
                if(nh.y==0u||nh.x>=root[2]) continue;
                Words ne=Words(reactive_entry_address(uvec2(root[4],root[5]),nh.x));
                if(ne.words[FR_ENTRY_GENERATION]!=nh.y||ne.words[FR_ENTRY_OWNER]!=2u) continue;
                uint ns=FR_ENTRY_STATE,nm=ne.words[ns];
                if(nm!=7u&&nm!=8u&&nm!=9u&&nm!=12u) continue;
