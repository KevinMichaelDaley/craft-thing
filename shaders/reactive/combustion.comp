}
void main() {
    uint i=gl_GlobalInvocationID.x+gl_GlobalInvocationID.y*gl_NumWorkGroups.x*64u;
    if(i>=params.width*params.height) return;
    ivec2 p=ivec2(i%params.width,i/params.width);uint at=atlas(p);
    if(params.unused.x==4u) {
        fluxes[i].zw=vec2(p.x+1<int(params.width)?contact_flux(at,atlas(p+ivec2(1,0))):0.,
            p.y+1<int(params.height)?contact_flux(at,atlas(p+ivec2(0,1))):0.);return;
    }
    if(params.unused.x==5u) {contact_apply(i,at);return;}
    if(params.unused.x==3u) {
        if(at!=0xffffffffu) emission[at]=vec4(0.,0.,uintBitsToFloat(slot_generation(at)),0.);
        uvec2 address;uint chosen=0xffffffffu;
        if(solid_address(at,address)) {
            uint material=Words(address).words[FR_ENTRY_STATE];
            if(material==7u||material==8u||material==9u||material==12u) chosen=choose_target(p);
        }
        samples[i+params.width*params.height].w=uintBitsToFloat(chosen);
        extinguish_unexposed(p,at);return;
    }
    if(params.unused.x==1u) {feedback(i,p,at);return;}
    if(!gas_cell(at)) return;
    bool alternate=params.sparse!=0u&&(Words(params.gates_address).words[at]&8u)!=0u;
    GasField field=GasField(alternate?params.alternate_address:params.world_address);Gas gas=field.values[at];
    if(gas.geometry.y<=0.) return;
    if(params.unused.x==2u) {
        Words model=Words(params.model_address);
        vec4 cv=vec4(uintBitsToFloat(model.words[5]),uintBitsToFloat(model.words[6]),
            uintBitsToFloat(model.words[7]),uintBitsToFloat(model.words[8]));
        float mass=dot(gas.species,vec4(1))+gas.dynamics.x;
        float capacity=dot(gas.species,cv)+gas.dynamics.x*uintBitsToFloat(model.words[9]);
        if(mass>0.&&capacity>0.) {
            float kinetic=.5*uintBitsToFloat(model.words[10])*dot(gas.dynamics.zw,gas.dynamics.zw)/mass;
            float energy=max(0.,gas.dynamics.y+gas.visual.w+gas.geometry.z-kinetic);
            samples[i]=vec4(energy,capacity,.02,0.);
            samples[i+params.width*params.height]=vec4(uintBitsToFloat(3u),0.,0.,0.);
        }
        return;
    }
    float admitted=oxidize_carbon(gas),temperature=gas_capacity(gas)>0.?gas_internal(gas)/gas_capacity(gas):0.;
    uint sources=admitted>0.?2u:0u;
    for(uint face=0u;face<4u;face++) burn(p+directions[face],at,gas,admitted,temperature,sources);
    emission[at]=vec4(admitted/uintBitsToFloat(params.seconds),temperature,
        uintBitsToFloat(slot_generation(at)),uintBitsToFloat(sources));
    field.values[at]=gas;
}
