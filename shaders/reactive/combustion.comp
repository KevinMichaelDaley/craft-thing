    uint char_mass=products.x,ash=products.y,soot=products.z;
    float exhaust=float(reacted-char_mass-ash-soot)+used;
    float heat=(float(reacted)*coefficient(profile,11u)-float(soot)*float(FR_COMBUSTION_AIRBORNE_ENERGY))/65536.;
#ifdef FR_BODY_REACTIONS
    if(owner==2u) Words(uvec2(root[FR_ARENA_THERMAL_SCRATCH],root[FR_ARENA_THERMAL_SCRATCH+1u])).words[handle.x*12u+6u]=floatBitsToUint(
        uintBitsToFloat(Words(uvec2(root[FR_ARENA_THERMAL_SCRATCH],root[FR_ARENA_THERMAL_SCRATCH+1u])).words[handle.x*12u+6u])+
        fr_surface_reaction_power(0.,.7*heat,dt));
