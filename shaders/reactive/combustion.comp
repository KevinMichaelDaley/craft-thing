                uint take_jelly=min(share_jelly,e.words[s+14u]);
                uint take_ox=min(share_oxidizer,e.words[s+FR_STATE_COATING_OXIDIZER]);
                if(take_oil+take_jelly==0u) break;
                atomicAdd(ne.words[ns+FR_STATE_COATING_OIL],take_oil);
                atomicAdd(ne.words[ns+FR_STATE_COATING_JELLY],take_jelly);
                atomicAdd(ne.words[ns+FR_STATE_COATING_OXIDIZER],take_ox);
                e.words[s+13u]-=take_oil;
                e.words[s+14u]-=take_jelly;
                e.words[s+FR_STATE_COATING_OXIDIZER]-=take_ox;
