    if(threshold==0.) threshold=ignition_threshold(entry.words[s+4u],entry.words[s+5u]);
    float rate=temperature>=coefficient(profile,7u)?coefficient(profile,8u)*
        (dry*dry+wet*coefficient(profile,22u))*(1.+uintBitsToFloat(entry.words[s+18u])*(coefficient(profile,20u)-1.))*
        max(oxygen,0.)/float(FR_COMBUSTION_AMBIENT_OXYGEN):0.;
