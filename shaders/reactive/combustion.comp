    uint mass=entry.words[s+11u]+entry.words[s+12u];
    if(mass==0u) {
        gas.dynamics.y+=uintBitsToFloat(entry.words[s+17u])+uintBitsToFloat(entry.words[s+25u])+
            uintBitsToFloat(entry.words[s+26u])+uintBitsToFloat(entry.words[s+24u]);
