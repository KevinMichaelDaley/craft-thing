#include "flame_gas.glsl"
vec2 two_sum(float a,float b) {
    precise float sum=a+b,recovered=sum-a;
    precise float error=(a-(sum-recovered))+(b-recovered);return vec2(sum,error);
}
void add_energy(Words entry,float delta) {
    vec2 first=two_sum(uintBitsToFloat(entry.words[FR_ENTRY_STATE+FR_STATE_ENERGY]),delta);
    vec2 second=two_sum(uintBitsToFloat(entry.words[FR_ENTRY_STATE+FR_STATE_ENERGY_RESIDUAL]),first.y);
    precise float last=uintBitsToFloat(entry.words[FR_ENTRY_STATE+FR_STATE_ENERGY_CORRECTION])+second.y;
    vec2 middle=two_sum(second.x,last),top=two_sum(first.x,middle.x),tail=two_sum(top.y,middle.y);
    entry.words[FR_ENTRY_STATE+FR_STATE_ENERGY]=floatBitsToUint(top.x);
    entry.words[FR_ENTRY_STATE+FR_STATE_ENERGY_RESIDUAL]=floatBitsToUint(tail.x);
    entry.words[FR_ENTRY_STATE+FR_STATE_ENERGY_CORRECTION]=floatBitsToUint(tail.y);
}
bool solid_address(uint at,out uvec2 address) {
    if(at==0xffffffffu||gas_cell(at)) return false;
    uvec2 handle=Handles(uvec2(root[6],root[7])).values[at];
    if(handle.y==0u||handle.x>=root[2]) return false;
    address=reactive_entry_address(uvec2(root[4],root[5]),handle.x);
    Words entry=Words(address);
    return entry.words[FR_ENTRY_GENERATION]==handle.y&&entry.words[FR_ENTRY_OWNER]==1u;
}
float solid_capacity(Words entry) {
    uint s=FR_ENTRY_STATE,m=entry.words[s];
    float base=((float(entry.words[s+9u])+float(entry.words[s+11u])+float(entry.words[s+15u]))*coefficient(m,5u)+
        float(entry.words[s+10u])*coefficient(12u,5u)+
        float(entry.words[s+12u])*coefficient(3u,5u))/65536.+coating_heat_capacity(entry,s);
    float energy=uintBitsToFloat(entry.words[s+17u])+uintBitsToFloat(entry.words[s+25u])+uintBitsToFloat(entry.words[s+26u]);
    return fr_char_mixture_secant_capacity(energy,base,float(entry.words[s+10u])/65536.);
}
float gas_conduction_flux(uint first,uint second,uint a,uint b) {
    if(gas_cell(a)&&gas_cell(b)) {
        uint axis=second==first+1u?0u:1u;
        if((Words(params.gates_address).words[a]&(1u<<axis))!=0u) return 0.;
        Gas left=local_gas(a),right=local_gas(b);
        float left_cap=gas_capacity(left),right_cap=gas_capacity(right);
        if(left_cap<=0.||right_cap<=0.||left.geometry.y<=0.||right.geometry.y<=0.) return 0.;
        float aperture=sqrt(min(min(left.geometry.y,right.geometry.y),1.));
        return gas_fourier_face_heat(gas_internal(left)/left_cap,gas_internal(right)/right_cap,
            left_cap,right_cap,aperture,uintBitsToFloat(params.seconds));
    }
