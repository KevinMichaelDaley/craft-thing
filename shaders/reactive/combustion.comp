uvec3 solid_products(uint consumed,uint material) {
    uint char_mass=uint(floor(float(consumed)*coefficient(material,14u))),rest=consumed-char_mass;
    uint ash=uint(floor(float(rest)*coefficient(material,15u)/(1.-coefficient(material,14u))));rest-=ash;
    uint soot=uint(floor(float(rest)*coefficient(material,16u)/(1.-coefficient(material,14u)-coefficient(material,15u))));
    return uvec3(char_mass,ash,soot);
}
bool burning(uint at) {
    if(at==0xffffffffu) return false;
    uvec2 handle=Handles(uvec2(root[6],root[7])).values[at];
    if(handle.y==0u||handle.x>=root[2]) return false;
    Words entry=Words(reactive_entry_address(uvec2(root[4],root[5]),handle.x));
    return entry.words[FR_ENTRY_GENERATION]==handle.y&&entry.words[FR_ENTRY_OWNER]==1u&&
        (entry.words[FR_ENTRY_STATE+1u]&2u)!=0u&&
        (entry.words[FR_ENTRY_STATE+9u]!=0u||entry.words[FR_ENTRY_STATE+10u]!=0u);
}
#include "body_surface_feedback.glsl"
void feedback(uint index,ivec2 p,uint at) {
    body_surface_feedback(index);
    if(at!=0xffffffffu&&!gas_cell(at)) {
        uvec2 handle=Handles(uvec2(root[6],root[7])).values[at];
        if(handle.y!=0u&&handle.x<root[2]) {
            Words entry=Words(reactive_entry_address(uvec2(root[4],root[5]),handle.x));uint s=FR_ENTRY_STATE;
            if(entry.words[FR_ENTRY_GENERATION]==handle.y&&entry.words[FR_ENTRY_OWNER]==1u&&
               (entry.words[s]==7u||entry.words[s]==8u||entry.words[s]==9u||entry.words[s]==12u)&&entry.words[s+8u]!=0u) {
                float charred=clamp(4.*float(entry.words[s+10u])/float(entry.words[s+8u]),0.,1.);
                vec3 color=unpackUnorm4x8(pixels[index]).rgb;
                pixels[index]=packUnorm4x8(vec4(color*(1.-.9*charred),1.));
            }
        }
    }
    /* Flame emission is supplied by local transported gas reaction state.
     * No screen-space trail or predetermined height is admissible. */
    if(!gas_cell(at)) return;
    vec4 source=emission[at];if(source.x<=0.||floatBitsToUint(source.z)!=slot_generation(at)) return;
    Gas gas=local_gas(at);float capacity=gas_capacity(gas);
    if(capacity<=0.||gas.geometry.y<=0.) return;
    if((floatBitsToUint(source.w)&1u)==0u&&gas_internal(gas)/capacity<float(FR_COMBUSTION_AIRBORNE_IGNITION_K)) return;
    /* Bits 8..31 optionally carry RGB8 magic chromaticity; bit 2 enables it.
     * Ordinary reaction writes leave this override disabled. */
    uint visual_flags=floatBitsToUint(source.w);
    vec3 magic=unpackUnorm4x8(visual_flags>>8u).rgb;
    vec3 color=fr_blackbody_rgb(source.y,1.,(visual_flags&FR_FIRE_EMISSION_MAGIC)!=0u,magic);
    float visible=(visual_flags&FR_FIRE_EMISSION_MAGIC)!=0u?1.:fr_blackbody_visible_efficiency(source.y);
    float alpha=1.-exp(-source.x*visible*float(FR_COMBUSTION_EMISSION_EXPOSURE));
    pixels[index]=packUnorm4x8(vec4(mix(unpackUnorm4x8(pixels[index]).rgb,color,alpha),1.));
}
void extinguish_thermally(uint at) {
    if(at==0xffffffffu) return;
    uvec2 handle=Handles(uvec2(root[6],root[7])).values[at];if(handle.y==0u||handle.x>=root[2]) return;
    Words entry=Words(reactive_entry_address(uvec2(root[4],root[5]),handle.x));
    if(entry.words[FR_ENTRY_GENERATION]!=handle.y||entry.words[FR_ENTRY_OWNER]!=1u) return;
    uint s=FR_ENTRY_STATE,m=entry.words[s],profile=entry.words[s+9u]==0u?12u:m;
    float capacity=solid_capacity(entry),temperature=capacity>0.?uintBitsToFloat(entry.words[s+17u])/capacity:0.;
    float water_capacity=float(entry.words[s+8u])*coefficient(m,19u);
    float wet=water_capacity>0.?float(entry.words[s+12u])/water_capacity:0.;
    if((entry.words[s+9u]|entry.words[s+10u])==0u||temperature<coefficient(profile,7u)||wet>=.8)
        entry.words[s+1u]&=~2u;
