float liquid_cut_cell_flux(uint at) {
    if(at==0xffffffffu||!gas_cell(at)||cells[at].y==0u) return 0.;
    Gas gas=local_gas(at);
    if(gas.geometry.y<=0.) return 0.;
    float water_capacity=float(cells[at].y)/65536.*coefficient(3u,5u);
    float gas_cap=gas_capacity(gas),mass=gas_mass(gas);
    if(water_capacity<=0.||gas_cap<=0.||mass<=0.) return 0.;
    float water_temperature=float(FR_THERMAL_AMBIENT_K)+uintBitsToFloat(water_heat_words[at])/water_capacity;
    float gas_temperature=gas_internal(gas)/gas_cap;
    float difference=water_temperature-gas_temperature;
    if(abs(difference)<.001) return 0.;
    float length_m=float(FR_THERMAL_GAMEPLAY_FACE_METERS);
    float speed=length(gas.dynamics.zw)/mass,density=mass*1000./max(gas.geometry.x,.000001);
    float reynolds=density*speed*length_m*length_m/float(FR_COMBUSTION_AIR_VISCOSITY);
    float nusselt=2.+.6*sqrt(max(reynolds,0.))*pow(float(FR_COMBUSTION_AIR_PRANDTL),1./3.);
    float conductance=nusselt*gas_air_conductivity(.5*(water_temperature+gas_temperature))*length_m;
    float requested=conductance*difference*uintBitsToFloat(params.seconds);
    float bound=.25*water_capacity*gas_cap/(water_capacity+gas_cap)*abs(difference);
    float available=requested>0.?max(0.,water_capacity*water_temperature)/4.:gas_internal(gas)/4.;
    return sign(requested)*min(abs(requested),min(bound,available));
