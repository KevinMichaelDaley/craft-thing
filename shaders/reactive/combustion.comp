float oxidize_carbon(inout Gas gas) {
    float activity=carbon_activity(gas);if(activity<=0.) return 0.;
    float extent=min(gas.dynamics.x*(1.-exp(-activity*uintBitsToFloat(params.seconds))),
        gas.species.x/float(FR_COMBUSTION_AIRBORNE_OXYGEN));
    float oxygen=min(gas.species.x,extent*float(FR_COMBUSTION_AIRBORNE_OXYGEN));
    gas.dynamics.x-=extent;gas.species.x-=oxygen;gas.species.z+=extent+oxygen;
    gas.dynamics.y+=extent*float(FR_COMBUSTION_AIRBORNE_ENERGY);
    return extent*float(FR_COMBUSTION_AIRBORNE_ENERGY);
}
vec2 two_sum(float a,float b) {
    precise float sum=a+b,recovered=sum-a;
    precise float error=(a-(sum-recovered))+(b-recovered);return vec2(sum,error);
}
void add_energy(Words entry,float delta) {
    vec2 first=two_sum(uintBitsToFloat(entry.words[FR_ENTRY_STATE+FR_STATE_ENERGY]),delta);
    vec2 second=two_sum(uintBitsToFloat(entry.words[FR_ENTRY_STATE+FR_STATE_ENERGY_RESIDUAL]),first.y);
    precise float last=uintBitsToFloat(entry.words[FR_ENTRY_STATE+FR_STATE_ENERGY_CORRECTION])+second.y;
    vec2 middle=two_sum(second.x,last),top=two_sum(first.x,middle.x),tail=two_sum(top.y,middle.y);
    entry.words[FR_ENTRY_STATE+FR_STATE_ENERGY]=floatBitsToUint(top.x);
    entry.words[FR_ENTRY_STATE+FR_STATE_ENERGY_RESIDUAL]=floatBitsToUint(tail.x);
    entry.words[FR_ENTRY_STATE+FR_STATE_ENERGY_CORRECTION]=floatBitsToUint(tail.y);
}
bool solid_address(uint at,out uvec2 address) {
    if(at==0xffffffffu||gas_cell(at)) return false;
    uvec2 handle=Handles(uvec2(root[6],root[7])).values[at];
    if(handle.y==0u||handle.x>=root[2]) return false;
    address=reactive_entry_address(uvec2(root[4],root[5]),handle.x);
    Words entry=Words(address);
    return entry.words[FR_ENTRY_GENERATION]==handle.y&&entry.words[FR_ENTRY_OWNER]==1u;
}
float solid_capacity(Words entry) {
    uint s=FR_ENTRY_STATE,m=entry.words[s];
    return ((float(entry.words[s+9u])+float(entry.words[s+11u])+float(entry.words[s+15u]))*coefficient(m,5u)+
        float(entry.words[s+10u])*coefficient(12u,5u)+float(entry.words[s+12u])*coefficient(3u,5u)+
        float(entry.words[s+13u])*coefficient(14u,5u)+
        (float(entry.words[s+14u])+float(entry.words[s+16u]))*coefficient(15u,5u))/65536.;
}
float contact_flux(uint a,uint b) {
    bool from_solid=!gas_cell(a);uvec2 address;
    if(gas_cell(a)==gas_cell(b)||!solid_address(from_solid?a:b,address)) return 0.;
    Words entry=Words(address);float capacity=solid_capacity(entry);Gas gas=local_gas(from_solid?b:a);
    float gas_cap=gas_capacity(gas),mass=gas_mass(gas);if(capacity<=0.||gas_cap<=0.||mass<=0.) return 0.;
    float energy=uintBitsToFloat(entry.words[FR_ENTRY_STATE+17u])+uintBitsToFloat(entry.words[FR_ENTRY_STATE+25u])+
        uintBitsToFloat(entry.words[FR_ENTRY_STATE+26u]);
    float difference=energy/capacity-gas_internal(gas)/gas_cap;
    if(abs(difference)<.001) return 0.;
    float speed=length(gas.dynamics.zw)/mass,density=mass*1000./max(gas.geometry.x,.000001);
    float length_m=float(FR_THERMAL_GAMEPLAY_FACE_METERS);
    float reynolds=density*speed*length_m*length_m/float(FR_COMBUSTION_AIR_VISCOSITY);
    float nusselt=2.+.6*sqrt(max(reynolds,0.))*pow(float(FR_COMBUSTION_AIR_PRANDTL),1./3.);
    float conductance=nusselt*float(FR_COMBUSTION_AIR_CONDUCTIVITY)*length_m;
    float requested=conductance*difference*uintBitsToFloat(params.seconds);
    float bound=.25*capacity*gas_cap/(capacity+gas_cap)*abs(difference);
    float flux=sign(requested)*min(abs(requested),bound);
    return from_solid?flux:-flux;
}
void contact_apply(uint i,uint at) {
    float heat=-fluxes[i].z-fluxes[i].w;
    if(i%params.width>0u) heat+=fluxes[i-1u].z;
    if(i>=params.width) heat+=fluxes[i-params.width].w;
    if(heat==0.) return;
    uvec2 address;
    if(solid_address(at,address)) add_energy(Words(address),heat);
    else if(gas_cell(at)) {
        bool alternate=params.sparse!=0u&&(Words(params.gates_address).words[at]&8u)!=0u;
        GasField field=GasField(alternate?params.alternate_address:params.world_address);
        Gas gas=field.values[at];gas.dynamics.y+=heat;field.values[at]=gas;
    }
}
uint choose_target(ivec2 p) {
    uint chosen=0xffffffffu;float best=-1.;
    for(uint i=0u;i<4u;i++) {
        uint at=atlas(p+directions[i]);if(!gas_cell(at)) continue;
        Gas gas=local_gas(at);float mass=gas_mass(gas);
        float fraction=mass>0.?gas.species.x/mass:0.;
        float supply=gas.species.x*clamp((fraction-float(FR_COMBUSTION_EXTINGUISH_OXYGEN))/
            float(FR_COMBUSTION_AMBIENT_OXYGEN-FR_COMBUSTION_EXTINGUISH_OXYGEN),0.,1.);
        if(supply>best) {best=supply;chosen=at;}
    }
    return chosen;
}
uint target(ivec2 p) {
    return floatBitsToUint(samples[uint(p.y)*params.width+uint(p.x)+params.width*params.height].w);
}
float ignition_threshold(uint low,uint high) {
    uint h=low^(high*0x9e3779b9u);h^=h>>16;h*=0x7feb352du;h^=h>>15;h*=0x846ca68bu;h^=h>>16;
    return -log(clamp((float(h>>8)+.5)/16777216.,0.0000000298023224,.99999994));
}
uvec3 solid_products(uint consumed,uint material) {
    uint char_mass=uint(floor(float(consumed)*coefficient(material,14u))),rest=consumed-char_mass;
    uint ash=uint(floor(float(rest)*coefficient(material,15u)/(1.-coefficient(material,14u))));rest-=ash;
    uint soot=uint(floor(float(rest)*coefficient(material,16u)/(1.-coefficient(material,14u)-coefficient(material,15u))));
    return uvec3(char_mass,ash,soot);
}
bool burning(uint at) {
    if(at==0xffffffffu) return false;
    uvec2 handle=Handles(uvec2(root[6],root[7])).values[at];
    if(handle.y==0u||handle.x>=root[2]) return false;
    Words entry=Words(reactive_entry_address(uvec2(root[4],root[5]),handle.x));
    return entry.words[FR_ENTRY_GENERATION]==handle.y&&entry.words[FR_ENTRY_OWNER]==1u&&
        (entry.words[FR_ENTRY_STATE+1u]&2u)!=0u&&
        (entry.words[FR_ENTRY_STATE+9u]!=0u||entry.words[FR_ENTRY_STATE+10u]!=0u);
}
void feedback(uint index,ivec2 p,uint at) {
    if(at!=0xffffffffu&&!gas_cell(at)) {
        uvec2 handle=Handles(uvec2(root[6],root[7])).values[at];
        if(handle.y!=0u&&handle.x<root[2]) {
            Words entry=Words(reactive_entry_address(uvec2(root[4],root[5]),handle.x));uint s=FR_ENTRY_STATE;
            if(entry.words[FR_ENTRY_GENERATION]==handle.y&&entry.words[FR_ENTRY_OWNER]==1u&&
               (entry.words[s]==7u||entry.words[s]==8u||entry.words[s]==9u||entry.words[s]==12u)&&entry.words[s+8u]!=0u) {
                float charred=clamp(4.*float(entry.words[s+10u])/float(entry.words[s+8u]),0.,1.);
                vec3 color=unpackUnorm4x8(pixels[index]).rgb;
                pixels[index]=packUnorm4x8(vec4(color*(1.-.9*charred),1.));
            }
        }
    }
    /* Flame emission is supplied by local transported gas reaction state.
     * No screen-space trail or predetermined height is admissible. */
    if(!gas_cell(at)) return;
    vec4 source=emission[at];if(source.x<=0.||floatBitsToUint(source.z)!=slot_generation(at)) return;
    Gas gas=local_gas(at);float capacity=gas_capacity(gas);
    if(capacity<=0.||gas.geometry.y<=0.) return;
    if((floatBitsToUint(source.w)&1u)==0u&&gas_internal(gas)/capacity<float(FR_COMBUSTION_AIRBORNE_IGNITION_K)) return;
    vec3 color=mix(vec3(1.,.3,.008),vec3(1.,.85,.2),clamp((source.y-650.)/1150.,0.,1.));
    float alpha=1.-exp(-source.x*float(FR_COMBUSTION_EMISSION_EXPOSURE));
    pixels[index]=packUnorm4x8(vec4(mix(unpackUnorm4x8(pixels[index]).rgb,color,alpha),1.));
}
void extinguish_unexposed(ivec2 p,uint at) {
    if(at==0xffffffffu) return;
    uvec2 handle=Handles(uvec2(root[6],root[7])).values[at];if(handle.y==0u||handle.x>=root[2]) return;
    Words entry=Words(reactive_entry_address(uvec2(root[4],root[5]),handle.x));
    if(entry.words[FR_ENTRY_GENERATION]!=handle.y||entry.words[FR_ENTRY_OWNER]!=1u||
       (entry.words[FR_ENTRY_STATE+1u]&2u)==0u) return;
    for(uint direction=0u;direction<4u;direction++) {
        uint neighbor=atlas(p+directions[direction]);if(!gas_cell(neighbor)) continue;
        Gas gas=local_gas(neighbor);float mass=gas_mass(gas);
        if(gas.geometry.y>0.&&mass>0.&&gas.species.x/mass>float(FR_COMBUSTION_EXTINGUISH_OXYGEN)) return;
    }
    entry.words[FR_ENTRY_STATE+1u]&=~2u;
