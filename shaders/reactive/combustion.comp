#include "bonfire_hud.glsl"
void main() {
    uint i=gl_GlobalInvocationID.x+gl_GlobalInvocationID.y*gl_NumWorkGroups.x*64u;
#ifdef FR_BODY_REACTIONS
    if(params.unused.x==9u) {
        uint slot=gl_WorkGroupID.x+gl_WorkGroupID.y*gl_NumWorkGroups.x;if(slot>=BODY_CAPACITY) return;
        Body body=DC_BODY(slot);if((body.enabled|body.reserved0)==0u||!pixel_body(body)) return;
        for(uint piece=gl_LocalInvocationID.x;piece<body_pieces(body);piece+=64u) {
            if(pixel_piece_material(body,piece)==0u) continue;
            uvec2 h=fr_body_reactive_handle(body,slot,piece);if(h.y!=0u) choose_body_target(h.x);
        }
        return;
    }
    if(i>=params.width*params.height) return;
    ivec2 p=ivec2(i%params.width,i/params.width);uint at=atlas(p);
    if(!gas_cell(at)) return;
    bool near_body=false;
    for(uint face=0u;face<4u;face++) {ivec2 q=p+directions[face];
        if(all(greaterThanEqual(q,ivec2(0)))&&all(lessThan(q,ivec2(params.width,params.height))))
            near_body=near_body||thermal_occupancy[uint(q.y)*params.width+uint(q.x)]!=0u;}
    if(!near_body) return;
    bool alternate=params.sparse!=0u&&(Words(params.gates_address).words[at]&8u)!=0u;
    GasField field=GasField(alternate?params.alternate_address:params.world_address);Gas gas=field.values[at];
    if(gas.geometry.y<=0.) return;
    float admitted=0.,temperature=0.;uint sources=0u;
    for(uint face=0u;face<4u;face++) burn_body_neighbor(p+directions[face],at,gas,admitted,temperature,sources);
    vec4 previous=emission[at];emission[at]=vec4(previous.x+admitted/uintBitsToFloat(params.seconds),max(previous.y,temperature),
        uintBitsToFloat(slot_generation(at)),uintBitsToFloat(floatBitsToUint(previous.w)|sources));
    field.values[at]=gas;
#else
    if(i>=params.width*params.height) return;
    ivec2 p=ivec2(i%params.width,i/params.width);uint at=atlas(p);
    if(params.unused.x>=6u) {bonfire_hud(params.unused.x,i,p,at);return;}
    if(params.unused.x==4u) {
        fluxes[i].zw=vec2(p.x+1<int(params.width)?contact_flux(i,i+1u,at,atlas(p+ivec2(1,0))):0.,
            p.y+1<int(params.height)?contact_flux(i,i+params.width,at,atlas(p+ivec2(0,1))):0.);return;
    }
    if(params.unused.x==5u) {contact_apply(i,at);return;}
    if(params.unused.x==3u) {
