        if(share_oil+share_jelly>0u) {
            uint donor_body=e.words[FR_ENTRY_OWNER+1u];
            for(uint d=0u;d<4u;d++) {
                ivec2 q=p+body_directions[d];
                uint slot=runtime_body_find(thermal_occupancy[uint(max(q.y,0))*params.width+min(uint(max(q.x,0)),params.width-1u)]);
                if(slot>=BODY_CAPACITY) continue;
