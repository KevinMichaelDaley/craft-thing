void corrode_entry(Words entry,uint owner,uint at,uint geometry_word,uint geometry_nibble,
                   inout Gas gas) {
    uint s=FR_ENTRY_STATE,material=entry.words[s];
    bool magical=material==18u||material==19u;
    if(!magical&&material!=1u) return;
    if((entry.words[s+1u]&16u)!=0u||entry.words[s+FR_STATE_DRY_MASS]==0u) return;
    float capacity=solid_capacity(entry);
    if(capacity<=0.) return;
    float energy=uintBitsToFloat(entry.words[s+FR_STATE_ENERGY])+
        uintBitsToFloat(entry.words[s+FR_STATE_ENERGY_RESIDUAL])+
        uintBitsToFloat(entry.words[s+FR_STATE_ENERGY_CORRECTION]);
    float temperature=energy/capacity,dt=uintBitsToFloat(params.seconds);
    float mass=dot(gas.species,vec4(1))+gas.dynamics.x;
    float oxygen=mass>0.?max(0.,gas.species.x)/mass:0.;
    float progress=uintBitsToFloat(entry.words[s+(magical?
        FR_STATE_CORRODED_FRACTION:FR_STATE_OXIDIZED_FRACTION)]);
    float rate=0.;uint denominator=magical?
        FR_CORROSION_GREEK_OXIDIZER_DENOMINATOR:FR_CORROSION_AIR_OXIDIZER_DENOMINATOR;
    if(magical) {
        if(temperature<FR_CORROSION_GREEK_MIN_K||entry.words[s+FR_STATE_COATING_JELLY]==0u||
           entry.words[s+FR_STATE_COATING_OXIDIZER]==0u) return;
        float coverage=min(1.,float(entry.words[s+FR_STATE_COATING_JELLY])/
            float(entry.words[s+FR_STATE_DRY_MASS]));
        rate=(material==18u?FR_CORROSION_GOLD_GREEK_RATE:
            FR_CORROSION_INGREDIENT_GREEK_RATE)*coverage;
    } else {
        float wet=min(1.,float(entry.words[s+FR_STATE_BOUND_WATER])/
            float(entry.words[s+FR_STATE_DRY_MASS]));
        rate=temperature>=273.15?
            FR_CORROSION_STONE_AIR_RATE*wet*oxygen/FR_CORROSION_AMBIENT_OXYGEN_FRACTION:0.;
    }
    float target=min(1.,progress+rate*dt);
    uint dry=entry.words[s+FR_STATE_DRY_MASS];
    uint old_units=uint(floor(float(dry)*progress)),target_units=uint(floor(float(dry)*target));
    target_units=max(old_units,target_units);
    uint old_cost=old_units/denominator+uint(old_units%denominator!=0u);
    uint stock=magical?entry.words[s+FR_STATE_COATING_OXIDIZER]:
        uint(floor(max(0.,gas.species.x)*65536.));
    target_units=min(target_units,uint(min(float(dry),float(old_cost+stock)*float(denominator))));
    uint new_cost=target_units/denominator+uint(target_units%denominator!=0u);
    uint consumed=new_cost-old_cost;
    if(target_units==old_units&&target<1.) return;
    if(magical) {
        entry.words[s+FR_STATE_COATING_OXIDIZER]-=consumed;
        entry.words[s+FR_STATE_CORE_OXIDIZER]+=consumed;
        if(target_units<dry) target=min(target,float(target_units)/float(dry));
        entry.words[s+FR_STATE_CORRODED_FRACTION]=floatBitsToUint(target);
        if(material==19u) {
            uint initial=uint(round(float(dry)*coefficient(material,9u)));
            uint desired=uint(floor(float(initial)*(1.-target)));
            uint moved=entry.words[s+FR_STATE_FUEL_MASS]>desired?
                entry.words[s+FR_STATE_FUEL_MASS]-desired:0u;
            entry.words[s+FR_STATE_FUEL_MASS]-=moved;
            entry.words[s+FR_STATE_INERT_MASS]+=moved;
        }
        if(target>=1.) {
            uint residue=material==18u?17u:13u;
            entry.words[s]=residue;entry.words[s+1u]|=16u;
            if(owner==1u) {
                cells[at].x=(cells[at].x&~65535u)|residue;
                terrain_changed();
            }
#ifdef FR_BODY_REACTIONS
            if(owner==2u) {
                uint shift=geometry_nibble*4u,mask=15u<<shift;
                uint body_residue=material==18u?14u:15u;
                uint old=BodyStorageWords(runtime_body_root.geometry).words[geometry_word];
                for(;;) {
                    uint next=(old&~mask)|(body_residue<<shift);
                    uint observed=atomicCompSwap(
                        BodyStorageWords(runtime_body_root.geometry).words[geometry_word],old,next);
                    if(observed==old) break;
                    old=observed;
                }
            }
#endif
        }
    } else {
        gas.species.x=max(0.,gas.species.x-float(consumed)/65536.);
        entry.words[s+FR_STATE_CORE_OXIDIZER]+=consumed;
        entry.words[s+FR_STATE_OXIDIZED_FRACTION]=floatBitsToUint(target_units<dry?
            min(target,float(target_units)/float(dry)):target);
    }
}
#include "coating_burn.glsl"
void burn_entry(ivec2 position,uint gas_at,uvec2 handle,uint owner,
    uint geometry_word,uint geometry_nibble,inout Gas gas,inout float admitted,
    inout float source_temperature,inout uint sources) {
    uint at=atlas(position);if(at==0xffffffffu||handle.y==0u||handle.x>=root[2]) return;
    Words entry=Words(reactive_entry_address(uvec2(root[4],root[5]),handle.x));
    if(entry.words[FR_ENTRY_GENERATION]!=handle.y||entry.words[FR_ENTRY_OWNER]!=owner) return;
    evaporate_entry(entry,gas);
