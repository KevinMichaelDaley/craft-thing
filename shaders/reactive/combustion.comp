    Handles canonical=Handles(uvec2(root[14],root[15])),alternate=Handles(uvec2(root[16],root[17]));
    if(canonical.values[particle].y!=0u||canonical.values[particle+4096u].y!=0u) return;
    uvec2 identity=uvec2(entry.words[s+2u],entry.words[s+3u]);
    uint radius=max(1u,uint(sqrt(float(mass)/65536./.25/3.14159265)*65536.));
    particles[particle]=Particle(int((uint(position.x)%64u)*65536u+32768u),
        int((uint(position.y)%64u)*65536u+32768u),0,0,1.,0.,0.,1.,identity.x,identity.y,mass,radius,13u,0u);
    entry.words[s]=13u;entry.words[s+1u]=16u;entry.words[s+8u]=entry.words[s+11u];
    entry.words[FR_ENTRY_OWNER]=3u;entry.words[FR_ENTRY_OWNER+1u]=identity.x;entry.words[FR_ENTRY_OWNER+2u]=identity.y;
    entry.words[FR_ENTRY_OWNER+3u]=identity.x;entry.words[FR_ENTRY_OWNER+4u]=identity.y;entry.words[FR_ENTRY_OWNER+5u]=0u;
    canonical.values[particle]=handle;alternate.values[particle]=uvec2(0);
