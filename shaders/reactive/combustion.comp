    scratch.words[target_word]=chosen;
    if(e.words[FR_ENTRY_STATE+10u]>0u&&e.words[FR_ENTRY_STATE+9u]==0u) {
        if(chosen!=0xffffffffu) {atomicAdd(hud[22],1u);Gas gas=local_gas(chosen);float mass=gas_mass(gas);
            if(gas.species.x>0.) atomicAdd(hud[23],1u);
            atomicMax(hud[27],floatBitsToUint(max(gas.species.x,0.)));}
        if(all(greaterThanEqual(p,ivec2(0)))&&all(lessThan(p,ivec2(params.width,params.height)))&&
            thermal_occupancy[uint(p.y)*params.width+uint(p.x)]==body.id) atomicAdd(hud[24],1u);
