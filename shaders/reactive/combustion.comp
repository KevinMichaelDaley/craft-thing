/* Each parcel chooses one neighboring gas cell. The owning gas invocation
 * gathers at most four surfaces, reserving shared oxygen locally before commit.
 * There is no field scan, atomic float race or global flame capacity. */
void burn(ivec2 position,uint gas_at,inout Gas gas,inout float admitted,inout float source_temperature,inout uint sources) {
    uint at=atlas(position);if(at==0xffffffffu||target(position)!=gas_at) return;
    uvec2 handle=Handles(uvec2(root[6],root[7])).values[at];
    if(handle.y==0u||handle.x>=root[2]) return;
    Words entry=Words(reactive_entry_address(uvec2(root[4],root[5]),handle.x));
    if(entry.words[FR_ENTRY_GENERATION]!=handle.y||entry.words[FR_ENTRY_OWNER]!=1u) return;
    uint s=FR_ENTRY_STATE,m=entry.words[s],wood_fuel=entry.words[s+9u];
    if((entry.words[s+13u]|entry.words[s+14u]|entry.words[s+15u]|entry.words[s+16u])!=0u) return;
    bool char_stage=wood_fuel==0u;uint fuel=char_stage?entry.words[s+10u]:wood_fuel;
    uint profile=char_stage?12u:m;
    float capacity=((float(wood_fuel)+float(entry.words[s+11u]))*coefficient(m,5u)+
        float(entry.words[s+10u])*coefficient(12u,5u)+float(entry.words[s+12u])*coefficient(3u,5u))/65536.;
    if(m!=7u&&m!=8u&&m!=9u&&m!=12u) return;
    if(fuel==0u) {loose_ash(position,at,handle,entry,gas);return;}
    if(capacity<=0.) return;
