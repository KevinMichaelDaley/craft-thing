layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer Root {uint root[];};
layout(set=0,binding=1,std430) readonly buffer Pages {uint pages[];};
layout(set=0,binding=2,std430) readonly buffer Profiles {uint profiles[];};
layout(set=0,binding=3,std430) buffer Cells {uvec2 cells[];};
layout(set=0,binding=4,std430) buffer Pixels {uint pixels[];};
layout(set=0,binding=5,std430) buffer Samples {vec4 samples[];};
struct Particle {int x_fp,y_fp,vx_fp,vy_fp;float f00,f01,f10,f11;uint id_lo,id_hi,mass_fp,grain_fp,material,flags;};
layout(set=0,binding=6,std430) buffer Particles {Particle particles[];};
layout(set=0,binding=7,std430) buffer Counts {uint counts[];};
layout(set=0,binding=8,std430) buffer Emission {vec4 emission[];};
layout(set=0,binding=9,std430) buffer Fluxes {vec4 fluxes[];};
layout(push_constant) uniform Params {
    uint width,height,seconds,sparse;
    uvec2 world_address,alternate_address,gates_address,model_address;
    uvec4 unused;
} params;
layout(buffer_reference,std430,buffer_reference_align=4) buffer Words {uint words[];};
layout(buffer_reference,std430,buffer_reference_align=8) buffer Handles {uvec2 values[];};
layout(buffer_reference,std430,buffer_reference_align=16) buffer GasField {Gas values[];};
float coefficient(uint material,uint field) {return uintBitsToFloat(profiles[material*32u+field]);}
uint atlas(ivec2 p) {
    if(any(lessThan(p,ivec2(0)))||any(greaterThanEqual(p,ivec2(params.width,params.height)))) return 0xffffffffu;
    uint page=pages[(uint(p.y)/64u)*((params.width+63u)/64u)+uint(p.x)/64u];
    return page==0u?0xffffffffu:(page-1u)*4096u+uint(p.y%64)*64u+uint(p.x%64);
}
const ivec2 directions[4]=ivec2[4](ivec2(0,-1),ivec2(-1,0),ivec2(1,0),ivec2(0,1));
bool gas_cell(uint at) {return at!=0xffffffffu&&(cells[at].x&255u)==0u&&cells[at].y==0u;}
uint slot_generation(uint at) {
    if((params.unused.z|params.unused.w)==0u) return 0u;
    return Words(params.unused.zw).words[32u+(at/4096u)*8u+4u];
}
void terrain_changed() {
    if((params.unused.z|params.unused.w)!=0u) atomicOr(Words(params.unused.zw).words[20u],1u);
}
Gas local_gas(uint at) {
    bool alternate=params.sparse!=0u&&(Words(params.gates_address).words[at]&8u)!=0u;
    return GasField(alternate?params.alternate_address:params.world_address).values[at];
}
float gas_mass(Gas gas) {return dot(gas.species,vec4(1))+gas.dynamics.x;}
float gas_capacity(Gas gas) {
    Words model=Words(params.model_address);
    return dot(gas.species,vec4(uintBitsToFloat(model.words[5]),uintBitsToFloat(model.words[6]),
        uintBitsToFloat(model.words[7]),uintBitsToFloat(model.words[8])))+gas.dynamics.x*uintBitsToFloat(model.words[9]);
}
float gas_internal(Gas gas) {
    float mass=gas_mass(gas);
    float kinetic=mass>0.?.5*uintBitsToFloat(Words(params.model_address).words[10])*dot(gas.dynamics.zw,gas.dynamics.zw)/mass:0.;
    return max(0.,gas.dynamics.y+gas.visual.w+gas.geometry.z-kinetic);
}
float carbon_activity(Gas gas) {
    float mass=gas_mass(gas),capacity=gas_capacity(gas);
    if(gas.dynamics.x<=0.||mass<=0.||capacity<=0.||gas.geometry.y<=0.) return 0.;
    float temperature=gas_internal(gas)/capacity,oxygen=gas.species.x/mass;
    float thermal=clamp((temperature-float(FR_COMBUSTION_AIRBORNE_IGNITION_K))/
        float(FR_COMBUSTION_AIRBORNE_FULL_RATE_K-FR_COMBUSTION_AIRBORNE_IGNITION_K),0.,1.);
    float supply=clamp((oxygen-float(FR_COMBUSTION_EXTINGUISH_OXYGEN))/
        float(FR_COMBUSTION_AMBIENT_OXYGEN-FR_COMBUSTION_EXTINGUISH_OXYGEN),0.,1.);
    return float(FR_COMBUSTION_AIRBORNE_RATE)*thermal*supply;
