    admitted+=heat;source_temperature=max(source_temperature,temperature);sources|=FR_FIRE_EMISSION_SURFACE;
    float removed=float(reacted)/65536.*(char_stage?fr_char_specific_enthalpy(bulk_temperature):
        coefficient(profile,5u)*bulk_temperature);
    float retained=float(char_mass)/65536.*fr_char_specific_enthalpy(bulk_temperature);
    /* Ash remains finite in the parcel until the loose-residue publication
     * stage admits its physical particle; no product is discarded here. */
    retained+=float(ash)/65536.*coefficient(m,5u)*bulk_temperature;
    if(char_stage) entry.words[s+10u]=fuel-reacted+char_mass;
    else {entry.words[s+9u]=fuel-reacted;entry.words[s+10u]+=char_mass;}
    entry.words[s+11u]+=ash;
    add_energy(entry,.7*heat-removed+retained);
