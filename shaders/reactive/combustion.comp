    float threshold=uintBitsToFloat(entry.words[s+20u]);
    if(threshold==0.) threshold=ignition_threshold(entry.words[s+4u],entry.words[s+5u]);
    /* The reaction zone sits at the hotter of the exposed-skin estimate and
     * the parcel bulk: a fully heated parcel burns like the CPU reference,
     * while a cold-interior log still needs its surface to reach ignition.
     * Oxygen funding, fuel and wetness continue to gate every reaction. */
    float zone=max(temperature,bulk_temperature);
