#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
#include "../../include/dungeoncraft/reactive_state_layout.h"
#include "../../include/dungeoncraft/reactive_profile_layout.h"
#include "../../include/dungeoncraft/thermal_parameters.h"
#include "../../include/dungeoncraft/thermal_surface.h"
#include "address.glsl"
layout(local_size_x=64) in;
layout(constant_id=0) const uint SPECIALIZED_PHASE=0xffffffffu;
layout(set=0,binding=0,std430) readonly buffer Root {uint root[];};
layout(set=0,binding=1,std430) readonly buffer Pages {uint pages[];};
layout(set=0,binding=2,std430) readonly buffer Profiles {uint profiles[];};
layout(set=0,binding=3,std430) buffer Samples {vec4 samples[];};
layout(set=0,binding=4,std430) buffer Fluxes {vec4 fluxes[];};
layout(set=0,binding=5,std430) buffer Probe {float probe_excess,probe_capacity;uint probe_index,probe_active;};
layout(set=0,binding=6,std430) buffer Cells {uvec2 cells[];};
layout(set=0,binding=7,std430) coherent buffer WaterEnergy {uint water_heat_words[];};
float water_energy_at(uint at) {return uintBitsToFloat(water_heat_words[at]);}
void water_energy_set(uint at,float energy) {water_heat_words[at]=floatBitsToUint(energy);}
layout(push_constant) uniform Params {uint width,height,phase,seconds,pool_word,unused_view,mode,unused;} params;
uint active_phase() {return SPECIALIZED_PHASE==0xffffffffu?params.phase:SPECIALIZED_PHASE;}
layout(buffer_reference,std430,buffer_reference_align=4) buffer Words {uint words[];};
layout(buffer_reference,std430,buffer_reference_align=8) readonly buffer Handles {uvec2 values[];};
layout(buffer_reference,std430,buffer_reference_align=16) buffer ParcelSamples {vec4 values[];};
float coefficient(uint material,uint field) {return uintBitsToFloat(profiles[material*FR_PROFILE_WORDS+field]);}
#include "world_body.glsl"
uint atlas_at(uint index) {
    uint x=index%params.width,y=index/params.width,page=pages[(y/64u)*((params.width+63u)/64u)+x/64u];
    return page==0u?0xffffffffu:(page-1u)*4096u+(y%64u)*64u+x%64u;
}
uvec2 handle_at(uint index) {
    uint x=index%params.width,y=index/params.width,page=pages[(y/64u)*((params.width+63u)/64u)+x/64u];
    return page==0u?uvec2(0):Handles(uvec2(root[6],root[7])).values[(page-1u)*4096u+(y%64u)*64u+x%64u];
}
bool valid(uvec2 handle) {
    if(handle.y==0u||handle.x>=root[2]) return false;
    Words e=Words(reactive_entry_address(uvec2(root[4],root[5]),handle.x));
    return e.words[FR_ENTRY_GENERATION]==handle.y&&e.words[FR_ENTRY_OWNER]==1u;
}
vec2 two_sum(float a,float b) {
    precise float sum=a+b;
    precise float recovered=sum-a;
    precise float error=(a-(sum-recovered))+(b-recovered);
    return vec2(sum,error);
}
void add_energy(Words entry,float delta) {
    vec2 first=two_sum(uintBitsToFloat(entry.words[FR_ENTRY_STATE+FR_STATE_ENERGY]),delta);
    vec2 second=two_sum(uintBitsToFloat(entry.words[FR_ENTRY_STATE+FR_STATE_ENERGY_RESIDUAL]),first.y);
    precise float last=uintBitsToFloat(entry.words[FR_ENTRY_STATE+FR_STATE_ENERGY_CORRECTION])+second.y;
    vec2 middle=two_sum(second.x,last),top=two_sum(first.x,middle.x),tail=two_sum(top.y,middle.y);
    entry.words[FR_ENTRY_STATE+FR_STATE_ENERGY]=floatBitsToUint(top.x);
    entry.words[FR_ENTRY_STATE+FR_STATE_ENERGY_RESIDUAL]=floatBitsToUint(tail.x);
    entry.words[FR_ENTRY_STATE+FR_STATE_ENERGY_CORRECTION]=floatBitsToUint(tail.y);
}
vec4 sample_with_metadata(uint index,out vec4 metadata) {
    metadata=vec4(0);
    uvec2 handle=handle_at(index);
    if(!valid(handle)) {
        uint atlas=atlas_at(index);
        if(atlas==0xffffffffu||cells[atlas].y==0u) return vec4(0);
        metadata=vec4(uintBitsToFloat(2u),uintBitsToFloat(cells[atlas].y),uintBitsToFloat(3u),0.);
        return vec4(water_energy_at(atlas),float(cells[atlas].y)/65536.*coefficient(3u,5u),coefficient(3u,6u),1.);
    }
    Words e=Words(reactive_entry_address(uvec2(root[4],root[5]),handle.x));uint at=FR_ENTRY_STATE,m=e.words[at];
    metadata=vec4(uintBitsToFloat(1u),uintBitsToFloat(e.words[at+12u]),uintBitsToFloat(m),
        round(float(e.words[at+8u])*coefficient(m,19u)));
    if(m>=params.unused) return vec4(0);
    float core=float(e.words[at+9u])+float(e.words[at+11u])+float(e.words[at+15u]);
    float capacity=(core*coefficient(m,5u)+float(e.words[at+10u])*coefficient(12u,5u)+
        float(e.words[at+12u])*coefficient(3u,5u)+float(e.words[at+13u])*coefficient(14u,5u)+
        (float(e.words[at+14u])+float(e.words[at+16u]))*coefficient(15u,5u))/65536.;
    float wet_capacity=float(e.words[at+8u])*coefficient(m,19u);
    return vec4(uintBitsToFloat(e.words[at+17u]),capacity,coefficient(m,6u),
        wet_capacity>0.?clamp(float(e.words[at+12u])/wet_capacity,0.,1.):0.);
}
vec4 sample_at(uint index) {
    vec4 metadata;
    return sample_with_metadata(index,metadata);
}
float temperature(vec4 node,uint index) {
    return node.x/node.y+(floatBitsToUint(samples[index+params.width*params.height].x)==2u?float(FR_THERMAL_AMBIENT_K):0.);
}
float wet_mass(uint first,uint second) {
    uint n=params.width*params.height;
    vec4 a=samples[first+n],b=samples[second+n];
    uint ak=floatBitsToUint(a.x),bk=floatBitsToUint(b.x);
    if(!((ak==2u&&bk==1u)||(ak==1u&&bk==2u))) return 0.;
    vec4 water=ak==2u?a:b,solid=ak==1u?a:b;
    float room=max(0.,solid.w-float(floatBitsToUint(solid.y)));
    float amount=min(min(floor(room/4.),floor(float(floatBitsToUint(water.y))/4.)),
        floor(uintBitsToFloat(params.seconds)*float(FR_THERMAL_WETTING_PER_SECOND)*65536./4.));
    return ak==2u?amount:-amount;
}
float wet_energy(uint first,uint second,float amount) {
    uint water=amount>0.?first:second;
    uint mass=floatBitsToUint(samples[water+params.width*params.height].y);
    return mass==0u?0.:samples[water].x*(amount/float(mass));
}
bool thermal_solid_material(uint material) {
    return material<params.unused&&profiles[material*FR_PROFILE_WORDS+FR_PROFILE_PHASE_WORD]<FR_PROFILE_PHASE_LIQUID;
}
float solid_transport_scale(uint first,uint second) {
    if(params.mode!=1u) return 1.;
    uint n=params.width*params.height;vec4 a=samples[first+n],b=samples[second+n];
    uint ak=floatBitsToUint(a.x),bk=floatBitsToUint(b.x);
    bool solids=(ak==1u||ak==4u)&&(bk==1u||bk==4u)&&
        thermal_solid_material(floatBitsToUint(a.z))&&thermal_solid_material(floatBitsToUint(b.z));
    return solids?float(FR_THERMAL_2D_TRANSPORT_SCALE):1.;
}
float exchange(vec4 a,vec4 b,float scale) {
    if(a.y<=0.||b.y<=0.||a.z<=0.||b.z<=0.) return 0.;
    float difference=a.x/a.y-b.x/b.y,conductance=scale*2.*a.z*b.z/(a.z+b.z);
    if(params.mode==1u) conductance*=float(FR_THERMAL_GAMEPLAY_FACE_METERS);
    float requested=conductance*difference*uintBitsToFloat(params.seconds);
    float bound=min(a.y,b.y)*abs(difference)/float(FR_THERMAL_NEIGHBORS);
    return sign(requested)*min(abs(requested),bound);
}
void body_conduction(uint index) {
    Words e=Words(reactive_entry_address(uvec2(root[4],root[5]),index));
    ParcelSamples cache=ParcelSamples(uvec2(root[FR_ARENA_THERMAL_SCRATCH],root[FR_ARENA_THERMAL_SCRATCH+1u]));
    if(active_phase()==8u) {
        vec4 value=vec4(0);
        if(e.words[FR_ENTRY_OWNER]==2u&&e.words[FR_ENTRY_GENERATION]!=0u) {
            uint s=FR_ENTRY_STATE,m=e.words[s];
            float capacity=((float(e.words[s+9u])+float(e.words[s+11u])+float(e.words[s+15u]))*coefficient(m,5u)+
                float(e.words[s+10u])*coefficient(12u,5u)+float(e.words[s+12u])*coefficient(3u,5u)+
                float(e.words[s+13u])*coefficient(14u,5u)+(float(e.words[s+14u])+float(e.words[s+16u]))*coefficient(15u,5u))/65536.;
            value=vec4(uintBitsToFloat(e.words[s+17u])+uintBitsToFloat(e.words[s+25u])+uintBitsToFloat(e.words[s+26u]),
                capacity,coefficient(m,6u),uintBitsToFloat(e.words[FR_ENTRY_GENERATION]));
        }
        vec4 surface=cache.values[index*3u+2u];
        float reaction_power=floatBitsToUint(surface.x)==e.words[FR_ENTRY_GENERATION]?cache.values[index*3u+1u].z:0.;
        float wet_fraction=floatBitsToUint(cache.values[index*3u].w)==e.words[FR_ENTRY_GENERATION]?cache.values[index*3u+1u].w:0.;
        cache.values[index*3u]=value;cache.values[index*3u+1u]=vec4(0,0,reaction_power,wet_fraction);
        if(floatBitsToUint(surface.x)!=e.words[FR_ENTRY_GENERATION]) surface=vec4(uintBitsToFloat(e.words[FR_ENTRY_GENERATION]),value.y>0.?value.x/value.y:0.,0.,0.);
        surface.zw=vec2(0);cache.values[index*3u+2u]=surface;return;
    }
    if(active_phase()==11u) {if(e.words[FR_ENTRY_OWNER]==2u) add_energy(e,cache.values[index*3u+1u].x);cache.values[index*3u+1u].xy=vec2(0);return;}
    vec4 a=cache.values[index*3u];if(a.y<=0.||floatBitsToUint(a.w)!=e.words[FR_ENTRY_GENERATION]) return;
    uint slot=runtime_body_find(e.words[FR_ENTRY_OWNER+1u]);if(slot>=BODY_CAPACITY) return;
    Body body=body_thermal_grid(DC_BODY(slot));if(!pixel_body(body)) return;
    ivec2 rest=ivec2(e.words[FR_ENTRY_OWNER+3u],e.words[FR_ENTRY_OWNER+4u]);
    const ivec2 directions[4]=ivec2[4](ivec2(-1,0),ivec2(1,0),ivec2(0,-1),ivec2(0,1));
    float delta=0.;
    for(uint d=0u;d<4u;d++) {
        uint piece=pixel_piece_at(body,rest+directions[d]);
        if(pixel_piece_material(body,piece)==0u) continue;
        uvec2 h=fr_body_reactive_handle(body,slot,piece);if(h.y==0u) continue;
        vec4 b=cache.values[h.x*3u];if(floatBitsToUint(b.w)!=h.y) continue;
        uint other_material=Words(reactive_entry_address(uvec2(root[4],root[5]),h.x)).words[FR_ENTRY_STATE];
        float scale=params.mode==1u&&thermal_solid_material(e.words[FR_ENTRY_STATE])&&thermal_solid_material(other_material)?float(FR_THERMAL_2D_TRANSPORT_SCALE):1.;
        float flux=exchange(a,b,scale);
        delta-=flux;
    }
    add_energy(e,delta);
}
#include "body_wetting.glsl"
#include "body_mass.glsl"
#include "radiation.glsl"
void main() {
    uint index=gl_GlobalInvocationID.x+gl_GlobalInvocationID.y*gl_NumWorkGroups.x*64u;
    if(active_phase()==8u||active_phase()==9u||active_phase()==11u||active_phase()==14u||active_phase()==20u) {
        uint slot=gl_WorkGroupID.x+gl_WorkGroupID.y*gl_NumWorkGroups.x;if(slot>=BODY_CAPACITY) return;
        Body body=DC_BODY(slot);if((body.enabled|body.reserved0)==0u||!pixel_storage(body)) return;
        if(active_phase()==14u) {
            if(pixel_body(body)) body_thermal_mass(slot,body);
            else if((body.motion_flags&DC_BODY_MOTION_THERMAL_GRID)!=0u&&
                    body.material==DC_BODY_WOOD_MATERIAL)
                body_thermal_mass(slot,body_thermal_grid(body));
            return;
        }
        body=body_thermal_grid(body);
        for(uint piece=gl_LocalInvocationID.x;piece<body_pieces(body);piece+=64u) {
            if(pixel_piece_material(body,piece)==0u) continue;
            uvec2 h=fr_body_reactive_handle(body,slot,piece);if(h.y!=0u) {
                if(active_phase()==20u) body_wet_parcel(body,piece,h);else body_conduction(h.x);
            }
        }
        return;
    }
    if(index>=params.width*params.height) return;
    uint x=index%params.width,y=index/params.width;
    if(active_phase()==7u||active_phase()==19u) {vec4 value,metadata;if(fr_body_sample(index,value,metadata)) {
        if(active_phase()==19u) value.w=value.x;
        if(active_phase()==19u&&params.unused_view!=0u) {ParcelSamples cache=ParcelSamples(uvec2(root[FR_ARENA_THERMAL_SCRATCH],root[FR_ARENA_THERMAL_SCRATCH+1u]));
            vec4 surface=cache.values[floatBitsToUint(metadata.y)*3u+2u];
            if(floatBitsToUint(surface.x)==floatBitsToUint(metadata.w)&&surface.y>0.) value.x=surface.y*value.y;}
        samples[index]=value;samples[index+params.width*params.height]=metadata;}return;}
    if(active_phase()==16u) {
        vec2 xray=radiant_ray(index,ivec2(1,0)),yray=radiant_ray(index,ivec2(0,1));fluxes[index]=vec4(xray.x,yray.x,xray.y,yray.y);
        vec2 right=radiant_ray(index,ivec2(1,1)),left=radiant_ray(index,ivec2(-1,1));
        fluxes[index+params.width*params.height]=vec4(right.x,left.x,right.y,left.y);return;
    }
    if(active_phase()==17u) {radiant_apply(index);return;}
    if(active_phase()==21u) {uint at=atlas_at(index);
        fluxes[index+params.width*params.height]=at==0xffffffffu?vec4(0):vec4(water_energy_at(at),uintBitsToFloat(cells[at].y),0.,0.);return;}
    if(active_phase()==0u||active_phase()==23u) {
        if(active_phase()==23u) {uint at=atlas_at(index);if(at!=0xffffffffu&&cells[at].y==0u) water_energy_set(at,0.);}
        vec4 metadata;
        samples[index]=sample_with_metadata(index,metadata);samples[index+params.width*params.height]=metadata;
    }
    if(active_phase()==5u) {
        float mx=x+1u<params.width?wet_mass(index,index+1u):0.,my=y+1u<params.height?wet_mass(index,index+params.width):0.;
        fluxes[index]=vec4(mx,my,mx!=0.?wet_energy(index,index+1u,mx):0.,my!=0.?wet_energy(index,index+params.width,my):0.);
    }
    if(active_phase()==6u) {
        vec4 net=-fluxes[index];
        if(x>0u) {net.x+=fluxes[index-1u].x;net.z+=fluxes[index-1u].z;}
        if(y>0u) {net.y+=fluxes[index-params.width].y;net.w+=fluxes[index-params.width].w;}
        int mass=int(net.x+net.y);float energy=net.z+net.w;
        uint kind=floatBitsToUint(samples[index+params.width*params.height].x);
        if(kind==1u&&mass!=0) {
            uvec2 h=handle_at(index);Words e=Words(reactive_entry_address(uvec2(root[4],root[5]),h.x));
            e.words[FR_ENTRY_STATE+12u]=uint(int(e.words[FR_ENTRY_STATE+12u])+mass);
            add_energy(e,energy+float(mass)/65536.*coefficient(3u,5u)*float(FR_THERMAL_AMBIENT_K));
        }
        if(kind==2u&&mass!=0) {
            uint atlas=atlas_at(index);cells[atlas].y=uint(int(cells[atlas].y)+mass);water_energy_set(atlas,water_energy_at(atlas)+energy);
            if(cells[atlas].y==0u&&(cells[atlas].x&65535u)==3u) cells[atlas].x&=0xffff0000u;
        }
    }
    if(active_phase()==1u) {
        vec4 a=samples[index];if(a.y>0.) a.x=temperature(a,index)*a.y;
        vec4 b=x+1u<params.width?samples[index+1u]:vec4(0),c=y+1u<params.height?samples[index+params.width]:vec4(0);
        if(b.y>0.) b.x=temperature(b,index+1u)*b.y;
        if(c.y>0.) c.x=temperature(c,index+params.width)*c.y;
        float horizontal=exchange(a,b,x+1u<params.width?solid_transport_scale(index,index+1u):1.),
            vertical=exchange(a,c,y+1u<params.height?solid_transport_scale(index,index+params.width):1.);
        uint n=params.width*params.height;
        bool rigid=floatBitsToUint(samples[index+n].x)==4u;
        bool right_body=x+1u<params.width&&floatBitsToUint(samples[index+1u+n].x)==4u;
        bool below_body=y+1u<params.height&&floatBitsToUint(samples[index+params.width+n].x)==4u;
        if(b.y>0.&&(rigid||right_body))
            horizontal=sign(horizontal)*min(abs(horizontal),min(a.y,b.y)*abs(a.x/a.y-b.x/b.y)/(rigid&&right_body?4.:16.));
        if(c.y>0.&&(rigid||below_body))
            vertical=sign(vertical)*min(abs(vertical),min(a.y,c.y)*abs(a.x/a.y-c.x/c.y)/(rigid&&below_body?4.:16.));
        uint id=thermal_occupancy[index];
        if(id!=0u&&x+1u<params.width&&thermal_occupancy[index+1u]==id) horizontal=0.;
        if(id!=0u&&y+1u<params.height&&thermal_occupancy[index+params.width]==id) vertical=0.;
        fluxes[index]=vec4(horizontal,vertical,0.,0.);
    }
    if(active_phase()==10u||active_phase()==13u) {
        if(floatBitsToUint(samples[index+params.width*params.height].x)!=4u) return;
        uint c=active_phase()==13u?2u:0u;
        float heat=-fluxes[index][c]-fluxes[index][c+1u];
        if(x>0u) heat+=fluxes[index-1u][c];
        if(y>0u) heat+=fluxes[index-params.width][c+1u];
        fr_body_deposit(index,heat);return;
    }
    if(active_phase()==2u&&samples[index].y>0.&&floatBitsToUint(samples[index+params.width*params.height].x)!=4u) {
        float energy=-fluxes[index].x-fluxes[index].y;
        if(x>0u) energy+=fluxes[index-1u].x;
        if(y>0u) energy+=fluxes[index-params.width].y;
        uvec2 handle=handle_at(index);
        if(valid(handle)) {
            Words e=Words(reactive_entry_address(uvec2(root[4],root[5]),handle.x));
            add_energy(e,energy);samples[index].x=uintBitsToFloat(e.words[FR_ENTRY_STATE+FR_STATE_ENERGY]);
        } else {uint atlas=atlas_at(index);if(atlas!=0xffffffffu) water_energy_set(atlas,samples[index].x+energy);}
    }
    if(active_phase()==4u&&index==0u&&probe_active!=0u) {
        vec4 target=sample_at(probe_index),body_value,body_metadata;
        bool rigid=fr_body_sample(probe_index,body_value,body_metadata);if(rigid) target=body_value;
        if(target.y>0.) {
            bool liquid=!rigid&&!valid(handle_at(probe_index));
            float stored=target.x;if(liquid) target.x+=target.y*float(FR_THERMAL_AMBIENT_K);
            vec4 source=vec4(probe_capacity*float(FR_THERMAL_AMBIENT_K)+probe_excess,probe_capacity,float(FR_THERMAL_PROBE_CONDUCTIVITY),0.);
            float flux=min(exchange(source,target,1.),probe_excess);
            uvec2 handle=rigid?uvec2(floatBitsToUint(body_metadata.y),floatBitsToUint(body_metadata.w)):handle_at(probe_index);
            if(liquid) water_energy_set(atlas_at(probe_index),stored+flux);
            else {Words e=Words(reactive_entry_address(uvec2(root[4],root[5]),handle.x));add_energy(e,flux);}
            probe_excess-=flux;
        }
    }
}
