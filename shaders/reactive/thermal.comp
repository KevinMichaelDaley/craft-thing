#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
#include "../../include/dungeoncraft/reactive_state_layout.h"
#include "../../include/dungeoncraft/reactive_profile_layout.h"
#include "../../include/dungeoncraft/thermal_parameters.h"
#include "address.glsl"
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer Root {uint root[];};
layout(set=0,binding=1,std430) readonly buffer Pages {uint pages[];};
layout(set=0,binding=2,std430) readonly buffer Profiles {uint profiles[];};
layout(set=0,binding=3,std430) buffer Samples {vec4 samples[];};
layout(set=0,binding=4,std430) buffer Fluxes {vec2 fluxes[];};
layout(set=0,binding=5,std430) buffer Pixels {uint pixels[];};
layout(push_constant) uniform Params {uint width,height,phase,seconds,view_x,view_y,mode,unused;} params;
layout(buffer_reference,std430,buffer_reference_align=4) buffer Words {uint words[];};
layout(buffer_reference,std430,buffer_reference_align=8) readonly buffer Handles {uvec2 values[];};
float coefficient(uint material,uint field) {return uintBitsToFloat(profiles[material*FR_PROFILE_WORDS+field]);}
uvec2 handle_at(uint index) {
    uint x=index%params.width,y=index/params.width,page=pages[(y/64u)*((params.width+63u)/64u)+x/64u];
    return page==0u?uvec2(0):Handles(uvec2(root[6],root[7])).values[(page-1u)*4096u+(y%64u)*64u+x%64u];
}
bool valid(uvec2 handle) {
    if(handle.y==0u||handle.x>=root[2]) return false;
    Words e=Words(reactive_entry_address(uvec2(root[4],root[5]),handle.x));
    return e.words[FR_ENTRY_GENERATION]==handle.y&&e.words[FR_ENTRY_OWNER]==1u;
}
vec4 sample_at(uint index) {
    uvec2 handle=handle_at(index);if(!valid(handle)) return vec4(0);
    Words e=Words(reactive_entry_address(uvec2(root[4],root[5]),handle.x));uint at=FR_ENTRY_STATE,m=e.words[at];
    if(m>=params.unused) return vec4(0);
    float core=float(e.words[at+9u])+float(e.words[at+11u])+float(e.words[at+15u]);
    float capacity=(core*coefficient(m,5u)+float(e.words[at+10u])*coefficient(12u,5u)+
        float(e.words[at+12u])*coefficient(3u,5u)+float(e.words[at+13u])*coefficient(14u,5u)+
        (float(e.words[at+14u])+float(e.words[at+16u]))*coefficient(15u,5u))/65536.;
    float wet_capacity=float(e.words[at+8u])*coefficient(m,19u);
    return vec4(uintBitsToFloat(e.words[at+17u]),capacity,coefficient(m,6u),
        wet_capacity>0.?clamp(float(e.words[at+12u])/wet_capacity,0.,1.):0.);
}
float exchange(vec4 a,vec4 b) {
    if(a.y<=0.||b.y<=0.||a.z<=0.||b.z<=0.) return 0.;
    float difference=a.x/a.y-b.x/b.y,conductance=2.*a.z*b.z/(a.z+b.z);
    float requested=conductance*difference*uintBitsToFloat(params.seconds);
    float bound=min(a.y,b.y)*abs(difference)/float(FR_THERMAL_NEIGHBORS);
    return sign(requested)*min(abs(requested),bound);
}
vec3 temperature_color(float temperature) {
    float t=clamp((temperature-float(FR_THERMAL_AMBIENT_K))/(float(FR_THERMAL_PROBE_K)-float(FR_THERMAL_AMBIENT_K)),0.,1.);
    return t<.5?mix(vec3(.025,.12,.65),vec3(.05,.85,.7),t*2.):mix(vec3(.05,.85,.7),vec3(1.,.13,.025),(t-.5)*2.);
}
void main() {
    uint index=gl_GlobalInvocationID.x+gl_GlobalInvocationID.y*gl_NumWorkGroups.x*64u;
    if(index>=params.width*params.height) return;
    uint x=index%params.width,y=index/params.width;
    if(params.phase==0u) samples[index]=sample_at(index);
    if(params.phase==1u) fluxes[index]=vec2(x+1u<params.width?exchange(samples[index],samples[index+1u]):0.,
        y+1u<params.height?exchange(samples[index],samples[index+params.width]):0.);
    if(params.phase==2u&&samples[index].y>0.) {
        float energy=samples[index].x-fluxes[index].x-fluxes[index].y;
        if(x>0u) energy+=fluxes[index-1u].x;
        if(y>0u) energy+=fluxes[index-params.width].y;
        uvec2 handle=handle_at(index);
        if(valid(handle)) {
            Words e=Words(reactive_entry_address(uvec2(root[4],root[5]),handle.x));
            e.words[FR_ENTRY_STATE+FR_STATE_ENERGY]=floatBitsToUint(energy);samples[index].x=energy;
        }
    }
    if(params.phase==3u) {
        vec4 node=samples[index];
        if(node.y>0.) pixels[index]=packUnorm4x8(vec4(temperature_color(node.x/node.y),1.));
        if(x>=params.view_x+10u&&x<params.view_x+150u&&y>=params.view_y+10u&&y<params.view_y+18u)
            pixels[index]=packUnorm4x8(vec4(temperature_color(float(FR_THERMAL_AMBIENT_K)+
                float(x-params.view_x-10u)/139.*(float(FR_THERMAL_PROBE_K)-float(FR_THERMAL_AMBIENT_K))),1.));
    }
}
