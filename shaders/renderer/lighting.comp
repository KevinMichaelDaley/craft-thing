#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
#include "../../include/ferrum/renderer/light_transport.h"
#include "../../include/dungeoncraft/blackbody.h"
#include "directional_storage.glsl"
layout(local_size_x=64) in;

struct OpticalCell {float opacity;uint known;};
layout(set=0,binding=0,std430) readonly buffer Optics {OpticalCell nodes[];};
layout(set=0,binding=1,std430) readonly buffer Parameters {uint metadata[];};
struct Light {vec4 position_radius;vec4 color_intensity;};
layout(set=0,binding=2,std430) readonly buffer Sources {Light sources[];};
layout(set=0,binding=3,std430) buffer Fields {PackedField fields[];};
struct FireTile {vec4 radiance;vec4 center;};
layout(set=0,binding=4,std430) buffer FireTiles {FireTile fire_tiles[];};
layout(set=0,binding=5,std430) readonly buffer Pages {uint pages[];};
layout(set=0,binding=6,std430) buffer Work {uint work[];};
layout(buffer_reference,std430,buffer_reference_align=16)
    readonly buffer FireEmission {vec4 values[];};
layout(push_constant) uniform Push {uint phase;} p;

uint cell_index(ivec2 cell) {return uint(cell.y)*metadata[0]+uint(cell.x);}
bool inside(ivec2 cell) {
    return all(greaterThanEqual(cell,ivec2(0)))&&
           all(lessThan(cell,ivec2(metadata[0],metadata[1])));
}
float opacity_at(vec2 point) {
    ivec2 cell=ivec2(floor(point));
    if(!inside(cell)) return 1.;
    uint at=cell_index(cell);
    return nodes[at].known==0u?1.:clamp(nodes[at].opacity,0.,1.);
}
vec3 local_fire(uint index) {
    uvec2 address=uvec2(metadata[FR_TRANSPORT_FIRE_ADDRESS_WORD],
        metadata[FR_TRANSPORT_FIRE_ADDRESS_WORD+1u]);
    if((address.x|address.y)==0u) return vec3(0.);
    uint x=index%metadata[0],y=index/metadata[0];
    uint page=pages[(y/64u)*((metadata[0]+63u)/64u)+x/64u];
    if(page==0u) return vec3(0.);
    uint at=(page-1u)*4096u+(y%64u)*64u+x%64u;
    vec4 source=FireEmission(address).values[at];
    if(source.x<=0.) return vec3(0.);
    uint flags=floatBitsToUint(source.w);
    bool magical=(flags&FR_FIRE_EMISSION_MAGIC)!=0u;
    vec3 magic=unpackUnorm4x8(flags>>8u).rgb;
    float visible=magical?1.:fr_blackbody_visible_efficiency(source.y);
    float power=max(0.,source.x)*visible*float(FR_TRANSPORT_FIRE_RADIANCE_PER_KW);
    return fr_blackbody_rgb(source.y,power,magical,magic);
}
float radial_falloff(float distance_to_source,float range) {
    if(distance_to_source>=range) return 0.;
    float scale=max(1.,range/6.);
    float squared=distance_to_source*distance_to_source/(scale*scale);
    float edge=clamp((range-distance_to_source)/max(1.,range*.25),0.,1.);
    return edge*edge*(3.-2.*edge)/(1.+squared);
}
/* Five weighted rays approximate an area emitter. Their overlapping
   penumbrae soften contact shadows without extending them past range. */
float soft_visibility(vec2 source,vec2 destination) {
    vec2 delta=destination-source;
    float distance_to_source=length(delta);
    if(distance_to_source<=1.5) return 1.;
    vec2 side=vec2(-delta.y,delta.x)/distance_to_source;
    int steps=clamp(int(ceil(distance_to_source)),1,48);
    float total=0.;
    for(int ray=-2;ray<=2;ray++) {
        float transmission=1.;
        vec2 offset=side*float(ray)*.75;
        for(int i=1;i<=48;i++) {
            if(i>=steps) break;
            float t=float(i)/float(steps);
            float opacity=opacity_at(mix(source+offset,destination,t));
            transmission*=1.-opacity;
            if(transmission<.001) break;
        }
        total+=transmission*float(3-abs(ray));
    }
    return total/9.;
}
float local_ambient_visibility(vec2 destination) {
    const vec2 offsets[8]=vec2[8](
        vec2(2,0),vec2(-2,0),vec2(0,2),vec2(0,-2),
        vec2(4,4),vec2(-4,4),vec2(4,-4),vec2(-4,-4));
    float blocked=0.;
    for(int i=0;i<8;i++) blocked+=opacity_at(destination+offsets[i]);
    return clamp(1.-blocked/8.,0.,1.);
}
void add_source(inout vec3 energy,inout vec3 mx,inout vec3 my,inout vec3 mz,
                vec3 radiance,vec2 source,vec2 destination,
                float height,float range) {
    vec2 delta=destination-source;
    float distance_to_source=length(vec3(delta,height));
    float falloff=radial_falloff(distance_to_source,range);
    if(falloff<=0.) return;
    vec3 amount=radiance*falloff*soft_visibility(source,destination);
    energy+=amount;
    vec3 direction=normalize(vec3(-delta,height)+vec3(0.,0.,1e-6));
    mx+=amount*direction.x;
    my+=amount*direction.y;
    mz+=amount*direction.z;
}
void aggregate_fire_tile(uint tile_index) {
    if(tile_index>=metadata[2]*metadata[3]) return;
    uint tx=tile_index%metadata[2],ty=tile_index/metadata[2];
    vec3 radiance=vec3(0.);
    vec2 weighted_position=vec2(0.);
    float weight=0.;
    for(uint y=0u;y<FR_TRANSPORT_FIRE_TILE;y++)
    for(uint x=0u;x<FR_TRANSPORT_FIRE_TILE;x++) {
        ivec2 cell=ivec2(tx*FR_TRANSPORT_FIRE_TILE+x,ty*FR_TRANSPORT_FIRE_TILE+y);
        if(!inside(cell)) continue;
        uint at=cell_index(cell);
        if(nodes[at].known==0u) continue;
        vec3 color=local_fire(at);
        float luminous=max(color.r,max(color.g,color.b));
        radiance+=color;
        weighted_position+=(vec2(cell)+.5)*luminous;
        weight+=luminous;
    }
    vec2 center=weight>0.?weighted_position/weight:
        (vec2(tx,ty)+.5)*float(FR_TRANSPORT_FIRE_TILE);
    fire_tiles[tile_index]=FireTile(vec4(radiance,weight),vec4(center,0.,0.));
}
void shade_cell(uint index) {
    if(index>=metadata[0]*metadata[1]) return;
    if(nodes[index].known==0u) {
        fields[index]=renderer_pack_field(Field(vec4(0),vec4(0),vec4(0),vec4(0)));
        return;
    }
    vec2 destination=vec2(index%metadata[0],index/metadata[0])+.5;
    vec3 energy=vec3(0.),mx=vec3(0.),my=vec3(0.),mz=vec3(0.);
    Light sun=sources[16];
    if(metadata[6]!=0u&&sun.color_intensity.a>0.) {
        float boundary=float(metadata[5]);
        if((metadata[6]&1u)!=0u) boundary=min(boundary,destination.x);
        if((metadata[6]&2u)!=0u) boundary=min(boundary,float(metadata[0])-destination.x);
        if((metadata[6]&4u)!=0u) boundary=min(boundary,destination.y);
        if((metadata[6]&8u)!=0u) boundary=min(boundary,float(metadata[1])-destination.y);
        float ambient=.25+.75*local_ambient_visibility(destination);
        vec3 amount=sun.color_intensity.rgb*sun.color_intensity.a*ambient*
            radial_falloff(boundary,float(metadata[5]));
        energy+=amount;
        vec3 incoming=normalize(sun.position_radius.xyz+vec3(0.,0.,1e-6));
        mx-=amount*incoming.x;
        my-=amount*incoming.y;
        mz+=amount*incoming.z;
    }
    for(uint i=0u;i<metadata[4];i++) {
        Light point=sources[i];
        float range=min(point.position_radius.w,float(metadata[5]));
        if(point.color_intensity.a<=0.||range<=0.) continue;
        add_source(energy,mx,my,mz,
            point.color_intensity.rgb*point.color_intensity.a,
            point.position_radius.xy,destination,point.position_radius.z,range);
    }
    if((metadata[FR_TRANSPORT_FIRE_ADDRESS_WORD]|
        metadata[FR_TRANSPORT_FIRE_ADDRESS_WORD+1u])!=0u) {
        int tile_x=int(floor(destination.x/float(FR_TRANSPORT_FIRE_TILE)));
        int tile_y=int(floor(destination.y/float(FR_TRANSPORT_FIRE_TILE)));
        int reach=int(ceil(float(FR_TRANSPORT_FIRE_RANGE)/float(FR_TRANSPORT_FIRE_TILE)))+1;
        for(int dy=-reach;dy<=reach;dy++)
        for(int dx=-reach;dx<=reach;dx++) {
            ivec2 tile=ivec2(tile_x+dx,tile_y+dy);
            if(any(lessThan(tile,ivec2(0)))||
               any(greaterThanEqual(tile,ivec2(metadata[2],metadata[3])))) continue;
            FireTile fire=fire_tiles[uint(tile.y)*metadata[2]+uint(tile.x)];
            if(fire.radiance.a<=0.) continue;
            add_source(energy,mx,my,mz,fire.radiance.rgb,fire.center.xy,
                destination,0.,float(FR_TRANSPORT_FIRE_RANGE));
        }
    }
    fields[index]=renderer_pack_field(Field(vec4(energy,0.),
        vec4(mx,0.),vec4(my,0.),vec4(mz,0.)));
}
void main() {
    uint index=gl_GlobalInvocationID.x;
    if(p.phase==2u) {
        if(index==0u) {
            bool enabled=work[0]!=0u;
            work[1]=enabled?(metadata[2]*metadata[3]+63u)/64u:0u;
            work[2]=1u;work[3]=1u;
            work[4]=enabled?(metadata[0]*metadata[1]+63u)/64u:0u;
            work[5]=1u;work[6]=1u;
            if(enabled) atomicAdd(work[7],1u);
        }
    } else if(p.phase==0u) aggregate_fire_tile(index);
    else shade_cell(index);
}
