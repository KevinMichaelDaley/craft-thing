#version 460
#extension GL_GOOGLE_include_directive : require
#include "../gas/types.glsl"
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer World {Gas world[];};
layout(set=0,binding=1,std430) readonly buffer Model {uint parameters[];};
layout(set=0,binding=2,std430) readonly buffer Pages {uint pages[];};
layout(set=0,binding=3,std430) buffer Frame {uint frame[];};
layout(set=0,binding=4,std430) readonly buffer Gates {uint gates[];};
layout(push_constant) uniform Params {uint width,height,view_x,view_y,view_width,view_height;} params;
void main() {
    uint index=gl_GlobalInvocationID.x+gl_GlobalInvocationID.y*gl_NumWorkGroups.x*64u;
    if(index>=params.width*params.height) return;
    uint x=index%params.width,y=index/params.width;
    if(x<params.view_x||y<params.view_y||x>=params.view_x+params.view_width||y>=params.view_y+params.view_height) return;
    uint page=pages[(y/64u)*((params.width+63u)/64u)+x/64u];if(page==0u) return;
    uint atlas=(page-1u)*4096u+(y%64u)*64u+x%64u;Gas s=world[atlas];uint gate=gates[atlas]&3u;
    bool oxygen_view=uintBitsToFloat(parameters[FR_GAS_VIEW_WORD])==1.;float carrier=s.species.z+s.dynamics.x;
    if(gate==0u&&(s.geometry.y<=0.||(!oxygen_view&&carrier<=0.))) return;
    vec3 color=unpackUnorm4x8(frame[index]).rgb;
    if(s.geometry.y>0.&&oxygen_view) {
        vec4 r=vec4(uintBitsToFloat(parameters[0]),uintBitsToFloat(parameters[1]),uintBitsToFloat(parameters[2]),uintBitsToFloat(parameters[3]));
        float molecular=dot(s.species,r)+s.dynamics.x*uintBitsToFloat(parameters[4]);
        float oxygen=molecular>0.?s.species.x*r.x/molecular:0.;
        color=mix(vec3(.72,.12,.08),vec3(.08,.65,.88),clamp(oxygen/.21,0.,1.));
    } else if(s.geometry.y>0.&&carrier>0.) {
        float opacity=uintBitsToFloat(parameters[FR_GAS_OPACITY_WORD]),density=uintBitsToFloat(parameters[FR_GAS_DENSITY_WORD]);
        float alpha=(1.-exp(-opacity*carrier/(s.geometry.x*density)))*clamp(s.geometry.y,0.,1.);
        color=mix(color,clamp(s.visual.rgb/carrier,vec3(0),vec3(1)),alpha);
    }
    if(gate!=0u) color=vec3(.62,.32,.07);
    frame[index]=packUnorm4x8(vec4(color,1.));
}
