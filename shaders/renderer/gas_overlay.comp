#version 460
#extension GL_GOOGLE_include_directive : require
#include "../gas/types.glsl"
#define FR_SMOKE_DETAIL_SCALE .125
#define FR_SMOKE_WARP_CELLS 4.
#define FR_SMOKE_WARP_ENERGY .5
#define FR_SMOKE_DETAIL_GAIN .6
#define FR_SMOKE_DETAIL_ENERGY .25
#define FR_SMOKE_DETAIL_MIN .5
#define FR_SMOKE_EDGE_START .08
#define FR_SMOKE_EDGE_FULL .5
/* Effective scattering from unresolved condensate in transported exhaust. */
#define FR_SMOKE_EXHAUST_OPTICAL_WEIGHT .05
#define FR_SMOKE_CLEAR_FACE_VOID .999
#define FR_SMOKE_MAX_FACE_CFL .18
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer World {Gas world[];};
layout(set=0,binding=1,std430) readonly buffer Model {uint parameters[];};
layout(set=0,binding=2,std430) readonly buffer Pages {uint pages[];};
layout(set=0,binding=3,std430) buffer Frame {uint frame[];};
layout(set=0,binding=4,std430) readonly buffer Gates {uint gates[];};
layout(set=0,binding=5,std430) readonly buffer Alternate {Gas alternate[];};
layout(set=0,binding=6,std430) buffer SmokeCoordinates0 {vec2 coordinates0[];};
layout(set=0,binding=7,std430) buffer SmokeCoordinates1 {vec2 coordinates1[];};
layout(set=0,binding=8,std430) buffer SmokePotential {float potentials[];};
layout(set=0,binding=9,std430) buffer SmokeDetail0 {float detail0[];};
layout(set=0,binding=10,std430) buffer SmokeDetail1 {float detail1[];};
layout(push_constant) uniform Params {uint width,height,view_x,view_y,view_width,view_height,seconds,bank,reset;} params;
vec2 smoke_coordinate(ivec2 p) {
    if(any(lessThan(p,ivec2(0)))||any(greaterThanEqual(p,ivec2(params.width,params.height)))) return vec2(p);
    uint index=uint(p.y)*params.width+uint(p.x);
    return params.bank==0u?coordinates0[index]:coordinates1[index];
}
vec2 smoke_advected_coordinate(vec2 back) {
    /* Keep a material coordinate field across presentations. The field follows
     * gas motion and stays unchanged while the simulation clock is paused. */
    if(params.reset!=0u) return back;
    ivec2 lower=ivec2(floor(back));vec2 fraction=fract(back);
    vec2 a=mix(smoke_coordinate(lower),smoke_coordinate(lower+ivec2(1,0)),fraction.x);
    vec2 b=mix(smoke_coordinate(lower+ivec2(0,1)),smoke_coordinate(lower+ivec2(1,1)),fraction.x);
    return mix(a,b,fraction.y);
}
Gas smoke_at(uint x,uint y) {
    uint page=pages[(y/64u)*((params.width+63u)/64u)+x/64u];
    if(page==0u) return gas_empty();
    uint at=(page-1u)*4096u+(y%64u)*64u+x%64u;
    return parameters[FR_GAS_CELL_OWNER_WORD]!=0u&&(gates[at]&FR_GAS_CELL_OWNER_BIT)!=0u?alternate[at]:world[at];
}
float smoke_aerosol(Gas s) {
    return max(s.dynamics.x,0.)+FR_SMOKE_EXHAUST_OPTICAL_WEIGHT*max(s.species.z,0.);
}
float smoke_optical_depth(Gas s,float opacity,float density) {
    return s.geometry.x>0.?opacity*smoke_aerosol(s)/(s.geometry.x*density):0.;
}
void smoke_detail_store(uint index,float value) {
    if(params.bank==0u) detail0[index]=value;else detail1[index]=value;
}
float smoke_detail_old(ivec2 p) {
    if(params.reset!=0u||any(lessThan(p,ivec2(0)))||
        any(greaterThanEqual(p,ivec2(params.width,params.height)))) return 0.;
    uint index=uint(p.y)*params.width+uint(p.x);
    return params.bank==0u?detail1[index]:detail0[index];
}
float smoke_aerosol_at(ivec2 p) {
    if(any(lessThan(p,ivec2(0)))||any(greaterThanEqual(p,ivec2(params.width,params.height)))) return 0.;
    return smoke_aerosol(smoke_at(uint(p.x),uint(p.y)));
}
float smoke_hash(ivec2 p) {
    uint phase=uint(p.x)*1664525u+uint(p.y)*1013904223u;
    phase^=phase>>16u;phase*=2246822519u;phase^=phase>>13u;
    return float(phase&65535u)*(2./65535.)-1.;
}
float smoke_wavelet_band(vec2 p) {
    /* The compact radial wavelet has zero integral in 2D: integrating
     * (1-r^2)^2(1-4r^2) over the unit disk gives zero. Random coefficients
     * translate its band without adding a low-frequency DC component. */
    ivec2 low=ivec2(floor(p));float value=0.;
    for(int dy=-1;dy<=1;dy++) for(int dx=-1;dx<=1;dx++) {
        ivec2 node=low+ivec2(dx,dy);vec2 delta=p-vec2(node);
        float radius=dot(delta,delta);if(radius>=1.) continue;
        float taper=1.-radius;
        value+=smoke_hash(node)*taper*taper*(1.-4.*radius);
    }
    return value;
}
float smoke_wavelet(vec2 p) {
    /* The second octave follows the -5/6 velocity-amplitude spectrum. */
    return smoke_wavelet_band(p)+.561231*smoke_wavelet_band(p*2.);
}
vec2 smoke_velocity_at(ivec2 p,vec2 fallback) {
    if(any(lessThan(p,ivec2(0)))||any(greaterThanEqual(p,ivec2(params.width,params.height)))) return fallback;
    Gas s=smoke_at(uint(p.x),uint(p.y));
    float mass=dot(s.species,vec4(1.))+s.dynamics.x;
    return mass>0.&&s.geometry.x>0.?s.dynamics.zw/mass:fallback;
}
vec2 smoke_advect_velocity(ivec2 p,Gas s) {
    float mass=dot(s.species,vec4(1.))+s.dynamics.x;
    vec2 velocity=mass>0.?s.dynamics.zw/mass:vec2(0.);
    if(s.species.z+s.dynamics.x>0.) return velocity;
    float nearby=0.;
    for(uint d=0u;d<4u;d++) {
        ivec2 q=p+(d==0u?ivec2(1,0):(d==1u?ivec2(-1,0):(d==2u?ivec2(0,1):ivec2(0,-1))));
        if(any(lessThan(q,ivec2(0)))||any(greaterThanEqual(q,ivec2(params.width,params.height)))) continue;
        Gas other=smoke_at(uint(q.x),uint(q.y));float smoke=other.species.z+other.dynamics.x;
        float other_mass=dot(other.species,vec4(1.))+other.dynamics.x;
        if(smoke>nearby&&other_mass>0.) {nearby=smoke;velocity=other.dynamics.zw/other_mass;}
    }
    return velocity;
}
bool smoke_wavelet_open_face(ivec2 p,uint direction) {
    ivec2 q=p+(direction==0u?ivec2(1,0):direction==1u?ivec2(-1,0):
        direction==2u?ivec2(0,1):ivec2(0,-1));
    if(any(lessThan(p,ivec2(0)))||any(greaterThanEqual(p,ivec2(params.width,params.height)))) return false;
    if(any(lessThan(q,ivec2(0)))||any(greaterThanEqual(q,ivec2(params.width,params.height)))) return false;
    if(smoke_at(uint(p.x),uint(p.y)).geometry.y<FR_SMOKE_CLEAR_FACE_VOID) return false;
    if(smoke_at(uint(q.x),uint(q.y)).geometry.y<FR_SMOKE_CLEAR_FACE_VOID) return false;
    ivec2 low=(direction&1u)==0u?p:q;
    uint x=uint(low.x),y=uint(low.y),page=pages[(y/64u)*((params.width+63u)/64u)+x/64u];
    if(page==0u) return false;
    uint at=(page-1u)*4096u+(y%64u)*64u+x%64u;
    return (gates[at]&(direction<2u?1u:2u))==0u;
}
float smoke_resolved_band(ivec2 p,vec2 center) {
    vec2 right=smoke_velocity_at(p+ivec2(1,0),center);
    vec2 down=smoke_velocity_at(p+ivec2(0,1),center);
    vec2 diagonal=smoke_velocity_at(p+ivec2(1,1),.5*(right+down));
    /* Three zero-mean Haar coefficients are the last resolved velocity band.
     * Uniform motion has no detail energy, regardless of its speed. */
    vec2 horizontal=.25*(center-right+down-diagonal);
    vec2 vertical=.25*(center+right-down-diagonal);
    vec2 diagonal_band=.25*(center-right-down+diagonal);
    return sqrt(dot(horizontal,horizontal)+dot(vertical,vertical)+
        dot(diagonal_band,diagonal_band));
}
bool smoke_coordinate_scattered(ivec2 p);
float smoke_scattering_weight(ivec2 p);
float smoke_stream_potential(ivec2 p) {
    if(any(lessThan(p,ivec2(0)))||any(greaterThanEqual(p,ivec2(params.width,params.height)))) return 0.;
    float resolved=smoke_resolved_band(p,smoke_velocity_at(p,vec2(0.)));
    if(resolved<=.001) return 0.;
    float energy=.5*resolved*resolved;
    float scattering=smoke_scattering_weight(p);
    if(scattering<=0.) return 0.;
    if(smoke_at(uint(p.x),uint(p.y)).geometry.y<FR_SMOKE_CLEAR_FACE_VOID) return 0.;
    for(uint d=0u;d<4u;d++) if(!smoke_wavelet_open_face(p,d)) return 0.;
    float amplitude=FR_SMOKE_WARP_CELLS*energy/(energy+FR_SMOKE_WARP_ENERGY)*scattering;
    return amplitude*smoke_wavelet(smoke_coordinate(p)*FR_SMOKE_DETAIL_SCALE);
}
vec2 smoke_wavelet_velocity(ivec2 p) {
    /* A discrete curl keeps the added velocity divergence free even where
     * smoke density and resolved band energy change across the plume. */
    if(smoke_at(uint(p.x),uint(p.y)).geometry.y<FR_SMOKE_CLEAR_FACE_VOID) return vec2(0.);
    ivec2 down=p+ivec2(0,1),up=p-ivec2(0,1);
    ivec2 left=p-ivec2(1,0),right=p+ivec2(1,0);
    float d=any(greaterThanEqual(down,ivec2(params.width,params.height)))?0.:potentials[uint(down.y)*params.width+uint(down.x)];
    float u=any(lessThan(up,ivec2(0)))?0.:potentials[uint(up.y)*params.width+uint(up.x)];
    float l=any(lessThan(left,ivec2(0)))?0.:potentials[uint(left.y)*params.width+uint(left.x)];
    float r=any(greaterThanEqual(right,ivec2(params.width,params.height)))?0.:potentials[uint(right.y)*params.width+uint(right.x)];
    return .5*vec2(d-u,l-r);
}
float smoke_potential_at(ivec2 p) {
    if(any(lessThan(p,ivec2(0)))||any(greaterThanEqual(p,ivec2(params.width,params.height)))) return 0.;
    return potentials[uint(p.y)*params.width+uint(p.x)];
}
float smoke_detail_face_flux(ivec2 low,bool horizontal,float dt) {
    if(!smoke_wavelet_open_face(low,horizontal?0u:2u)) return 0.;
    ivec2 high=low+(horizontal?ivec2(1,0):ivec2(0,1));
    float wavelet=horizontal?
        smoke_potential_at(low+ivec2(1,1))-smoke_potential_at(low+ivec2(1,0)):
        smoke_potential_at(low)-smoke_potential_at(low+ivec2(1,0));
    float coarse=.5*(smoke_velocity_at(low,vec2(0.))[horizontal?0:1]+
        smoke_velocity_at(high,vec2(0.))[horizontal?0:1]);
    float d0=smoke_detail_old(low),d1=smoke_detail_old(high);
    float a0=max(0.,smoke_aerosol_at(low)+d0),a1=max(0.,smoke_aerosol_at(high)+d1);
    float fine_rate=clamp(dt*wavelet,-FR_SMOKE_MAX_FACE_CFL,FR_SMOKE_MAX_FACE_CFL);
    float coarse_rate=clamp(dt*coarse,-FR_SMOKE_MAX_FACE_CFL,FR_SMOKE_MAX_FACE_CFL);
    return fine_rate*(fine_rate>=0.?a0:a1)+coarse_rate*(coarse_rate>=0.?d0:d1);
}
float smoke_advected_detail(ivec2 p,float dt) {
    if(dt<=0.||params.reset!=0u) return smoke_detail_old(p);
    if(smoke_aerosol_at(p)+abs(smoke_detail_old(p))<=0.&&
        smoke_aerosol_at(p+ivec2(1,0))+abs(smoke_detail_old(p+ivec2(1,0)))<=0.&&
        smoke_aerosol_at(p-ivec2(1,0))+abs(smoke_detail_old(p-ivec2(1,0)))<=0.&&
        smoke_aerosol_at(p+ivec2(0,1))+abs(smoke_detail_old(p+ivec2(0,1)))<=0.&&
        smoke_aerosol_at(p-ivec2(0,1))+abs(smoke_detail_old(p-ivec2(0,1)))<=0.) return 0.;
    return smoke_detail_old(p)+
        smoke_detail_face_flux(p-ivec2(1,0),true,dt)-smoke_detail_face_flux(p,true,dt)+
        smoke_detail_face_flux(p-ivec2(0,1),false,dt)-smoke_detail_face_flux(p,false,dt);
}
bool smoke_coordinate_scattered(ivec2 p) {
    vec2 dx=.5*(smoke_coordinate(p+ivec2(1,0))-smoke_coordinate(p-ivec2(1,0)));
    vec2 dy=.5*(smoke_coordinate(p+ivec2(0,1))-smoke_coordinate(p-ivec2(0,1)));
    float trace=dot(dx,dx)+dot(dy,dy),det=dx.x*dy.y-dx.y*dy.x;
    float discriminant=sqrt(max(0.,trace*trace-4.*det*det));
    float low=sqrt(max(0.,.5*(trace-discriminant)));
    float high=sqrt(max(0.,.5*(trace+discriminant)));
    return low<=.5||high>=2.;
}
float smoke_scattering_weight(ivec2 p) {
    if(params.reset!=0u) return 0.;
    vec2 dx=.5*(smoke_coordinate(p+ivec2(1,0))-smoke_coordinate(p-ivec2(1,0)));
    vec2 dy=.5*(smoke_coordinate(p+ivec2(0,1))-smoke_coordinate(p-ivec2(0,1)));
    float strain=max(length(dx-vec2(1,0)),length(dy-vec2(0,1)));
    return smoothstep(.15,.9,strain);
}
vec4 smoke_visual_gas(Gas s,float opacity,float density) {
    float carrier=s.species.z+s.dynamics.x;
    if(carrier<=0.||s.geometry.y<=0.) return vec4(0.);
    float depth=smoke_optical_depth(s,opacity,density);
    float alpha=(1.-exp(-depth))*clamp(s.geometry.y,0.,1.);
    float effective=-log(max(1e-6,1.-alpha));
    return vec4(effective,effective*clamp(s.visual.rgb/carrier,vec3(0.),vec3(1.)));
}
vec4 smoke_visual_at(ivec2 p,float opacity,float density) {
    if(any(lessThan(p,ivec2(0)))||any(greaterThanEqual(p,ivec2(params.width,params.height)))) return vec4(0.);
    uint x=uint(p.x),y=uint(p.y),page=pages[(y/64u)*((params.width+63u)/64u)+x/64u];
    if(page==0u) return vec4(0.);
    uint at=(page-1u)*4096u+(y%64u)*64u+x%64u;
    if((gates[at]&3u)!=0u) return vec4(0.);
    return smoke_visual_gas(smoke_at(x,y),opacity,density);
}
vec4 smoke_visual_sample(vec2 p,float opacity,float density) {
    ivec2 low=ivec2(floor(p));vec2 t=fract(p);
    vec4 a=mix(smoke_visual_at(low,opacity,density),smoke_visual_at(low+ivec2(1,0),opacity,density),t.x);
    vec4 b=mix(smoke_visual_at(low+ivec2(0,1),opacity,density),smoke_visual_at(low+ivec2(1,1),opacity,density),t.x);
    return mix(a,b,t.y);
}
float smoke_edge_weight(float original_depth,float displaced_depth) {
    /* A large relative change marks the plume boundary. Inside uniform smoke,
     * the original optical depth dominates and only the soft detail remains. */
    if(original_depth<=0.&&displaced_depth>0.) return 1.;
    float change=abs(displaced_depth-original_depth)/max(max(displaced_depth,original_depth),.25);
    return smoothstep(FR_SMOKE_EDGE_START,FR_SMOKE_EDGE_FULL,change);
}
void main() {
    uint index=gl_GlobalInvocationID.x+gl_GlobalInvocationID.y*gl_NumWorkGroups.x*64u;
    if(index>=params.width*params.height) return;
    uint x=index%params.width,y=index/params.width;
    uint page=pages[(y/64u)*((params.width+63u)/64u)+x/64u];
    uint atlas=page==0u?0u:(page-1u)*4096u+(y%64u)*64u+x%64u;
    Gas s=page==0u?gas_empty():(parameters[FR_GAS_CELL_OWNER_WORD]!=0u&&(gates[atlas]&FR_GAS_CELL_OWNER_BIT)!=0u?alternate[atlas]:world[atlas]);
    uint gate=page==0u?0u:gates[atlas]&3u;
    ivec2 cell=ivec2(x,y);
#ifdef FR_SMOKE_COORDINATE_ONLY
    if(s.geometry.y<FR_SMOKE_CLEAR_FACE_VOID) {
        if(params.bank==0u) coordinates1[index]=vec2(x,y);else coordinates0[index]=vec2(x,y);
        return;
    }
    vec2 velocity=page==0u?vec2(0.):smoke_advect_velocity(cell,s);
    if(s.species.z+s.dynamics.x<=0.&&all(equal(velocity,vec2(0.)))) {
        if(params.bank==0u) coordinates1[index]=vec2(x,y);else coordinates0[index]=vec2(x,y);
        return;
    }
    vec2 coordinate=smoke_advected_coordinate(vec2(x,y)-velocity*uintBitsToFloat(params.seconds));
    if(params.reset==0u&&params.seconds!=0u&&smoke_coordinate_scattered(cell)) coordinate=vec2(x,y);
    if(params.bank==0u) coordinates1[index]=coordinate;else coordinates0[index]=coordinate;
#elif defined(FR_SMOKE_POTENTIAL_ONLY)
    potentials[index]=smoke_stream_potential(cell);
#else
    if(page==0u) {
        smoke_detail_store(index,0.);
        return;
    }
    float transported_detail=smoke_advected_detail(cell,uintBitsToFloat(params.seconds));
    smoke_detail_store(index,transported_detail);
    if(x<params.view_x||y<params.view_y||x>=params.view_x+params.view_width||y>=params.view_y+params.view_height) return;
    vec2 coordinate=smoke_coordinate(cell);
    bool oxygen_view=uintBitsToFloat(parameters[FR_GAS_VIEW_WORD])==1.;
    if(!oxygen_view&&gate==0u&&s.species.z+s.dynamics.x<=0.&&transported_detail<=0.) {
        bool near_smoke=false;
        for(uint d=0u;d<4u;d++) {
            ivec2 q=cell+(d==0u?ivec2(1,0):(d==1u?ivec2(-1,0):(d==2u?ivec2(0,1):ivec2(0,-1))));
            if(any(lessThan(q,ivec2(0)))||any(greaterThanEqual(q,ivec2(params.width,params.height)))) continue;
            Gas other=smoke_at(uint(q.x),uint(q.y));
            near_smoke=near_smoke||other.species.z+other.dynamics.x>0.;
        }
        if(!near_smoke) return;
    }
    if(gate==0u&&oxygen_view&&s.geometry.y<=0.) return;
    vec2 velocity=gate==0u&&!oxygen_view?smoke_advect_velocity(cell,s):vec2(0.);
    vec3 color=unpackUnorm4x8(frame[index]).rgb;
    if(s.geometry.y>0.&&oxygen_view) {
        vec4 r=vec4(uintBitsToFloat(parameters[0]),uintBitsToFloat(parameters[1]),uintBitsToFloat(parameters[2]),uintBitsToFloat(parameters[3]));
        float molecular=dot(s.species,r)+s.dynamics.x*uintBitsToFloat(parameters[4]);
        float oxygen=molecular>0.?s.species.x*r.x/molecular:0.;
        color=mix(vec3(.72,.12,.08),vec3(.08,.65,.88),clamp(oxygen/.21,0.,1.));
    } else if(gate==0u) {
        float opacity=uintBitsToFloat(parameters[FR_GAS_OPACITY_WORD]),density=uintBitsToFloat(parameters[FR_GAS_DENSITY_WORD]);
        vec2 material=coordinate;
        vec2 curl=smoke_wavelet_velocity(cell);
        float energy_band=smoke_resolved_band(cell,velocity);
        vec4 original=smoke_visual_gas(s,opacity,density);
        vec4 warped=dot(curl,curl)>1e-8?smoke_visual_sample(vec2(x,y)-curl,opacity,density):original;
        vec4 smoke=mix(original,warped,smoke_edge_weight(original.x,warped.x));
        if(s.geometry.x>0.) {
            float optical_change=opacity*transported_detail/(s.geometry.x*density);
            float depth=max(0.,smoke.x+optical_change);
            if(smoke.x>0.) smoke.yzw*=depth/smoke.x;
            else if(depth>0.) smoke.yzw=depth*vec3(.18,.16,.14);
            smoke.x=depth;
        }
        if(smoke.x<=0.) return;
        float visual_energy=.5*energy_band*energy_band;
        float visual_weight=visual_energy/(visual_energy+FR_SMOKE_DETAIL_ENERGY)*smoke_scattering_weight(cell);
        float detail=visual_weight>0.?max(FR_SMOKE_DETAIL_MIN,1.+FR_SMOKE_DETAIL_GAIN*visual_weight*
            smoke_wavelet(material*FR_SMOKE_DETAIL_SCALE)):1.;
        color=mix(color,smoke.yzw/smoke.x,1.-exp(-smoke.x*detail));
    }
    if(gate!=0u) color=vec3(.62,.32,.07);
    frame[index]=packUnorm4x8(vec4(color,1.));
#endif
}
