#version 460
#extension GL_GOOGLE_include_directive : require
#include "../gas/types.glsl"
#define FR_SMOKE_DETAIL_SCALE .5
#define FR_SMOKE_WARP_CELLS 5.
#define FR_SMOKE_WARP_SPEED .1
#define FR_SMOKE_DETAIL_GAIN 2.5
#define FR_SMOKE_DETAIL_SPEED .02
#define FR_SMOKE_DETAIL_MIN .08
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer World {Gas world[];};
layout(set=0,binding=1,std430) readonly buffer Model {uint parameters[];};
layout(set=0,binding=2,std430) readonly buffer Pages {uint pages[];};
layout(set=0,binding=3,std430) buffer Frame {uint frame[];};
layout(set=0,binding=4,std430) readonly buffer Gates {uint gates[];};
layout(set=0,binding=5,std430) readonly buffer Alternate {Gas alternate[];};
layout(set=0,binding=6,std430) buffer SmokeCoordinates0 {vec2 coordinates0[];};
layout(set=0,binding=7,std430) buffer SmokeCoordinates1 {vec2 coordinates1[];};
layout(push_constant) uniform Params {uint width,height,view_x,view_y,view_width,view_height,seconds,bank,reset;} params;
vec2 smoke_coordinate(ivec2 p) {
    if(any(lessThan(p,ivec2(0)))||any(greaterThanEqual(p,ivec2(params.width,params.height)))) return vec2(p);
    uint index=uint(p.y)*params.width+uint(p.x);
    return params.bank==0u?coordinates0[index]:coordinates1[index];
}
vec2 smoke_advected_coordinate(vec2 back) {
    /* Keep a material coordinate field across presentations. The field follows
     * gas motion and stays unchanged while the simulation clock is paused. */
    if(params.reset!=0u) return back;
    ivec2 lower=ivec2(floor(back));vec2 fraction=fract(back);
    vec2 a=mix(smoke_coordinate(lower),smoke_coordinate(lower+ivec2(1,0)),fraction.x);
    vec2 b=mix(smoke_coordinate(lower+ivec2(0,1)),smoke_coordinate(lower+ivec2(1,1)),fraction.x);
    return mix(a,b,fraction.y);
}
Gas smoke_at(uint x,uint y) {
    uint page=pages[(y/64u)*((params.width+63u)/64u)+x/64u];
    if(page==0u) return gas_empty();
    uint at=(page-1u)*4096u+(y%64u)*64u+x%64u;
    return parameters[FR_GAS_CELL_OWNER_WORD]!=0u&&(gates[at]&FR_GAS_CELL_OWNER_BIT)!=0u?alternate[at]:world[at];
}
float smoke_optical_depth(Gas s,float opacity,float density) {
    float carrier=s.species.z+s.dynamics.x;
    return s.geometry.x>0.?opacity*max(carrier,0.)/(s.geometry.x*density):0.;
}
float smoke_hash(ivec2 p) {
    uint phase=uint(p.x)*1664525u+uint(p.y)*1013904223u;
    phase^=phase>>16u;phase*=2246822519u;phase^=phase>>13u;
    return float(phase&65535u)*(2./65535.)-1.;
}
float smoke_smooth_noise(vec2 p) {
    ivec2 low=ivec2(floor(p));vec2 t=fract(p);t=t*t*(3.-2.*t);
    float a=mix(smoke_hash(low),smoke_hash(low+ivec2(1,0)),t.x);
    float b=mix(smoke_hash(low+ivec2(0,1)),smoke_hash(low+ivec2(1,1)),t.x);
    return mix(a,b,t.y);
}
float smoke_wavelet(vec2 p) {
    /* A local fine band minus a lower frequency band gives moving detail
     * without anchoring a dither mask to screen cells. */
    return clamp(smoke_smooth_noise(p)-.5*smoke_smooth_noise(p*.5),-1.,1.);
}
vec4 smoke_visual_at(ivec2 p,float opacity,float density) {
    if(any(lessThan(p,ivec2(0)))||any(greaterThanEqual(p,ivec2(params.width,params.height)))) return vec4(0.);
    uint x=uint(p.x),y=uint(p.y),page=pages[(y/64u)*((params.width+63u)/64u)+x/64u];
    if(page==0u) return vec4(0.);
    uint at=(page-1u)*4096u+(y%64u)*64u+x%64u;
    if((gates[at]&3u)!=0u) return vec4(0.);
    Gas s=smoke_at(x,y);float carrier=s.species.z+s.dynamics.x;
    if(carrier<=0.||s.geometry.y<=0.) return vec4(0.);
    float depth=smoke_optical_depth(s,opacity,density);
    float alpha=(1.-exp(-depth))*clamp(s.geometry.y,0.,1.);
    float effective=-log(max(1e-6,1.-alpha));
    return vec4(effective,effective*clamp(s.visual.rgb/carrier,vec3(0.),vec3(1.)));
}
vec4 smoke_visual_sample(vec2 p,float opacity,float density) {
    ivec2 low=ivec2(floor(p));vec2 t=fract(p);
    vec4 a=mix(smoke_visual_at(low,opacity,density),smoke_visual_at(low+ivec2(1,0),opacity,density),t.x);
    vec4 b=mix(smoke_visual_at(low+ivec2(0,1),opacity,density),smoke_visual_at(low+ivec2(1,1),opacity,density),t.x);
    return mix(a,b,t.y);
}
void main() {
    uint index=gl_GlobalInvocationID.x+gl_GlobalInvocationID.y*gl_NumWorkGroups.x*64u;
    if(index>=params.width*params.height) return;
    uint x=index%params.width,y=index/params.width;
    uint page=pages[(y/64u)*((params.width+63u)/64u)+x/64u];
    uint atlas=page==0u?0u:(page-1u)*4096u+(y%64u)*64u+x%64u;
    Gas s=page==0u?gas_empty():(parameters[FR_GAS_CELL_OWNER_WORD]!=0u&&(gates[atlas]&FR_GAS_CELL_OWNER_BIT)!=0u?alternate[atlas]:world[atlas]);
    uint gate=page==0u?0u:gates[atlas]&3u;
    float carrier=s.species.z+s.dynamics.x;
    float mass=dot(s.species,vec4(1.))+s.dynamics.x;
    vec2 velocity=mass>0.?s.dynamics.zw/mass:vec2(0.);
    if(carrier<=0.&&page!=0u) {
        float nearby=0.;
        for(uint d=0u;d<4u;d++) {
            ivec2 q=ivec2(x,y)+(d==0u?ivec2(1,0):(d==1u?ivec2(-1,0):(d==2u?ivec2(0,1):ivec2(0,-1))));
            if(any(lessThan(q,ivec2(0)))||any(greaterThanEqual(q,ivec2(params.width,params.height)))) continue;
            Gas other=smoke_at(uint(q.x),uint(q.y));float smoke=other.species.z+other.dynamics.x;
            float other_mass=dot(other.species,vec4(1.))+other.dynamics.x;
            if(smoke>nearby&&other_mass>0.) {nearby=smoke;velocity=other.dynamics.zw/other_mass;}
        }
    }
    vec2 coordinate=smoke_advected_coordinate(vec2(x,y)-velocity*uintBitsToFloat(params.seconds));
    if(params.bank==0u) coordinates1[index]=coordinate;else coordinates0[index]=coordinate;
    if(x<params.view_x||y<params.view_y||x>=params.view_x+params.view_width||y>=params.view_y+params.view_height) return;
    if(page==0u) return;
    bool oxygen_view=uintBitsToFloat(parameters[FR_GAS_VIEW_WORD])==1.;
    if(gate==0u&&oxygen_view&&s.geometry.y<=0.) return;
    vec3 color=unpackUnorm4x8(frame[index]).rgb;
    if(s.geometry.y>0.&&oxygen_view) {
        vec4 r=vec4(uintBitsToFloat(parameters[0]),uintBitsToFloat(parameters[1]),uintBitsToFloat(parameters[2]),uintBitsToFloat(parameters[3]));
        float molecular=dot(s.species,r)+s.dynamics.x*uintBitsToFloat(parameters[4]);
        float oxygen=molecular>0.?s.species.x*r.x/molecular:0.;
        color=mix(vec3(.72,.12,.08),vec3(.08,.65,.88),clamp(oxygen/.21,0.,1.));
    } else if(gate==0u) {
        float opacity=uintBitsToFloat(parameters[FR_GAS_OPACITY_WORD]),density=uintBitsToFloat(parameters[FR_GAS_DENSITY_WORD]);
        vec2 material=coordinate;
        vec2 curl=.5*vec2(smoke_wavelet((material+vec2(0.,1.))*FR_SMOKE_DETAIL_SCALE)-smoke_wavelet((material-vec2(0.,1.))*FR_SMOKE_DETAIL_SCALE),
            smoke_wavelet((material-vec2(1.,0.))*FR_SMOKE_DETAIL_SCALE)-smoke_wavelet((material+vec2(1.,0.))*FR_SMOKE_DETAIL_SCALE));
        float speed=length(velocity),strength=FR_SMOKE_WARP_CELLS*speed/(speed+FR_SMOKE_WARP_SPEED);
        vec4 smoke=smoke_visual_sample(vec2(x,y)-strength*curl,opacity,density);
        if(smoke.x<=0.) return;
        float detail=max(FR_SMOKE_DETAIL_MIN,1.+FR_SMOKE_DETAIL_GAIN*speed/(speed+FR_SMOKE_DETAIL_SPEED)*
            smoke_wavelet(material*FR_SMOKE_DETAIL_SCALE));
        color=mix(color,smoke.yzw/smoke.x,1.-exp(-smoke.x*detail));
    }
    if(gate!=0u) color=vec3(.62,.32,.07);
    frame[index]=packUnorm4x8(vec4(color,1.));
}
