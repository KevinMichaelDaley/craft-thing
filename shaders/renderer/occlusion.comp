#version 450
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer Inputs {uvec2 inputs[];};
struct Node {float minimum;float maximum;uint known;uint revision;};
layout(set=0,binding=1,std430) buffer Hierarchy {Node nodes[];};
layout(push_constant) uniform Params {uint width;uint height;uint destination;uint source;uint source_width;uint source_height;uint revision;} p;
void publish(uint i, Node value) {
    uint at = p.destination + i;
    if (p.revision != 1u && nodes[at].minimum == value.minimum &&
        nodes[at].maximum == value.maximum && nodes[at].known == value.known)
        return;
    nodes[at] = value;
    if (p.revision == 1u || (p.width == 1u && p.height == 1u)) return;
    uint parent_width = (p.width + 1u) / 2u;
    uint parent = (i / p.width / 2u) * parent_width + (i % p.width) / 2u;
    atomicExchange(nodes[p.destination + p.width * p.height + parent].revision, p.revision);
}
void main() {
    uint i=gl_GlobalInvocationID.x;if(i>=p.width*p.height) return;
    if(p.source_width==0u) {
        uvec2 input_cell=inputs[i];float opacity=input_cell.y==0u?1.:uintBitsToFloat(input_cell.x);
        publish(i,Node(opacity,opacity,input_cell.y,p.revision));return;
    }
    if (p.revision != 1u && nodes[p.destination+i].revision != p.revision) return;
    uvec2 low=uvec2(i%p.width,i/p.width)*2u;
    Node result=Node(1,0,1,p.revision);
    for(uint child=0u;child<4u;child++) {
        uvec2 q=low+uvec2(child%2u,child/2u);
        if(q.x>=p.source_width || q.y>=p.source_height) continue;
        Node n=nodes[p.source+q.y*p.source_width+q.x];
        result.minimum=min(result.minimum,n.minimum);result.maximum=max(result.maximum,n.maximum);result.known&=n.known;
    }
    publish(i,result);
}
