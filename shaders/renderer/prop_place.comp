#version 450
#extension GL_GOOGLE_include_directive : require
#include "texture.glsl"
#include "../../include/dungeoncraft/material_density.h"
#include "../../include/dungeoncraft/terrain_flags.h"
layout(local_size_x=128) in;
layout(set=0,binding=11,std430) buffer WaterColors {vec4 water_colors[];};
layout(set=0,binding=12,std430) buffer TerrainColors {vec4 terrain_colors[];};
layout(set=0,binding=0,std430) buffer Input {uint words[];};
layout(set=0,binding=1,std430) buffer Cells {uvec2 cells[];};
layout(set=0,binding=2,std430) readonly buffer Pages {uint pages[];};
struct Particle {int x_fp,y_fp,vx_fp,vy_fp;float f00,f01,f10,f11;uint id_lo,id_hi,mass_fp,grain_fp,material,flags;};
layout(set=0,binding=3,std430) buffer Particles {Particle particles[];};
layout(set=0,binding=4,std430) buffer Counts {uint counts[];};
layout(set=0,binding=5,std430) readonly buffer Seeds {uint seeds[];};
layout(set=0,binding=6,std430) buffer Palette {Appearance palette[];};
layout(set=0,binding=7,std430) buffer Keys {uvec2 keys[];};
layout(set=0,binding=8,std430) readonly buffer Configuration {uint configuration[];};
layout(set=0,binding=9,std430) readonly buffer Registry {uint registry[];};
layout(set=0,binding=10,std430) readonly buffer Occupancy {uint occupancy[];};
layout(push_constant) uniform Params {uint width,height,x,y,asset_width,asset_height,phase,registry_base;} p;
uint terrain(uint m) {
    return m==1u?1u:m==2u?7u:m==4u?8u:m==5u?2u:m==6u?0u:m==7u?4u:m==8u?5u:m==9u?6u:m==10u?9u:0xffffffffu;
}
bool rigid_material(uint m) {return m!=0u&&m!=3u&&m!=0xffffffffu;}
void restore_bonds(uint i,uvec2 position,uint page,uint mapped) {
    if(page==0u||!rigid_material(mapped)) return;
    uint atlas=(page-1u)*4096u+(position.y%64u)*64u+position.x%64u;
    uint flags=cells[atlas].x>>DC_CELL_FLAGS_SHIFT;
    if((cells[atlas].x&65535u)!=mapped) return;
    if((flags&(DC_CELL_LOADED_TERRAIN|DC_CELL_DIAGONAL_BONDS_READY|DC_CELL_SUPPORT_BONDS_READY))==
            (DC_CELL_LOADED_TERRAIN|DC_CELL_DIAGONAL_BONDS_READY|DC_CELL_SUPPORT_BONDS_READY)) return;
    flags|=DC_CELL_LOADED_TERRAIN;
    const ivec2 directions[8]=ivec2[8](ivec2(-1,0),ivec2(1,0),ivec2(0,-1),ivec2(0,1),
        ivec2(-1,-1),ivec2(1,-1),ivec2(-1,1),ivec2(1,1));
    uint bonds=flags&DC_CELL_ALL_BOND_MASK;
    for(uint axis=0u;axis<8u;axis++) {
        ivec2 source=ivec2(i%p.asset_width,i/p.asset_width)+directions[axis];
        if(any(lessThan(source,ivec2(0)))||any(greaterThanEqual(source,ivec2(p.asset_width,p.asset_height)))) continue;
        uint packed=words[8u+(uint(source.y)*p.asset_width+uint(source.x))*2u];
        uint original=terrain(packed&65535u);
        bool occupied=((packed>>16u)&255u)==1u&&original!=0u&&original!=0xffffffffu;
        uint bit=1u<<(axis<4u?10u+axis:axis-4u);
        if(axis>=4u&&(flags&DC_CELL_DIAGONAL_BONDS_READY)==0u)
            bonds=occupied?bonds|bit:bonds&~bit;
        else if((flags&DC_CELL_SUPPORT_BONDS_READY)==0u&&occupied) bonds|=bit;
    }
    flags=(flags&~DC_CELL_ALL_BOND_MASK)|bonds|DC_CELL_BONDS_READY|DC_CELL_DIAGONAL_BONDS_READY|DC_CELL_SUPPORT_BONDS_READY;
    cells[atlas].x=(cells[atlas].x&65535u)|(flags<<DC_CELL_FLAGS_SHIFT);
}
float scalar(uint i) {return uintBitsToFloat(words[i]);}
int canonical_cell(uint chunk,uint local) {
    uint coordinate=((chunk&16383u)*64u+local)&1048575u;
    return coordinate>=524288u?int(coordinate)-1048576:int(coordinate);
}
void main() {
    uint i=gl_GlobalInvocationID.x,count=p.asset_width*p.asset_height;
    if(i>=count) return;
    uint packed=words[8u+i*2u],material=packed&65535u,role=(packed>>16u)&255u;
    if(material==0u && role==0u) return;
    uvec2 position=uvec2(p.x+i%p.asset_width,p.y+i/p.asset_width);
    uint page=pages[(position.y/64u)*((p.width+63u)/64u)+position.x/64u];
    uint mapped=terrain(material);
    if(p.phase==2u) {if(role==1u) restore_bonds(i,position,page,mapped);return;}
    if(p.phase==0u) {
        uint failure=role!=1u||mapped==0xffffffffu?1u:page==0u?2u:occupancy[position.y*p.width+position.x]!=0u?4u:0u;
        if(failure!=0u) atomicOr(words[0],failure);
        return;
    }
    if(words[0]!=0u) return;
    uint slot=page-1u,local=(position.y%64u)*64u+position.x%64u,atlas=slot*4096u+local;
    uint first=slot*8192u+local,second=first+4096u;
    if(particles[first].mass_fp!=0u) atomicAdd(counts[slot],uint(-1));
    if(particles[second].mass_fp!=0u) atomicAdd(counts[slot],uint(-1));
    particles[first].mass_fp=0u;particles[second].mass_fp=0u;
    bool grain=mapped==2u||mapped==4u||mapped==5u||mapped==6u;
    if(grain) {
        Particle particle;
        particle.x_fp=int((position.x%64u)*65536u+32768u);particle.y_fp=int((position.y%64u)*65536u+32768u);
        particle.vx_fp=0;particle.vy_fp=0;particle.f00=1.;particle.f11=1.;particle.f01=0.;particle.f10=0.;
        particle.id_lo=local+1u;particle.id_hi=seeds[slot];
        float density=mapped==2u?1.:mapped==4u?DC_DENSITY_DIRT:
            mapped==5u?DC_DENSITY_STONE:DC_DENSITY_MORTAR;
        particle.mass_fp=uint(round(65536.*density));
        particle.grain_fp=mapped==2u?16384u:32768u;particle.material=mapped;particle.flags=0u;
        particles[first]=particle;atomicAdd(counts[slot],1u);
    }
    cells[atlas]=uvec2(mapped|(rigid_material(mapped)?DC_CELL_LOADED_TERRAIN<<DC_CELL_FLAGS_SHIFT:0u),material==6u?65536u:0u);
    uint r=p.registry_base+32u+slot*8u,style=configuration[4u+mapped];
    ivec2 rest=ivec2(canonical_cell(registry[r],position.x%64u),canonical_cell(registry[r+2u],position.y%64u));
    Appearance a=texture_sample(rest,1u,mapped,style);
    uint source=8u+count*2u+i*16u,flags=words[source+15u];
    float alpha=scalar(source+12u);
    a.color_roughness.rgb=mix(a.color_roughness.rgb,vec3(scalar(source),scalar(source+1u),scalar(source+2u)),alpha);
    terrain_colors[atlas]=mapped!=0u&&alpha>0.?vec4(a.color_roughness.rgb,1.):vec4(0);
    water_colors[atlas]=material==6u?vec4(mix(vec3(.035,.193,.666),
        vec3(scalar(source),scalar(source+1u),scalar(source+2u)),alpha),1.):vec4(0);
    if((flags&2u)!=0u) a.color_roughness.a=scalar(source+3u);
    if((flags&1u)!=0u) a.normal_relief.xyz=vec3(scalar(source+4u),scalar(source+5u),scalar(source+6u));
    if((flags&4u)!=0u) a.normal_relief.w=scalar(source+7u);
    palette[atlas]=a;keys[atlas]=uvec2(0x80000000u|mapped|(style<<16u),registry[r+4u]);
}
