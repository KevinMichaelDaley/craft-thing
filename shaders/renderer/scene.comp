#version 450
#extension GL_GOOGLE_include_directive : require
#include "../sim/rigid_body.glsl"
#include "../sim/rigid_shape.glsl"
#include "../sim/rigid_clip.glsl"
#include "texture.glsl"

layout(local_size_x=64) in;
layout(constant_id=0) const uint SCENE_PHASE=0u;
layout(set=0,binding=0,std430) readonly buffer ChunkCells {uvec2 chunk_cells[];};
layout(set=0,binding=1,std430) readonly buffer PageTable {uint pages[];};
layout(set=0,binding=2,std430) readonly buffer Occupancy {uint occupancy[];};
layout(set=0,binding=3,std430) readonly buffer Bodies {Body bodies[64];uint body_data[];};
struct Particle {int x_fp,y_fp,vx_fp,vy_fp;float f00,f01,f10,f11;uint id_lo,id_hi,mass_fp,grain_fp,material,flags;};
layout(set=0,binding=4,std430) readonly buffer Particles {Particle particles[];};
layout(set=0,binding=5,std430) buffer Palette {Appearance palette[];};
layout(set=0,binding=6,std430) buffer Keys {uvec2 keys[];};
struct Surface {vec4 albedo;vec4 nx;vec4 ny;vec4 nz;vec4 weights;};
layout(set=0,binding=7,std430) buffer Surfaces {Surface surfaces[];};
layout(set=0,binding=8,std430) buffer OpticalInput {uvec2 optical[];};
layout(set=0,binding=9,std430) buffer Work {uint work[];};
layout(set=0,binding=10,std430) readonly buffer Markers {uint markers[];};
layout(set=0,binding=11,std430) buffer Display {uint display[];};
layout(set=0,binding=12,std430) readonly buffer PreviousWater {uint previous_water[];};
struct Field {vec4 l0;vec4 lx;vec4 ly;vec4 lz;};
layout(set=0,binding=13,std430) readonly buffer Fields {Field fields[];};
layout(set=0,binding=14,std430) readonly buffer Configuration {uint configuration[];};
layout(set=0,binding=15,std430) readonly buffer WaterColors {vec4 water_colors[];};
layout(push_constant) uniform Params {uint width;uint height;uint registry;uint force_light;uint flags;uint mode;uint view_x;uint view_y;} params;
shared uint group_statistics[64];
uint group_sum(uint value) {
    uint lane=gl_LocalInvocationID.x;group_statistics[lane]=value;barrier();
    for(uint step=32u;step>0u;step>>=1u) {
        if(lane<step) group_statistics[lane]+=group_statistics[lane+step];
        barrier();
    }
    return group_statistics[0];
}

uint pixel_word_at(uint index) {return body_data[index-BODY_STORAGE_WORDS];}
#include "../sim/shape_colors.glsl"
uint map_hash(uint id) {return texture_hash(id)&4095u;}
uint body_slot(uint id) {
    uint hash=map_hash(id);
    for(uint probe=0u;probe<64u;probe++) {
        uint slot=work[128u+((hash+probe)&4095u)];
        if(slot==0u) return 64u;
        if(bodies[slot-1u].id==id) return slot-1u;
    }
    return 64u;
}
uint terrain_material(uint material) {
    return material==1u?1u:material==2u?7u:material==3u?6u:material==4u?8u:material==5u?9u:0u;
}
int canonical_cell(uint chunk,uint local) {
    uint coordinate=((chunk&16383u)*64u+local)&1048575u;
    return coordinate>=524288u?int(coordinate)-1048576:int(coordinate);
}
void add_surface(inout Surface surface,Appearance a,float coverage,float angle) {
    vec2 n=body_rotate(a.normal_relief.xy,angle);
    vec3 weighted=coverage*a.color_roughness.rgb;
    float contrast=1.-.35*a.color_roughness.a;
    surface.albedo.rgb+=weighted;
    surface.nx.rgb+=weighted*contrast*n.x;
    surface.ny.rgb+=weighted*contrast*n.y;
    surface.nz.rgb+=weighted*contrast*a.normal_relief.z;
    surface.weights.x+=coverage;
}
Surface surface_at(uint i,out float opacity,out uint known) {
    Surface surface=Surface(vec4(0),vec4(0),vec4(0),vec4(0),vec4(0));
    uvec2 cell=uvec2(i%params.width,i/params.width);
    uint page=pages[(cell.y/64u)*((params.width+63u)/64u)+cell.x/64u];
    known=page==0u?0u:1u;opacity=known==0u?1.:0.;
    surface.weights.w=float(known);
    if(known==0u) return surface;
    uint local=(cell.y%64u)*64u+cell.x%64u,atlas=(page-1u)*4096u+local;
    uvec2 physical=chunk_cells[atlas];uint material=physical.x&65535u;
    float body_coverage=0.;uint id=occupancy[i],slot=id==0u?64u:body_slot(id);
    if(slot<64u) {
        Body body=bodies[slot];
        vec2 relative=vec2(cell)-vec2(body.x_fp,body.y_fp)/65536.;
        uvec4 query=body_piece_query(body,relative,relative+1.);
        for(uint ordinal=0u;ordinal<query.z*query.w;ordinal++) {
            uint piece=query_piece(body,query,ordinal);vec2 center_point;
            float coverage=body_cell_volume(body,piece,ivec2(cell),1.,center_point);
            if(coverage<=0.) continue;
            ivec2 rest=pixel_body(body)?pixel_piece_cell(body,piece):ivec2(floor(body_local_point(body,center_point-vec2(body.x_fp,body.y_fp)/65536.)));
            uint mapped_material=terrain_material(piece_material(body,piece));
            Appearance a=texture_sample(rest,body.id,mapped_material,mapped_material<=10u?configuration[4u+mapped_material]:0u);
            if(pixel_body(body)) {
                uint word=body.compound_reserved+pixel_tile_offset(body,piece/256u)+1u+(piece%256u)/8u;
                vec4 color=shape_color_get(word,piece%8u);
                if(color.w>0.) a.color_roughness.rgb=color.rgb;
            }
            add_surface(surface,a,coverage,body.angle);body_coverage+=coverage;
        }
    }
    body_coverage=min(body_coverage,1.);
    float water=min(float(physical.y)/65536.,1.);
    if((params.flags>>8)<65535u) water=mix(min(float(previous_water[i])/65536.,1.),water,float(params.flags>>8)/65535.);
    float remaining=(1.-body_coverage)*(1.-water),solid=0.;
    if(material==2u || material==4u || material==5u || material==6u || material==10u) {
        uint first=(page-1u)*8192u+local;float mass=0.;
        for(uint layer=0u;layer<2u;layer++) mass+=float(particles[first+4096u*layer].mass_fp)/65536.;
        if(mass>0.) {
            solid=min(mass,1.);
            for(uint layer=0u;layer<2u;layer++) {
                Particle p=particles[first+4096u*layer];if(p.mass_fp==0u) continue;
                Appearance a=palette[atlas];
                if((p.flags&0x80ffffffu)!=0u) a.color_roughness.rgb*=.6;
                add_surface(surface,a,remaining*solid*float(p.mass_fp)/65536./mass,0.);
            }
        } else {solid=1.;add_surface(surface,palette[atlas],remaining,0.);}
    } else if(material!=0u && material!=3u) {
        solid=1.;add_surface(surface,palette[atlas],remaining,0.);
    }
    surface.weights.y=(1.-body_coverage)*water;
    if(water>0.) {
        vec3 color=water_colors[atlas].w>0.?water_colors[atlas].rgb:vec3(.035,.193,.666);
        Appearance a=Appearance(vec4(color,.1),vec4(0,0,1,0));
        add_surface(surface,a,surface.weights.y,0.);
        surface.weights.y=0.;
    }
    surface.weights.z=max(0.,1.-surface.weights.x-surface.weights.y);
    opacity=body_coverage>0. || solid>0.?1.:water*.08;
    return surface;
}
uint pack_display(vec3 linear,bool lit) {
    linear=max(linear,vec3(0));if(lit) linear=linear/(1.+linear);
    vec3 srgb=mix(12.92*linear,1.055*pow(linear,vec3(1./2.4))-.055,greaterThan(linear,vec3(.0031308)));
    uvec3 rgb=uvec3(round(clamp(srgb,vec3(0),vec3(1))*255.));
    return 0xff000000u|(rgb.z<<16)|(rgb.y<<8)|rgb.x;
}
void main() {
    uint i=gl_GlobalInvocationID.x;
    if(SCENE_PHASE==0u) {
        if(i<4096u) work[128u+i]=0u;
        if(i==0u) {work[0]=0u;work[1]=0u;work[2]=1u;work[3]=1u;work[4]=0u;work[5]=0u;}
        return;
    }
    if(SCENE_PHASE==1u) {
        if(i>=64u || bodies[i].enabled==0u || bodies[i].id==0u) return;
        uint hash=map_hash(bodies[i].id);
        for(uint probe=0u;probe<64u;probe++)
            if(atomicCompSwap(work[128u+((hash+probe)&4095u)],0u,i+1u)==0u) break;
        return;
    }
    if(SCENE_PHASE==2u) {
        uint generated=0u;
        if(i<body_data[params.registry+1u]*4096u) {
            uint registry=params.registry+32u+(i/4096u)*8u;
            if(body_data[registry+5u]!=0u) {
                uint generation=body_data[registry+4u],material=chunk_cells[i].x&65535u;
                uint style=material<=10u?configuration[4u+material]:0u,key=material|(style<<16);
                if(uvec2(keys[i].x&0x7fffffffu,keys[i].y)!=uvec2(key,generation)) {
                    ivec2 rest=ivec2(canonical_cell(body_data[registry],i%64u),canonical_cell(body_data[registry+2u],(i%4096u)/64u));
                    palette[i]=texture_sample(rest,1u,material,style);keys[i]=uvec2(key,generation);
                    generated=material!=0u && material!=3u?1u:0u;
                }
                if(terrain_colors[i].w>0.) palette[i].color_roughness.rgb=terrain_colors[i].rgb;
            }
        }
        uint count=group_sum(generated);
        if(gl_LocalInvocationID.x==0u && count!=0u) atomicAdd(work[4],count);
        return;
    }
    if(SCENE_PHASE==3u) {
        uint changed=0u;
        if(i<params.width*params.height) {
            float opacity;uint known;surfaces[i]=surface_at(i,opacity,known);
            uvec2 value=uvec2(floatBitsToUint(opacity),known);
            changed=any(notEqual(optical[i],value))?1u:0u;optical[i]=value;
        }
        uint count=group_sum(changed);
        if(gl_LocalInvocationID.x==0u && count!=0u) {atomicOr(work[0],1u);atomicAdd(work[5],count);}
        return;
    }
    if(SCENE_PHASE==4u) {
        uint levels=max(params.width,params.height)==1u?1u:uint(findMSB(max(params.width,params.height)-1u))+2u;
        if(i<levels) {
            uint scale=1u<<i,w=(params.width+scale-1u)/scale,h=(params.height+scale-1u)/scale;
            work[8u+3u*i]=work[0]!=0u?(w*h+63u)/64u:0u;work[9u+3u*i]=1u;work[10u+3u*i]=1u;
        }
        if(i==0u) work[1]=(work[0]!=0u || work[6]!=params.force_light)?(params.width*params.height+7u)/8u:0u;
        return;
    }
    uint view_width=configuration[0],view_height=configuration[1];
    if(i>=view_width*view_height) return;
    uvec2 cell=uvec2(i%view_width+params.view_x,i/view_width+params.view_y);
    uint index=cell.y*params.width+cell.x;Surface surface=surfaces[index];
    if(surface.weights.w==0.) {display[index]=0xffff00ffu;return;}
    vec3 color=surface.albedo.rgb;bool lit=params.mode==0u;
    if(lit) {
        Field field=fields[index];
        color=max(vec3(0),.5*(surface.albedo.rgb*field.l0.rgb+surface.nx.rgb*field.lx.rgb+surface.ny.rgb*field.ly.rgb+surface.nz.rgb*field.lz.rgb));
        color+=surface.albedo.rgb*.18;
    }
    color+=surface.weights.y*vec3(.035,.193,.666)+surface.weights.z*vec3(.00886);
    uint packed=pack_display(color,lit);
    if((params.flags&1u)!=0u) {
        uint page=pages[(cell.y/64u)*((params.width+63u)/64u)+cell.x/64u];
        uint guide=markers[(page-1u)*4096u+(cell.y%64u)*64u+cell.x%64u];
        if((guide&1u)!=0u) packed=0xffd040e0u;else if((guide&2u)!=0u) packed=0xff40e0d0u;
    }
    display[index]=packed;
    if(i==0u && lit) work[6]=params.force_light;
}
