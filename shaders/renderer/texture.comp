#version 450
#extension GL_GOOGLE_include_directive : require
#include "texture.glsl"
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer Owners {uvec4 owners[];};
layout(set=0,binding=1,std430) buffer Colors {Appearance appearance[];};
layout(push_constant) uniform Params {uint count;} params;
void main() {
    uint i=gl_GlobalInvocationID.x;if(i>=params.count) return;
    uvec4 o=owners[i];
    appearance[i]=texture_sample(ivec2(o.xy),o.z,o.w&255u,o.w>>8);
}
