#version 460
#extension GL_GOOGLE_include_directive : require
#include "../gas/acoustic.glsl"
#include "../gas/vorticity.glsl"

layout(set=0,binding=24,std430) writeonly buffer Impulses {vec2 impulses[];};

void main() {
    uint index=gas_index();
    if(index>=params.width*params.height) return;
    ivec2 p=ivec2(int(index%params.width),int(index/params.width));
    impulses[index]=vec2(0.);
    if(gas_finishes_tile(gas_activity_tile(p))&&gas_cached(p).metric.z>0.)
        impulses[index]=gas_subgrid_momentum(p,uintBitsToFloat(params.seconds));
}
