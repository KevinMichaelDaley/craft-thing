#version 460
#extension GL_GOOGLE_include_directive : require
void flag_update(uint value);
#define FR_GAS_FLAGS_UPDATE(value) flag_update(value)
#include "../gas/storage.glsl"
void flag_update(uint value) {atomicOr(stats[FR_GAS_REJECT_STAGE_WORD],value);atomicAdd(stats[10],1u);}
void main() {
    uint lane=gl_LocalInvocationIndex;
    gas_report_repair_flags(lane<57u?1u<<(lane%4u):0u);
    if(lane%3u==0u) gas_report_repair_flags(32u);
    gas_report_repair_flags(0u);
    if(lane==0u) stats[11]=gl_NumSubgroups;
}
