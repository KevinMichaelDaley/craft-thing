#version 460
#extension GL_GOOGLE_include_directive : require
#define FR_GAS_LOCAL_SIZE 32
#include "acoustic.glsl"
void main() {
    uint tile=active_tiles[gl_WorkGroupID.x],lane=gl_LocalInvocationIndex,tiles_x=(params.width+7u)/8u;
    uint row=lane/4u,color=(params.bank>>1u)&1u;
    uvec2 p=uvec2(tile%tiles_x,tile/tiles_x)*8u+uvec2(2u*(lane%4u)+((row+color)&1u),row);
    if(p.x>=params.width||p.y>=params.height) return;
    uint index=p.y*params.width+p.x;
    vec4 data=correction_data[index];float rhs=data.x;vec4 coefficients=stencil[index];
    if(data.y<=0.) return;
    for(uint d=0u;d<4u;d++) {
        if(coefficients[d]==0.) continue;
        uint j=d==0u?index+1u:(d==1u?index-1u:(d==2u?index+params.width:index-params.width));
        rhs+=coefficients[d]*correction[j];
    }
    float relaxation=(params.bank&FR_GAS_MG_BOUNDARY_BIT)!=0u?1.5:data.z;
    correction[index]+=relaxation*(rhs*data.y-correction[index]);
}
