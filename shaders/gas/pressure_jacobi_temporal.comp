#version 460
#extension GL_GOOGLE_include_directive : require
#define FR_GAS_CUSTOM_LOCAL_SIZE 1
#define FR_GAS_FORCE_PRACTICAL 1
#include "acoustic.glsl"
layout(local_size_x=256) in;
layout(set=0,binding=24,std430) restrict buffer JacobiWork {uint jacobi_words[];};
shared float values[256];
float source_value(uint at) {
    return (params.bank&FR_GAS_TEMPORAL_SOURCE_BIT)!=0u?uintBitsToFloat(jacobi_words[at]):correction[at];
}
void main() {
    uint tile=active_tiles[gl_WorkGroupID.x],width=(params.width+7u)/8u,lane=gl_LocalInvocationIndex;
    ivec2 origin=ivec2(int(tile%width),int(tile/width))*8-4,p=origin+ivec2(lane%16u,lane/16u);
    bool inside=all(greaterThanEqual(p,ivec2(0)))&&all(lessThan(p,ivec2(params.width,params.height)));
    uint at=inside?uint(p.y)*params.width+uint(p.x):0u;
    values[lane]=inside?source_value(at):0.;vec4 weights=vec4(0);vec2 row=vec2(0);bool awake=false;
    if(inside) {
        uint own_tile=(uint(p.y)/8u)*width+uint(p.x)/8u;
        awake=(activity[gas_tile_count()+own_tile]&FR_GAS_SOLVE_TILE_BIT)!=0u;
        if(awake) {
            if((params.bank&FR_GAS_HALF_PRESSURE_BIT)!=0u) {
                uint base=16u*params.width*params.height+at*4u;
                float inverse=uintBitsToFloat(jacobi_words[base+3u]);
                if(inverse>=0.) {weights=vec4(unpackHalf2x16(jacobi_words[base]),unpackHalf2x16(jacobi_words[base+1u]));row=vec2(uintBitsToFloat(jacobi_words[base+2u]),inverse);}
                else {weights=stencil[at];row=correction_data[at].xy;}
            } else {weights=stencil[at];row=correction_data[at].xy;}
        }
    }
    barrier();uint x=lane%16u,y=lane/16u;
    for(uint stage=0u;stage<4u;stage++) {
        uint margin=stage+1u;float next=values[lane];
        if(awake&&row.y>0.&&x>=margin&&x<16u-margin&&y>=margin&&y<16u-margin) {
            float rhs=row.x;
            for(uint d=0u;d<4u;d++) if(weights[d]!=0.) {
                uint neighbor=d==0u?lane+1u:(d==1u?lane-1u:(d==2u?lane+16u:lane-16u));
                rhs+=weights[d]*values[neighbor];
            }
            next+=(2./3.)*(rhs*row.y-next);
        }
        barrier();values[lane]=next;barrier();
    }
    if(inside&&x>=4u&&x<12u&&y>=4u&&y<12u) {
        if((params.bank&FR_GAS_TEMPORAL_SOURCE_BIT)!=0u) correction[at]=values[lane];
        else jacobi_words[at]=floatBitsToUint(values[lane]);
    }
}
