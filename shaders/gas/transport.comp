#version 460
#extension GL_GOOGLE_include_directive : require
#include "storage.glsl"
GasFlux gas_flux_sum(GasFlux a,GasFlux b,GasFlux c,GasFlux d) {
    return GasFlux(((a.species-b.species)+c.species)-d.species,
        ((a.dynamics-b.dynamics)+c.dynamics)-d.dynamics,
        ((a.pigment-b.pigment)+c.pigment)-d.pigment);
}
float gas_lower_wall(Primitive p,uint axis) {
    float u=p.hydro[axis+1u];
    return (p.hydro.w+p.hydro.x*u*(u-abs(u)-p.metric.x))*p.metric.w;
}
void main() {
