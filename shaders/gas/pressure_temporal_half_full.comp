#version 460
#extension GL_GOOGLE_include_directive : require
#define FR_GAS_LOCAL_SIZE 256
#define FR_GAS_FORCE_PRACTICAL 1
#include "acoustic.glsl"
layout(set=0,binding=24,std430) restrict buffer TemporalWork {uvec4 half_work[];};
shared float values[256];
float source_value(uint at) {return (params.bank&FR_GAS_TEMPORAL_SOURCE_BIT)!=0u?uintBitsToFloat(half_work[at/4u][at%4u]):correction[at];}
void main() {
    uint tile=active_tiles[gl_WorkGroupID.x],width=(params.width+7u)/8u,lane=gl_LocalInvocationIndex;
    ivec2 origin=ivec2(int(tile%width),int(tile/width))*8-4,p=origin+ivec2(lane%16u,lane/16u);
    bool inside=all(greaterThanEqual(p,ivec2(0)))&&all(lessThan(p,ivec2(params.width,params.height)));
    uint at=inside?uint(p.y)*params.width+uint(p.x):0u,x=lane%16u,y=lane/16u,color=(x+y)&1u;
    values[lane]=inside?source_value(at):0.;vec4 weights=vec4(0),data=vec4(0);bool awake=false;
    uint margin=color+1u;
    if(inside&&x>=margin&&x<16u-margin&&y>=margin&&y<16u-margin) {
        uint own_tile=(uint(p.y)/8u)*width+uint(p.x)/8u;
        awake=(activity[gas_tile_count()+own_tile]&FR_GAS_SOLVE_TILE_BIT)!=0u;
        if(awake) {
            uvec4 encoded=half_work[4u*params.width*params.height+at];float inverse=uintBitsToFloat(encoded.w);
            if(inverse<0.) {weights=stencil[at];data=correction_data[at];}
            else {weights=vec4(unpackHalf2x16(encoded.x),unpackHalf2x16(encoded.y));data=vec4(uintBitsToFloat(encoded.z),inverse,1.8,0);}
        }
    }
    if(gl_WorkGroupID.x==0u&&lane==0u) atomicOr(stats[15],16u);
    barrier();
    for(uint phase=0u;phase<4u;phase++) {
        uint phase_margin=phase+1u;
        if(color==(phase&1u)&&awake&&data.y>0.&&x>=phase_margin&&x<16u-phase_margin&&y>=phase_margin&&y<16u-phase_margin) {
            float rhs=data.x;
            for(uint d=0u;d<4u;d++) if(weights[d]!=0.) {
                uint neighbor=d==0u?lane+1u:(d==1u?lane-1u:(d==2u?lane+16u:lane-16u));
                rhs+=weights[d]*values[neighbor];
            }
            float relaxation=(params.bank&FR_GAS_MG_BOUNDARY_BIT)!=0u?1.5:data.z;
            values[lane]+=relaxation*(rhs*data.y-values[lane]);
        }
        barrier();
    }
    if(inside&&x>=4u&&x<12u&&y>=4u&&y<12u) {
        if((params.bank&FR_GAS_TEMPORAL_SOURCE_BIT)!=0u) correction[at]=values[lane];
        else half_work[at/4u][at%4u]=floatBitsToUint(values[lane]);
    }
}
