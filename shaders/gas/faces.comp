#version 460
#extension GL_GOOGLE_include_directive : require
#include "storage.glsl"
#include "riemann.glsl"
void main() {
    uint at=gas_index(),count=params.width*params.height;if(at>=2u*count) return;
    uint axis=at/count,index=at%count;
    ivec2 p=ivec2(int(index%params.width),int(index/params.width));
    faces[at]=gas_face(p,p+(axis==0u?ivec2(1,0):ivec2(0,1)),axis);
}
