#version 460
#extension GL_GOOGLE_include_directive : require
#include "storage.glsl"
#include "../../include/dungeoncraft/terrain_flags.h"
void main() {
    uint index=gas_index();if(index>=params.width*params.height) return;
    ivec2 p=ivec2(int(index%params.width),int(index/params.width));uint atlas=gas_atlas(p);if(atlas==0xffffffffu) return;
    uint packed=cells[atlas].x,material=packed&65535u;
    bool fixed_solid=material!=0u&&material!=3u&&((packed&(DC_CELL_LOADED_TERRAIN<<DC_CELL_FLAGS_SHIFT))!=0u||
        material==1u||material==6u||material==7u||material==8u||material==9u);
    float volume=fixed_solid?0.:max(0.,1.-float(min(65536u,occupancy[2u*params.width*params.height+index]))/65536.-
        clamp(mpm[index].w,0.,1.)-float(cells[atlas].y)/65536.);
    Gas s=gas_empty();s.geometry.xy=vec2(volume);
    if(volume>0.) {
        float fraction=gas_parameter(FR_GAS_OXYGEN_WORD);
        float oxygen=(fraction/gas_parameter(0u))/(fraction/gas_parameter(0u)+(1.-fraction)/gas_parameter(1u));
        float mass=gas_parameter(FR_GAS_DENSITY_WORD)*volume;s.species.x=mass*oxygen;s.species.y=mass-s.species.x;
        float capacity=s.species.x*gas_parameter(5u)+s.species.y*gas_parameter(6u);
        s.dynamics.y=capacity*gas_parameter(FR_GAS_AMBIENT_WORD);
    }
    world[atlas]=s;
}
