#version 460
#extension GL_GOOGLE_include_directive : require
#include "acoustic.glsl"
void main() {
    uint tile=gas_index(),width=(params.width+7u)/8u,height=(params.height+7u)/8u;
    if(tile>=width*height) return;
    ivec2 p=ivec2(int(tile%width),int(tile/width));bool needed=false;
    for(int y=-1;y<=1;y++) for(int x=-1;x<=1;x++) {
        ivec2 q=p+ivec2(x,y);
        if(all(greaterThanEqual(q,ivec2(0)))&&all(lessThan(q,ivec2(width,height)))&&activity[uint(q.y)*width+uint(q.x)]!=0u) needed=true;
    }
    activity[width*height+tile]=needed?3u:0u;
    if(needed) {uint slot=atomicAdd(indirect[8],1u);active_tiles[2u*width*height+slot]=tile;}
}
