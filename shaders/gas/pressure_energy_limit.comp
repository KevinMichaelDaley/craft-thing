#version 460
#extension GL_GOOGLE_include_directive : require
#include "acoustic.glsl"
void main() {
    uint index=gas_sparse_index(3u);if(index>=params.width*params.height) return;
    ivec2 p=ivec2(int(index%params.width),int(index/params.width));uint atlas=gas_atlas(p);
    float limit=1.;
    if(atlas!=0xffffffffu) {
        bool advected=gas_advected(index);Primitive center=gas_cached(p);
        Gas value=advected?gas_provisional(atlas):gas_source(p);
        vec4 own=advected?provisional[index]:vec4(center.hydro.yz*center.metric.z,0.,center.metric.w);
        float dt=uintBitsToFloat(params.seconds),volume=value.geometry.x,outgoing=0.;
        if(volume>0.) for(uint d=0u;d<4u;d++) {
            uint j=0u;if(!gas_neighbor(p,d,j)) continue;Primitive other=gas_cached(p+gas_direction(d));
            vec4 neighbor=gas_advected(j)?provisional[j]:vec4(other.hydro.yz*other.metric.z,0.,other.metric.w);
            float area=min(volume,neighbor.w),enthalpy=matrix[index][d]/area;
            float difference=((other.hydro.w-center.hydro.w)+(pressure[j].x-pressure[index].x))+(acoustic[j].z-acoustic[index].z);
            float sign=(d&1u)==0u?-1.:1.;
            float q=.5*(own[d/2u]/volume+neighbor[d/2u]/neighbor.w)*area+sign*dt*area*difference;
            outgoing+=max(0.,-sign*dt*enthalpy*q);
        }
        GasFlux remove=gas_empty_flux();remove.dynamics.y=-own.z;value=gas_add_flux(value,remove,1.);
        float available=max(0.,gas_energy(value))*.95;
        if(outgoing>available&&outgoing>0.) {limit=available/outgoing;atomicOr(stats[FR_GAS_REJECT_STAGE_WORD],FR_GAS_LIMITED_PRESSURE_ENERGY);}
    }
    correction_data[index].w=limit;
}
