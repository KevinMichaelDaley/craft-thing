#version 460
#extension GL_GOOGLE_include_directive : require
#include "acoustic.glsl"
#include "group_mask.glsl"
void main() {
    uint lane=gl_LocalInvocationIndex,local_needed=0u;
    uint width=(params.width+7u)/8u;
    uint tile=(params.bank&1024u)!=0u?active_tiles[3u*gas_tile_count()+gl_WorkGroupID.x]:gl_WorkGroupID.y*width+gl_WorkGroupID.x;
    uvec2 p=uvec2(tile%width,tile/width)*8u+uvec2(lane%8u,lane/8u);
    if(p.x<params.width&&p.y<params.height) {
        uint at=p.y*params.width+p.x;
        if((params.bank&FR_GAS_SKIP_EMPTY_PRESSURE_BIT)!=0u&&gas_cached(ivec2(p)).metric.w>0.) local_needed|=2u;
        float tolerance=(params.bank&FR_GAS_MULTIGRID_BIT)!=0u?1e-3:1e-7;
        if(correction_data[at].y>0.&&abs(correction_data[at].x)/pressure[at].w>tolerance) local_needed|=1u;
    }
    uint needed=gas_group_mask(local_needed);if(lane==0u) active_mask[tile]=needed;
}
