#version 460
#extension GL_GOOGLE_include_directive : require
#include "acoustic.glsl"
shared vec4 equations[2048];
shared uint active_line;
float line_source(uint index,uint axis) {return axis==0u?correction[index]:line_data[index].y;}
void main() {
    if(indirect[0]==0u) return;
    uint axis=(params.bank>>3u)&1u,length=axis==0u?params.width:params.height;
    uint lane=gl_LocalInvocationIndex,line=gl_WorkGroupID.x;
    if(lane==0u) active_line=0u;barrier();
    float minimum=.5*uintBitsToFloat(stats[FR_GAS_CAPACITY_MIN_WORD]);
    float maximum=uintBitsToFloat(stats[FR_GAS_MATRIX_MAX_WORD]);
    float exponent=(float((params.bank>>4u)&3u)+.5)*.25;
    float shift=minimum*pow(max(maximum/minimum,1.),exponent);
    for(uint cell=lane;cell<length;cell+=64u) {
        uint index=axis==0u?line*params.width+cell:cell*params.width+line;
        vec4 edges=stencil[index],data=correction_data[index],row=vec4(0,1,0,0);
        if(data.y>0.) {
            float horizontal=.5*line_data[index].x+edges.x+edges.y;
            float vertical=.5*line_data[index].x+edges.z+edges.w;
            float own=axis==0u?horizontal:vertical,other=axis==0u?vertical:horizontal;
            float rhs=data.x+(shift-other)*line_source(index,axis);
            uint first=axis==0u?2u:0u;
            for(uint d=first;d<first+2u;d++) if(edges[d]!=0.) {
                uint j=d==0u?index+1u:(d==1u?index-1u:(d==2u?index+params.width:index-params.width));
                rhs+=edges[d]*line_source(j,axis);
            }
            row=vec4(-edges[axis==0u?1u:3u],shift+own,-edges[axis==0u?0u:2u],rhs);
        }
        equations[cell]=row;
        if(row.w!=0.) atomicOr(active_line,1u);
    }
    barrier();
    if(active_line==0u) {
        for(uint cell=lane;cell<length;cell+=64u) {
            uint index=axis==0u?line*params.width+cell:cell*params.width+line;
            if(axis==0u) line_data[index].y=0.;else correction[index]=0.;
        }
        return;
    }
    uint bank=0u;
    for(uint stride=1u;stride<length;stride*=2u) {
        for(uint cell=lane;cell<length;cell+=64u) {
            vec4 own=equations[bank+cell];
            vec4 left=cell>=stride?equations[bank+cell-stride]:vec4(0,1,0,0);
            vec4 right=cell+stride<length?equations[bank+cell+stride]:vec4(0,1,0,0);
            float a=-own.x/left.y,b=-own.z/right.y;
            equations[(bank^1024u)+cell]=vec4(a*left.x,own.y+a*left.z+b*right.x,b*right.z,own.w+a*left.w+b*right.w);
        }
        barrier();bank^=1024u;
    }
    for(uint cell=lane;cell<length;cell+=64u) {
        uint index=axis==0u?line*params.width+cell:cell*params.width+line;
        float value=equations[bank+cell].w/equations[bank+cell].y;
        if(axis==0u) line_data[index].y=value;else correction[index]=value;
    }
}
