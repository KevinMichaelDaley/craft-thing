#version 450
#extension GL_GOOGLE_include_directive : require
#include "rigid_body.glsl"
#include "rigid_shape.glsl"
#include "rigid_clip.glsl"
layout(local_size_x = 16, local_size_y = 16) in;
layout(constant_id = 0) const uint RIGID_RASTER_STAGE = 0u;
const uint RASTER_MODE=1u, PREPARE_MODE=2u, PHYSICAL_MASK=128u, MODE_MASK=127u;
shared uint raster_ids[BODY_CAPACITY];
shared uint raster_count;

layout(set = 0, binding = 1, std430) readonly buffer ChunkCells { uvec2 chunk_cells[]; };
layout(set = 0, binding = 2, std430) readonly buffer PageTable { uint pages[]; };
layout(set = 0, binding = 3, std430) buffer Occupancy { uint occupancy[]; };

layout(set = 0, binding = 4, std430) buffer Bodies { Body bodies[BODY_CAPACITY]; uint data[]; };
uint pixel_word_at(uint index) {return data[index-BODY_STORAGE_WORDS];}
layout(push_constant) uniform Params {
    uint width;
    uint height;
    uint mode;
    uint body_count;
    uvec2 origin_x;
    uvec2 origin_y;
} params;

bool locate_body(inout Body body) {
    ivec2 old_position=ivec2(body.x_fp,body.y_fp);
    int x = 0, y = 0;
    bool nearby = relative_chunk(body.chunk_x, params.origin_x, x) &&
                  relative_chunk(body.chunk_y, params.origin_y, y);
    nearby = nearby && x >= -1 && y >= -1 &&
        x < int((params.width + 63u) / 64u) && y < int((params.height + 63u) / 64u);
    body.x_fp = nearby ? x * (64 << 16) + body.local_fp.x : -(16 << 16);
    body.y_fp = nearby ? y * (64 << 16) + body.local_fp.y : -(16 << 16);
    if(body.rest_ticks!=0u) {
        if(nearby && body.visible!=0u)
            body.rest_position+=ivec2(body.x_fp,body.y_fp)-old_position;
        else body.rest_ticks=0u;
    }
    vec2 low,high; body_bounds(body,low,high);
    vec2 position = vec2(body.x_fp,body.y_fp)/65536.0;
    body.visible = uint(nearby && all(lessThan(position+low,vec2(params.width,params.height))) &&
        all(greaterThan(position+high,vec2(0))));
    body.previous_x_fp = body.x_fp;
    body.previous_y_fp = body.y_fp;
    body.previous_angle = body.angle;
    return body.visible != 0u;
}

bool resident_at(int x, int y) {
    if (x < 0 || y < 0 || x >= int(params.width) || y >= int(params.height)) return false;
    uint page_width = (params.width + 63u) / 64u;
    return pages[(uint(y) / 64u) * page_width + uint(x) / 64u] != 0u;
}

bool solid_at(int x, int y) {
    if (x < 0 || x >= int(params.width) || y >= int(params.height)) return true;
    if (y < 0) return false;
    uint page_width = (params.width + 63u) / 64u;
    uint page = pages[(uint(y) / 64u) * page_width + uint(x) / 64u];
    if (page == 0u) return true;
    uint index = (page - 1u) * 4096u + (uint(y) % 64u) * 64u + uint(x) % 64u;
    return (chunk_cells[index].x & 0xffffu) != 0u;
}

void integrate_body(uint index) {
    Body body = bodies[index];
    if (body.enabled == 0u) {
        if(body.reserved0!=0u&&pixel_body(body)&&body.motion_ready!=0u) {
            body_properties(body);bodies[index]=body;
        }
        return;
    }
    body_properties(body);
    bool visible = locate_body(body);
    body_cache_bounds(body);
    if (!visible || params.mode == PREPARE_MODE ||
        !resident_at(clamp(body.x_fp >> 16, 0, int(params.width) - 1),
                     clamp(body.y_fp >> 16, 0, int(params.height) - 1))) {
        bodies[index] = body;
        return;
    }
    int vx = clamp(body.vx_fp, -(4 << 16), 4 << 16);
    int next_x = body.x_fp + vx;
    int x = next_x >> 16;
    int top = body.y_fp >> 16;
    bool supported = false;
    for (uint col = 0u; body.vertex_count == 0u && col < body.width; ++col)
        supported = supported || solid_at(x + int(col), top + int(body.height));
    int vy = clamp(body.vy_fp, -(4 << 16), 4 << 16);
    int next_y = body.y_fp;
    if (supported && vy >= 0 && body.vertex_count == 0u) {
        next_y = top << 16;
        vy = 0;
    } else {
        vy = min(vy + 16384, 4 << 16);
        next_y += vy;
        int old_bottom = top + int(body.height) - 1;
        int new_bottom = (next_y >> 16) + int(body.height) - 1;
        bool hit = false;
        for (int row = old_bottom + 1; body.vertex_count == 0u && row <= new_bottom && !hit; ++row) {
            for (uint col = 0u; col < body.width; ++col) {
                if (solid_at(x + int(col), row)) { hit = true; break; }
            }
            if (hit) { next_y = (row - int(body.height)) << 16; vy = 0; }
        }
    }
    uvec2 anchor_x, anchor_y;
    if (!shifted_chunk(params.origin_x, next_x >> 22, anchor_x)) {
        next_x = body.x_fp; vx = 0; anchor_x = body.chunk_x;
    }
    if (!shifted_chunk(params.origin_y, next_y >> 22, anchor_y)) {
        next_y = body.y_fp; vy = 0; anchor_y = body.chunk_y;
    }
    body.chunk_x = anchor_x;
    body.chunk_y = anchor_y;
    body.local_fp = ivec2(next_x, next_y) & ivec2((64 << 16) - 1);
    body.x_fp = next_x;
    body.y_fp = next_y;
    body.vx_fp = vx;
    body.vy_fp = vy;
    body_cache_bounds(body);
    bodies[index] = body;
}

void main() {
    uvec2 p = gl_GlobalInvocationID.xy;
    if (RIGID_RASTER_STAGE == 2u) return;
    if (RIGID_RASTER_STAGE == 0u) {
        uint index = gl_LocalInvocationIndex;
        if (index < params.body_count) integrate_body(index);
        return;
    }
    if (gl_LocalInvocationIndex == 0u) {
        /* Preserve slot order and conservatively include swept cells and faces. */
        raster_count = 0u;
        ivec2 tile_low = ivec2(gl_WorkGroupID.xy * gl_WorkGroupSize.xy);
        ivec2 tile_high = tile_low + ivec2(gl_WorkGroupSize.xy);
        for (uint i = 0u; i < params.body_count; ++i) {
            if (bodies[i].enabled == 0u || bodies[i].visible == 0u) continue;
            ivec2 low = min(bodies[i].bounds_low - ivec2(1), bodies[i].swept_low);
            ivec2 high = max(bodies[i].bounds_high, bodies[i].swept_high);
            if (all(lessThan(tile_low, high)) && all(greaterThan(tile_high, low)))
                raster_ids[raster_count++] = i;
        }
    }
    barrier();
    if (p.x >= params.width || p.y >= params.height) return;
    uint current = 0u, swept = 0u;float volume=0;vec2 face_covered=vec2(0);
    for (uint ordinal_id = 0u; ordinal_id < raster_count; ++ordinal_id) {
        uint i = raster_ids[ordinal_id];
        ivec2 cell = ivec2(p);
        bool potential = all(greaterThanEqual(cell,bodies[i].bounds_low)) &&
                         all(lessThan(cell,bodies[i].bounds_high));
        bool face_potential=all(greaterThanEqual(cell+ivec2(1),bodies[i].bounds_low)) &&
                            all(lessThan(cell,bodies[i].bounds_high));
        bool crossed = all(greaterThanEqual(cell,bodies[i].swept_low)) &&
                       all(lessThan(cell,bodies[i].swept_high));
        if (!potential && !crossed && !face_potential) continue;
        Body body = bodies[i];
        ivec2 origin = ivec2(body.x_fp, body.y_fp) >> 16;
        ivec2 extent = ivec2(body.width, body.height);
        bool inside = all(greaterThanEqual(cell, origin)) &&
                      all(lessThan(cell, origin + extent));
        if (pixel_body(body) || body.vertex_count != 0u || body.angle != 0.0 || (params.mode & PHYSICAL_MASK) != 0u)
            inside = potential && convex_cell_overlap(body,cell);
        if ((params.mode & PHYSICAL_MASK) != 0u) crossed = crossed || potential;
        if (inside && (current == 0u || body.id < current)) current = body.id;
        vec2 query_low=vec2(cell)-vec2(body.x_fp,body.y_fp)/65536.;
        uvec4 query=body_piece_query(body,query_low,query_low+1);
        if (inside) for(uint ordinal=0u;ordinal<query.z*query.w;ordinal++) {
            uint piece=query_piece(body,query,ordinal);
            vec2 center_point;volume+=body_cell_volume(body,piece,cell,1,center_point);
        }
        if(face_potential) for(uint ordinal=0u;ordinal<query.z*query.w;ordinal++) {
            uint piece=query_piece(body,query,ordinal);
            face_covered.x+=body_face_coverage(body,piece,vec2(cell)+vec2(1,0),vec2(cell)+1);
            face_covered.y+=body_face_coverage(body,piece,vec2(cell)+vec2(0,1),vec2(cell)+1);
        }
        if (crossed && (swept == 0u || body.id < swept)) swept = body.id;
    }
    uint index = p.y * params.width + p.x;
    if (!resident_at(int(p.x), int(p.y))) { current = 0u; swept = 0u; volume=0; face_covered=vec2(0); }
    occupancy[index] = current;
    occupancy[params.width * params.height + index] = swept;
    occupancy[2u * params.width * params.height + index] = uint(round(clamp(volume,0,1)*65536.0));
    occupancy[3u * params.width * params.height + index] = uint(round(clamp(face_covered.x,0,1)*65536.0));
    occupancy[4u * params.width * params.height + index] = uint(round(clamp(face_covered.y,0,1)*65536.0));
}
