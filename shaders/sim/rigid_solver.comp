#version 450
#extension GL_GOOGLE_include_directive : require
#include "rigid_body.glsl"
layout(local_size_x = 64) in;
#ifdef DC_SOLVER_MOTION_PROFILE
layout(set=0,binding=31,std430) buffer MotionProfile {uint motion_profile[];};
#endif
/* Specializing each phase removes unrelated branches and their register pressure. */
layout(constant_id = 0) const uint PHASE = 0u;
layout(constant_id = 1) const bool SPARSE_MOTION_WRITES = true;
layout(constant_id = 3) const bool CACHE_CONTACT_STARTS = true;
layout(set = 0, binding = 2, std430) readonly buffer Pages { uint pages[]; };
#ifndef DC_RUNTIME_BODY_STORAGE
layout(set = 0, binding = 4, std430) buffer Bodies {
    Body bodies[BODY_CAPACITY];
    uint data[];
};
#endif
uint pixel_word_at(uint index) {return DC_PIXEL_WORD(index);}
layout(push_constant) uniform Params {
    uint width, height, mode, body_count;
    uvec2 origin_x, origin_y;
}
params;

#include "structural_load.glsl"
#include "rigid_impact.glsl"
#include "rigid_hydro.glsl"

const float DT = 0.125, SUM_SCALE = 65536.0;
#define CONTACT_CAPACITY DC_LAYOUT_CONTACT_CAPACITY
const uint BODY_AWAKE_WORD = 13u;
const uint REST_FLAGS_WORD = 19u, REST_SUPPORTED = 1u, REST_MOVING_CONTACT = 2u;
const uint REST_TICKS = 30u;
const float REST_CONTACT_DISTANCE = 0.05, REST_DISPLACEMENT = 0.1, REST_SPEED = 0.1;
const uint RESET = 0u, BEGIN_FRAME = 1u, PREDICT = 2u, PREPARE = 3u, INIT_CONTACTS = 4u;
const uint CLEAR = 5u, SOLVE = 6u, APPLY = 7u, DERIVE_VELOCITY = 8u, IMPULSE = 9u,
           APPLY_VELOCITY = 10u, FINISH = 11u;
/* Header: enabled, iterations, substeps, sticky overflow, contact sum, awake count,
   indirect contact groups (3 words), speculative-contact mode, pixel contact
   groups (3 words), and grain contact groups (3 words).
   Body scratch (32 words): frame pose/velocity, substep pose/velocity, degree,
   awake flag, signed fixed-point Jacobi sums, and binding-constraint degree.
   Contact scratch (16 words): normal/tangent multipliers, stable body slots,
   rest-space COM-relative anchors, pre-impact speed, static witness, active flag. */
uint cb() {
    uvec2 size = uvec2((params.width + 63u) / 64u, (params.height + 63u) / 64u) + 2u;
    return 8u + 2u * size.x * size.y + DC_LAYOUT_PAIR_CAPACITY * 8u;
}
uint sb() { return cb() + 12u + CONTACT_CAPACITY * 32u; }
uint bs(uint i) {
#ifdef DC_RUNTIME_BODY_STORAGE
    return DC_RUNTIME_BODY_STATE(i);
#else
    return sb() + 16u + i * 32u;
#endif
}
/* This reserved metadata extent is retained for snapshot compatibility;
   runtime per-body state lives in independently growable slabs. */
uint cs(uint i) { return sb() + 16u + 64u * 32u + i * 16u; }
float getf(uint p) { return uintBitsToFloat(DC_SOLVER_DATA(p)); }
void putf(uint p, float f) { DC_SOLVER_DATA(p) = floatBitsToUint(f); }
vec2 getv(uint p) { return vec2(getf(p), getf(p + 1u)); }
void putv(uint p, vec2 v) {
    putf(p, v.x);
    putf(p + 1u, v.y);
}
vec2 position(Body b) { return vec2(b.x_fp, b.y_fp) / 65536.0; }
vec2 velocity(Body b) { return vec2(b.vx_fp, b.vy_fp) / 65536.0; }
float wrap(float a) { return mod(a + 3.141592653589793, 6.283185307179586) - 3.141592653589793; }
float angular_limit(Body b) {
    float radius = b.radius;
    /* Translation contributes at most sqrt(2)*4 cells/tick and rotation at most
       two. Eight substeps therefore move every vertex less than one cell. */
    return min(0.5, 2.0 / max(radius, 0.0001));
}
bool publish(inout Body b, vec2 p) {
    ivec2 fp = ivec2(round(p * 65536.0));
    uvec2 x, y;
    if (!shifted_chunk(params.origin_x, fp.x >> 22, x) ||
        !shifted_chunk(params.origin_y, fp.y >> 22, y)) {
        atomicOr(DC_DATA(sb() + 3u), 2u);
        return false;
    }
    b.x_fp = fp.x;
    b.y_fp = fp.y;
    b.chunk_x = x;
    b.chunk_y = y;
    b.local_fp = fp & ivec2((64 << 16) - 1);
    return true;
}
bool awake(Body b) {
    if (b.enabled == 0u || b.visible == 0u)
        return false;
    ivec2 p = clamp(ivec2(b.x_fp, b.y_fp) >> 16, ivec2(0), ivec2(params.width, params.height) - 1);
    if(pixel_body(b)) {
        p=ivec2(floor(vec2(b.x_fp,b.y_fp)/65536.+body_reference_point(b)));
        if(any(lessThan(p,ivec2(0)))||any(greaterThanEqual(p,ivec2(params.width,params.height)))) return false;
    }
    uint page=pages[uint(p.y / 64) * ((params.width + 63u) / 64u) + uint(p.x / 64)];
    if(!pixel_body(b)) return page!=0u;
    uint base=structural_base();if(page==0u||page>DC_DATA(base+1u)) return false;
    uint record=base+32u+(page-1u)*8u;uvec2 x,y;
    return DC_DATA(record+5u)!=0u&&shifted_chunk(params.origin_x,p.x/64,x)&&shifted_chunk(params.origin_y,p.y/64,y)&&
        all(equal(x,uvec2(DC_DATA(record),DC_DATA(record+1u))))&&all(equal(y,uvec2(DC_DATA(record+2u),DC_DATA(record+3u))));
}
uint slot(uint id) {
#ifdef DC_RUNTIME_BODY_STORAGE
    return runtime_body_find(id);
#else
    if (id == 0u)
        return BODY_CAPACITY;
    for (uint i = 0u; i < params.body_count; ++i)
        if (DC_BODY(i).enabled != 0u && DC_BODY(i).id == id)
            return i;
    return BODY_CAPACITY;
#endif
}
Body contact_body(uint i) {
    Body b = DC_BODY(i);
    /* A streamed-out reference page freezes this slot; keep its saved motion
       intact while treating its visible geometry as stationary support. */
    if (DC_SOLVER_DATA(bs(i) + BODY_AWAKE_WORD) == 0u) {
        b.inverse_mass = 0.0;
        b.inverse_inertia = 0.0;
        b.vx_fp = 0;
        b.vy_fp = 0;
        b.angular_velocity = 0.0;
    }
    return b;
}
vec2 anchor(uint p) {
    int x, y;
    if (!relative_chunk(uvec2(DC_SOLVER_DATA(p), DC_SOLVER_DATA(p + 1u)), params.origin_x, x) ||
        !relative_chunk(uvec2(DC_SOLVER_DATA(p + 2u), DC_SOLVER_DATA(p + 3u)), params.origin_y, y)) {
        atomicOr(DC_DATA(sb() + 3u), 2u);
        return vec2(0);
    }
    return vec2(x, y) * 64.0 + vec2(int(DC_SOLVER_DATA(p + 4u)), int(DC_SOLVER_DATA(p + 5u))) / 65536.0;
}
void add_correction(uint i, vec2 linear, float angular) {
    if (i == BODY_CAPACITY)
        return;
    uint p = bs(i) + 16u;
    /* Integer reduction is independent of emission order; the proposal bound
       keeps all 8192 contributions inside signed 32-bit range. */
    ivec3 v = ivec3(round(clamp(vec3(linear, angular), vec3(-2), vec3(2)) * SUM_SCALE));
#ifdef DC_SOLVER_MOTION_PROFILE
    atomicAdd(motion_profile[2],3u);
#endif
    atomicAdd(DC_SOLVER_DATA(p), uint(v.x));
    atomicAdd(DC_SOLVER_DATA(p + 1u), uint(v.y));
    atomicAdd(DC_SOLVER_DATA(p + 2u), uint(v.z));
}
vec3 correction(uint i) {
    uint p = bs(i) + 16u;
    return vec3(int(DC_SOLVER_DATA(p)), int(DC_SOLVER_DATA(p + 1u)), int(DC_SOLVER_DATA(p + 2u))) / SUM_SCALE;
}
float weight(uint a, uint b,bool conservative) {
    uint offset=conservative?12u:20u;
    uint degree = DC_SOLVER_DATA(bs(a) + offset);
    if (b != BODY_CAPACITY)
        degree = max(degree, DC_SOLVER_DATA(bs(b) + offset));
    return 0.8 / max(float(degree)/(conservative?1.0:SUM_SCALE), 1.0);
}
vec2 contact_start_anchor(uint slot,Body body,vec2 local) {
#ifdef DC_SOLVER_MOTION_PROFILE
    atomicAdd(motion_profile[1],1u);
#endif
    return getv(bs(slot)+6u)+body.center+body_rotate(local,getf(bs(slot)+8u));
}
#include "rigid_grain.glsl"
#include "grain_bed.glsl"
void solve_contact(uint i, bool impulse) {
    uint c = cb() + 12u + i * 32u, s = cs(i), a = DC_SOLVER_DATA(s + 2u), b = DC_SOLVER_DATA(s + 3u);
    if (a == BODY_CAPACITY)
        return;
    Body ba = contact_body(a);
    vec2 ra = body_rotate(getv(s + 4u), ba.angle), rb = getv(s + 6u);
    vec2 pa = position(ba) + ba.center + ra, pb = getv(s + 9u);
    vec2 va = velocity(ba) + ba.angular_velocity * vec2(-ra.y, ra.x), vb = vec2(0);
    uint grain_ref=grain_reference(c);
    float creep=getf(s+12u);
    float mb = 0.0, ib = 0.0;
    if(grain_ref!=0u) {
        Particle p=particles[grain_ref-1u];
        pb=grain_position(c,grain_ref-1u)+rb;
        vb=vec2(p.vx_fp,p.vy_fp)/65536.0;
        mb=p.mass_fp!=0u?65536.0/float(p.mass_fp):0.0;
        if(creep>=0.0) {
            mb=0.0;
            pb+=getf(s+13u)*getv(c+8u);
            pb.y+=creep*DT;vb.y=creep;
        }
    }
    if (b != BODY_CAPACITY) {
        Body bb = contact_body(b);
        rb = body_rotate(rb, bb.angle);
        pb = position(bb) + bb.center + rb;
        vb = velocity(bb) + bb.angular_velocity * vec2(-rb.y, rb.x);
        mb = bb.inverse_mass;
        ib = bb.inverse_inertia;
    }
    vec2 n = getv(c + 8u), t = vec2(-n.y, n.x);
    float an = body_cross(ra, n), bn = body_cross(rb, n), at = body_cross(ra, t),
          bt = body_cross(rb, t);
    float wn = ba.inverse_mass + mb + ba.inverse_inertia * an * an + ib * bn * bn;
    float wt = ba.inverse_mass + mb + ba.inverse_inertia * at * at + ib * bt * bt;
    if (wn <= 0.0)
        return;
    float scale = weight(a, b,(grain_ref!=0u&&creep<0.0)||DC_SOLVER_DATA(s+11u)==0u), dn = 0.0, dt = 0.0;
    if(grain_ref!=0u) scale=min(scale,0.8/float(max(grain_scratch[(grain_ref-1u)*4u+3u],1u)));
    if (impulse) {
        if (dot(pa - pb, n) > 1.0 / 65536.0 && getf(s) == 0.0)
            return;
        float pre = getf(s + 8u), target = pre < -0.5 ? -getf(c + 12u) * pre : 0.0;
        dn = max(0.0, (target - dot(va - vb, n)) / wn) * scale;
        float limit = getf(c + 11u) * (getf(s) / DT + dn);
        if (wt > 0.0)
            dt = clamp(-dot(va - vb, t) / wt, -limit, limit) * scale;
    } else {
        float alpha = creep>=0.0?0.0:getf(c + 13u) / (DT * DT), lambda = getf(s);
        dn = (max(0.0, lambda + (-dot(pa - pb, n) - alpha * lambda) / (wn + alpha)) - lambda) *
             scale;
        putf(s, lambda + dn);
        vec2 start_a = CACHE_CONTACT_STARTS?getv(s+14u):contact_start_anchor(a,ba,getv(s+4u));
        vec2 start_b = getv(s + 9u);
        if (b != BODY_CAPACITY)
            start_b =
                CACHE_CONTACT_STARTS?getv(s+9u):contact_start_anchor(b,DC_BODY(b),getv(s+6u));
        float tangent_error = dot((pa - start_a) - (pb - start_b), t);
        float lt = getf(s + 1u), limit = getf(c + 11u) * max(0.0, lambda + dn);
        if (wt > 0.0)
            dt = (clamp(lt - tangent_error / wt, -limit, limit) - lt) * scale;
        putf(s + 1u, lt + dt);
    }
    vec2 force = dn * n + dt * t;
    vec2 applied_impulse=force/(impulse?1.0:DT);
    float incoming=getf(s+8u),normal_impulse=max(dn,0)/(impulse?1.0:DT);
    impact_capture(a,b,DC_DATA(c+5u),DC_DATA(c+6u),n,incoming,normal_impulse,wn,getf(c+12u));
    impact_capture(b,a,DC_DATA(c+6u),DC_DATA(c+5u),-n,incoming,normal_impulse,wn,getf(c+12u));
    structural_capture(a,b,pa,applied_impulse);
    structural_capture(b,a,pb,-applied_impulse);
    if(any(greaterThan(abs(vec3(ba.inverse_mass*force,ba.inverse_inertia*(an*dn+at*dt))),vec3(2))))
        atomicOr(DC_BODY_CLIPPED(a),1u);
    if(b<BODY_CAPACITY&&any(greaterThan(abs(vec3(mb*force,ib*(bn*dn+bt*dt))),vec3(2))))
        atomicOr(DC_BODY_CLIPPED(b),1u);
    add_correction(a, ba.inverse_mass * force, ba.inverse_inertia * (an * dn + at * dt));
    add_correction(b, -mb * force, -ib * (bn * dn + bt * dt));
    if(grain_ref!=0u) grain_correction(grain_ref-1u,-mb*force);
}
#include "rigid_bonds.glsl"
void main() {
    uint i = gl_GlobalInvocationID.x, h = sb();
    if(PHASE==GRAIN_BED_PLAN) {grain_bed_plan();return;}
    if(PHASE>=GRAIN_BED_INIT) {grain_bed_phase(i);return;}
    if(PHASE>=GRAIN_PREPARE) {grain_phase(i);return;}
    if(PHASE>=12u) {solve_bonds(PHASE);return;}
    if (PHASE == RESET) {
        if (i == 0u) {
            DC_DATA(h + 3u) = 0u;
            DC_DATA(h + 4u) = 0u;
            DC_DATA(h + 5u) = 0u;
            DC_DATA(h + 9u) = 1u;
        }
        return;
    }
    if (PHASE == INIT_CONTACTS || PHASE == SOLVE || PHASE == IMPULSE) {
        if (DC_DATA(h + 3u) != 0u || i >= DC_DATA(cb()))
            return;
        if (PHASE != INIT_CONTACTS) {
            solve_contact(i, PHASE == IMPULSE);
            return;
        }
        uint c = cb() + 12u + i * 32u, s = cs(i), a = slot(DC_DATA(c)), b = slot(DC_DATA(c + 1u));
        /* Cold start each regenerated manifold; retain multipliers within its iterations. */
        for (uint k = 0u; k < 16u; ++k)
            DC_SOLVER_DATA(s + k) = 0u;
        DC_SOLVER_DATA(s + 2u) = a;
        DC_SOLVER_DATA(s + 3u) = b;
        if (a == BODY_CAPACITY)
            return;
        Body ba = contact_body(a);
        vec2 pa = anchor(c + 16u), pb = anchor(c + 22u);
        vec2 ra = pa - position(ba) - ba.center;
        putv(s + 4u, body_rotate(ra, -ba.angle));
        putv(s + 9u, pb);
        putv(s+14u,contact_start_anchor(a,ba,getv(s+4u)));
        vec2 va = velocity(ba) + ba.angular_velocity * vec2(-ra.y, ra.x), vb = vec2(0);
        vec2 normal=getv(c+8u);
        DC_SOLVER_DATA(s+11u)=uint(dot(pa-pb,normal)<=1.0/65536.0);
        if(dot(pa-pb,normal)<=REST_CONTACT_DISTANCE && normal.y<-.5)
            atomicOr(DC_SOLVER_DATA(bs(a)+REST_FLAGS_WORD),REST_SUPPORTED);
        uint grain_ref=grain_reference(c);
        float creep=grain_ref!=0u&&normal.y<-.5?grain_bed_creep(ba,c,grain_ref):-1.0;
        putf(s+12u,creep);
        if(creep>=0.0) {
            /* Existing granular overlap represents the loaded bed's rest
               configuration. Resist new compression without lifting the body
               out of that configuration and letting grains ratchet beneath it. */
            vec2 start=contact_start_anchor(a,ba,getv(s+4u));
            putf(s+13u,min(dot(start-pb,normal),0.0));
        }
        bool moving=grain_ref!=0u&&creep<0.0;
        if(grain_ref!=0u) {
            Particle p=particles[grain_ref-1u];
            putv(s+6u,pb-grain_position(c,grain_ref-1u));
            vb=vec2(p.vx_fp,p.vy_fp)/65536.0;
            atomicAdd(grain_scratch[(grain_ref-1u)*4u+3u],1u);
        }
        /* Loose grains receive most of their own correction. Count their
           body mobility fraction, and exclude nonbinding speculative rows
           from rigid preconditioning. Those rows retain conservative weights. */
        float degree=1.0;
        if(grain_ref!=0u&&creep<0.0) {
            float arm=body_cross(ra,normal);
            float body_weight=ba.inverse_mass+ba.inverse_inertia*arm*arm;
            float grain_weight=65536.0/float(particles[grain_ref-1u].mass_fp);
            degree=body_weight/(body_weight+grain_weight);
        } else if(DC_SOLVER_DATA(s+11u)==0u) degree=0.0;
        atomicAdd(DC_SOLVER_DATA(bs(a) + 12u),1u);
        atomicAdd(DC_SOLVER_DATA(bs(a) + 20u),uint(round(degree*SUM_SCALE)));
        if (b != BODY_CAPACITY) {
            Body bb = contact_body(b);
            vec2 rb = pb - position(bb) - bb.center;
            putv(s + 6u, body_rotate(rb, -bb.angle));
            putv(s+9u,contact_start_anchor(b,bb,getv(s+6u)));
            vb = velocity(bb) + bb.angular_velocity * vec2(-rb.y, rb.x);
            if(dot(pa-pb,normal)<=REST_CONTACT_DISTANCE && normal.y>.5)
                atomicOr(DC_SOLVER_DATA(bs(b)+REST_FLAGS_WORD),REST_SUPPORTED);
            float limit_a=(ba.motion_flags&1u)!=0u ? 1.0/65536.0 : REST_SPEED;
            float limit_b=(bb.motion_flags&1u)!=0u ? 1.0/65536.0 : REST_SPEED;
            moving=moving || length(va)>limit_a || length(vb)>limit_b;
            atomicAdd(DC_SOLVER_DATA(bs(b) + 12u),1u);
            atomicAdd(DC_SOLVER_DATA(bs(b) + 20u),uint(round(degree*SUM_SCALE)));
        }
        if(moving) {
            atomicOr(DC_SOLVER_DATA(bs(a)+REST_FLAGS_WORD),REST_MOVING_CONTACT);
            if(b!=BODY_CAPACITY) atomicOr(DC_SOLVER_DATA(bs(b)+REST_FLAGS_WORD),REST_MOVING_CONTACT);
        }
        putf(s + 8u, dot(va - vb, getv(c + 8u)));
        return;
    }
    if (i >= params.body_count)
        return;
    Body body = DC_BODY(i);
    uint s = bs(i);
    if (PHASE == BEGIN_FRAME) {
        for (uint k = 0u; k < 32u; ++k)
            DC_SOLVER_DATA(s + k) = 0u;
        DC_SOLVER_DATA(s + BODY_AWAKE_WORD) = uint(awake(body));
        putv(s, position(body));
        putf(s + 2u, body.angle);
        DC_SOLVER_DATA(s + 3u) = uint(body.vx_fp);
        DC_SOLVER_DATA(s + 4u) = uint(body.vy_fp);
        putf(s + 5u, body.angular_velocity);
        if (DC_SOLVER_DATA(s + BODY_AWAKE_WORD) != 0u) {
            atomicAdd(DC_DATA(h + 5u), 1u);
            if(!pixel_body(body)) {
                hydro_impulse(i, body);
                body.vx_fp = clamp(body.vx_fp, -(4 << 16), 4 << 16);
                body.vy_fp = clamp(clamp(body.vy_fp, -(4 << 16), 4 << 16) +
                                       ((body.motion_flags & 1u) == 0u ? 16384 : 0),
                                   -(4 << 16), 4 << 16);
                DC_BODY(i) = body;
            }
        }
        return;
    }
    if (PHASE == PREPARE) {
        DC_SOLVER_DATA(s + 12u) = 0u;
        DC_SOLVER_DATA(s + 20u) = 0u;
        DC_SOLVER_DATA(s + REST_FLAGS_WORD) = 0u;
        if (i == 0u) {
            atomicOr(DC_DATA(h + 3u), DC_DATA(cb() + 2u));
            DC_DATA(h + 6u) = DC_DATA(h + 3u) == 0u ? (DC_DATA(cb()) + 63u) / 64u : 0u;
            DC_DATA(h + 7u) = 1u;
            DC_DATA(h + 8u) = 1u;
            DC_DATA(h + 13u) = DC_DATA(h+13u)!=0u ? DC_DATA(h+6u) : 0u;
            DC_DATA(h + 14u) = 1u;
            DC_DATA(h + 15u) = 1u;
            if (DC_DATA(h + 3u) == 0u)
                DC_DATA(h + 4u) += DC_DATA(cb());
        }
        return;
    }
    if (PHASE == CLEAR) {
        DC_SOLVER_DATA(s + 16u) = 0u;
        DC_SOLVER_DATA(s + 17u) = 0u;
        DC_SOLVER_DATA(s + 18u) = 0u;
        return;
    }
    if (PHASE == FINISH && i == 0u) {
        DC_DATA(h + 9u) = 0u;
        if (DC_DATA(h + 3u) != 0u)
            DC_DATA(h + 4u) = 0u;
    }
    if (PHASE == PREDICT) {
        putv(s + 6u, position(body));
        putf(s + 8u, body.angle);
        putv(s + 9u, velocity(body));
        putf(s + 11u, body.angular_velocity);
    }
    if (DC_SOLVER_DATA(s + BODY_AWAKE_WORD) == 0u)
        return;
    if (PHASE == FINISH) {
        if (DC_DATA(h + 3u) != 0u) {
            publish(body, getv(s));
            body.angle = getf(s + 2u);
            body.vx_fp = int(DC_SOLVER_DATA(s + 3u));
            body.vy_fp = int(DC_SOLVER_DATA(s + 4u));
            body.angular_velocity = getf(s + 5u);
        } else if((body.motion_flags&1u)==0u) {
            float angular_motion=abs(wrap(body.angle-getf(s+2u)))*body.radius;
            bool quiet=DC_SOLVER_DATA(s+REST_FLAGS_WORD)==REST_SUPPORTED &&
                length(position(body)-getv(s))+angular_motion<REST_DISPLACEMENT &&
                length(velocity(body))<REST_SPEED &&
                abs(body.angular_velocity)*body.radius<REST_SPEED;
            if(body.rest_ticks==0u) {
                body.rest_position=ivec2(body.previous_x_fp,body.previous_y_fp);
                body.rest_angle=body.previous_angle;
            }
            float drift=length(position(body)-vec2(body.rest_position)/65536.0)+
                abs(wrap(body.angle-body.rest_angle))*body.radius;
            quiet=quiet && drift<REST_DISPLACEMENT;
            body.rest_ticks=quiet ? min(body.rest_ticks+1u,REST_TICKS) : 0u;
            if(body.rest_ticks==REST_TICKS) {
                publish(body,getv(s));
                body.angle=getf(s+2u);
                body.vx_fp=0;body.vy_fp=0;body.angular_velocity=0.0;
            }
        }
        body_cache_bounds(body);
        /* Physical boxes include fractional edge coverage in the swept mask. */
        if (body.vertex_count == 0u && body.angle == 0.0 && body.previous_angle == 0.0)
            body.swept_high = (max(ivec2(body.x_fp,body.y_fp),
                ivec2(body.previous_x_fp,body.previous_y_fp)) +
                (ivec2(body.width,body.height)<<16) + 65535)>>16;
        DC_BODY(i) = body;
        return;
    }
    if (DC_DATA(h + 3u) != 0u)
        return;
    if (PHASE == PREDICT) {
        publish(body, position(body) + velocity(body) * DT);
        body.angular_velocity =
            clamp(body.angular_velocity, -angular_limit(body), angular_limit(body));
        if ((body.motion_flags & 2u) == 0u)
            body.angle = wrap(body.angle + body.angular_velocity * DT);
    } else if (PHASE == APPLY) {
        vec3 change = correction(i);
        if(abs(change.z)>0.25) atomicOr(DC_BODY_CLIPPED(i),1u);
        publish(body, position(body) + change.xy);
        body.angle = wrap(body.angle + clamp(change.z, -0.25, 0.25));
        DC_SOLVER_DATA(s + 16u) = 0u;
        DC_SOLVER_DATA(s + 17u) = 0u;
        DC_SOLVER_DATA(s + 18u) = 0u;
    } else if (PHASE == DERIVE_VELOCITY && (body.motion_flags & 1u) == 0u) {
        vec2 v = (position(body) - getv(s + 6u)) / DT;
        float omega=wrap(body.angle-getf(s+8u))/DT;
        if(any(greaterThan(abs(v),vec2(4)))||abs(omega)>angular_limit(body))
            atomicOr(DC_BODY_CLIPPED(i),1u);
        body.vx_fp = int(round(clamp(v.x, -4.0, 4.0) * 65536.0));
        body.vy_fp = int(round(clamp(v.y, -4.0, 4.0) * 65536.0));
        body.angular_velocity =
            clamp(wrap(body.angle - getf(s + 8u)) / DT, -angular_limit(body), angular_limit(body));
    } else if (PHASE == APPLY_VELOCITY && (body.motion_flags & 1u) == 0u) {
        vec3 change = correction(i);
        if(any(greaterThan(abs(velocity(body)+change.xy),vec2(4)))||
           abs(body.angular_velocity+change.z)>angular_limit(body))
            atomicOr(DC_BODY_CLIPPED(i),1u);
        vec2 v = clamp(velocity(body) + change.xy, vec2(-4), vec2(4));
        body.vx_fp = int(round(v.x * 65536.0));
        body.vy_fp = int(round(v.y * 65536.0));
        body.angular_velocity =
            clamp(body.angular_velocity + change.z, -angular_limit(body), angular_limit(body));
    }
    if (SPARSE_MOTION_WRITES && (PHASE == PREDICT || PHASE == APPLY)) {
        DC_BODY(i).x_fp = body.x_fp;
        DC_BODY(i).y_fp = body.y_fp;
        DC_BODY(i).chunk_x = body.chunk_x;
        DC_BODY(i).chunk_y = body.chunk_y;
        DC_BODY(i).local_fp = body.local_fp;
        DC_BODY(i).angle = body.angle;
        if (PHASE == PREDICT) DC_BODY(i).angular_velocity = body.angular_velocity;
#ifdef DC_SOLVER_MOTION_PROFILE
        atomicAdd(motion_profile[0],PHASE == PREDICT ? 10u : 9u);
#endif
    } else if (SPARSE_MOTION_WRITES &&
               (PHASE == DERIVE_VELOCITY || PHASE == APPLY_VELOCITY)) {
        DC_BODY(i).vx_fp = body.vx_fp;
        DC_BODY(i).vy_fp = body.vy_fp;
        DC_BODY(i).angular_velocity = body.angular_velocity;
#ifdef DC_SOLVER_MOTION_PROFILE
        atomicAdd(motion_profile[0],3u);
#endif
    } else {
#ifdef DC_SOLVER_MOTION_PROFILE
        atomicAdd(motion_profile[0],136u);
#endif
        DC_BODY(i) = body;
    }
}
