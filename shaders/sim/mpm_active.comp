#version 450
#extension GL_GOOGLE_include_directive : require
#include "rigid_body.glsl"
#include "../../include/dungeoncraft/mpm_activity_layout.h"
layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 1, std430) readonly buffer ChunkCells { uvec2 chunk_cells[]; };
layout(set = 0, binding = 2, std430) readonly buffer Pages { uint pages[]; };
layout(set=0,binding=4,std430) readonly buffer Storage { Body bodies[BODY_CAPACITY]; uint data[]; };
layout(set = 0, binding = 20, std430) readonly buffer ParticleCounts { uint particle_counts[]; };
layout(set = 0, binding = 27, std430) buffer Activity { uint activity[]; };
uint pixel_word_at(uint index) {return data[index-BODY_STORAGE_WORDS];}
layout(push_constant) uniform Params {
    uint width;
    uint height;
    uint mode;
    uint unused0;
    uint unused1;
    uint unused2;
    uint unused3;
} params;

#include "mpm_rigid_cache.glsl"
shared uint has_grain;

void scan_tile() {
    if(mpm_rigid_cache_clean()) return;
    uint tiles_x = (params.width + 15u) / 16u;
    uint tiles_y = (params.height + 15u) / 16u;
    uint tile = gl_WorkGroupID.x+gl_WorkGroupID.y*gl_NumWorkGroups.x;
    if(tile>=tiles_x*tiles_y) return;
    if (gl_LocalInvocationIndex == 0u) has_grain = 0u;
    barrier();
    uvec2 cell = uvec2((tile%tiles_x)*16u,(tile/tiles_x)*16u)+gl_LocalInvocationID.xy;
    if (cell.x < params.width && cell.y < params.height) {
        uint page_width = (params.width + 63u) / 64u;
        uint page = pages[(cell.y / 64u) * page_width + cell.x / 64u];
        if (page != 0u && (params.unused0 != 0u || particle_counts[page - 1u] != 0u)) {
            uint index = (page - 1u) * 4096u + (cell.y % 64u) * 64u + cell.x % 64u;
            uint material = chunk_cells[index].x & 0xffffu;
            if (params.unused0 != 0u ? (material==1u || material==7u || material==8u) :
                (material == 2u || material == 4u || material == 5u || material == 6u))
                atomicOr(has_grain, 1u);
        }
    }
    barrier();
    if (gl_LocalInvocationIndex == 0u)
        activity[3u + tiles_x * tiles_y + tile] = has_grain;
}

void main() {
    scan_tile();
}
