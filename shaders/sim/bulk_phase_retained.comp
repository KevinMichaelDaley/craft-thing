#version 450
layout(local_size_x=64) in;
layout(set=0,binding=1,std430) readonly buffer Cells {uvec2 cells[];};
layout(set=0,binding=2,std430) readonly buffer Pages {uint pages[];};
layout(set=0,binding=3,std430) readonly buffer Occupancy {uint occupancy[];};
layout(set=0,binding=37,std430) buffer Bulk {uint bulk[];};
layout(push_constant) uniform Params {uint width,height;} params;
const uint FULL=65536u;
void main() {
    uint index=gl_GlobalInvocationID.x;
    if(index>=params.width*params.height) return;
    uint x=index%params.width,y=index/params.width;
    uint page=pages[(y/64u)*((params.width+63u)/64u)+x/64u];
    if(page==0u) return;
    uint local=(y%64u)*64u+x%64u;
    uint atlas=(page-1u)*4096u+local;
    uint base=(page-1u)*6u*4096u+local;
    uint oil=bulk[base],slime=bulk[base+4096u];
    uint capacity=FULL-min(FULL,occupancy[2u*params.width*params.height+index]);
    uint used=cells[atlas].y+oil+slime;
    uint overflow=used>capacity?used-capacity:0u;
    uint retained_oil=min(oil,overflow);
    bulk[base+2u*4096u]=retained_oil;
    bulk[base+3u*4096u]=min(slime,overflow-retained_oil);
}
