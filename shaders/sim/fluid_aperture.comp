#version 450
#extension GL_GOOGLE_include_directive : require
#include "../../include/dungeoncraft/fluid_aperture_layout.h"
layout(local_size_x=64) in;
layout(set=0,binding=1,std430) readonly buffer Cells {uvec2 chunk_cells[];};
layout(set=0,binding=2,std430) readonly buffer Pages {uint pages[];};
layout(set=0,binding=3,std430) readonly buffer Coverage {uint occupancy[];};
layout(set=0,binding=28,std430) buffer Prefix {uint aperture_prefix[];};
layout(set=0,binding=29,std430) buffer Tree {uint aperture_tree[];};
layout(push_constant) uniform Params {uint width,height,axis,nodes,leaves;} params;
const uint FULL=65536u;
shared uint prefix[64],suffix[64];
uint page_at(ivec2 p) {
    if(any(lessThan(p,ivec2(0)))||any(greaterThanEqual(p,ivec2(params.width,params.height)))) return 0u;
    return pages[uint(p.y/64)*((params.width+63u)/64u)+uint(p.x/64)];
}
uint atlas_index(ivec2 p,uint page) {return (page-1u)*4096u+uint(p.y%64)*64u+uint(p.x%64);}
#include "hydraulic_face.glsl"
uint face_value(uvec2 p, bool vertical) {
    uint page=pages[(p.y/64u)*((params.width+63u)/64u)+p.x/64u];
    if(page==0u) return 0u;
    uint index=p.y*params.width+p.x;
    uint covered=occupancy[(vertical?4u:3u)*params.width*params.height+index];
    return hydraulic_aperture(FULL-min(FULL,covered),ivec2(p),vertical?ivec2(0,1):ivec2(1,0));
}

/* Adjacent lanes visit adjacent columns on each row. Each lane owns one
   whole tile, including its prefix, suffix and tree leaf. */
void vertical_tile(uint id) {
    uint column=id%params.width,tile=id/params.width;
    if(tile>=params.leaves) return;
    uint start=tile*DC_FLUID_APERTURE_TILE_CELLS;
    uint count=min(DC_FLUID_APERTURE_TILE_CELLS,params.height-min(start,params.height));
    uint values[DC_FLUID_APERTURE_TILE_CELLS],minimum=FULL;
    for(uint i=0u;i<count;++i) {
        values[i]=face_value(uvec2(column,start+i),true);
        minimum=min(minimum,values[i]);
        aperture_prefix[2u*((start+i)*params.width+column)]=minimum;
    }
    uint base=DC_FLUID_APERTURE_TREE_BASE+column*2u*params.leaves;
    aperture_tree[base+params.leaves+tile]=minimum;
    minimum=FULL;
    for(uint i=count;i>0u;--i) {
        minimum=min(minimum,values[i-1u]);
        aperture_prefix[2u*((start+i-1u)*params.width+column)+1u]=minimum;
    }
}
void main() {
    uint lane=gl_LocalInvocationID.x,group=gl_WorkGroupID.x+gl_WorkGroupID.y*65535u;
    uint length=params.axis!=0u?params.height:params.width;
    uint lines=params.axis!=0u?params.width:params.height;
    if(params.nodes!=0u) {
        uint index=group*64u+lane;
        if(index>=lines*params.nodes) return;
        uint line=index/params.nodes,node=params.nodes+index%params.nodes;
        uint base=DC_FLUID_APERTURE_TREE_BASE+line*2u*params.leaves;
        aperture_tree[base+node]=min(aperture_tree[base+2u*node],aperture_tree[base+2u*node+1u]);
        return;
    }
    if(params.axis!=0u) {
        vertical_tile(group*64u+lane);
        return;
    }
    uint batches=(params.leaves+3u)/4u;
    if(group>=lines*batches) return;
    uint line=group/batches,position=(group%batches)*64u+lane;
    uvec2 p=uvec2(position,line);
    uint value=position<length?face_value(p,false):FULL;
    prefix[lane]=value;suffix[lane]=value;barrier();
    for(uint stride=1u;stride<16u;stride*=2u) {
        uint prior=lane%16u>=stride?prefix[lane-stride]:FULL;
        uint next=lane%16u+stride<16u?suffix[lane+stride]:FULL;
        barrier();prefix[lane]=min(prefix[lane],prior);suffix[lane]=min(suffix[lane],next);barrier();
    }
    if(position<length) {
        uint index=p.y*params.width+p.x;
        aperture_prefix[2u*index]=prefix[lane];aperture_prefix[2u*index+1u]=suffix[lane];
    }
    uint tile=position/16u;
    if(lane%16u==15u&&tile<params.leaves)
        aperture_tree[DC_FLUID_APERTURE_TREE_BASE+line*2u*params.leaves+params.leaves+tile]=prefix[lane];
}
