bool recipients_full(uint coordinate,bool positive,uint reach) {
    uint low=positive?coordinate+1u:coordinate-reach;
    uint high=positive?coordinate+reach:coordinate-1u;
    if(high>=CACHE_CELLS) return false;
    uint first=low/32u,last=high/32u;
    for(uint word=first;word<=last;word++) {
        uint mask=0xffffffffu;
        if(word==first) mask&=0xffffffffu<<(low%32u);
        if(word==last) mask&=0xffffffffu>>(31u-high%32u);
        if((capacity_bits[word]&mask)!=0u) return false;
    }
