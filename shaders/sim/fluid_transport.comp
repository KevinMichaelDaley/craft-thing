            /* Cached one-cell moves own pigment in lane zero. Cooperative
               recipients publish before/after crossing lane ownership. */
            if(length>CACHE_CELLS) transport_buffer_barrier();
#endif
            subgroupBarrier();
        }
    }
    for(uint position=gl_SubgroupInvocationID;position<min(length,CACHE_CELLS);position+=transport_team_size()) {
        ivec2 p=point_at(position);uint page=page_at(p);if(page!=0u) chunk_cells[atlas_index(p,page)].y=cached[position].x;
    }
#ifdef DC_TRANSPORT_PROFILE
    uint requests=subgroupAdd(request_queries),checks=subgroupAdd(blocker_checks),page_reads=subgroupAdd(page_queries);
    if(gl_SubgroupInvocationID==0u) {
        atomicAdd(transport_profile[0],requests);
        atomicAdd(transport_profile[1],checks);
        atomicAdd(transport_profile[2],source_queries);
        atomicAdd(transport_profile[4],buffer_barriers);
        atomicAdd(transport_profile[5],page_reads);
        atomicAdd(transport_profile[6],stagnant_sources);
    }
#endif
}
