/* A prefix whose complete reachable intervals are already full cannot move.
 * No member of that prefix vacates a recipient for a later source. */
uint stagnant_block(int first,bool positive) {
    uint lane=gl_SubgroupInvocationID,team=transport_team_size();
    int coordinate=first+(positive?-int(lane):int(lane));
    bool valid=coordinate>=0&&coordinate<int(length),stationary=valid;
    if(valid) {
        uint position=uint(coordinate);
        bool source=(source_bits[position/32u]&(1u<<(position%32u)))!=0u;
        if(source) {
            uint face=positive?position:position-1u;
            uint edge=positive?length-1u-position:position;
            uint reach=min(uint(ceil(uintBitsToFloat(cached[face].w))),edge);
            uint bound=cached[position].y>>BOUND_SHIFT;
            reach=min(reach,positive?bound-position:position-bound);
            stationary=reach==0u||recipients_full(position,positive,reach);
        }
    }
    uint count=subgroupMin(stationary?team:lane);
#ifdef DC_TRANSPORT_PROFILE
    if(lane==0u) stagnant_sources+=count;
#endif
    return count;
}
