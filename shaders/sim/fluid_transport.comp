            if(positive) connected=position+1u<length&&open_cell(point_at(position))&&
                open_cell(point_at(position+1u))&&(line_open_aperture||(cached[position].z&131071u)!=0u);
            else connected=position>0u&&open_cell(point_at(position-1u))&&
                open_cell(point_at(position))&&(line_open_aperture||(cached[position-1u].z&131071u)!=0u);
            if(!connected) boundary=position;
        }
        uint scan=positive?subgroupInclusiveMin(boundary):subgroupInclusiveMax(boundary);
        uint bound=positive?min(carry,scan):max(carry,scan);
        subgroupMemoryBarrierShared();subgroupBarrier();
        if(ordinal<length) cached[position].y=(cached[position].y&((1u<<BOUND_SHIFT)-1u))|(bound<<BOUND_SHIFT);
