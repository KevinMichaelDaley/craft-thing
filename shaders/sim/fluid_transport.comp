        uint ordinal=block+lane,position=positive?length-1u-ordinal:ordinal;
        uint boundary=positive?0xffffffffu:0u;
        if(ordinal<length) {
#ifdef DC_TRANSPORT_PROFILE
            blocker_checks++;
#endif
