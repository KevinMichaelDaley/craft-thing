}
uint recipient_mask(uint word,uint low,uint high,bool atomic_read) {
    uint mask=atomic_read?atomicOr(capacity_bits[word],0u):capacity_bits[word];
    if(word==low/32u) mask&=0xffffffffu<<(low%32u);
    if(word==high/32u) mask&=0xffffffffu>>(31u-high%32u);
    return mask;
}
uint move_cached_recipients(ivec2 source,ivec2 direction,uint reach,float travel,uint available) {
