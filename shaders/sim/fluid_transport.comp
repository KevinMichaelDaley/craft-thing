    for(uint visited=0u;visited<(CACHE_CELLS+31u)/32u;visited++) {
        if(mask!=0u) return int(word*32u)+int(positive?findMSB(mask):findLSB(mask));
        if(positive) {if(word==0u) return -1;word--;}
        else {word++;if(word>=(min(length,CACHE_CELLS)+31u)/32u) return int(min(length,CACHE_CELLS));}
        mask=source_bits[word];
