#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_ballot : require
layout(local_size_x=128) in;
layout(constant_id=0) const uint TRANSPORT_MODE=0u;
layout(set=0,binding=1,std430) coherent buffer Cells {uvec2 chunk_cells[];};
layout(set=0,binding=2,std430) readonly buffer Pages {uint pages[];};
layout(set=0,binding=3,std430) readonly buffer Coverage {uint occupancy[];};
layout(set=0,binding=8,std430) readonly buffer SavedVelocity {uint fluid_a[];};
layout(set=0,binding=10,std430) readonly buffer Velocity {vec2 face_velocity[];};
layout(set=0,binding=28,std430) readonly buffer Prefix {uint aperture_prefix[];};
layout(set=0,binding=29,std430) readonly buffer Tree {uint aperture_tree[];};
layout(push_constant) uniform Params {
    uint width,height,mode,tick_parity,unused1,step_scale_bits,elapsed_time_mode;
} params;
const uint FULL=65536u,CACHE_CELLS=2048u;
const float TRANSPORT_FUDGE=1.001;
shared uint water[CACHE_CELLS];
bool vertical;
uint line,length;
uint page_at(ivec2 p) {
    if(any(lessThan(p,ivec2(0)))||any(greaterThanEqual(p,ivec2(params.width,params.height)))) return 0u;
    return pages[uint(p.y/64)*((params.width+63u)/64u)+uint(p.x/64)];
}
uint atlas_index(ivec2 p,uint page) {return (page-1u)*4096u+uint(p.y%64)*64u+uint(p.x%64);}
bool permeable_material(uint m) {return m==0u||m==2u||m==4u||m==5u||m==6u;}
uint receiving_capacity(ivec2 p) {return FULL-min(FULL,occupancy[2u*params.width*params.height+uint(p.y)*params.width+uint(p.x)]);}
bool open_cell(ivec2 p) {
    uint page=page_at(p);
    return page!=0u&&permeable_material(chunk_cells[atlas_index(p,page)].x&65535u)&&receiving_capacity(p)>0u;
}
float face_aperture(ivec2 p,ivec2 direction) {
    ivec2 face=p+min(direction,ivec2(0));if(page_at(face)==0u) return 0.;
    uint axis=direction.x!=0?3u:4u,index=uint(face.y)*params.width+uint(face.x);
    return float(FULL-min(FULL,occupancy[axis*params.width*params.height+index]))/float(FULL);
}
#include "fluid_aperture.glsl"
ivec2 point_at(uint position) {return vertical?ivec2(line,position):ivec2(position,line);}
uint water_at(ivec2 p,uint page) {
    uint position=uint(vertical?p.y:p.x);
    return position<CACHE_CELLS?water[position]:chunk_cells[atlas_index(p,page)].y;
}
void put_water(ivec2 p,uint page,uint value) {
    uint position=uint(vertical?p.y:p.x);
    if(position<CACHE_CELLS) water[position]=value;
    else chunk_cells[atlas_index(p,page)].y=value;
}
uint request_at(ivec2 source,ivec2 direction,uint offset,float travel) {
    ivec2 target=source+direction*int(offset);uint page=page_at(target);
    uint receiving=water_at(target,page),capacity=receiving_capacity(target);
    if(receiving>=capacity) return 0u;
    float fraction=clamp(travel-float(offset-1u),0.,1.);
    float aperture=cached_path_aperture(source,direction,offset);
    uint allowance=uint(floor(fraction*float(FULL)*aperture));
    return min(allowance,capacity-receiving);
}
bool move_source(ivec2 source,ivec2 direction) {
    uint page=page_at(source);if(page==0u) return false;
    uint source_index=atlas_index(source,page),available=water_at(source,page);
    if(available==0u||!permeable_material(chunk_cells[source_index].x&65535u)||
       receiving_capacity(source)==0u||!open_cell(source+direction)) return false;
    float aperture=face_aperture(source,direction);if(aperture<=0.) return false;
    ivec2 face=source+min(direction,ivec2(0));uint face_index=uint(face.y)*params.width+uint(face.x);
    float speed=vertical?face_velocity[face_index].y:face_velocity[face_index].x;
    if(vertical&&params.elapsed_time_mode!=0u) speed=.5*(speed+uintBitsToFloat(fluid_a[face_index]));
    if(direction.x<0||direction.y<0) speed=-speed;
    if(speed<=0.) return false;
    float travel=speed*uintBitsToFloat(params.step_scale_bits)*TRANSPORT_FUDGE;
    uint coordinate=uint(vertical?source.y:source.x);
    uint edge=(direction.x>0||direction.y>0)?length-1u-coordinate:coordinate;
    uint reach=min(uint(ceil(travel)),edge),lane=gl_SubgroupInvocationID;
    if(reach==1u) {
        subgroupBarrier();
        uint moved=0u;
        if(lane==0u) {
            ivec2 target=source+direction;uint target_page=page_at(target);
            uint receiving=water_at(target,target_page),capacity=receiving_capacity(target);
            uint allowance=uint(floor(clamp(travel,0.,1.)*float(FULL)*aperture));
            moved=min(min(allowance,available),receiving<capacity?capacity-receiving:0u);
            if(moved!=0u) {put_water(target,target_page,receiving+moved);put_water(source,page,available-moved);}
        }
        return subgroupBroadcastFirst(moved)!=0u;
    }
    uint blocked=reach+1u;
    for(uint offset=2u+lane;offset<=reach;offset+=gl_SubgroupSize)
        if(!open_cell(source+direction*int(offset))||face_aperture(source+direction*int(offset-1u),direction)<=0.) blocked=min(blocked,offset);
    reach=min(reach,subgroupMin(blocked)-1u);
    uint chunk=(reach+gl_SubgroupSize-1u)/gl_SubgroupSize;
    uint first=lane*chunk,last=min(reach,first+chunk),requested=0u;
    for(uint order=first;order<last;order++) requested+=request_at(source,direction,reach-order,travel);
    uint prior=subgroupExclusiveAdd(requested),total=subgroupAdd(requested);
    uint remaining=available>prior?available-prior:0u;
    for(uint order=first;order<last&&remaining!=0u;order++) {
        uint offset=reach-order,request=request_at(source,direction,offset,travel);
        uint flux=min(request,remaining);remaining-=flux;
        if(flux!=0u) {ivec2 target=source+direction*int(offset);uint target_page=page_at(target);put_water(target,target_page,water_at(target,target_page)+flux);}
    }
    uint sent=min(available,total);
    if(lane==0u&&sent!=0u) put_water(source,page,available-sent);
    return sent!=0u;
}
void main() {
    /* A complete subgroup owns each ordered line. Other subgroups never enter
       its collectives; there are no workgroup barriers behind their return. */
    line=gl_WorkGroupID.x+gl_WorkGroupID.y*65535u;vertical=TRANSPORT_MODE<2u;
    length=vertical?params.height:params.width;
    if(gl_SubgroupID!=0u||line>=(vertical?params.width:params.height)) return;
    for(uint position=gl_SubgroupInvocationID;position<min(length,CACHE_CELLS);position+=gl_SubgroupSize) {
        ivec2 p=point_at(position);uint page=page_at(p);water[position]=page==0u?0u:chunk_cells[atlas_index(p,page)].y;
    }
    subgroupMemoryBarrierShared();subgroupBarrier();
    bool positive=(TRANSPORT_MODE&1u)==0u;
    ivec2 direction=vertical?ivec2(0,positive?1:-1):ivec2(positive?1:-1,0);
    for(int position=positive?int(length)-2:1;position>=0&&position<int(length);position+=positive?-1:1) {
        if(move_source(point_at(uint(position)),direction)) {
            subgroupMemoryBarrierShared();
            if(length>CACHE_CELLS) subgroupMemoryBarrierBuffer();
            subgroupBarrier();
        }
    }
    for(uint position=gl_SubgroupInvocationID;position<min(length,CACHE_CELLS);position+=gl_SubgroupSize) {
        ivec2 p=point_at(position);uint page=page_at(p);if(page!=0u) chunk_cells[atlas_index(p,page)].y=water[position];
    }
}
