#version 450
layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 1, std430) readonly buffer ChunkCells { uvec2 cells[]; };
layout(set = 0, binding = 2, std430) readonly buffer PageTable { uint pages[]; };
layout(set = 0, binding = 3, std430) readonly buffer Occupancy { uint occupancy[]; };
layout(set = 0, binding = 10, std430) buffer FaceVelocity { vec2 face_velocity[]; };
layout(set = 0, binding = 11, std430) buffer PressureA { float pressure_a[]; };
layout(set = 0, binding = 17, std430) readonly buffer SlotPages { uint slot_pages[]; };
layout(set = 0, binding = 9, std430) buffer HydroHead { uint hydro_head[]; };
layout(set = 0, binding = 8, std430) buffer PreviousVerticalVelocity { uint previous_vertical_velocity[]; };
layout(set = 1, binding = 0, std430) readonly buffer PressureWork {uint pressure_work[];};
#ifdef DC_CACHE_PRESSURE_STENCIL
layout(set = 1, binding = 1, std430) buffer PressureStencil {uint pressure_stencil[];};
#else
layout(set = 1, binding = 1, std430) readonly buffer PressureStencil {uint pressure_stencil[];};
#endif
layout(push_constant) uniform Params {
    uint width;
    uint height;
    uint mode;
    uint unused0;
    uint unused1;
    uint step_scale_bits;
    uint unused3;
} params;
layout(constant_id=0) const uint FLUID_PHASE=0xffffffffu;
uint dispatch_mode() {return FLUID_PHASE==0xffffffffu?params.mode:FLUID_PHASE;}


uint index_of(ivec2 p) { return uint(p.y) * params.width + uint(p.x); }

uint atlas_of(ivec2 p) {
    if (p.x < 0 || p.y < 0 || p.x >= int(params.width) ||
        p.y >= int(params.height)) return 0xffffffffu;
    uint stride = (params.width + 63u) / 64u;
    uint page = pages[(uint(p.y) / 64u) * stride + uint(p.x) / 64u];
    if (page == 0u) return 0xffffffffu;
    return (page - 1u) * 4096u + (uint(p.y) % 64u) * 64u + uint(p.x) % 64u;
}

bool open_cell(ivec2 p) {
    uint atlas = atlas_of(p);
    if (atlas == 0xffffffffu) return false;
    uint material = cells[atlas].x & 0xffffu;
    return (material == 0u || material == 2u || material == 4u ||
            material == 5u || material == 6u || material == 10u) &&
            occupancy[2u*params.width*params.height+index_of(p)] < 65536u;
}

bool wet(ivec2 p) {
    return open_cell(p) && cells[atlas_of(p)].y != 0u;
}

float face_aperture(ivec2 p,ivec2 direction) {
    ivec2 face=p+min(direction,ivec2(0));
    if(atlas_of(face)==0xffffffffu) return 0;
    uint axis=direction.x!=0?3u:4u;
    return float(65536u-min(65536u,occupancy[axis*params.width*params.height+index_of(face)]))/65536.0;
}

float pressure_at(ivec2 p) {
    if (!wet(p)) return 0.0;
    return pressure_a[index_of(p)];
}

vec2 velocity_at(ivec2 p) {
    if (p.x < 0 || p.y < 0 || p.x >= int(params.width) ||
        p.y >= int(params.height)) return vec2(0.0);
    return face_velocity[index_of(p)];
}

float divergence(ivec2 p) {
    vec2 own = velocity_at(p);
    return own.x*face_aperture(p,ivec2(1,0)) -
           velocity_at(p+ivec2(-1,0)).x*face_aperture(p,ivec2(-1,0)) +
           own.y*face_aperture(p,ivec2(0,1)) -
           velocity_at(p+ivec2(0,-1)).y*face_aperture(p,ivec2(0,-1));
}

uint stencil_base(uint index) {
    return 4u*index;
}
ivec2 stencil_delta(int axis) {
    return axis==0?ivec2(-1,0):axis==1?ivec2(1,0):axis==2?ivec2(0,-1):ivec2(0,1);
}
#ifdef DC_CACHE_PRESSURE_STENCIL
void cache_pressure_stencil(ivec2 p,uint index) {
    uint base=stencil_base(index);bool source_wet=wet(p);
    for(int axis=0;axis<4;axis++) {
        uint weight=0u;ivec2 delta=stencil_delta(axis),next=p+delta;
        if(source_wet&&open_cell(next)) {
            /* Apertures in [0,1] leave the top two float bits free. */
            weight=floatBitsToUint(face_aperture(p,delta))|0x80000000u|(wet(next)?0x40000000u:0u);
        }
        pressure_stencil[base+uint(axis)]=weight;
    }
}
#endif
float cached_pressure_value(ivec2 p,uint index) {
    uint base=stencil_base(index);float sum=0.0,count=0.0;
    for(int axis=0;axis<4;axis++) {
        uint weight=pressure_stencil[base+uint(axis)];
        if((weight&0x80000000u)!=0u) {
            float aperture=uintBitsToFloat(weight&0x3fffffffu);
            float pressure=(weight&0x40000000u)!=0u?pressure_a[index_of(p+stencil_delta(axis))]:0.0;
            sum+=aperture*pressure;count+=aperture;
        }
    }
    /* Keep divergence in the original expression: caching its rounded result
       changes contraction and the pressure bytes on partial hydraulic faces. */
    return count>0.0?(sum-divergence(p))/count:0.0;
}

float previous_vertical_at(ivec2 p) {
    if (p.x < 0 || p.y < 0 || p.x >= int(params.width) ||
        p.y >= int(params.height)) return 0.0;
    return uintBitsToFloat(previous_vertical_velocity[index_of(p)]);
}

float advected_vertical(ivec2 p) {
    float transport = 0.5 * (previous_vertical_at(p + ivec2(0, -1)) +
                             previous_vertical_at(p + ivec2(0, 1)));
    float sample_y = clamp(float(p.y) - transport * uintBitsToFloat(params.step_scale_bits), 0.0,
                           float(params.height - 1u));
    int first_y = int(floor(sample_y));
    float fraction = sample_y - float(first_y);
    return mix(previous_vertical_at(ivec2(p.x, first_y)),
               previous_vertical_at(ivec2(p.x, first_y + 1)), fraction);
}

uint neighboring_head(ivec2 p) {
    uint result=0u;
    for(int side=-1;side<=1;side+=2)
        for(int distance=1;distance<=32;distance++) {
            ivec2 q=p+ivec2(side*distance,0);uint atlas=atlas_of(q);
            if(atlas==0xffffffffu) break;
            uint material=cells[atlas].x&0xffffu;
            if(material!=0u&&material!=2u&&material!=4u&&material!=5u&&material!=6u&&material!=10u) break;
            if(occupancy[index_of(q)]!=0u) continue;
            uint head=0u;
            for(int y=q.y;y>=0;y--) {
                ivec2 above=ivec2(q.x,y);
                if(!wet(above)) break;
                head=min(head+cells[atlas_of(above)].y,64u*65536u);
            }
            result=max(result,head);break;
        }
    return result;
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (params.unused1 != 0u) {
        uint ordinal=gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x;
        if(ordinal>=pressure_work[0]) return;
        uint tile=pressure_work[4u+ordinal],stride=(params.width+15u)/16u;
        p=ivec2((tile%stride)*16u,(tile/stride)*16u)+ivec2(gl_LocalInvocationID.xy);
    } else if (params.unused0 != 0u) {
        uint tile = slot_pages[gl_WorkGroupID.z];
        if (tile == 0xffffffffu) return;
        uint stride = (params.width + 63u) / 64u;
        p += ivec2(int((tile % stride) * 64u),
                   int((tile / stride) * 64u));
    }
    if (p.x >= int(params.width) || p.y >= int(params.height)) return;
    uint index = index_of(p);
#ifdef DC_CACHE_PRESSURE_STENCIL
    if (dispatch_mode() == 6u) {
        cache_pressure_stencil(p,index);
        return;
    }
#endif
    if (dispatch_mode() == 5u) {
        previous_vertical_velocity[index] = floatBitsToUint(face_velocity[index].y);
    } else if (dispatch_mode() == 4u) {
        if (p.y != 0) return;
        uint head = 0u;
        for (uint y = 0u; y < params.height; ++y) {
            ivec2 cell = ivec2(p.x, int(y));
            uint covered=occupancy[2u*params.width*params.height+index_of(cell)];
            if(covered!=0u) {
                if(head==0u) head=neighboring_head(cell);
                else head=min(head+min(65536u,cells[atlas_of(cell)].y+covered),64u*65536u);
            } else head = wet(cell) ? min(head + cells[atlas_of(cell)].y, 64u * 65536u) : 0u;
            hydro_head[index_of(cell)] = head;
        }
    } else if (dispatch_mode() == 0u) {
        vec2 old_velocity = face_velocity[index];
        ivec2 right = p + ivec2(1, 0);
        ivec2 below = p + ivec2(0, 1);
        vec2 predicted = vec2(0.0);
        if (open_cell(p) && open_cell(right) && face_aperture(p,ivec2(1,0))>0 && (wet(p) || wet(right)))
            predicted.x = old_velocity.x * pow(0.99, uintBitsToFloat(params.step_scale_bits)) +
                0.05 * uintBitsToFloat(params.step_scale_bits) *
                (float(int(hydro_head[index]) - int(hydro_head[index_of(right)])) /
                         65536.0);
        if (open_cell(p) && open_cell(below) && face_aperture(p,ivec2(0,1))>0 && (wet(p) || wet(below))) {
            predicted.y = advected_vertical(p) *
                pow(0.99, uintBitsToFloat(params.step_scale_bits)) +
                0.5 * uintBitsToFloat(params.step_scale_bits);
        }
        face_velocity[index] = predicted;
        pressure_a[index] = wet(p) ?
            0.5 * uintBitsToFloat(params.step_scale_bits) *
            float(hydro_head[index]) / 65536.0 : 0.0;
    } else if (dispatch_mode() == 1u || dispatch_mode() == 2u) {
        if (((p.x + p.y) & 1) != int(dispatch_mode() - 1u)) return;
        float value = 0.0;
        if(params.unused3!=0u) value=cached_pressure_value(p,index);
        else if (wet(p)) {
            float sum = 0.0;
            float count = 0.0;
            for (int axis = 0; axis < 4; ++axis) {
                ivec2 delta = axis == 0 ? ivec2(-1, 0) :
                              axis == 1 ? ivec2(1, 0) :
                              axis == 2 ? ivec2(0, -1) : ivec2(0, 1);
                ivec2 next = p + delta;
                if (open_cell(next)) {
                    float aperture=face_aperture(p,delta);
                    sum += aperture*pressure_at(next);
                    count += aperture;
                }
            }
            if (count > 0.0) value = (sum - divergence(p)) / count;
        }
        pressure_a[index] = mix(pressure_a[index], value, 1.5);
    } else if (dispatch_mode() == 3u) {
        vec2 result = face_velocity[index];
        ivec2 right = p + ivec2(1, 0);
        ivec2 below = p + ivec2(0, 1);
        if (open_cell(p) && open_cell(right) && face_aperture(p,ivec2(1,0))>0 && (wet(p) || wet(right)))
            result.x -= pressure_a[index_of(right)] - pressure_a[index];
        if (open_cell(p) && open_cell(below) && face_aperture(p,ivec2(0,1))>0 && (wet(p) || wet(below)))
            result.y -= pressure_a[index_of(below)] - pressure_a[index];
        face_velocity[index] = result;
    }
}
