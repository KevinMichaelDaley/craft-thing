#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require
#define DC_RUNTIME_ROOT_READONLY 1
#include "../../include/dungeoncraft/contact_work_layout.h"
#ifdef DC_CONTACT_PIXEL_MODULE
layout(constant_id=1) const bool CONTACT_PIXEL_ONLY=true;
#else
layout(constant_id=1) const bool CONTACT_PIXEL_ONLY=false;
#endif
#define DC_RIGID_PIXEL_ONLY CONTACT_PIXEL_ONLY
#include "rigid_body.glsl"
#include "contact_boundary.glsl"
#include "contact_geometry.glsl"
#ifndef DC_CONTACT_GROUP_LANES
#define DC_CONTACT_GROUP_LANES 16
#endif
layout(local_size_x = DC_CONTACT_GROUP_LANES) in;
layout(constant_id = 0) const uint CONTACT_PHASE = 0u;
layout(constant_id = 31) const uint TYPED_CONTACT_ACTIVITY_WORD = DC_CONTACT_TYPED_ACTIVITY_WORD;
layout(constant_id = 32) const uint CONTACT_WORK_VERSION = DC_CONTACT_WORK_ABI;
const uint PIXEL_CONTACT_DISPATCH_WORD = 10u;

struct Particle {
    int x_fp, y_fp, vx_fp, vy_fp;
    float f00, f01, f10, f11;
    uint id_lo, id_hi, mass_fp, grain_fp, material, flags;
};
layout(set = 0, binding = 1, std430) readonly buffer ChunkCells { uvec2 chunk_cells[]; };
layout(set = 0, binding = 2, std430) readonly buffer Pages { uint pages[]; };
layout(set = 0, binding = 19, std430) readonly buffer Particles { Particle particles[]; };
layout(set = 0, binding = 27, std430) buffer PixelContactDispatch { uint pixel_dispatch[]; };
#ifndef DC_RUNTIME_BODY_STORAGE
layout(set = 0, binding = 4, std430) buffer Bodies { Body bodies[BODY_CAPACITY]; uint data[]; };
#endif
uint pixel_word_at(uint index) {return DC_PIXEL_WORD(index);}
layout(push_constant) uniform Params {
    uint width, height, mode, body_count;
    uvec2 origin_x, origin_y;
} params;

const uint HEADER_WORDS = 8u, PAIR_WORDS = 8u;
#define PAIR_CAPACITY DC_LAYOUT_PAIR_CAPACITY
const uint CONTACT_HEADER_WORDS = 12u, CONTACT_GROUP_SIZE = DC_CONTACT_GROUP_LANES;
const uint CONTACT_WORDS = 32u;
const uint BODY_CONTACT = 0u, TERRAIN_CONTACT = 1u, BOUNDARY_CONTACT = 2u, MPM_CONTACT = 3u;
const uint PAIR_CONTACT_FOUND=1u,PAIR_COLLIDABLE_TERRAIN=2u;
shared uint group_found;
shared uint group_work_first;
shared uint body_kinds[64];
#ifndef DC_CONTACT_TERRAIN_CACHE
#define DC_CONTACT_TERRAIN_CACHE 1
#endif
#ifdef DC_RUNTIME_BODY_STORAGE
uint terrain_cache_base() {return 4u+DC_LAYOUT_PAIR_CAPACITY*DC_CONTACT_PIXEL_GROUPS*2u;}
void cache_terrain_presence() {
    uint lane=gl_LocalInvocationIndex;
    uint tile=gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x;
    uint page=pages[tile];
    if(lane==0u) group_found=0u;
    barrier();
    if(page!=0u) for(uint cell=lane;cell<4096u;cell+=CONTACT_GROUP_SIZE) {
        uint material=chunk_cells[(page-1u)*4096u+cell].x&65535u;
        if(material==0u||material==3u) continue;
        if(material==2u||material==4u||material==5u||material==6u||material==10u) {
            uint particle=(page-1u)*8192u+cell;
            if(particles[particle].mass_fp==0u&&particles[particle+4096u].mass_fp==0u) continue;
        }
        atomicOr(group_found,1u);break;
    }
    barrier();
    if(lane==0u) DC_CONTACT_WORK(terrain_cache_base()+tile)=group_found;
}
#endif

uvec2 page_extent() { return uvec2((params.width + 63u) / 64u, (params.height + 63u) / 64u); }
uint pair_base() { uvec2 size = page_extent() + 2u; return HEADER_WORDS + 2u * size.x * size.y; }
uint contact_base() { return pair_base() + PAIR_CAPACITY * PAIR_WORDS; }
#include "contact_boundary_cache.glsl"

uint body_slot(uint id) {
#ifdef DC_RUNTIME_BODY_STORAGE
    return runtime_body_find(id);
#else
    for (uint i = 0u; i < params.body_count; ++i)
        if (DC_BODY(i).enabled != 0u && DC_BODY(i).id == id) return i;
    return BODY_CAPACITY;
#endif
}

bool relative_body(Body a, Body b, out vec2 offset) {
    int x, y;
    if (!relative_chunk(b.chunk_x, a.chunk_x, x) || !relative_chunk(b.chunk_y, a.chunk_y, y)) return false;
    ivec2 fixed_offset = ivec2(x, y) * (64 << 16) + b.local_fp - a.local_fp;
    offset = vec2(fixed_offset) / 65536.0;
    return true;
}

bool world_point(Body body, vec2 point, out uvec2 chunk_x, out uvec2 chunk_y, out ivec2 local_fp) {
    ivec2 fixed_point = body.local_fp + ivec2(round(point * 65536.0));
    if (!shifted_chunk(body.chunk_x, fixed_point.x >> 22, chunk_x) ||
        !shifted_chunk(body.chunk_y, fixed_point.y >> 22, chunk_y)) return false;
    local_fp = fixed_point & ivec2((64 << 16) - 1);
    return true;
}

float body_friction(uint material) { return material == 2u ? 0.6 : 0.7; }
float cell_friction(uint material) { return material == 4u ? 0.8 : material == 2u ? 0.6 : 0.7; }
uint contact_feature(Body body,uint piece,uint feature) {
    return pixel_body(body)?(feature&0x80000007u)|(piece<<3u):feature|(piece<<28u);
}

bool emit_contact(Body a, uint body_b, uint kind, uint material_b, uint cell_feature,
                  uvec2 feature_x, uvec2 feature_y, Polygon pa, Polygon pb,uint piece_a,uint piece_b,uint particle_ref) {
    vec2 normal; float depth;
    if (!polygon_contact(pa, pb, normal, depth)) return false;
    if(pixel_body(a)) {
        vec2 outward=body_rotate(-normal,-a.angle);ivec2 p=pixel_piece_cell(a,piece_a);
        bool exposed=(abs(outward.x)>1e-5&&pixel_material(a,p+ivec2(outward.x>0?1:-1,0))==0u)||
            (abs(outward.y)>1e-5&&pixel_material(a,p+ivec2(0,outward.y>0?1:-1))==0u);
        if(!exposed) return false;
    }
    uint other_slot=kind==BODY_CONTACT?body_slot(body_b):BODY_CAPACITY;
    Body other=a;
    if(other_slot<BODY_CAPACITY) {
        other=DC_BODY(other_slot);
        if(pixel_body(other)) {
            vec2 outward=body_rotate(normal,-other.angle);ivec2 p=pixel_piece_cell(other,piece_b);
            bool exposed=(abs(outward.x)>1e-5&&pixel_material(other,p+ivec2(outward.x>0?1:-1,0))==0u)||
                (abs(outward.y)>1e-5&&pixel_material(other,p+ivec2(0,outward.y>0?1:-1))==0u);
            if(!exposed) return false;
        }
    }
    vec2 point_a, point_b; uint feature_a, feature_b;
    contact_witnesses(pa, pb, normal, point_a, point_b, feature_a, feature_b);
    uvec2 ax, ay, bx, by; ivec2 alocal, blocal;
    uint base = contact_base();
    if (!world_point(a, point_a, ax, ay, alocal) || !world_point(a, point_b, bx, by, blocal)) {
        atomicOr(DC_DATA(base + 2u), 2u);
        return true;
    }
    uint index = atomicAdd(DC_DATA(base + 1u), 1u);
    if (index >= DC_DATA(base + 3u)) {
        atomicOr(DC_DATA(base + 2u), 1u);
#ifdef DC_RUNTIME_BODY_STORAGE
        if(DC_DATA(base+3u)==DC_LAYOUT_CONTACT_CAPACITY) atomicMax(DC_RUNTIME_REQUEST(7u),index+1u);
#endif
        return true;
    }
    uint offset = base + CONTACT_HEADER_WORDS + index * CONTACT_WORDS;
    uint material_a = piece_material(a,piece_a);
    if(material_a==0u) material_a=1u;
    float fa = body_friction(material_a);
    float fb = kind == BODY_CONTACT ? body_friction(material_b) : cell_friction(material_b);
    float restitution_a = material_a == 2u ? 0.1 : 0.05;
    float restitution_b = kind == BODY_CONTACT && material_b == 2u ? 0.1 : 0.05;
    float compliance = kind == MPM_CONTACT ? 0.0001 :
        (material_a == 2u || (kind == BODY_CONTACT && material_b == 2u) ? 0.00002 : 0.0);
    DC_DATA(offset) = a.id; DC_DATA(offset + 1u) = body_b; DC_DATA(offset + 2u) = kind;
    DC_DATA(offset + 3u) = contact_feature(a,piece_a,feature_a);
    DC_DATA(offset + 4u) = kind == BODY_CONTACT ? contact_feature(other,piece_b,feature_b) : cell_feature;
    DC_DATA(offset + 5u) = material_a; DC_DATA(offset + 6u) = material_b; DC_DATA(offset + 7u) = particle_ref;
    DC_DATA(offset + 8u) = floatBitsToUint(normal.x); DC_DATA(offset + 9u) = floatBitsToUint(normal.y);
    DC_DATA(offset + 10u) = floatBitsToUint(depth); DC_DATA(offset + 11u) = floatBitsToUint(sqrt(fa * fb));
    DC_DATA(offset + 12u) = floatBitsToUint(min(restitution_a, restitution_b));
    DC_DATA(offset + 13u) = floatBitsToUint(compliance); DC_DATA(offset + 14u) = 0u; DC_DATA(offset + 15u) = 0u;
    DC_DATA(offset + 16u) = ax.x; DC_DATA(offset + 17u) = ax.y;
    DC_DATA(offset + 18u) = ay.x; DC_DATA(offset + 19u) = ay.y;
    DC_DATA(offset + 20u) = uint(alocal.x); DC_DATA(offset + 21u) = uint(alocal.y);
    DC_DATA(offset + 22u) = bx.x; DC_DATA(offset + 23u) = bx.y;
    DC_DATA(offset + 24u) = by.x; DC_DATA(offset + 25u) = by.y;
    DC_DATA(offset + 26u) = uint(blocal.x); DC_DATA(offset + 27u) = uint(blocal.y);
    DC_DATA(offset + 28u) = feature_x.x; DC_DATA(offset + 29u) = feature_x.y;
    DC_DATA(offset + 30u) = feature_y.x; DC_DATA(offset + 31u) = feature_y.y;
    atomicAdd(DC_DATA(base), 1u);
    if(particle_ref!=0u) atomicAdd(DC_DATA(base+CONTACT_HEADER_WORDS+DC_LAYOUT_CONTACT_CAPACITY*CONTACT_WORDS+13u),1u);
    return true;
}

bool emit_contact(Body a,uint body_b,uint kind,uint material_b,uint cell_feature,
    uvec2 feature_x,uvec2 feature_y,Polygon pa,Polygon pb,uint piece_a,uint piece_b) {
    return emit_contact(a,body_b,kind,material_b,cell_feature,feature_x,feature_y,
        pa,pb,piece_a,piece_b,0u);
}

bool terrain_contacts(Body body, uint kind, uvec2 chunk_x, uvec2 chunk_y, Polygon polygon,uint piece) {
    int cx, cy;
    if (!relative_chunk(chunk_x, params.origin_x, cx) || !relative_chunk(chunk_y, params.origin_y, cy)) return false;
    ivec2 tile = ivec2(cx, cy), tile_low = tile * 64;
    ivec2 current = ivec2(body.x_fp, body.y_fp);
    vec2 shape_low=vec2(1e20),shape_high=vec2(-1e20);
    for(uint vertex=0u;vertex<polygon.count;vertex++) {shape_low=min(shape_low,polygon.vertices[vertex]);shape_high=max(shape_high,polygon.vertices[vertex]);}
    ivec2 low = max(ivec2(floor(vec2(current)/65536.0+shape_low))-1,tile_low);
    ivec2 high = min(ivec2(ceil(vec2(current)/65536.0+shape_high))+1,tile_low+64);
    uint page = 0u;
    if (kind != BOUNDARY_CONTACT && all(greaterThanEqual(tile, ivec2(0))) &&
        all(lessThan(tile, ivec2(page_extent())))) page = pages[uint(cy) * page_extent().x + uint(cx)];
    bool found = false;
    for (int y = low.y; y < high.y; ++y) for (int x = low.x; x < high.x; ++x) {
        uint cell_feature = uint(y - tile_low.y) * 64u + uint(x - tile_low.x);
        uint contact_kind = kind, material = 0xffffffffu;
        if (page != 0u && x >= 0 && y >= 0 && x < int(params.width) && y < int(params.height)) {
            material = chunk_cells[(page - 1u) * 4096u + cell_feature].x & 0xffffu;
            if (material == 0u || material == 3u) continue;
            if (material == 2u || material == 4u || material == 5u || material == 6u || material == 10u) {
                uint pi = (page - 1u) * 8192u + cell_feature;
                for(uint layer=0u;layer<2u;layer++) {
                    Particle grain=particles[pi+layer*4096u];if(grain.mass_fp==0u) continue;
                    float radius=float(grain.grain_fp)/65536.;
                    vec2 center=vec2(tile_low)+vec2(grain.x_fp,grain.y_fp)/65536.-vec2(current)/65536.;
                    /* Grain axes include world X/Y, so this rejects only
                       candidates that the exact SAT would also reject. */
                    if(any(lessThan(center+vec2(radius),shape_low-vec2(contact_skin)))||
                       any(greaterThan(center-vec2(radius),shape_high+vec2(contact_skin)))) continue;
                    Polygon grain_shape=cell_polygon(center-vec2(radius));
                    for(uint vertex=0u;vertex<4u;vertex++)
                        grain_shape.vertices[vertex]=center-vec2(radius)+
                            (grain_shape.vertices[vertex]-(center-vec2(radius)))*(2.*radius);
                    bool emitted=emit_contact(body,0u,MPM_CONTACT,grain.material,cell_feature|(layer<<12u),
                        chunk_x,chunk_y,polygon,grain_shape,piece,0u,pi+layer*4096u+1u);
                    found=found||emitted;
                }
                continue;
            }
        } else contact_kind = BOUNDARY_CONTACT;
        vec2 offset = vec2((ivec2(x, y) << 16) - current) / 65536.0;
        if(any(lessThan(offset+vec2(1),shape_low-vec2(contact_skin)))||
           any(greaterThan(offset,shape_high+vec2(contact_skin)))) continue;
        bool emitted = emit_contact(body, 0u, contact_kind, material, cell_feature,
            chunk_x, chunk_y, polygon, cell_polygon(offset),piece,0u);
        found = found || emitted;
    }
    return found;
}

uint body_contact_scan(Body a,out uvec4 scan,out bool rectangle,out bool single_tile) {
    uint count=body_pieces(a);scan=uvec4(0);rectangle=false;
    single_tile=pixel_body(a)&&count==256u;
    if(pixel_body(a)) {
        uvec2 low=uvec2(pixel_low(a)),extent=uvec2(pixel_high(a))-low;
        if(extent.y!=0u&&extent.x<=count/extent.y) {
            scan=uvec4(low,extent);count=extent.x*extent.y;rectangle=true;
        }
    }
    return count;
}
uvec4 terrain_contact_scan(Body a,uint offset) {
    if(!pixel_body(a)) return uvec4(0,0,body_pieces(a),1);
    int x,y;
    if(!relative_chunk(uvec2(DC_DATA(offset+4u),DC_DATA(offset+5u)),a.chunk_x,x)||
       !relative_chunk(uvec2(DC_DATA(offset+6u),DC_DATA(offset+7u)),a.chunk_y,y)) return uvec4(0);
    vec2 low=vec2(x,y)*64.-vec2(a.local_fp)/65536.;
    return body_piece_query(a,low-vec2(contact_skin),low+64.+vec2(contact_skin));
}

void main() {
    if(CONTACT_WORK_VERSION!=DC_CONTACT_WORK_ABI) return;
    if(CONTACT_PHASE==7u) {
#ifdef DC_RUNTIME_BODY_STORAGE
        cache_body_boundaries();
#endif
        return;
    }
#ifdef DC_RUNTIME_BODY_STORAGE
    contact_boundary_cached=(params.mode&4096u)!=0u;
    contact_boundary_cache_base=boundary_cache_base();
    contact_boundary_geometry_base=DC_RUNTIME_WORK(52u);
    contact_boundary_geometry_capacity=2u*DC_RUNTIME_WORK(29u);
#endif
    if(CONTACT_PHASE==6u) {
#ifdef DC_RUNTIME_BODY_STORAGE
        cache_terrain_presence();
#endif
        return;
    }
    if(CONTACT_PHASE==5u) {
#ifdef DC_RUNTIME_BODY_STORAGE
        if(gl_GlobalInvocationID.x==0u) {
            uint count=DC_CONTACT_WORK(0u);
            pixel_dispatch[TYPED_CONTACT_ACTIVITY_WORD]=min(count,65535u);
            pixel_dispatch[TYPED_CONTACT_ACTIVITY_WORD+1u]=count==0u?1u:(count-1u)/65535u+1u;
            pixel_dispatch[TYPED_CONTACT_ACTIVITY_WORD+2u]=1u;
        }
#endif
        return;
    }
    bool planner=CONTACT_PHASE==4u;
    bool cooperative = CONTACT_PHASE == 2u || planner;
    uint index = cooperative ? gl_WorkGroupID.x : gl_GlobalInvocationID.x;
    uint pair_group=gl_WorkGroupID.y,pair_groups=DC_CONTACT_PIXEL_GROUPS;
#ifdef DC_RUNTIME_BODY_STORAGE
    if(CONTACT_PIXEL_ONLY&&CONTACT_PHASE==2u) {
        uint work=gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x;
        if(work>=DC_CONTACT_WORK(0u)) return;
        index=DC_CONTACT_WORK(4u+work*2u);
        uint packed=DC_CONTACT_WORK(5u+work*2u);
        pair_group=packed&65535u;pair_groups=packed>>16u;
    }
#endif
    uint lane = gl_LocalInvocationID.x, base = contact_base();
    /* Keep nearby constraints available when another Jacobi correction closes
       a gap within this substep. Diagnostics retain the exact overlap skin. */
    uint solver = base + CONTACT_HEADER_WORDS + DC_LAYOUT_CONTACT_CAPACITY * CONTACT_WORDS;
    contact_skin = DC_DATA(solver + 9u) != 0u ? 0.25 : CONTACT_SKIN;
    if (CONTACT_PHASE == 0u) {
#ifdef DC_RUNTIME_BODY_STORAGE
        if(lane==0u) DC_CONTACT_WORK(0u)=0u;
#endif
        uint kind=0u;
        for(uint body=lane;body<params.body_count;body+=CONTACT_GROUP_SIZE)
            if(DC_BODY(body).enabled!=0u) kind|=pixel_body(DC_BODY(body))?1u:2u;
        body_kinds[lane]=kind;
        barrier();
        for(uint stride=CONTACT_GROUP_SIZE/2u;stride>0u;stride/=2u) {
            if(lane<stride) body_kinds[lane]|=body_kinds[lane+stride];
            barrier();
        }
        bool pixels=(body_kinds[0]&1u)!=0u;
        bool typed=pixels&&(body_kinds[0]&2u)==0u&&(params.mode&1024u)!=0u&&(params.mode&512u)==0u;
        if(lane<CONTACT_HEADER_WORDS&&lane!=3u) {
            uint value=0u;
            if(lane==2u) value=DC_DATA(2)==0u?0u:4u;
            else if(lane==4u) value=DC_DATA(0);
            else if(lane==6u) value=DC_DATA(2)==0u?(DC_DATA(0)+CONTACT_GROUP_SIZE-1u)/CONTACT_GROUP_SIZE:0u;
            else if(lane==7u||lane==8u) value=1u;
            DC_DATA(base+lane)=value;
        }
        if(lane<3u) {
            DC_DATA(solver+13u+lane)=lane==0u?0u:1u;
            DC_DATA(solver+PIXEL_CONTACT_DISPATCH_WORD+lane)=lane==0u?(pixels&&!typed&&DC_DATA(2)==0u?DC_DATA(0):0u):1u;
            uint candidate_count=typed&&DC_DATA(2)==0u?DC_DATA(0):0u;
            pixel_dispatch[TYPED_CONTACT_ACTIVITY_WORD+lane]=lane==0u?candidate_count:
                lane==1u&&candidate_count!=0u?DC_CONTACT_PIXEL_GROUPS:1u;
            pixel_dispatch[DC_CONTACT_PLAN_ACTIVITY_WORD+lane]=lane==0u?candidate_count:1u;
            pixel_dispatch[DC_CONTACT_FINISH_ACTIVITY_WORD+lane]=lane==0u?(candidate_count+CONTACT_GROUP_SIZE-1u)/CONTACT_GROUP_SIZE:1u;
        }
        return;
    }
    if (DC_DATA(2) != 0u || index >= DC_DATA(0)) return;
    uint offset = pair_base() + index * PAIR_WORDS;
    if(CONTACT_PHASE==3u) {
        if(pixel_dispatch[DC_CONTACT_PLAN_ACTIVITY_WORD]!=0u &&
           (atomicExchange(DC_DATA(offset+3u),0u)&PAIR_CONTACT_FOUND)==0u) atomicAdd(DC_DATA(base+5u),1u);
        return;
    }
    if(planner&&lane==0u) DC_DATA(offset+3u)=0u;
    uint slot = body_slot(DC_DATA(offset));
    if (slot == BODY_CAPACITY) {
        if (!cooperative&&pixel_dispatch[TYPED_CONTACT_ACTIVITY_WORD]==0u) atomicAdd(DC_DATA(base + 5u), 1u);
        return;
    }
    Body a = DC_BODY(slot);
    uint kind = DC_DATA(offset + 2u); bool found = false;
    bool pixel_candidate = pixel_body(a);
    if (kind==BODY_CONTACT) {
        uint other = body_slot(DC_DATA(offset+1u));
        if (other!=BODY_CAPACITY) pixel_candidate = pixel_candidate || pixel_body(DC_BODY(other));
    }
    if (cooperative != pixel_candidate) return;
    if (cooperative) {
        if (lane == 0u) group_found = 0u;
        barrier();
    }
    if (cooperative && kind == TERRAIN_CONTACT) {
        if(CONTACT_PIXEL_ONLY&&!planner) {
            if((atomicOr(DC_DATA(offset+3u),0u)&PAIR_COLLIDABLE_TERRAIN)==0u) return;
        } else {
        int cx, cy;
        if (relative_chunk(uvec2(DC_DATA(offset+4u),DC_DATA(offset+5u)),params.origin_x,cx) &&
            relative_chunk(uvec2(DC_DATA(offset+6u),DC_DATA(offset+7u)),params.origin_y,cy) &&
            cx >= 0 && cy >= 0 && (cx+1)*64 <= int(params.width) && (cy+1)*64 <= int(params.height)) {
            uint page = pages[uint(cy)*page_extent().x+uint(cx)];
            if (page != 0u) {
#if defined(DC_RUNTIME_BODY_STORAGE) && DC_CONTACT_TERRAIN_CACHE
                if((params.mode&2048u)!=0u) {
                    if(lane==0u) group_found=DC_CONTACT_WORK(terrain_cache_base()+uint(cy)*page_extent().x+uint(cx));
                } else
#endif
                {
#ifdef DC_TERRAIN_SCAN_PROFILE
                uint scanned=0u;
#endif
                for (uint cell=lane; cell<4096u; cell+=CONTACT_GROUP_SIZE) {
#ifdef DC_TERRAIN_SCAN_PROFILE
                    scanned++;
#endif
                    uint material=chunk_cells[(page-1u)*4096u+cell].x&0xffffu;
                    if (material==0u || material==3u) continue;
                    if (material==2u || material==4u || material==5u || material==6u || material==10u) {
                        uint pi=(page-1u)*8192u+cell;
                        if (particles[pi].mass_fp==0u && particles[pi+4096u].mass_fp==0u) continue;
                    }
                    atomicOr(group_found,1u);
                    break;
                }
#ifdef DC_TERRAIN_SCAN_PROFILE
                if ((params.mode&256u)!=0u) atomicAdd(DC_DATA(base+9u),scanned);
#endif
                }
                barrier();
                bool empty_terrain = group_found == 0u;
                barrier();
                if (empty_terrain) {
                    if (lane==0u&&!planner) atomicAdd(DC_DATA(base+5u),1u);
                    return;
                }
                if (lane==0u) group_found=0u;
                barrier();
            }
        }
        }
    }
    if(planner) {
#ifdef DC_RUNTIME_BODY_STORAGE
        uvec4 scan;bool rectangle,single_tile;
        uint count=kind==BODY_CONTACT?body_contact_scan(a,scan,rectangle,single_tile):
            0u;
        if(kind!=BODY_CONTACT) {scan=terrain_contact_scan(a,offset);count=scan.z*scan.w;}
        uint groups=count==0u?0u:min(DC_CONTACT_PIXEL_GROUPS,(count-1u)/CONTACT_GROUP_SIZE+1u);
        if(lane==0u) {
            DC_DATA(offset+3u)=PAIR_COLLIDABLE_TERRAIN;
            group_work_first=atomicAdd(DC_CONTACT_WORK(0u),groups);
        }
        barrier();
        if(lane<groups) {
            uint work=group_work_first+lane;
            DC_CONTACT_WORK(4u+work*2u)=index;
            DC_CONTACT_WORK(5u+work*2u)=lane|(groups<<16u);
        }
#else
        if(lane==0u) DC_DATA(offset+3u)=PAIR_COLLIDABLE_TERRAIN;
#endif
        return;
    }
    uint work_lane=lane+(CONTACT_PIXEL_ONLY?pair_group*CONTACT_GROUP_SIZE:0u);
    uint work_stride=CONTACT_GROUP_SIZE*(CONTACT_PIXEL_ONLY?pair_groups:1u);
    if (kind == BODY_CONTACT) {
        uint other = body_slot(DC_DATA(offset + 1u)); vec2 delta;
        if (other != BODY_CAPACITY && relative_body(a, DC_BODY(other), delta)) {
            Body b = DC_BODY(other);
            bool distribute_b=cooperative&&!pixel_body(a)&&pixel_body(b);
            uvec4 scan;bool rectangle,single_tile;
            uint work_count=body_contact_scan(a,scan,rectangle,single_tile);
            if(pixel_body(a)) {
                if((params.mode&256u)!=0u&&lane==0u&&(!CONTACT_PIXEL_ONLY||pair_group==0u)) atomicAdd(DC_DATA(base+9u),work_count);
            }
            if(CONTACT_PIXEL_ONLY&&pair_group*CONTACT_GROUP_SIZE>=work_count) return;
            for(uint ordinal=cooperative&&!distribute_b?work_lane:0u;ordinal<work_count;ordinal+=cooperative&&!distribute_b?work_stride:1u) {
                uint ap=rectangle?(single_tile?
                    ((scan.y+ordinal/scan.z)%16u)*16u+(scan.x+ordinal%scan.z)%16u:
                    query_piece(a,scan,ordinal)):ordinal;
                if(!contact_pixel_boundary(a,ap,CONTACT_PIXEL_ONLY&&work_count>=256u&&(!rectangle||scan.z>=8u)&&contact_dense_pixel_body(a))) continue;
                if((params.mode&256u)!=0u&&(!distribute_b||lane==0u)) atomicAdd(DC_DATA(base+10u),1u);
                Polygon pa=body_polygon(a,ap,vec2(0));vec2 lo=vec2(1e20),hi=vec2(-1e20);
                for(uint vertex=0u;vertex<pa.count;vertex++) {lo=min(lo,pa.vertices[vertex]-delta);hi=max(hi,pa.vertices[vertex]-delta);}
                uvec4 query=body_piece_query(b,lo-vec2(contact_skin),hi+vec2(contact_skin));
                if((params.mode&256u)!=0u&&pixel_body(b)&&(!distribute_b||lane==0u)) atomicAdd(DC_DATA(base+9u),query.z*query.w);
                for(uint ordinal=distribute_b?lane:0u;ordinal<query.z*query.w;ordinal+=distribute_b?CONTACT_GROUP_SIZE:1u) {
                    uint bp=query_piece(b,query,ordinal);if(!contact_pixel_boundary(b,bp,false)) continue;
                    if((params.mode&256u)!=0u) atomicAdd(DC_DATA(base+11u),1u);
                bool emitted=emit_contact(a, b.id, BODY_CONTACT, piece_material(b,bp),
                    0u, uvec2(0), uvec2(0), pa, body_polygon(b,bp,delta),ap,bp);
                found=found || emitted;
                }
            }
        }
    } else {
        uvec4 query=terrain_contact_scan(a,offset);
        if(pixel_body(a)) {
            if ((params.mode&256u)!=0u&&lane==0u&&(!CONTACT_PIXEL_ONLY||pair_group==0u)) atomicAdd(DC_DATA(base+9u),query.z*query.w);
        }
        if(CONTACT_PIXEL_ONLY&&pair_group*CONTACT_GROUP_SIZE>=query.z*query.w) return;
        for(uint ordinal=cooperative?work_lane:0u;ordinal<query.z*query.w;ordinal+=cooperative?work_stride:1u) {
            uint ap=query_piece(a,query,ordinal);
            if(!contact_pixel_boundary(a,ap,CONTACT_PIXEL_ONLY&&query.z>=8u&&query.z*query.w>=256u&&contact_dense_pixel_body(a))) continue;
            if((params.mode&256u)!=0u) atomicAdd(DC_DATA(base+10u),1u);
            bool emitted=terrain_contacts(a, kind, uvec2(DC_DATA(offset + 4u), DC_DATA(offset + 5u)),
                uvec2(DC_DATA(offset + 6u), DC_DATA(offset + 7u)), body_polygon(a,ap,vec2(0)),ap);
            found=found || emitted;
        }
    }
    if (cooperative) {
        if (found) atomicOr(group_found, 1u);
        barrier();
        if (lane == 0u) {
            if(CONTACT_PIXEL_ONLY) {
                if(group_found!=0u) atomicOr(DC_DATA(offset+3u),PAIR_CONTACT_FOUND);
            } else if(group_found==0u) atomicAdd(DC_DATA(base+5u),1u);
        }
    } else if (!found) atomicAdd(DC_DATA(base + 5u), 1u);
}
