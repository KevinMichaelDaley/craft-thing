#version 450
#extension GL_GOOGLE_include_directive : require
#include "../../include/dungeoncraft/contact_work_layout.h"
layout(constant_id=1) const bool CONTACT_PIXEL_ONLY=false;
#define DC_RIGID_PIXEL_ONLY CONTACT_PIXEL_ONLY
#include "rigid_body.glsl"
#include "contact_geometry.glsl"
layout(local_size_x = 64) in;
layout(constant_id = 0) const uint CONTACT_PHASE = 0u;
layout(constant_id = 31) const uint TYPED_CONTACT_ACTIVITY_WORD = DC_CONTACT_TYPED_ACTIVITY_WORD;
layout(constant_id = 32) const uint CONTACT_WORK_VERSION = DC_CONTACT_WORK_ABI;
const uint PIXEL_CONTACT_DISPATCH_WORD = 10u;

struct Particle {
    int x_fp, y_fp, vx_fp, vy_fp;
    float f00, f01, f10, f11;
    uint id_lo, id_hi, mass_fp, grain_fp, material, flags;
};
layout(set = 0, binding = 1, std430) readonly buffer ChunkCells { uvec2 chunk_cells[]; };
layout(set = 0, binding = 2, std430) readonly buffer Pages { uint pages[]; };
layout(set = 0, binding = 19, std430) readonly buffer Particles { Particle particles[]; };
layout(set = 0, binding = 27, std430) buffer PixelContactDispatch { uint pixel_dispatch[]; };
layout(set = 0, binding = 4, std430) buffer Bodies { Body bodies[BODY_CAPACITY]; uint data[]; };
uint pixel_word_at(uint index) {return data[index-BODY_STORAGE_WORDS];}
layout(push_constant) uniform Params {
    uint width, height, mode, body_count;
    uvec2 origin_x, origin_y;
} params;

const uint HEADER_WORDS = 8u, PAIR_WORDS = 8u, PAIR_CAPACITY = 4096u;
const uint CONTACT_HEADER_WORDS = 12u, CONTACT_GROUP_SIZE = 64u;
const uint CONTACT_WORDS = 32u;
const uint BODY_CONTACT = 0u, TERRAIN_CONTACT = 1u, BOUNDARY_CONTACT = 2u, MPM_CONTACT = 3u;
const uint PAIR_CONTACT_FOUND=1u,PAIR_COLLIDABLE_TERRAIN=2u;
shared uint group_found;
shared uint body_kinds[BODY_CAPACITY];

uvec2 page_extent() { return uvec2((params.width + 63u) / 64u, (params.height + 63u) / 64u); }
uint pair_base() { uvec2 size = page_extent() + 2u; return HEADER_WORDS + 2u * size.x * size.y; }
uint contact_base() { return pair_base() + PAIR_CAPACITY * PAIR_WORDS; }

uint body_slot(uint id) {
    for (uint i = 0u; i < params.body_count; ++i)
        if (bodies[i].enabled != 0u && bodies[i].id == id) return i;
    return BODY_CAPACITY;
}

bool relative_body(Body a, Body b, out vec2 offset) {
    int x, y;
    if (!relative_chunk(b.chunk_x, a.chunk_x, x) || !relative_chunk(b.chunk_y, a.chunk_y, y)) return false;
    ivec2 fixed_offset = ivec2(x, y) * (64 << 16) + b.local_fp - a.local_fp;
    offset = vec2(fixed_offset) / 65536.0;
    return true;
}

bool world_point(Body body, vec2 point, out uvec2 chunk_x, out uvec2 chunk_y, out ivec2 local_fp) {
    ivec2 fixed_point = body.local_fp + ivec2(round(point * 65536.0));
    if (!shifted_chunk(body.chunk_x, fixed_point.x >> 22, chunk_x) ||
        !shifted_chunk(body.chunk_y, fixed_point.y >> 22, chunk_y)) return false;
    local_fp = fixed_point & ivec2((64 << 16) - 1);
    return true;
}

float body_friction(uint material) { return material == 2u ? 0.6 : 0.7; }
float cell_friction(uint material) { return material == 4u ? 0.8 : material == 2u ? 0.6 : 0.7; }
uint contact_feature(Body body,uint piece,uint feature) {
    return pixel_body(body)?(feature&0x80000007u)|(piece<<3u):feature|(piece<<28u);
}

bool emit_contact(Body a, uint body_b, uint kind, uint material_b, uint cell_feature,
                  uvec2 feature_x, uvec2 feature_y, Polygon pa, Polygon pb,uint piece_a,uint piece_b) {
    vec2 normal; float depth;
    if (!polygon_contact(pa, pb, normal, depth)) return false;
    if(pixel_body(a)) {
        vec2 outward=body_rotate(-normal,-a.angle);ivec2 p=pixel_piece_cell(a,piece_a);
        bool exposed=(abs(outward.x)>1e-5&&pixel_material(a,p+ivec2(outward.x>0?1:-1,0))==0u)||
            (abs(outward.y)>1e-5&&pixel_material(a,p+ivec2(0,outward.y>0?1:-1))==0u);
        if(!exposed) return false;
    }
    uint other_slot=kind==BODY_CONTACT?body_slot(body_b):BODY_CAPACITY;
    Body other=a;
    if(other_slot<BODY_CAPACITY) {
        other=bodies[other_slot];
        if(pixel_body(other)) {
            vec2 outward=body_rotate(normal,-other.angle);ivec2 p=pixel_piece_cell(other,piece_b);
            bool exposed=(abs(outward.x)>1e-5&&pixel_material(other,p+ivec2(outward.x>0?1:-1,0))==0u)||
                (abs(outward.y)>1e-5&&pixel_material(other,p+ivec2(0,outward.y>0?1:-1))==0u);
            if(!exposed) return false;
        }
    }
    vec2 point_a, point_b; uint feature_a, feature_b;
    contact_witnesses(pa, pb, normal, point_a, point_b, feature_a, feature_b);
    uvec2 ax, ay, bx, by; ivec2 alocal, blocal;
    uint base = contact_base();
    if (!world_point(a, point_a, ax, ay, alocal) || !world_point(a, point_b, bx, by, blocal)) {
        atomicOr(data[base + 2u], 2u);
        return true;
    }
    uint index = atomicAdd(data[base + 1u], 1u);
    if (index >= data[base + 3u]) { atomicOr(data[base + 2u], 1u); return true; }
    uint offset = base + CONTACT_HEADER_WORDS + index * CONTACT_WORDS;
    uint material_a = piece_material(a,piece_a);
    if(material_a==0u) material_a=1u;
    float fa = body_friction(material_a);
    float fb = kind == BODY_CONTACT ? body_friction(material_b) : cell_friction(material_b);
    float restitution_a = material_a == 2u ? 0.1 : 0.05;
    float restitution_b = kind == BODY_CONTACT && material_b == 2u ? 0.1 : 0.05;
    float compliance = kind == MPM_CONTACT ? 0.0001 :
        (material_a == 2u || (kind == BODY_CONTACT && material_b == 2u) ? 0.00002 : 0.0);
    data[offset] = a.id; data[offset + 1u] = body_b; data[offset + 2u] = kind;
    data[offset + 3u] = contact_feature(a,piece_a,feature_a);
    data[offset + 4u] = kind == BODY_CONTACT ? contact_feature(other,piece_b,feature_b) : cell_feature;
    data[offset + 5u] = material_a; data[offset + 6u] = material_b; data[offset + 7u] = 0u;
    data[offset + 8u] = floatBitsToUint(normal.x); data[offset + 9u] = floatBitsToUint(normal.y);
    data[offset + 10u] = floatBitsToUint(depth); data[offset + 11u] = floatBitsToUint(sqrt(fa * fb));
    data[offset + 12u] = floatBitsToUint(min(restitution_a, restitution_b));
    data[offset + 13u] = floatBitsToUint(compliance); data[offset + 14u] = 0u; data[offset + 15u] = 0u;
    data[offset + 16u] = ax.x; data[offset + 17u] = ax.y;
    data[offset + 18u] = ay.x; data[offset + 19u] = ay.y;
    data[offset + 20u] = uint(alocal.x); data[offset + 21u] = uint(alocal.y);
    data[offset + 22u] = bx.x; data[offset + 23u] = bx.y;
    data[offset + 24u] = by.x; data[offset + 25u] = by.y;
    data[offset + 26u] = uint(blocal.x); data[offset + 27u] = uint(blocal.y);
    data[offset + 28u] = feature_x.x; data[offset + 29u] = feature_x.y;
    data[offset + 30u] = feature_y.x; data[offset + 31u] = feature_y.y;
    atomicAdd(data[base], 1u);
    return true;
}

bool terrain_contacts(Body body, uint kind, uvec2 chunk_x, uvec2 chunk_y, Polygon polygon,uint piece) {
    int cx, cy;
    if (!relative_chunk(chunk_x, params.origin_x, cx) || !relative_chunk(chunk_y, params.origin_y, cy)) return false;
    ivec2 tile = ivec2(cx, cy), tile_low = tile * 64;
    ivec2 current = ivec2(body.x_fp, body.y_fp);
    vec2 shape_low=vec2(1e20),shape_high=vec2(-1e20);
    for(uint vertex=0u;vertex<polygon.count;vertex++) {shape_low=min(shape_low,polygon.vertices[vertex]);shape_high=max(shape_high,polygon.vertices[vertex]);}
    ivec2 low = max(ivec2(floor(vec2(current)/65536.0+shape_low))-1,tile_low);
    ivec2 high = min(ivec2(ceil(vec2(current)/65536.0+shape_high))+1,tile_low+64);
    uint page = 0u;
    if (kind != BOUNDARY_CONTACT && all(greaterThanEqual(tile, ivec2(0))) &&
        all(lessThan(tile, ivec2(page_extent())))) page = pages[uint(cy) * page_extent().x + uint(cx)];
    bool found = false;
    for (int y = low.y; y < high.y; ++y) for (int x = low.x; x < high.x; ++x) {
        uint cell_feature = uint(y - tile_low.y) * 64u + uint(x - tile_low.x);
        uint contact_kind = kind, material = 0xffffffffu;
        if (page != 0u && x >= 0 && y >= 0 && x < int(params.width) && y < int(params.height)) {
            material = chunk_cells[(page - 1u) * 4096u + cell_feature].x & 0xffffu;
            if (material == 0u || material == 3u) continue;
            if (material == 2u || material == 4u || material == 5u || material == 6u) {
                uint pi = (page - 1u) * 8192u + cell_feature;
                if (particles[pi].mass_fp == 0u && particles[pi + 4096u].mass_fp == 0u) continue;
                contact_kind = MPM_CONTACT;
            }
        } else contact_kind = BOUNDARY_CONTACT;
        vec2 offset = vec2((ivec2(x, y) << 16) - current) / 65536.0;
        bool emitted = emit_contact(body, 0u, contact_kind, material, cell_feature,
            chunk_x, chunk_y, polygon, cell_polygon(offset),piece,0u);
        found = found || emitted;
    }
    return found;
}

void main() {
    if(CONTACT_WORK_VERSION!=DC_CONTACT_WORK_ABI) return;
    bool planner=CONTACT_PHASE==4u;
    bool cooperative = CONTACT_PHASE == 2u || planner;
    uint index = cooperative ? gl_WorkGroupID.x : gl_GlobalInvocationID.x;
    uint lane = gl_LocalInvocationID.x, base = contact_base();
    /* Keep nearby constraints available when another Jacobi correction closes
       a gap within this substep. Diagnostics retain the exact overlap skin. */
    uint solver = base + CONTACT_HEADER_WORDS + 8192u * CONTACT_WORDS;
    contact_skin = data[solver + 9u] != 0u ? 0.25 : CONTACT_SKIN;
    if (CONTACT_PHASE == 0u) {
        uint kind=0u;
        if(lane<params.body_count&&bodies[lane].enabled!=0u) kind=pixel_body(bodies[lane])?1u:2u;
        body_kinds[lane]=kind;
        barrier();
        for(uint stride=BODY_CAPACITY/2u;stride>0u;stride/=2u) {
            if(lane<stride) body_kinds[lane]|=body_kinds[lane+stride];
            barrier();
        }
        bool pixels=(body_kinds[0]&1u)!=0u;
        bool typed=pixels&&(body_kinds[0]&2u)==0u&&(params.mode&1024u)!=0u&&(params.mode&512u)==0u;
        if(lane<CONTACT_HEADER_WORDS&&lane!=3u) {
            uint value=0u;
            if(lane==2u) value=data[2]==0u?0u:4u;
            else if(lane==4u) value=data[0];
            else if(lane==6u) value=data[2]==0u?(data[0]+CONTACT_GROUP_SIZE-1u)/CONTACT_GROUP_SIZE:0u;
            else if(lane==7u||lane==8u) value=1u;
            data[base+lane]=value;
        }
        if(lane<3u) {
            data[solver+PIXEL_CONTACT_DISPATCH_WORD+lane]=lane==0u?(pixels&&!typed&&data[2]==0u?data[0]:0u):1u;
            uint candidate_count=typed&&data[2]==0u?data[0]:0u;
            pixel_dispatch[TYPED_CONTACT_ACTIVITY_WORD+lane]=lane==0u?candidate_count:
                lane==1u&&candidate_count!=0u?DC_CONTACT_PIXEL_GROUPS:1u;
            pixel_dispatch[DC_CONTACT_PLAN_ACTIVITY_WORD+lane]=lane==0u?candidate_count:1u;
            pixel_dispatch[DC_CONTACT_FINISH_ACTIVITY_WORD+lane]=lane==0u?(candidate_count+63u)/64u:1u;
        }
        return;
    }
    if (data[2] != 0u || index >= data[0]) return;
    uint offset = pair_base() + index * PAIR_WORDS;
    if(CONTACT_PHASE==3u) {
        if(pixel_dispatch[TYPED_CONTACT_ACTIVITY_WORD]!=0u &&
           (atomicExchange(data[offset+3u],0u)&PAIR_CONTACT_FOUND)==0u) atomicAdd(data[base+5u],1u);
        return;
    }
    if(planner&&lane==0u) data[offset+3u]=0u;
    uint slot = body_slot(data[offset]);
    if (slot == BODY_CAPACITY) {
        if (!cooperative&&pixel_dispatch[TYPED_CONTACT_ACTIVITY_WORD]==0u) atomicAdd(data[base + 5u], 1u);
        return;
    }
    Body a = bodies[slot];
    uint kind = data[offset + 2u]; bool found = false;
    bool pixel_candidate = pixel_body(a);
    if (kind==BODY_CONTACT) {
        uint other = body_slot(data[offset+1u]);
        if (other!=BODY_CAPACITY) pixel_candidate = pixel_candidate || pixel_body(bodies[other]);
    }
    if (cooperative != pixel_candidate) return;
    if (cooperative) {
        if (lane == 0u) group_found = 0u;
        barrier();
    }
    if (cooperative && kind == TERRAIN_CONTACT) {
        if(CONTACT_PIXEL_ONLY&&!planner) {
            if((atomicOr(data[offset+3u],0u)&PAIR_COLLIDABLE_TERRAIN)==0u) return;
        } else {
        int cx, cy;
        if (relative_chunk(uvec2(data[offset+4u],data[offset+5u]),params.origin_x,cx) &&
            relative_chunk(uvec2(data[offset+6u],data[offset+7u]),params.origin_y,cy) &&
            cx >= 0 && cy >= 0 && (cx+1)*64 <= int(params.width) && (cy+1)*64 <= int(params.height)) {
            uint page = pages[uint(cy)*page_extent().x+uint(cx)];
            if (page != 0u) {
#ifdef DC_TERRAIN_SCAN_PROFILE
                uint scanned=0u;
#endif
                for (uint cell=lane; cell<4096u; cell+=CONTACT_GROUP_SIZE) {
#ifdef DC_TERRAIN_SCAN_PROFILE
                    scanned++;
#endif
                    uint material=chunk_cells[(page-1u)*4096u+cell].x&0xffffu;
                    if (material==0u || material==3u) continue;
                    if (material==2u || material==4u || material==5u || material==6u) {
                        uint pi=(page-1u)*8192u+cell;
                        if (particles[pi].mass_fp==0u && particles[pi+4096u].mass_fp==0u) continue;
                    }
                    atomicOr(group_found,1u);
                    break;
                }
#ifdef DC_TERRAIN_SCAN_PROFILE
                if ((params.mode&256u)!=0u) atomicAdd(data[base+9u],scanned);
#endif
                barrier();
                bool empty_terrain = group_found == 0u;
                barrier();
                if (empty_terrain) {
                    if (lane==0u&&!planner) atomicAdd(data[base+5u],1u);
                    return;
                }
                if (lane==0u) group_found=0u;
                barrier();
            }
        }
        }
    }
    if(planner) {if(lane==0u) data[offset+3u]=PAIR_COLLIDABLE_TERRAIN;return;}
    uint work_lane=lane+(CONTACT_PIXEL_ONLY?gl_WorkGroupID.y*CONTACT_GROUP_SIZE:0u);
    uint work_stride=CONTACT_GROUP_SIZE*(CONTACT_PIXEL_ONLY?DC_CONTACT_PIXEL_GROUPS:1u);
    if (kind == BODY_CONTACT) {
        uint other = body_slot(data[offset + 1u]); vec2 delta;
        if (other != BODY_CAPACITY && relative_body(a, bodies[other], delta)) {
            Body b = bodies[other];
            bool distribute_b=cooperative&&!pixel_body(a)&&pixel_body(b);
            if(pixel_body(a) && lane == 0u&&(!CONTACT_PIXEL_ONLY||gl_WorkGroupID.y==0u)) atomicAdd(data[base+9u],body_pieces(a));
            for(uint ap=cooperative&&!distribute_b?work_lane:0u;ap<body_pieces(a);ap+=cooperative&&!distribute_b?work_stride:1u) {
                if(!pixel_boundary(a,ap)) continue;
                if((params.mode&256u)!=0u&&(!distribute_b||lane==0u)) atomicAdd(data[base+10u],1u);
                Polygon pa=body_polygon(a,ap,vec2(0));vec2 lo=vec2(1e20),hi=vec2(-1e20);
                for(uint vertex=0u;vertex<pa.count;vertex++) {lo=min(lo,pa.vertices[vertex]-delta);hi=max(hi,pa.vertices[vertex]-delta);}
                uvec4 query=body_piece_query(b,lo-vec2(contact_skin),hi+vec2(contact_skin));
                if(pixel_body(b)&&(!distribute_b||lane==0u)) atomicAdd(data[base+9u],query.z*query.w);
                for(uint ordinal=distribute_b?lane:0u;ordinal<query.z*query.w;ordinal+=distribute_b?CONTACT_GROUP_SIZE:1u) {
                    uint bp=query_piece(b,query,ordinal);if(!pixel_boundary(b,bp)) continue;
                    if((params.mode&256u)!=0u) atomicAdd(data[base+11u],1u);
                bool emitted=emit_contact(a, b.id, BODY_CONTACT, piece_material(b,bp),
                    0u, uvec2(0), uvec2(0), body_polygon(a,ap,vec2(0)), body_polygon(b,bp,delta),ap,bp);
                found=found || emitted;
                }
            }
        }
    } else {
        uvec4 query=uvec4(0,0,body_pieces(a),1);
        if(pixel_body(a)) {
            int x,y;
            if(!relative_chunk(uvec2(data[offset+4u],data[offset+5u]),a.chunk_x,x)||
               !relative_chunk(uvec2(data[offset+6u],data[offset+7u]),a.chunk_y,y)) return;
            vec2 low=vec2(x,y)*64.-vec2(a.local_fp)/65536.;
            query=body_piece_query(a,low-vec2(contact_skin),low+64.+vec2(contact_skin));
            if (lane == 0u&&(!CONTACT_PIXEL_ONLY||gl_WorkGroupID.y==0u)) atomicAdd(data[base+9u],query.z*query.w);
        }
        for(uint ordinal=cooperative?work_lane:0u;ordinal<query.z*query.w;ordinal+=cooperative?work_stride:1u) {
            uint ap=query_piece(a,query,ordinal);
            if(!pixel_boundary(a,ap)) continue;
            if((params.mode&256u)!=0u) atomicAdd(data[base+10u],1u);
            bool emitted=terrain_contacts(a, kind, uvec2(data[offset + 4u], data[offset + 5u]),
                uvec2(data[offset + 6u], data[offset + 7u]), body_polygon(a,ap,vec2(0)),ap);
            found=found || emitted;
        }
    }
    if (cooperative) {
        if (found) atomicOr(group_found, 1u);
        barrier();
        if (lane == 0u) {
            if(CONTACT_PIXEL_ONLY) {
                if(group_found!=0u) atomicOr(data[offset+3u],PAIR_CONTACT_FOUND);
            } else if(group_found==0u) atomicAdd(data[base+5u],1u);
        }
    } else if (!found) atomicAdd(data[base + 5u], 1u);
}
