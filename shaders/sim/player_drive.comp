#version 450
#extension GL_GOOGLE_include_directive : require
#define DC_RUNTIME_BODY_STORAGE 1
#define DC_RUNTIME_BODY_BINDING 0
#include "rigid_body.glsl"
#include "solver_body_state.glsl"
#include "../../include/dungeoncraft/player_drive_layout.h"
const uint PLAYER_SUPPORT_WORD=19u, PLAYER_SUPPORTED=1u;
layout(local_size_x=64) in;
layout(set=0,binding=1,std430) buffer Commands {uint commands[];};
layout(push_constant) uniform Params {uint count;} params;
uint pixel_word_at(uint index) {return DC_PIXEL_WORD(index);}
void main() {
    uint i=gl_GlobalInvocationID.x;
    if (i>=params.count) return;
    uint base=i*FR_PLAYER_DRIVE_WORDS;
    uvec2 previous=uvec2(commands[base+FR_PLAYER_DRIVE_PREVIOUS],commands[base+FR_PLAYER_DRIVE_PREVIOUS+1u]);
    uvec2 sequence=uvec2(commands[base+FR_PLAYER_DRIVE_SEQUENCE],commands[base+FR_PLAYER_DRIVE_SEQUENCE+1u]);
    if (sequence.y<previous.y || (sequence.y==previous.y && sequence.x<=previous.x)) return;
    commands[base+FR_PLAYER_DRIVE_PREVIOUS]=sequence.x;
    commands[base+FR_PLAYER_DRIVE_PREVIOUS+1u]=sequence.y;
    uint slot=runtime_body_find(commands[base+FR_PLAYER_DRIVE_BODY]);
    if (slot>=BODY_CAPACITY) return;
    BodyStorageOwner owner=DC_BODY_OWNER(runtime_body_root,slot);
    Body body=DC_BODY(slot);
    if (owner.state!=DC_BODY_OWNER_LIVE || owner.generation!=commands[base+FR_PLAYER_DRIVE_GENERATION] ||
        owner.runtime_id!=body.id || body.enabled==0u || (body.motion_flags&1u)!=0u) return;
    float movement=float(int(commands[base+FR_PLAYER_DRIVE_MOVE]))/65536.;
    DC_BODY(slot).vx_fp=int(round(movement*float(commands[base+FR_PLAYER_DRIVE_SPEED])));
    if (commands[base+FR_PLAYER_DRIVE_JUMP]!=0u &&
        (SOLVER_BODY_WORD(slot,PLAYER_SUPPORT_WORD)&PLAYER_SUPPORTED)!=0u) {
        DC_BODY(slot).vy_fp=-int(commands[base+FR_PLAYER_DRIVE_JUMP_SPEED]);
        SOLVER_BODY_WORD(slot,PLAYER_SUPPORT_WORD)&=~PLAYER_SUPPORTED;
    }
    DC_BODY(slot).rest_ticks=0u;
}
