#version 450
#extension GL_GOOGLE_include_directive : require
#include "../../include/dungeoncraft/bulk_phase_layout.h"
#include "../../include/dungeoncraft/bulk_rheology_layout.h"
#include "../reactive/thermal_water.glsl"
layout(local_size_x=64) in;
layout(set=0,binding=1,std430) buffer Cells {uvec2 cells[];};
layout(set=0,binding=2,std430) readonly buffer Pages {uint pages[];};
layout(set=0,binding=3,std430) readonly buffer Occupancy {uint occupancy[];};
layout(set=0,binding=10,std430) readonly buffer FaceVelocity {vec2 face_velocity[];};
layout(set=0,binding=37,std430) buffer Bulk {uint bulk[];};
layout(push_constant) uniform Params {
    uint width,height,parity,axis;
    float seconds,gravity,water_density,oil_density,slime_density;
    float oil_yield,slime_yield,oil_consistency,slime_consistency;
    float oil_exponent,slime_exponent,oil_softening,slime_softening;
    float oil_hot_yield,slime_hot_yield,oil_capacity,slime_capacity;
} params;
const uint FULL=65536u;
uint page_at(ivec2 p) {
    if(any(lessThan(p,ivec2(0)))||any(greaterThanEqual(p,ivec2(params.width,params.height)))) return 0u;
    return pages[uint(p.y/64)*((params.width+63u)/64u)+uint(p.x/64)];
}
uint atlas_at(ivec2 p,uint page) {return (page-1u)*4096u+uint(p.y%64)*64u+uint(p.x%64);}
uint bulk_at(uint atlas,uint phase) {
    uint base=(atlas/4096u)*FR_BULK_CHUNK_CHANNELS*4096u+atlas%4096u;
    return bulk[base+(phase-1u)*4096u];
}
void bulk_write(uint atlas,uint phase,uint value) {
    uint base=(atlas/4096u)*FR_BULK_CHUNK_CHANNELS*4096u+atlas%4096u;
    bulk[base+(phase-1u)*4096u]=value;
}
float bulk_heat_at(uint atlas,uint phase) {
    uint base=(atlas/4096u)*FR_BULK_CHUNK_CHANNELS*4096u+atlas%4096u;
    return uintBitsToFloat(bulk[base+(phase+3u)*4096u]);
}
void bulk_heat_write(uint atlas,uint phase,float energy) {
    uint base=(atlas/4096u)*FR_BULK_CHUNK_CHANNELS*4096u+atlas%4096u;
    bulk[base+(phase+3u)*4096u]=floatBitsToUint(energy);
}
bool permeable(uint material) {
    return material==0u||material==2u||material==4u||material==5u||material==6u||
        material==10u||material==13u;
}
uint used(uint volume[3]) {return volume[0]+volume[1]+volume[2];}
void move_water_heat(uint source,uint target,uint source_before,uint source_after) {
    uint moved=source_before-source_after;
    thermal_water_move(source,target,moved,source_before);
    thermal_water_resize(source,source_before,source_after);
}
float water_drag_speed(float face_flow,bool reverse,uint water,uint occupied) {
    float aligned=max(0.,reverse?-face_flow:face_flow);
    return aligned*float(water)/float(max(occupied,1u));
}
float rheology_mobility(uint phase,uint atlas,uint volume,float stress,float shear) {
    if(phase==0u) return 1.;
    float yield=phase==1u?params.oil_yield:params.slime_yield;
    float consistency=phase==1u?params.oil_consistency:params.slime_consistency;
    float exponent=phase==1u?params.oil_exponent:params.slime_exponent;
    float softening=phase==1u?params.oil_softening:params.slime_softening;
    float hot_yield=phase==1u?params.oil_hot_yield:params.slime_hot_yield;
    float capacity=phase==1u?params.oil_capacity:params.slime_capacity;
    float temperature=FR_BULK_RHEOLOGY_AMBIENT_K+bulk_heat_at(atlas,phase)/
        max(capacity*float(volume)/float(FULL),FR_BULK_RHEOLOGY_CAPACITY_FLOOR);
    float hot=softening>FR_BULK_RHEOLOGY_AMBIENT_K?
        clamp((temperature-FR_BULK_RHEOLOGY_AMBIENT_K)/
            (softening-FR_BULK_RHEOLOGY_AMBIENT_K),0.,1.):0.;
    yield*=1.-hot*(1.-hot_yield);
    if(stress<=yield) return 0.;
    float viscosity=consistency*pow(max(shear,FR_BULK_RHEOLOGY_SHEAR_FLOOR),
        exponent-1.);
    return clamp((stress-yield)/(stress+viscosity),0.,1.);
}
void main() {
    uint index=gl_GlobalInvocationID.x;
    if(index>=params.width*params.height) return;
    ivec2 p=ivec2(int(index%params.width),int(index/params.width));
    uint coordinate=params.axis==0u?uint(p.y):uint(p.x);
    if((coordinate&1u)!=params.parity) return;
    ivec2 q=p+(params.axis==0u?ivec2(0,1):ivec2(1,0));
    if(q.x>=int(params.width)||q.y>=int(params.height)) return;
    uint top_page=page_at(p),bottom_page=page_at(q);
    if(top_page==0u||bottom_page==0u) return;
    uint top_at=atlas_at(p,top_page),bottom_at=atlas_at(q,bottom_page);
    if(!permeable(cells[top_at].x&65535u)||!permeable(cells[bottom_at].x&65535u)) return;
    uint world_size=params.width*params.height;
    uint face_open=FULL-min(FULL,occupancy[(params.axis==0u?4u:3u)*world_size+index]);
    uint top_index=index;
    uint bottom_index=uint(q.y)*params.width+uint(q.x);
    uint top[3],bottom[3];
    top[0]=cells[top_at].y;bottom[0]=cells[bottom_at].y;
    top[1]=bulk_at(top_at,1u);bottom[1]=bulk_at(bottom_at,1u);
    top[2]=bulk_at(top_at,2u);bottom[2]=bulk_at(bottom_at,2u);
    uint top_capacity=FULL-min(FULL,occupancy[2u*world_size+top_index]);
    uint bottom_capacity=FULL-min(FULL,occupancy[2u*world_size+bottom_index]);
    float water_flow=params.axis==0u?face_velocity[index].y:face_velocity[index].x;
    bool reverse_by_fill=params.axis==0u?
        (used(bottom)>bottom_capacity&&used(top)<top_capacity):
        (used(bottom)>bottom_capacity&&used(top)<=top_capacity)||
        (used(bottom)<=bottom_capacity&&used(bottom)>used(top));
    bool reverse_by_drag=water_flow<0.&&bottom[0]>0u&&used(top)<top_capacity;
    bool forward_by_drag=water_flow>0.&&top[0]>0u&&used(bottom)<bottom_capacity;
    bool reverse=reverse_by_drag||(!forward_by_drag&&reverse_by_fill);
    if(reverse) {
        uint swap_at=top_at;top_at=bottom_at;bottom_at=swap_at;
        uint swap_index=top_index;top_index=bottom_index;bottom_index=swap_index;
        uint swap_capacity=top_capacity;top_capacity=bottom_capacity;bottom_capacity=swap_capacity;
        for(uint phase=0u;phase<3u;phase++) {
            uint swap_volume=top[phase];top[phase]=bottom[phase];bottom[phase]=swap_volume;
        }
    }
    uvec3 top_before=uvec3(top[0],top[1],top[2]);
    uvec3 bottom_before=uvec3(bottom[0],bottom[1],bottom[2]);
    uint excess=used(top)>top_capacity?used(top)-top_capacity:0u;
    if(excess>0u) face_open=FULL;
    if(face_open==0u) return;
    float density[3]=float[3](params.water_density,params.oil_density,params.slime_density);
    bool changed=false;
    for(uint pass=0u;pass<3u;pass++) {
        uint heavy=0u;
        for(uint phase=0u;phase<3u;phase++) {
            uint rank=0u;
            for(uint other=0u;other<3u;other++)
                if(density[other]>density[phase]||
                   (density[other]==density[phase]&&other>phase)) rank++;
            if(rank==pass) heavy=phase;
        }
        if(top[heavy]==0u||(params.axis==1u&&heavy==0u)) continue;
        if(params.axis==1u&&used(top)<=used(bottom)&&excess==0u) break;
        uint light=3u;float light_density=0.;
        for(uint phase=0u;phase<3u;phase++)
            if(bottom[phase]>0u&&density[phase]<density[heavy]&&
               (light==3u||density[phase]<light_density)) {light=phase;light_density=density[phase];}
        uint free_bottom=used(bottom)<bottom_capacity?bottom_capacity-used(bottom):0u;
        if(free_bottom==0u&&light==3u) continue;
        float opposing=light==3u?0.:light_density;
        float buoyancy=params.axis==0u?
            max(0.,params.gravity*(density[heavy]-opposing)/density[heavy]*
                (reverse?-1.:1.)):
            params.gravity*float(max(0,int(used(top))-int(used(bottom))))/float(FULL);
        float drag=water_drag_speed(water_flow,reverse,top[0],used(top));
        float speed=sqrt(2.*buoyancy)+drag;
        float mobility=1.;
        uint rheology_phase=heavy==0u?light:heavy;
        if(rheology_phase<3u) {
            uint sample_at=rheology_phase==heavy?top_at:bottom_at;
            uint sample_volume=rheology_phase==heavy?top[heavy]:bottom[light];
            float physical_density=density[rheology_phase];
            float stress=physical_density*FR_BULK_RHEOLOGY_GRAVITY*
                float(sample_volume)/float(FULL)+
                abs(water_flow)*physical_density;
            mobility=rheology_mobility(rheology_phase,sample_at,sample_volume,
                stress,abs(water_flow));
        }
        uint allowance=excess>0u?min(excess,face_open):
            uint(floor(min(float(FULL),speed*mobility*params.seconds*float(face_open))));
        uint swappable=light==3u?0u:bottom[light];
        uint moved=min(top[heavy],min(allowance,free_bottom+swappable));
        uint exchanged=min(moved,swappable);
        if(moved==0u) continue;
        top[heavy]-=moved;bottom[heavy]+=moved;
        excess-=min(excess,moved);
        if(exchanged>0u) {bottom[light]-=exchanged;top[light]+=exchanged;}
        changed=true;
    }
    if(!changed) return;
    if(top[0]>top_before.x)
        move_water_heat(bottom_at,top_at,bottom_before.x,bottom[0]);
    else if(bottom[0]>bottom_before.x)
        move_water_heat(top_at,bottom_at,top_before.x,top[0]);
    for(uint phase=1u;phase<3u;phase++) {
        uint source=0u,target=0u,before=0u,moved=0u;
        if(top[phase]>top_before[phase]) {
            source=bottom_at;target=top_at;before=bottom_before[phase];
            moved=top[phase]-top_before[phase];
        } else if(bottom[phase]>bottom_before[phase]) {
            source=top_at;target=bottom_at;before=top_before[phase];
            moved=bottom[phase]-bottom_before[phase];
        }
        if(moved>0u&&before>0u) {
            float carried=bulk_heat_at(source,phase)*float(moved)/float(before);
            bulk_heat_write(source,phase,bulk_heat_at(source,phase)-carried);
            bulk_heat_write(target,phase,bulk_heat_at(target,phase)+carried);
        }
    }
    cells[top_at].y=top[0];cells[bottom_at].y=bottom[0];
    for(uint phase=1u;phase<3u;phase++) {
        bulk_write(top_at,phase,top[phase]);bulk_write(bottom_at,phase,bottom[phase]);
    }
}
