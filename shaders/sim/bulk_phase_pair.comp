#version 450
layout(local_size_x=64) in;
layout(set=0,binding=1,std430) buffer Cells {uvec2 cells[];};
layout(set=0,binding=2,std430) readonly buffer Pages {uint pages[];};
layout(set=0,binding=3,std430) readonly buffer Occupancy {uint occupancy[];};
layout(set=0,binding=37,std430) buffer Bulk {uint bulk[];};
layout(push_constant) uniform Params {
    uint width,height,parity;
    float seconds,gravity,water_density,oil_density,slime_density;
} params;
const uint FULL=65536u;
uint page_at(ivec2 p) {
    if(any(lessThan(p,ivec2(0)))||any(greaterThanEqual(p,ivec2(params.width,params.height)))) return 0u;
    return pages[uint(p.y/64)*((params.width+63u)/64u)+uint(p.x/64)];
}
uint atlas_at(ivec2 p,uint page) {return (page-1u)*4096u+uint(p.y%64)*64u+uint(p.x%64);}
uint bulk_at(uint atlas,uint phase) {
    uint base=(atlas/4096u)*4u*4096u+atlas%4096u;
    return bulk[base+(phase-1u)*4096u];
}
void bulk_write(uint atlas,uint phase,uint value) {
    uint base=(atlas/4096u)*4u*4096u+atlas%4096u;
    bulk[base+(phase-1u)*4096u]=value;
}
bool permeable(uint material) {
    return material==0u||material==2u||material==4u||material==5u||material==6u||
        material==10u||material==13u;
}
uint used(uint volume[3]) {return volume[0]+volume[1]+volume[2];}
void main() {
    uint index=gl_GlobalInvocationID.x;
    if(index>=params.width*params.height) return;
    ivec2 p=ivec2(int(index%params.width),int(index/params.width));
    if((uint(p.y)&1u)!=params.parity||p.y+1>=int(params.height)) return;
    ivec2 q=p+ivec2(0,1);uint top_page=page_at(p),bottom_page=page_at(q);
    if(top_page==0u||bottom_page==0u) return;
    uint top_at=atlas_at(p,top_page),bottom_at=atlas_at(q,bottom_page);
    if(!permeable(cells[top_at].x&65535u)||!permeable(cells[bottom_at].x&65535u)) return;
    uint world_size=params.width*params.height;
    uint face_open=FULL-min(FULL,occupancy[4u*world_size+index]);
    if(face_open==0u) return;
    uint bottom_capacity=FULL-min(FULL,occupancy[2u*world_size+index+params.width]);
    uint top[3],bottom[3];
    top[0]=cells[top_at].y;bottom[0]=cells[bottom_at].y;
    top[1]=bulk_at(top_at,1u);bottom[1]=bulk_at(bottom_at,1u);
    top[2]=bulk_at(top_at,2u);bottom[2]=bulk_at(bottom_at,2u);
    float density[3]=float[3](params.water_density,params.oil_density,params.slime_density);
    bool changed=false;
    for(uint pass=0u;pass<3u;pass++) {
        uint heavy=0u;
        for(uint phase=0u;phase<3u;phase++) {
            uint rank=0u;
            for(uint other=0u;other<3u;other++)
                if(density[other]>density[phase]||
                   (density[other]==density[phase]&&other>phase)) rank++;
            if(rank==pass) heavy=phase;
        }
        if(top[heavy]==0u) continue;
        uint light=3u;float light_density=0.;
        for(uint phase=0u;phase<3u;phase++)
            if(bottom[phase]>0u&&density[phase]<density[heavy]&&
               (light==3u||density[phase]<light_density)) {light=phase;light_density=density[phase];}
        uint free_bottom=used(bottom)<bottom_capacity?bottom_capacity-used(bottom):0u;
        if(free_bottom==0u&&light==3u) continue;
        float opposing=light==3u?0.:light_density;
        float buoyancy=max(0.,params.gravity*(density[heavy]-opposing)/density[heavy]);
        float speed=sqrt(2.*buoyancy);
        uint allowance=uint(floor(min(float(FULL),speed*params.seconds*float(face_open))));
        uint swappable=light==3u?0u:bottom[light];
        uint moved=min(top[heavy],min(allowance,free_bottom+swappable));
        uint exchanged=min(moved,swappable);
        if(moved==0u) continue;
        top[heavy]-=moved;bottom[heavy]+=moved;
        if(exchanged>0u) {bottom[light]-=exchanged;top[light]+=exchanged;}
        changed=true;
    }
    if(!changed) return;
    cells[top_at].y=top[0];cells[bottom_at].y=bottom[0];
    for(uint phase=1u;phase<3u;phase++) {
        bulk_write(top_at,phase,top[phase]);bulk_write(bottom_at,phase,bottom[phase]);
    }
}
