#version 450
#extension GL_GOOGLE_include_directive : require
#include "../../include/dungeoncraft/pixel_geometry_layout.h"
#define DC_RUNTIME_BODY_STORAGE 1
#define DC_RUNTIME_BODY_BINDING 1
#include "rigid_body.glsl"
uint pixel_word_at(uint index) {return DC_PIXEL_WORD(index);}
layout(local_size_x=128) in;
layout(constant_id=0) const uint PHASE=0u;
layout(set=0,binding=0,std430) buffer Staging { uint words[]; };
layout(push_constant) uniform Params { uint width,height,has_graph,padding,pool_offset,pool_capacity; } params;
const uint INVALID=0xffffffffu;
const uint GRAPH_WORDS=2320u;
const uint GRAPH_NODES=16u,GRAPH_MEMBERS=400u,GRAPH_JOINTS=528u,GRAPH_ANCHORS=1552u;
const uint JOINT_STIFFNESS_WORD=5u,ANCHOR_STIFFNESS_WORD=13u,INTERFACE_ANGLE_INDEX=8u;
const uint MEMBER_COVERAGE_WORD=21u;
uint pixels() {return params.width*params.height;}
uint physical(uint i) {return 24u+i*2u;}
uint appearance(uint i) {return 24u+pixels()*2u+i*16u;}
uint members(uint i) {return 24u+pixels()*18u+i;}
uint label(uint i) {return 24u+pixels()*19u+i;}
uint graph() {return 24u+pixels()*20u;}
uint plans() {return graph()+GRAPH_WORDS;}
uint plan(uint i) {return plans()+i*10u;}
uint scan(uint parity,uint i) {return plans()+pixels()*10u+parity*pixels()+i;}
uint output_plan(uint i) {return plans()+pixels()*12u+i*11u;}
#include "authored/body_slots.glsl"
void reject(uint i) {atomicOr(words[2],1u);atomicMin(words[20],i);}
shared uint first_matches,second_matches;
void check_graph_record() {
    uint g=graph(),record=gl_WorkGroupID.x,lane=gl_LocalInvocationID.x;
    uint nodes=words[g],members_count=words[g+1u],joints=words[g+2u];
    uint first_joint=nodes+members_count,first_anchor=first_joint+joints;
    bool needs_first=record>=nodes,needs_second=needs_first && record<first_anchor;
    uint start=GRAPH_NODES,stride=12u;
    if(record>=first_anchor) {record-=first_anchor;start=GRAPH_ANCHORS;stride=24u;}
    else if(record>=first_joint) {record-=first_joint;start=GRAPH_JOINTS;stride=16u;}
    else if(needs_first) {record-=nodes;start=GRAPH_MEMBERS;stride=8u;}
    uint table=g+start,entry=table+record*stride,id=words[entry];
    if ((start==GRAPH_JOINTS || start==GRAPH_ANCHORS) && lane<=INTERFACE_ANGLE_INDEX) {
        uint coefficients=entry+(start==GRAPH_JOINTS ? JOINT_STIFFNESS_WORD : ANCHOR_STIFFNESS_WORD);
        float value=uintBitsToFloat(words[coefficients+lane]);
        if (isnan(value) || isinf(value) || (lane<INTERFACE_ANGLE_INDEX && value<0.)) reject(INVALID);
    }
    if(lane==0u) {
        first_matches=0u;second_matches=0u;
        if(id==0u || words[entry+1u]==0u) reject(INVALID);
    }
    if(lane<record && words[table+lane*stride]==id) reject(INVALID);
    if(!needs_first) return;
    barrier();
    uint first=words[entry+2u],second=needs_second?words[entry+3u]:0u;
    if(lane<nodes) {
        uint node_id=words[g+GRAPH_NODES+lane*12u];
        if(node_id==first) atomicAdd(first_matches,1u);
        if(needs_second && node_id==second) atomicAdd(second_matches,1u);
    }
    barrier();
    if(lane==0u && (first_matches!=1u || (needs_second && (second_matches!=1u || first==second))))
        reject(INVALID);
}
bool terrain_material(uint m) {return m>=1u&&m<=12u&&m!=3u;}
bool body_material(uint m) {return (m>=1u&&m<=4u)||m>=10u&&m<=12u;}
bool finite_value(float f) {return !isnan(f)&&!isinf(f);}
bool appearance_valid(uint index) {
    uint a=appearance(index);
    for(uint i=0u;i<15u;i++) if(!finite_value(uintBitsToFloat(words[a+i]))) return false;
    for(uint i=0u;i<3u;i++) if(uintBitsToFloat(words[a+i])<0.||uintBitsToFloat(words[a+8u+i])<0.) return false;
    float roughness=uintBitsToFloat(words[a+3u]),relief=uintBitsToFloat(words[a+7u]),alpha=uintBitsToFloat(words[a+12u]);
    if(roughness<0.||roughness>1.||relief<0.||alpha<0.||alpha>1.||words[a+11u]!=0u||words[a+13u]!=0u||words[a+14u]!=0u||(words[a+15u]&~7u)!=0u) return false;
    vec3 normal=vec3(uintBitsToFloat(words[a+4u]),uintBitsToFloat(words[a+5u]),uintBitsToFloat(words[a+6u]));
    return (words[a+15u]&1u)==0u||abs(dot(normal,normal)-1.)<=.001;
}
uint member_index(uint index,uint material) {
    if(params.has_graph==0u) return INVALID;
    uint owner=words[members(index)],g=graph();
    if(owner==0u || material<1u || material>3u) return INVALID;
    // Canonical stone, wood and mortar have registered structural profiles in that order.
    uint profile=material-1u;
    for(uint m=0u;m<words[g+1u];m++) {
        uint p=g+GRAPH_MEMBERS+m*8u;
        if(words[p]==owner) return words[p+4u]==profile?m:INVALID;
    }
    return INVALID;
}
uint root(uint index) {
    uint parent=atomicAdd(words[label(index)],0u);
    while(parent!=index) {
        uint ancestor=atomicAdd(words[label(parent)],0u);
        atomicMin(words[label(index)],ancestor);index=parent;parent=ancestor;
    }
    return index;
}
void join(uint a,uint b) {
    if(atomicAdd(words[label(b)],0u)==INVALID||words[physical(a)+1u]!=words[physical(b)+1u]) return;
    for(;;) {
        uint ra=root(a),rb=root(b);if(ra==rb) return;
        uint high=max(ra,rb),low=min(ra,rb);
        if(atomicCompSwap(words[label(high)],high,low)==high) return;
    }
}
uint geometry_size(uint p) {
    if(words[p+2u]==0u) return 0u;
    uint columns=1u+(words[p+5u]-words[p+3u])/DC_PIXEL_TILE_SIDE;
    uint rows=1u+(words[p+6u]-words[p+4u])/DC_PIXEL_TILE_SIDE;
    return DC_PIXEL_SHAPE_HEADER_WORDS+columns*rows+words[p+7u]*DC_PIXEL_TILE_WORDS;
}
uint geometry_prefix(uint i,uint offset,uint parity) {
    uint p=plan(i);
    return offset==1u ? geometry_size(p) : words[p+8u+parity];
}
void main() {
    if(PHASE>=9u) {plan_body_slots();return;}
    if(PHASE==8u) {check_graph_record();return;}
    uint i=gl_GlobalInvocationID.x;if(i>=pixels()) return;
    if(PHASE==0u) {
        uint packed=words[physical(i)],material=packed&65535u,role=(packed>>16u)&255u,anchor=packed>>24u;
        bool valid=material<=12u&&role<=4u&&anchor<=1u&&words[physical(i)+1u]<=0xffffffu&&(anchor==0u||role==2u)&&
            (material==0u?(role==0u||role==4u):role==1u?terrain_material(material):(role==2u||role==3u)&&body_material(material))&&appearance_valid(i);
        uint member=INVALID;
        if(role==2u) {
            member=member_index(i,material);
            if(member==INVALID) valid=false;
        }
        if(params.has_graph!=0u&&role!=2u&&words[members(i)]!=0u) valid=false;
        if(!valid) reject(i);
        words[label(i)]=valid&&role==3u?i:INVALID;
        if(valid) {
            if(role==3u) atomicAdd(words[16],1u);
            if(role==2u) {
                atomicOr(words[MEMBER_COVERAGE_WORD],1u<<member);
                atomicAdd(words[17],1u);
            }
            if(role==1u) atomicAdd(words[18],1u);
            if(role==4u) atomicAdd(words[19],1u);
        }
        return;
    }
    if(PHASE==1u && i==0u && params.has_graph!=0u) {
        uint expected=(1u<<words[graph()+1u])-1u;
        if(words[MEMBER_COVERAGE_WORD]!=expected) reject(INVALID);
    }
    uint owner=atomicAdd(words[label(i)],0u);
    if(PHASE==3u) {
        uint p=plan(i);
        words[p]=i;words[p+1u]=words[physical(i)+1u];words[p+2u]=0u;
        words[p+3u]=INVALID;words[p+4u]=INVALID;
        for(uint k=5u;k<10u;k++) words[p+k]=0u;
        words[scan(0u,i)]=uint(owner==i);
        if(owner==i) atomicAdd(words[4],1u);
        return;
    }
    if(PHASE==6u) {
        uint offset=params.padding>>1u,parity=params.padding&1u;
        uint sum=words[scan(parity,i)];
        uint geometry=geometry_prefix(i,offset,parity);
        if(i>=offset) {
            sum+=words[scan(parity,i-offset)];
            geometry+=geometry_prefix(i-offset,offset,parity);
        }
        words[scan(parity^1u,i)]=sum;
        words[plan(i)+8u+(parity^1u)]=geometry;
        return;
    }
    if(owner==INVALID) return;
    if(PHASE==1u) {
        if(i%params.width+1u<params.width) join(i,i+1u);
        if(i/params.width+1u<params.height) join(i,i+params.width);
        return;
    }
    if(PHASE==2u) {uint canonical=root(i);atomicMin(words[label(i)],canonical);return;}
    uint p=plan(owner),x=i%params.width,y=i/params.width;
    if(PHASE==4u) {
        atomicAdd(words[p+2u],1u);
        atomicMin(words[p+3u],x);atomicMin(words[p+4u],y);
        atomicMax(words[p+5u],x);atomicMax(words[p+6u],y);
        return;
    }
    if(PHASE==5u) {
        uint low_x=words[p+3u],low_y=words[p+4u];
        uint tx=x-(x-low_x)%DC_PIXEL_TILE_SIDE,ty=y-(y-low_y)%DC_PIXEL_TILE_SIDE;
        if(x>tx && words[label(i-1u)]==owner) return;
        if(y>ty && words[label(i-params.width)]==owner) return;
        /* Only the first occupied texel of this component in this tile contributes. */
        for(uint yy=ty;yy<=y;yy++) for(uint xx=tx;xx<min(tx+DC_PIXEL_TILE_SIDE,params.width);xx++) {
            uint candidate=yy*params.width+xx;
            if(candidate>=i) break;
            if(words[label(candidate)]==owner) return;
        }
        atomicAdd(words[p+7u],1u);return;
    }
    if(PHASE==7u&&owner==i) {
        uint rank=words[scan(params.padding,i)]-1u,d=output_plan(rank);
        uint width=words[p+5u]-words[p+3u]+1u,height=words[p+6u]-words[p+4u]+1u;
        for(uint k=0u;k<5u;k++) words[d+k]=words[p+k];
        words[d+5u]=width;words[d+6u]=height;words[d+7u]=words[p+7u];
        words[d+8u]=geometry_size(p);
        atomicAdd(words[5],words[d+8u]);
        words[d+9u]=INVALID;
        uint prior=i==0u ? 0u : words[plan(i-1u)+8u+params.padding];
        words[d+10u]=params.pool_offset+16u+pixel_word_at(params.pool_offset)*params.pool_capacity+
                     pixel_word_at(params.pool_offset+1u)+prior;
    }
}
