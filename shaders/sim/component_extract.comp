    data[target+4u]=0u;data[target+5u]=0u;data[target+6u]=uint(extent.x);data[target+7u]=uint(extent.y);
    uint tile_index=0u;
    for(uint y=0u;y<directory.y;y++) for(uint x=0u;x<directory.x;x++) {
