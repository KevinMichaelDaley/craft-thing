    for(uint piece=0u;piece<4u;piece++) {b.pieces[piece].count=0u;b.pieces[piece].material=0u;for(uint vertex=0u;vertex<8u;vertex++) b.pieces[piece].vertices[vertex]=ivec2(0);}
