    b.previous_x_fp=b.x_fp;b.previous_y_fp=b.y_fp;b.reserved0=0x53545232u;b.reserved1=1u;
    shifted_chunk(params.origin_x,low.x/64,b.chunk_x);shifted_chunk(params.origin_y,low.y/64,b.chunk_y);
    b.local_fp=(low%64)<<16;b.visible=1u;b.angle=0;b.angular_velocity=0;
