}
uint pool() {return graph()+40000u;}
uint pool_capacity() {return 2u*((max(params.width*params.height,data[base()+1u]*4096u)+7u)/8u)+64u*8u;}
void compact_pixels() {
    uint p=pool(),capacity=pool_capacity(),bank=1u-data[p],used=0u;
    for(uint slot=0u;slot<64u;slot++) {
        Body b=bodies[slot];if(!pixel_body(b)||(b.enabled==0u&&b.reserved0==0u)) continue;
        uint words=pixel_shape_words(b);
        uint target=p+16u+bank*capacity+used;
        for(uint word=0u;word<words;word++) data[target+word]=pixel_word_at(b.compound_reserved+word);
        b.compound_reserved=BODY_STORAGE_WORDS+target;bodies[slot]=b;used+=words;
    }
    data[p]=bank;data[p+1u]=used;data[p+2u]=capacity;
}
bool component_tile(uint root,ivec2 low,ivec2 extent,ivec2 tile) {
    for(int y=0;y<16;y++) for(int x=0;x<16;x++) {
        ivec2 local=tile*16+ivec2(x,y);
        if(any(greaterThanEqual(local,extent))) continue;
        if(label_at(low+local)==root) return true;
    }
    return false;
}
void extract(uint root,uint bounds) {
    uint size=sizes[root];if(size==0u||labels[root]!=root) return;
    uint atlas;ivec2 first=ivec2(root%params.width,root/params.width);
    if(!cell_ref(first,atlas)) return;
    uint material=cells[atlas].x&0xffffu;
    if(material!=1u&&material!=7u&&material!=8u) return;
    uint root_material=material==7u?2u:material==8u?4u:1u;
    ivec2 low=ivec2(data[bounds+1u],data[bounds+2u]),high=ivec2(data[bounds+3u],data[bounds+4u]);
    if(data[bounds+6u]!=0u||data[bounds+5u]!=size) return;
