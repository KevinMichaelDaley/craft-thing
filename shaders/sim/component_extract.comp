        for(uint section=0u;section<2u&&count<64u;section++) {
            uint begin=section==0u?cursor:0u,end=section==0u?total:cursor;
            if(begin==end) continue;
            for(uint word=begin/32u;word<=(end-1u)/32u&&count<64u;word++) {
                uint mask=candidates[word],lo=word==begin/32u?begin%32u:0u;
