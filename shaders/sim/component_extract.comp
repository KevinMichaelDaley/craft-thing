#version 450
#extension GL_GOOGLE_include_directive : require
#include "rigid_body.glsl"
layout(local_size_x=128) in;
layout(set=0,binding=1,std430) buffer Cells { uvec2 cells[]; };
layout(set=0,binding=2,std430) readonly buffer Pages { uint pages[]; };
layout(set=0,binding=4,std430) buffer Storage { Body bodies[BODY_CAPACITY]; uint data[]; };
layout(set=0,binding=28,std430) readonly buffer Labels { uint labels[]; };
layout(set=0,binding=29,std430) buffer Candidates { uint candidates[]; };
layout(set=0,binding=30,std430) readonly buffer Sizes { uint sizes[]; };
layout(push_constant) uniform Params { uint width,height,mode,count; uvec2 origin_x,origin_y; } params;
uint base() {
    uint w=(params.width+63u)/64u+2u,h=(params.height+63u)/64u+2u;
    return 8u+2u*w*h+4096u*8u+12u+8192u*32u+16u+64u*32u+8192u*16u;
}
uint graph() {return base()+32u+data[base()+1u]*8u;}
bool cell_ref(ivec2 p,out uint index) {
    if(any(lessThan(p,ivec2(0)))||any(greaterThanEqual(p,ivec2(params.width,params.height)))) return false;
    uint page=pages[uint(p.y/64)*((params.width+63u)/64u)+uint(p.x/64)];
    if(page==0u||page>data[base()+1u]) return false;
    uint slot=base()+32u+(page-1u)*8u;uvec2 x,y;
    if(!shifted_chunk(params.origin_x,p.x/64,x)||!shifted_chunk(params.origin_y,p.y/64,y)) return false;
    if(data[slot+5u]==0u||any(notEqual(uvec2(data[slot],data[slot+1u]),x))||
       any(notEqual(uvec2(data[slot+2u],data[slot+3u]),y))) return false;
    index=(page-1u)*4096u+uint(p.y%64)*64u+uint(p.x%64);return true;
}
uint label_at(ivec2 p) {return labels[uint(p.y)*params.width+uint(p.x)];}
void extract(uint root) {
    uint size=sizes[root];if(size==0u||size>256u||labels[root]!=root) return;
    uint root_atlas;ivec2 root_point=ivec2(root%params.width,root/params.width);
    if(!cell_ref(root_point,root_atlas)) return;
    uint root_material=cells[root_atlas].x&0xffffu;
    if(root_material!=1u&&root_material!=7u&&root_material!=8u) return;
    ivec2 first=ivec2(root%params.width,root/params.width),low=first,high=first;
    uint found=0u;bool cold=false;
    const ivec2 neighbors[4]=ivec2[4](ivec2(-1,0),ivec2(1,0),ivec2(0,-1),ivec2(0,1));
    for(int y=0;y<16;y++) for(int x=-15;x<=15;x++) {
        ivec2 p=first+ivec2(x,y);uint atlas;
        if(!cell_ref(p,atlas)||label_at(p)!=root) continue;
        found++;low=min(low,p);high=max(high,p);
        for(uint n=0u;n<4u;n++) {uint other;if(!cell_ref(p+neighbors[n],other)) cold=true;}
    }
    if(cold||found!=size||any(greaterThan(high-low+1,ivec2(16)))) return;
    uint occupied[256];
    for(uint i=0u;i<256u;i++) occupied[i]=0u;
    ivec2 extent=high-low+1;
    for(int y=0;y<extent.y;y++) for(int x=0;x<extent.x;x++) {
        ivec2 p=low+ivec2(x,y);uint atlas;
        if(cell_ref(p,atlas)&&label_at(p)==root) occupied[uint(y*16+x)]=cells[atlas].x&0xffffu;
    }
    Shape pieces[4];uint piece_count=0u;
    for(int y=0;y<extent.y;y++) for(int x=0;x<extent.x;x++) {
        uint material=occupied[uint(y*16+x)];if(material==0u) continue;
        if(piece_count==4u) return;
        int right=x+1;while(right<extent.x&&occupied[uint(y*16+right)]==material) right++;
        int bottom=y+1;
        while(bottom<extent.y) {
            bool row=true;for(int xx=x;xx<right;xx++) if(occupied[uint(bottom*16+xx)]!=material) row=false;
            if(!row) break;bottom++;
        }
        Shape shape;shape.count=4u;shape.material=material==7u?2u:material==8u?4u:1u;
        for(uint v=0u;v<8u;v++) shape.vertices[v]=ivec2(0);
        shape.vertices[0]=ivec2(x,y)<<16;shape.vertices[1]=ivec2(right,y)<<16;
        shape.vertices[2]=ivec2(right,bottom)<<16;shape.vertices[3]=ivec2(x,bottom)<<16;
        pieces[piece_count++]=shape;
        for(int yy=y;yy<bottom;yy++) for(int xx=x;xx<right;xx++) occupied[uint(yy*16+xx)]=0u;
    }
    uint slot=64u;for(uint i=0u;i<64u;i++) if(bodies[i].enabled==0u&&bodies[i].reserved0==0u) {slot=i;break;}
    if(slot==64u) {data[base()+STRUCTURAL_COMPONENT_DIRTY_WORD]=1u;return;}
    if(data[base()+14u]>=0x7fffffffu) return;
    uint serial=data[base()+14u]+1u,id=0x80000000u+serial;
    for(uint i=0u;i<64u;i++) if(bodies[i].id==id&&(bodies[i].enabled!=0u||bodies[i].reserved0!=0u)) return;
    Body body=bodies[slot];
    body.x_fp=low.x<<16;body.y_fp=low.y<<16;body.vx_fp=0;body.vy_fp=0;
    body.width=uint(extent.x);body.height=uint(extent.y);body.id=id;body.enabled=1u;
    body.previous_x_fp=body.x_fp;body.previous_y_fp=body.y_fp;body.reserved0=0x53545232u;body.reserved1=1u;
    shifted_chunk(params.origin_x,low.x/64,body.chunk_x);shifted_chunk(params.origin_y,low.y/64,body.chunk_y);
    body.local_fp=(low%64)<<16;body.visible=1u;body.angle=0;body.angular_velocity=0;
    body.motion_flags=0u;body.motion_ready=0u;body.piece_count=piece_count==1u?0u:piece_count;
    body.compound_reserved=0u;body.vertex_count=pieces[0].count;body.material=pieces[0].material;
    for(uint v=0u;v<8u;v++) body.vertices[v]=pieces[0].vertices[v];
    for(uint p=0u;p<4u;p++) {body.pieces[p].count=0u;body.pieces[p].material=0u;
        for(uint v=0u;v<8u;v++) body.pieces[p].vertices[v]=ivec2(0);
        if(p<piece_count&&piece_count>1u) body.pieces[p]=pieces[p];}
    body.previous_angle=0;body.rest_position=ivec2(body.x_fp,body.y_fp);body.rest_angle=0;body.rest_ticks=0u;
    body_properties(body);body_cache_bounds(body);
    bodies[slot]=body;data[base()+14u]=serial;
    uint record=graph()+36000u+slot*4u;data[record]=id;data[record+1u]=1u;data[record+2u]=serial;data[record+3u]=1u;
    for(int y=0;y<extent.y;y++) for(int x=0;x<extent.x;x++) {
        ivec2 p=low+ivec2(x,y);uint atlas;
        if(cell_ref(p,atlas)&&label_at(p)==root) cells[atlas].x=0u;
    }
}
void main() {
    if(data[base()+STRUCTURAL_COMPONENT_DIRTY_WORD]==0u) return;
    uint total=params.width*params.height, words=(total+31u)/32u;
    if(params.mode==1u) {
        uint word=gl_GlobalInvocationID.x;if(word>=words) return;
        uint mask=0u;
        for(uint bit=0u;bit<32u;bit++) {
            uint root=word*32u+bit;if(root>=total) break;
            if(sizes[root]!=0u&&sizes[root]<=256u&&labels[root]==root) mask|=1u<<bit;
        }
        candidates[word]=mask;return;
    }
    if(gl_GlobalInvocationID.x!=0u) return;
    data[base()+STRUCTURAL_COMPONENT_DIRTY_WORD]=0u;
    for(uint word=0u;word<words;word++) {
        uint mask=candidates[word];
        while(mask!=0u) {uint bit=uint(findLSB(mask));extract(word*32u+bit);mask&=mask-1u;}
    }
}
