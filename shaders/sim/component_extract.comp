#version 450
#extension GL_GOOGLE_include_directive : require
#include "rigid_body.glsl"
layout(local_size_x=128) in;
layout(set=0,binding=1,std430) buffer Cells { uvec2 cells[]; };
layout(set=0,binding=2,std430) readonly buffer Pages { uint pages[]; };
layout(set=0,binding=4,std430) buffer Storage { Body bodies[BODY_CAPACITY]; uint data[]; };
layout(set=0,binding=28,std430) readonly buffer Labels { uint labels[]; };
layout(set=0,binding=29,std430) buffer Candidates { uint candidates[]; };
layout(set=0,binding=30,std430) readonly buffer Sizes { uint sizes[]; };
uint pixel_word_at(uint index) {return data[index-BODY_STORAGE_WORDS];}
layout(push_constant) uniform Params { uint width,height,mode,count; uvec2 origin_x,origin_y; } params;
uint base() {
    uint w=(params.width+63u)/64u+2u,h=(params.height+63u)/64u+2u;
    return 8u+2u*w*h+4096u*8u+12u+8192u*32u+16u+64u*32u+8192u*16u;
