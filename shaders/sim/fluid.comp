#version 450
layout(local_size_x = 64, local_size_y = 1) in;

layout(set = 0, binding = 1, std430) buffer ChunkCells { uvec2 chunk_cells[]; };
layout(set = 0, binding = 2, std430) readonly buffer PageTable { uint pages[]; };
layout(set = 0, binding = 3, std430) readonly buffer Occupancy { uint occupancy[]; };
layout(set = 0, binding = 8, std430) buffer FluidA { uint fluid_a[]; };
layout(set = 0, binding = 9, std430) buffer FluidB { int fluid_b[]; };
layout(set = 0, binding = 10, std430) buffer FaceVelocity { vec2 face_velocity[]; };
layout(set = 0, binding = 16, std430) readonly buffer MarkerGrid { uint marker_grid[]; };
layout(push_constant) uniform Params {
    uint width;
    uint height;
    uint mode;
    uint tick_parity;
    uint unused1;
    uint unused2;
    uint unused3;
} params;

const uint SIDE = 64u;
const uint CELLS_PER_CHUNK = 4096u;
const uint FULL = 65536u;
const float STEP_SECONDS = 1.0;
const float TRANSPORT_FUDGE = 1.001;
const float VELOCITY_DAMPING = 0.999;

uint page_at(ivec2 p) {
    if (p.x < 0 || p.y < 0 || p.x >= int(params.width) ||
        p.y >= int(params.height)) return 0u;
    uint page_width = (params.width + SIDE - 1u) / SIDE;
    return pages[(uint(p.y) / SIDE) * page_width + uint(p.x) / SIDE];
}

uint atlas_index(ivec2 p, uint page) {
    return (page - 1u) * CELLS_PER_CHUNK +
           (uint(p.y) % SIDE) * SIDE + uint(p.x) % SIDE;
}

uint source_mass(uint index) {
    return params.mode == 6u || params.mode == 8u ?
           fluid_a[index] : uint(fluid_b[index]);
}

void write_mass(uint index, uint mass) {
    if (params.mode == 6u || params.mode == 8u) fluid_b[index] = int(mass);
    else fluid_a[index] = mass;
}

bool open_cell(ivec2 p) {
    uint page = page_at(p);
    if (page == 0u) return false;
    uint index = uint(p.y) * params.width + uint(p.x);
    uint material = chunk_cells[atlas_index(p, page)].x & 0xffffu;
    return (material == 0u || material == 2u || material == 4u ||
            material == 5u) && occupancy[index] == 0u;
}

void move_line(ivec2 source, ivec2 direction, bool vertical) {
    if (!open_cell(source)) return;
    ivec2 face = source + min(direction, ivec2(0));
    if (!open_cell(source + direction)) return;
    uint face_index = uint(face.y) * params.width + uint(face.x);
    float speed = vertical ? face_velocity[face_index].y : face_velocity[face_index].x;
    if (direction.x < 0 || direction.y < 0) speed = -speed;
    if (speed <= 0.0) return;
    uint source_index = atlas_index(source, page_at(source));
    uint available = chunk_cells[source_index].y;
    if (available == 0u) return;
    float travel = speed * STEP_SECONDS * TRANSPORT_FUDGE;
    uint edge = vertical ? (direction.y > 0 ? params.height - 1u - uint(source.y) :
                                                uint(source.y)) :
                           (direction.x > 0 ? params.width - 1u - uint(source.x) :
                                                uint(source.x));
    uint reach = min(uint(ceil(travel)), edge);
    for (uint offset = 1u; offset <= reach; ++offset)
        if (!open_cell(source + direction * int(offset))) {
            reach = offset - 1u;
            break;
        }
    for (uint offset = reach; offset > 0u && available > 0u; --offset) {
        ivec2 destination = source + direction * int(offset);
        uint destination_index = atlas_index(destination, page_at(destination));
        uint receiving = chunk_cells[destination_index].y;
        if (receiving >= FULL) continue;
        float fraction = clamp(travel - float(offset - 1u), 0.0, 1.0);
        uint allowance = uint(floor(fraction * float(FULL)));
        uint flux = min(min(allowance, available), FULL - receiving);
        available -= flux;
        chunk_cells[destination_index].y = receiving + flux;
    }
    chunk_cells[source_index].y = available;
}

void scan_line(uint line) {
    if (params.mode <= 1u) {
        if (line >= params.width) return;
        if (params.mode == 0u) {
            for (int y = int(params.height) - 2; y >= 0; --y)
                move_line(ivec2(int(line), y), ivec2(0, 1), true);
        } else {
            for (uint y = 1u; y < params.height; ++y)
                move_line(ivec2(int(line), int(y)), ivec2(0, -1), true);
        }
    } else {
        if (line >= params.height) return;
        if (params.mode == 2u) {
            for (int x = int(params.width) - 2; x >= 0; --x)
                move_line(ivec2(x, int(line)), ivec2(1, 0), false);
        } else {
            for (uint x = 1u; x < params.width; ++x)
                move_line(ivec2(int(x), int(line)), ivec2(-1, 0), false);
        }
    }
}

void correct_pair(ivec2 p) {
    uint index = uint(p.y) * params.width + uint(p.x);
    uint own = source_mass(index);
    bool vertical = params.mode <= 7u;
    int parity = int(((params.mode - 6u) & 1u) ^ params.tick_parity);
    int coordinate = vertical ? p.y : p.x;
    int delta = (coordinate & 1) == parity ? 1 : -1;
    ivec2 neighbor = p + (vertical ? ivec2(0, delta) : ivec2(delta, 0));
    uint own_page = page_at(p);
    uint other_page = page_at(neighbor);
    if (own_page == 0u || other_page == 0u ||
        !open_cell(p) || !open_cell(neighbor)) {
        write_mass(index, own);
        return;
    }
    uint other_index = uint(neighbor.y) * params.width + uint(neighbor.x);
    uint other = source_mass(other_index);
    ivec2 first = vertical ? (p.y < neighbor.y ? p : neighbor) :
                              (p.x < neighbor.x ? p : neighbor);
    ivec2 second = first == p ? neighbor : p;
    uint first_page = page_at(first);
    uint second_page = page_at(second);
    uint first_guide = marker_grid[atlas_index(first, first_page)];
    uint second_guide = marker_grid[atlas_index(second, second_page)];
    uint first_mass = first == p ? own : other;
    uint second_mass = first == p ? other : own;
    int request = 0;
    if ((first_guide & 1u) != 0u && (second_guide & 1u) == 0u &&
        (second_guide & 2u) != 0u &&
        first_mass >= second_mass) request = -8192;
    else if ((first_guide & 1u) == 0u && (first_guide & 2u) != 0u &&
             (second_guide & 1u) != 0u &&
             second_mass >= first_mass) request = 8192;
    if (request == 0) {
        write_mass(index, own);
        return;
    }
    bool sender = (p == first) == (request > 0);
    uint available = sender ? own : other;
    uint receiving = sender ? other : own;
    uint flux = min(min(uint(abs(request)), available),
                    receiving < FULL ? FULL - receiving : 0u);
    write_mass(index, sender ? own - flux : own + flux);
}

void main() {
    uint linear = gl_GlobalInvocationID.x;
    if (params.mode <= 3u) {
        scan_line(linear);
        return;
    }
    if (linear >= params.width * params.height) return;
    uint index = linear;
    ivec2 position = ivec2(int(linear % params.width), int(linear / params.width));
    uint page = page_at(position);
    if (params.mode == 4u) {
        fluid_a[index] = page == 0u ? 0u :
                         chunk_cells[atlas_index(position, page)].y;
    } else if (params.mode == 5u) {
        if (page != 0u) chunk_cells[atlas_index(position, page)].y = fluid_a[index];
        face_velocity[index] *= VELOCITY_DAMPING;
    } else if (params.mode >= 6u && params.mode <= 9u) {
        correct_pair(position);
    }
}
