#version 450
layout(local_size_x = 64, local_size_y = 1) in;

layout(set = 0, binding = 1, std430) buffer ChunkCells { uvec2 chunk_cells[]; };
layout(set = 0, binding = 2, std430) readonly buffer PageTable { uint pages[]; };
layout(set = 0, binding = 3, std430) readonly buffer Occupancy { uint occupancy[]; };
layout(set = 0, binding = 8, std430) buffer FluidA { uint fluid_a[]; };
layout(set = 0, binding = 9, std430) buffer FluidB { int fluid_b[]; };
layout(set = 0, binding = 10, std430) buffer FaceVelocity { vec2 face_velocity[]; };
layout(set = 0, binding = 16, std430) readonly buffer MarkerGrid { uint marker_grid[]; };
layout(set = 0, binding = 17, std430) readonly buffer SlotPages { uint slot_pages[]; };
layout(set = 0, binding = 31, std430) buffer FluidPrevious { uint fluid_previous[]; };
layout(push_constant) uniform Params {
    uint width;
    uint height;
    uint mode;
    uint tick_parity;
    uint unused1;
    uint step_scale_bits;
    uint elapsed_time_mode;
} params;

const uint SIDE = 64u;
const uint CELLS_PER_CHUNK = 4096u;
const uint FULL = 65536u;
const uint DISPLACEMENT_MODE = 11u;
const uint LATERAL_DISPLACEMENT_MODE = 12u;
const int DISPLACEMENT_REACH = 64;
const float TRANSPORT_FUDGE = 1.001;
const float VELOCITY_DAMPING = 0.997;

uint page_at(ivec2 p) {
    if (p.x < 0 || p.y < 0 || p.x >= int(params.width) ||
        p.y >= int(params.height)) return 0u;
    uint page_width = (params.width + SIDE - 1u) / SIDE;
    return pages[(uint(p.y) / SIDE) * page_width + uint(p.x) / SIDE];
}

uint atlas_index(ivec2 p, uint page) {
    return (page - 1u) * CELLS_PER_CHUNK +
           (uint(p.y) % SIDE) * SIDE + uint(p.x) % SIDE;
}

uint source_mass(uint index) {
    return params.mode == 6u || params.mode == 8u ?
           fluid_a[index] : uint(fluid_b[index]);
}

void write_mass(uint index, uint mass) {
    if (params.mode == 6u || params.mode == 8u) fluid_b[index] = int(mass);
    else fluid_a[index] = mass;
}

bool permeable_material(uint material) {
    return material == 0u || material == 2u || material == 4u || material == 5u || material == 6u;
}

bool open_cell(ivec2 p) {
    uint page = page_at(p);
    if (page == 0u) return false;
    uint index = uint(p.y) * params.width + uint(p.x);
    uint material = chunk_cells[atlas_index(p, page)].x & 0xffffu;
    return permeable_material(material) && occupancy[2u*params.width*params.height+index] < FULL;
}

uint receiving_capacity(ivec2 p) {
    uint index=uint(p.y)*params.width+uint(p.x);
    return FULL-min(FULL,occupancy[2u*params.width*params.height+index]);
}

float face_aperture(ivec2 p,ivec2 direction) {
    ivec2 face=p+min(direction,ivec2(0));
    if(page_at(face)==0u) return 0;
    uint index=uint(face.y)*params.width+uint(face.x);
    uint axis=direction.x!=0?3u:4u;
    return float(FULL-min(FULL,occupancy[axis*params.width*params.height+index]))/float(FULL);
}

void move_line(ivec2 source, ivec2 direction, bool vertical) {
    uint source_page = page_at(source);
    if (source_page == 0u) return;
    uint source_index = atlas_index(source, source_page);
    uvec2 source_cell = chunk_cells[source_index];
    uint available = source_cell.y;
    if (available == 0u) return;
    if (!permeable_material(source_cell.x & 0xffffu) ||
        receiving_capacity(source)==0u) return;
    ivec2 face = source + min(direction, ivec2(0));
    if (!open_cell(source + direction)) return;
    float aperture=face_aperture(source,direction);
    if(aperture<=0) return;
    uint face_index = uint(face.y) * params.width + uint(face.x);
    float speed = vertical ? face_velocity[face_index].y : face_velocity[face_index].x;
    if (vertical && params.elapsed_time_mode != 0u)
        speed = 0.5 * (speed + uintBitsToFloat(fluid_a[face_index]));
    if (direction.x < 0 || direction.y < 0) speed = -speed;
    if (speed <= 0.0) return;
    float travel = speed * uintBitsToFloat(params.step_scale_bits) * TRANSPORT_FUDGE;
    uint edge = vertical ? (direction.y > 0 ? params.height - 1u - uint(source.y) :
                                                uint(source.y)) :
                           (direction.x > 0 ? params.width - 1u - uint(source.x) :
                                                uint(source.x));
    uint reach = min(uint(ceil(travel)), edge);
    if (reach == 1u) {
        ivec2 destination = source + direction;
        uint destination_index = atlas_index(destination, page_at(destination));
        uint receiving = chunk_cells[destination_index].y;
        uint allowance = uint(floor(clamp(travel, 0.0, 1.0) * float(FULL)*aperture));
        uint capacity=receiving_capacity(destination);
        uint flux = min(min(allowance, available), receiving < capacity ? capacity - receiving : 0u);
        if (flux != 0u) {
            chunk_cells[destination_index].y = receiving + flux;
            chunk_cells[source_index].y = available - flux;
        }
        return;
    }
    for (uint offset = 2u; offset <= reach; ++offset)
        if (!open_cell(source + direction * int(offset)) ||
            face_aperture(source+direction*int(offset-1u),direction)<=0) {
            reach = offset - 1u;
            break;
        }
    for (uint offset = reach; offset > 0u && available > 0u; --offset) {
        ivec2 destination = source + direction * int(offset);
        uint destination_index = atlas_index(destination, page_at(destination));
        uint receiving = chunk_cells[destination_index].y;
        uint capacity=receiving_capacity(destination);
        if (receiving >= capacity) continue;
        float fraction = clamp(travel - float(offset - 1u), 0.0, 1.0);
        float path_aperture=aperture;
        for(uint edge=1u;edge<offset;edge++)
            path_aperture=min(path_aperture,face_aperture(source+direction*int(edge),direction));
        uint allowance = uint(floor(fraction * float(FULL)*path_aperture));
        uint flux = min(min(allowance, available), capacity - receiving);
        available -= flux;
        chunk_cells[destination_index].y = receiving + flux;
    }
    if (available != source_cell.y) chunk_cells[source_index].y = available;
}

void scan_line(uint line) {
    if (params.mode <= 1u) {
        if (line >= params.width) return;
        if (params.mode == 0u) {
            for (int y = int(params.height) - 2; y >= 0; --y)
                move_line(ivec2(int(line), y), ivec2(0, 1), true);
        } else {
            for (uint y = 1u; y < params.height; ++y)
                move_line(ivec2(int(line), int(y)), ivec2(0, -1), true);
        }
    } else {
        if (line >= params.height) return;
        if (params.mode == 2u) {
            for (int x = int(params.width) - 2; x >= 0; --x)
                move_line(ivec2(x, int(line)), ivec2(1, 0), false);
        } else {
            for (uint x = 1u; x < params.width; ++x)
                move_line(ivec2(int(x), int(line)), ivec2(-1, 0), false);
        }
    }
}

void displace_column(uint x) {
    if (x >= params.width) return;
    for (int y = int(params.height) - 1; y >= 0; --y) {
        ivec2 source = ivec2(int(x), y);
        uint page = page_at(source);
        if (page == 0u || occupancy[uint(y) * params.width + x] == 0u) continue;
        uint source_index = atlas_index(source, page);
        uint retained=min(chunk_cells[source_index].y,receiving_capacity(source));
        uint remaining = chunk_cells[source_index].y-retained;
        if (remaining == 0u) continue;
        for (int above = y - 1; above >= 0 && remaining != 0u; --above) {
            ivec2 destination = ivec2(int(x), above);
            uint destination_page = page_at(destination);
            if (destination_page == 0u) break;
            uint destination_index = atlas_index(destination, destination_page);
            if (!permeable_material(chunk_cells[destination_index].x & 0xffffu)) break;
            uint receiving = chunk_cells[destination_index].y;
            uint capacity=receiving_capacity(destination);
            uint flux = min(remaining, receiving < capacity ? capacity - receiving : 0u);
            chunk_cells[destination_index].y = receiving + flux;
            remaining -= flux;
        }
        /* Retain unresolved water at its original world cell. It is explicitly
           reported as overflow and remains authoritative through streaming. */
        chunk_cells[source_index].y = retained+remaining;
    }
}

void displace_row(uint y) {
    if(y>=params.height) return;
    for(uint x=0u;x<params.width;x++) {
        ivec2 source=ivec2(int(x),int(y));uint page=page_at(source);
        if(page==0u||occupancy[y*params.width+x]==0u) continue;
        uint source_index=atlas_index(source,page),water=chunk_cells[source_index].y;
        uint retained=min(water,receiving_capacity(source)),remaining=water-retained;
        if(remaining==0u) continue;
        bool left_open=true,right_open=true;
        for(int distance=1;distance<=DISPLACEMENT_REACH&&remaining!=0u;distance++) {
            for(int side=-1;side<=1;side+=2) {
                if((side<0&&!left_open)||(side>0&&!right_open)) continue;
                ivec2 destination=source+ivec2(side*distance,0);uint target_page=page_at(destination);
                if(target_page==0u) {if(side<0) left_open=false;else right_open=false;continue;}
                uint target=atlas_index(destination,target_page);
                if(!permeable_material(chunk_cells[target].x&0xffffu)) {
                    if(side<0) left_open=false;else right_open=false;continue;
                }
                uint capacity=receiving_capacity(destination),receiving=chunk_cells[target].y;
                uint flux=min(remaining,receiving<capacity?capacity-receiving:0u);
                chunk_cells[target].y=receiving+flux;remaining-=flux;
            }
            if(!left_open&&!right_open) break;
        }
        chunk_cells[source_index].y=retained+remaining;
    }
}

void correct_pair(ivec2 p) {
    uint index = uint(p.y) * params.width + uint(p.x);
    uint own = source_mass(index);
    bool vertical = params.mode <= 7u;
    int parity = int(((params.mode - 6u) & 1u) ^ params.tick_parity);
    int coordinate = vertical ? p.y : p.x;
    int delta = (coordinate & 1) == parity ? 1 : -1;
    ivec2 neighbor = p + (vertical ? ivec2(0, delta) : ivec2(delta, 0));
    uint own_page = page_at(p);
    uint other_page = page_at(neighbor);
    if (own_page == 0u || other_page == 0u ||
        !open_cell(p) || !open_cell(neighbor)) {
        write_mass(index, own);
        return;
    }
    uint other_index = uint(neighbor.y) * params.width + uint(neighbor.x);
    uint other = source_mass(other_index);
    ivec2 first = vertical ? (p.y < neighbor.y ? p : neighbor) :
                              (p.x < neighbor.x ? p : neighbor);
    ivec2 second = first == p ? neighbor : p;
    uint first_page = page_at(first);
    uint second_page = page_at(second);
    uint first_guide = marker_grid[atlas_index(first, first_page)];
    uint second_guide = marker_grid[atlas_index(second, second_page)];
    uint first_mass = first == p ? own : other;
    uint second_mass = first == p ? other : own;
    int request = 0;
    if ((first_guide & 1u) != 0u && (second_guide & 1u) == 0u &&
        (second_guide & 2u) != 0u &&
        first_mass >= second_mass) request = -8192;
    else if ((first_guide & 1u) == 0u && (first_guide & 2u) != 0u &&
             (second_guide & 1u) != 0u &&
             second_mass >= first_mass) request = 8192;
    if (request == 0) {
        write_mass(index, own);
        return;
    }
    bool sender = (p == first) == (request > 0);
    uint available = sender ? own : other;
    uint receiving = sender ? other : own;
    uint capacity=receiving_capacity(sender?neighbor:p);
    float aperture=face_aperture(p,neighbor-p);
    uint flux = min(min(min(uint(abs(request)),uint(aperture*float(FULL))), available),
                    receiving < capacity ? capacity - receiving : 0u);
    write_mass(index, sender ? own - flux : own + flux);
}

void main() {
    uint linear = gl_GlobalInvocationID.x;
    if (params.mode == LATERAL_DISPLACEMENT_MODE) {
        displace_row(linear);
        return;
    }
    if (params.mode == DISPLACEMENT_MODE) {
        displace_column(linear);
        return;
    }
    if (params.mode <= 3u) {
        scan_line(linear);
        return;
    }
    uint tile = slot_pages[gl_WorkGroupID.z];
    if (tile == 0xffffffffu) return;
    uint stride = (params.width + SIDE - 1u) / SIDE;
    ivec2 position = ivec2(int((tile % stride) * SIDE + linear % SIDE),
                           int((tile / stride) * SIDE + linear / SIDE));
    if (position.x >= int(params.width) || position.y >= int(params.height)) return;
    uint index = uint(position.y) * params.width + uint(position.x);
    uint page = page_at(position);
    if (params.mode == 10u) {
        fluid_previous[index] = page == 0u ? 0u :
                                chunk_cells[atlas_index(position, page)].y;
    } else if (params.mode == 4u) {
        fluid_a[index] = page == 0u ? 0u :
                         chunk_cells[atlas_index(position, page)].y;
    } else if (params.mode == 5u) {
        if (page != 0u) chunk_cells[atlas_index(position, page)].y = fluid_a[index];
        face_velocity[index] *= pow(VELOCITY_DAMPING,
                                    uintBitsToFloat(params.step_scale_bits));
    } else if (params.mode >= 6u && params.mode <= 9u) {
        correct_pair(position);
    }
}
