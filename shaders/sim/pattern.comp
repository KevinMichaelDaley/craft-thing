#version 450
#extension GL_GOOGLE_include_directive : require
#include "material_palette.glsl"
layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0, std430) buffer Cells { uint cells[]; };
layout(set = 0, binding = 1, std430) buffer ChunkCells { uvec2 chunk_cells[]; };
layout(set = 0, binding = 2, std430) readonly buffer PageTable { uint pages[]; };
layout(set = 0, binding = 3, std430) readonly buffer Occupancy { uint occupancy[]; };
layout(set = 0, binding = 16, std430) readonly buffer MarkerGrid { uint marker_grid[]; };
struct Particle {
    int x_fp, y_fp, vx_fp, vy_fp;
    float f00, f01, f10, f11;
    uint id_lo, id_hi, mass_fp, grain_fp;
    uint material, flags;
};
layout(set = 0, binding = 18, std430) readonly buffer SlotSeeds { uint seeds[]; };
layout(set = 0, binding = 19, std430) buffer Particles { Particle particles[]; };
layout(set = 0, binding = 20, std430) buffer ParticleCounts { uint particle_counts[]; };
layout(set = 0, binding = 31, std430) readonly buffer FluidPrevious { uint previous_mass[]; };
layout(push_constant) uniform Params {
    uint width;
    uint height;
    uint mode;
    uint brush_x;
    uint brush_y;
    uint radius;
    uint color;
} params;

uint grain_radius_fp(uint material) {
    return material == 2u ? 16384u : material == 4u ? 24576u : 32768u;
}

float grain_density(uint material) {
    return material == 2u ? 2.65 : material == 5u ? 2.7 : 1.2;
}

vec3 linear_color(uint packed) {
    vec3 rgb = vec3(float(packed & 255u), float((packed >> 8) & 255u),
                    float((packed >> 16) & 255u)) / 255.0;
    return rgb * rgb;
}

uint pack_linear_color(vec3 linear_rgb) {
    uvec3 rgb = uvec3(round(255.0 * sqrt(clamp(linear_rgb, vec3(0.0),
                                               vec3(1.0)))));
    return 0xff000000u | (rgb.b << 16) | (rgb.g << 8) | rgb.r;
}

uint material_color(uint material, uint flags) {
    if (material == 0u || material == 3u) return 0xff181818u;
    if (material == 1u) return COLOR_STONE;
    if (material == 2u)
        return (flags & 0x00ffffffu) != 0u ? COLOR_WET_SAND : COLOR_SAND;
    if (material == 4u)
        return (flags & 0x80000000u) != 0u ? COLOR_MUD : COLOR_DIRT;
    if (material == 5u) return COLOR_GRAVEL;
    return COLOR_STONE;
}

struct DensitySample {
    vec3 premultiplied;
    float coverage;
};
DensitySample material_density(ivec2 p) {
    DensitySample density_sample = DensitySample(vec3(0.0), 0.0);
    if (p.x < 0 || p.y < 0 || p.x >= int(params.width) ||
        p.y >= int(params.height)) return density_sample;
    uint page_width = (params.width + 63u) / 64u;
    uint page = pages[(uint(p.y) / 64u) * page_width + uint(p.x) / 64u];
    if (page == 0u) return density_sample;
    uint index = (page - 1u) * 4096u + (uint(p.y) % 64u) * 64u + uint(p.x) % 64u;
    uvec2 cell = chunk_cells[index];
    uint material = cell.x & 0xffffu;
    float solid = 0.0;
    float solid_volume = 0.0;
    vec3 solid_color = vec3(0.0);
    if (material == 2u || material == 4u || material == 5u) {
        uint first = (page - 1u) * 8192u + index % 4096u;
        float particle_mass = 0.0;
        float particle_volume = 0.0;
        for (uint layer = 0u; layer < 2u; ++layer) {
            Particle particle = particles[first + layer * 4096u];
            if (particle.mass_fp == 0u) continue;
            float mass = float(particle.mass_fp) / 65536.0;
            solid_color += mass * linear_color(material_color(particle.material,
                                                               particle.flags));
            particle_mass += mass;
            particle_volume += mass / grain_density(particle.material);
        }
        if (particle_mass > 0.0) {
            solid = min(particle_mass, 1.0);
            solid_volume = min(particle_volume, 1.0);
            solid_color /= particle_mass;
        } else {
            solid = 1.0;
            solid_volume = 1.0;
            solid_color = linear_color(material_color(material, 0u));
        }
    } else if (material != 0u && material != 3u) {
        solid = 1.0;
        solid_volume = 1.0;
        solid_color = linear_color(material_color(material, 0u));
    }
    float water = min(float(cell.y) / 65536.0, 1.0);
    if (params.mode == 2u && (params.brush_x >> 8) < 65535u) {
        float old_water = min(float(previous_mass[uint(p.y) * params.width +
                                                 uint(p.x)]) / 65536.0, 1.0);
        water = mix(old_water, water, float(params.brush_x >> 8) / 65535.0);
    }
    float solid_weight = mix(solid, solid_volume, water);
    float water_weight = water * (1.0 - solid_volume);
    density_sample.coverage = solid_weight + water_weight;
    density_sample.premultiplied = water_weight * linear_color(COLOR_WATER) +
                                   solid_weight * solid_color;
    if (occupancy[uint(p.y) * params.width + uint(p.x)] != 0u) {
        density_sample.coverage = 1.0;
        density_sample.premultiplied = linear_color(0xff30c040u);
    }
    return density_sample;
}

uint cell_material_color(ivec2 p) {
    DensitySample density_sample = material_density(p);
    return pack_linear_color(density_sample.premultiplied +
                             (1.0 - density_sample.coverage) * linear_color(0xff181818u));
}

void main() {
    uvec2 display_cell = gl_GlobalInvocationID.xy;
    uvec2 p = display_cell;
    if (params.mode == 2u) p += uvec2(params.radius, params.color);
    if (params.mode == 4u) {
        ivec2 source = ivec2(display_cell) +
                       ivec2(params.brush_x, params.brush_y) - ivec2(8);
        if (source.x < 0 || source.y < 0) return;
        p = uvec2(source);
    }
    if (p.x >= params.width || p.y >= params.height) return;
    if (params.mode == 0u) {
        cells[p.y * params.width + p.x] = ((p.x + p.y) & 1u) == 0u
            ? 0xff202020u : 0xff4040c0u;
    } else if (params.mode == 1u) {
        int dx = int(p.x) - int(params.brush_x);
        int dy = int(p.y) - int(params.brush_y);
        int r = int(params.radius);
        if (dx * dx + dy * dy <= r * r)
            cells[p.y * params.width + p.x] = params.color;
    } else {
        uint page_width = (params.width + 63u) / 64u;
        uint page = pages[(p.y / 64u) * page_width + p.x / 64u];
        if (page == 0u) {
            cells[p.y * params.width + p.x] = 0xffff00ffu;
            return;
        }
        uint index = (page - 1u) * 4096u + (p.y % 64u) * 64u + p.x % 64u;
        if (params.mode == 2u && params.brush_y != 2u) {
            uint filtered = cell_material_color(ivec2(p));
            if ((params.brush_x & 1u) != 0u) {
                uint guide = marker_grid[index];
                if ((guide & 1u) != 0u) filtered = 0xffd040e0u;
                else if ((guide & 2u) != 0u) filtered = 0xff40e0d0u;
            }
            if (params.brush_y == 1u &&
                ((p.x % 64u) == 0u || (p.y % 64u) == 0u))
                filtered = 0xff30d030u;
            cells[p.y * params.width + p.x] = filtered;
            return;
        }
        uvec2 cell = chunk_cells[index];
        uint material = cell.x & 0xffffu;
        uint slot = page - 1u;
        uint local_index = index % 4096u;
        uint particle_index = slot * 8192u + local_index;
        uint secondary_index = particle_index + 4096u;
        if (params.mode == 3u || params.mode == 4u) {
            int dx = int(p.x) - int(params.brush_x);
            int dy = int(p.y) - int(params.brush_y);
            int r = int(params.radius);
            if (dx * dx + dy * dy <= r * r) {
                material = params.color == 3u &&
                           (material == 2u || material == 4u || material == 5u)
                           ? material : params.color == 3u ? 0u : params.color;
                bool new_grain = material == 2u || material == 4u || material == 5u;
                if (!new_grain) {
                    if (particles[particle_index].mass_fp != 0u) {
                        particles[particle_index].mass_fp = 0u;
                        atomicAdd(particle_counts[slot], uint(-1));
                    }
                    if (particles[secondary_index].mass_fp != 0u) {
                        particles[secondary_index].mass_fp = 0u;
                        atomicAdd(particle_counts[slot], uint(-1));
                    }
                } else {
                    if (particles[particle_index].mass_fp == 0u &&
                        particles[secondary_index].mass_fp != 0u) {
                        particles[particle_index] = particles[secondary_index];
                        particles[secondary_index].mass_fp = 0u;
                    }
                    if (particles[particle_index].mass_fp == 0u) {
                        Particle particle;
                        particle.x_fp = int((p.x % 64u) * 65536u + 32768u);
                        particle.y_fp = int((p.y % 64u) * 65536u + 32768u);
                        particle.vx_fp = particle.vy_fp = 0;
                        particle.f00 = particle.f11 = 1.0;
                        particle.f01 = particle.f10 = 0.0;
                        particle.id_lo = local_index + 1u;
                        particle.id_hi = seeds[slot];
                        particle.mass_fp = 65536u;
                        particle.grain_fp = grain_radius_fp(material);
                        particle.material = material;
                        particle.flags = 0u;
                        particles[particle_index] = particle;
                        atomicAdd(particle_counts[slot], 1u);
                    } else {
                        particles[particle_index].material = material;
                        particles[particle_index].grain_fp = grain_radius_fp(material);
                    }
                    if (particles[secondary_index].mass_fp != 0u) {
                        particles[secondary_index].material = material;
                        particles[secondary_index].grain_fp = grain_radius_fp(material);
                    }
                }
                cell.x = (cell.x & 0xffff0000u) | material;
                if (params.mode == 4u && params.color == 3u) {
                    uint source_rate = params.radius == 1u ? 16384u : 65536u;
                    cell.y = min(65536u, cell.y + source_rate);
                } else {
                    cell.y = params.color == 3u ? 65536u : new_grain ? cell.y : 0u;
                }
                chunk_cells[index] = cell;
            }
        }
        if (params.mode == 4u) return;
        uint color = cell_material_color(ivec2(p));
        if (params.mode == 3u && occupancy[p.y * params.width + p.x] != 0u)
            color = 0xff30c040u;
        if (params.mode == 2u && params.brush_y == 2u) {
            color = 0xff181818u;
            if (material == 1u) color = 0xff303030u;
            if (material == 2u) color = 0xff40c8e0u;
            if (cell.y > 0u) color = 0xffd08030u;
            if (occupancy[p.y * params.width + p.x] != 0u)
                color = 0xff30c040u;
            if (display_cell.y < 8u && display_cell.x < 8u)
                color = 0xff30c040u;
            else if (display_cell.y < 8u && display_cell.x < 16u)
                color = 0xffd08030u;
            else if (display_cell.y < 8u && display_cell.x < 24u)
                color = 0xff40c8e0u;
        }
        cells[p.y * params.width + p.x] = color;
    }
}
