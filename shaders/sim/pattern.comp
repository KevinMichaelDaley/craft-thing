#version 450
#extension GL_GOOGLE_include_directive : require
#define DC_RUNTIME_ROOT_READONLY 1
#include "../../include/dungeoncraft/terrain_flags.h"
layout(constant_id=1) const bool DRAW_PIXEL_ONLY=false;
layout(constant_id=2) const bool DRAW_SIMPLE=false;
#define DC_RIGID_PIXEL_ONLY DRAW_PIXEL_ONLY
#include "rigid_body.glsl"
#include "rigid_shape.glsl"
#include "rigid_clip.glsl"
layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0, std430) buffer Cells { uint cells[]; };
layout(set = 0, binding = 1, std430) buffer ChunkCells { uvec2 chunk_cells[]; };
layout(set = 0, binding = 2, std430) readonly buffer PageTable { uint pages[]; };
layout(set=0,binding=32,std430) buffer WaterColors {vec4 water_colors[];};
layout(set=0,binding=33,std430) buffer TerrainColors {vec4 terrain_colors[];};
layout(set = 0, binding = 3, std430) readonly buffer Occupancy { uint occupancy[]; };
#ifndef DC_RUNTIME_BODY_STORAGE
layout(set = 0, binding = 4, std430) buffer Bodies { Body bodies[64]; uint body_data[]; };
#endif
layout(set = 0, binding = 16, std430) readonly buffer MarkerGrid { uint marker_grid[]; };
struct Particle {
    int x_fp, y_fp, vx_fp, vy_fp;
    float f00, f01, f10, f11;
    uint id_lo, id_hi, mass_fp, grain_fp;
    uint material, flags;
};
layout(set = 0, binding = 18, std430) readonly buffer SlotSeeds { uint seeds[]; };
layout(set = 0, binding = 19, std430) buffer Particles { Particle particles[]; };
layout(set = 0, binding = 20, std430) buffer ParticleCounts { uint particle_counts[]; };
layout(set = 0, binding = 31, std430) readonly buffer FluidPrevious { uint previous_mass[]; };
#ifndef DC_RUNTIME_BODY_STORAGE
#undef DC_PIXEL_WORD
#define DC_PIXEL_WORD(index) DC_BUFFER_DATA((index)-BODY_STORAGE_WORDS)
#endif
uint pixel_word_at(uint index) {return DC_PIXEL_WORD(index);}
layout(push_constant) uniform Params {
    uint width;
    uint height;
    uint mode;
    uint brush_x;
    uint brush_y;
    uint radius;
    uint color;
} params;

bool rigid_material(uint material) {return material!=0u&&material!=3u;}
void release_edited_support(ivec2 position) {
    for(int y=-1;y<=1;y++) for(int x=-1;x<=1;x++) {
        if(x==0&&y==0) continue;
        ivec2 neighbor=position+ivec2(x,y);
        if(any(lessThan(neighbor,ivec2(0)))||any(greaterThanEqual(neighbor,ivec2(params.width,params.height)))) continue;
        uint page=pages[uint(neighbor.y/64)*((params.width+63u)/64u)+uint(neighbor.x/64)];
        if(page==0u) continue;
        uint index=(page-1u)*4096u+uint(neighbor.y%64)*64u+uint(neighbor.x%64);
        uint packed=chunk_cells[index].x;
        if(rigid_material(packed&65535u)&&(packed&(DC_CELL_LOADED_TERRAIN<<DC_CELL_FLAGS_SHIFT))!=0u)
            atomicOr(chunk_cells[index].x,DC_CELL_RELEASED_TERRAIN<<DC_CELL_FLAGS_SHIFT);
    }
}

uint grain_radius_fp(uint material) {
    return material == 2u ? 16384u : 32768u;
}

uint grain_mass_fp(uint material) {
    float density=material==4u?DC_DENSITY_DIRT:material==5u?DC_DENSITY_STONE:
        material==6u?DC_DENSITY_MORTAR:material==10u?DC_DENSITY_LEAVES:1.;
    return uint(round(65536.*density));
}

vec3 linear_color(uint packed) {
    vec3 rgb = vec3(float(packed & 255u), float((packed >> 8) & 255u),
                    float((packed >> 16) & 255u)) / 255.0;
    return rgb * rgb;
}

uint pack_linear_color(vec3 linear_rgb) {
    uvec3 rgb = uvec3(round(255.0 * sqrt(clamp(linear_rgb, vec3(0.0),
                                               vec3(1.0)))));
    return 0xff000000u | (rgb.b << 16) | (rgb.g << 8) | rgb.r;
}

uint material_color(uint material, uint flags) {
    if (material == 1u) return 0xff707070u;
    if (material == 2u)
        return (flags & 0x00ffffffu) != 0u ? 0xff368e9cu : 0xff40c8e0u;
    if (material == 4u)
        return (flags & 0x80000000u) != 0u ? 0xff29465bu : 0xff326495u;
    if (material == 5u) return 0xff808090u;
    if (material == 9u || material == 10u) return 0xff248228u;
    if (material == 6u) return 0xffa0a8b0u;
    return 0xff707070u;
}

uint packed_color(vec3 color) {
    uvec3 rgb=uvec3(round(clamp(color,vec3(0),vec3(255))));
    return 0xff000000u|(rgb.z<<16)|(rgb.y<<8)|rgb.x;
}

uint structure_base() {
    uint w=(params.width+63u)/64u+2u,h=(params.height+63u)/64u+2u;
    return 8u+2u*w*h+DC_LAYOUT_PAIR_CAPACITY*8u+12u+DC_LAYOUT_CONTACT_CAPACITY*32u+16u+64u*32u+DC_LAYOUT_CONTACT_CAPACITY*16u;
}
vec3 unpacked_color(uint color) {return vec3(color&255u,(color>>8)&255u,(color>>16)&255u);}
uint structure_color(Body body) {
    uint material=body.material;
    uint color=material==2u?0xff287aaau:material==4u?0xff205f85u:material==3u?0xffb0b8c0u:0xff909090u;
    if(body.reserved0!=0x53545231u||body.reserved1==0u||body.reserved1>16u) return color;
    uint base=structure_base();
    uint graph=base+32u+DC_BUFFER_DATA(base+1u)*8u;
    uint state=graph+24000u+(body.reserved1-1u)*16u;
    float utilization=uintBitsToFloat(DC_BUFFER_DATA(state+7u));
    if(DC_BUFFER_DATA(state+3u)==3u||isnan(utilization)||isinf(utilization)) return 0xffd040d0u;
    vec3 green=vec3(48,192,64),yellow=vec3(240,208,32),red=vec3(240,48,32);
    vec3 stress=utilization<.5?mix(green,yellow,clamp(utilization*2.,0.,1.)):
        mix(yellow,red,clamp((utilization-.5)*2.,0.,1.));
    return packed_color(stress);
}
uint structural_pixel(ivec2 cell,uint id,uint background) {
#ifdef DC_RUNTIME_BODY_STORAGE
    uint found=runtime_body_find(id);
    for(uint slot=found;slot<min(found+1u,BODY_CAPACITY);slot++) {
#else
    for(uint slot=0u;slot<BODY_CAPACITY;slot++) {
#endif
        Body body=DC_BODY(slot);if(body.enabled==0u||body.id!=id) continue;
        uint foreground=structure_color(body);
        if(body.reserved0!=0x53545231u&&body.piece_count!=0u) {
            vec2 low=vec2(cell)-vec2(body.x_fp,body.y_fp)/65536.;uvec4 query=body_piece_query(body,low,low+1);
            vec3 weighted=vec3(0);float total=0;
            for(uint ordinal=0u;ordinal<query.z*query.w;ordinal++) {
                uint piece=query_piece(body,query,ordinal);vec2 point;
                float volume=body_cell_volume(body,piece,cell,1,point);if(volume<=0) continue;
                uint material=piece_material(body,piece);
                uint color=material==2u?0xff287aaau:material==4u?0xff205f85u:material==3u?0xffb0b8c0u:0xff909090u;
                weighted+=volume*unpacked_color(color);total+=volume;
            }
            if(total>0) foreground=packed_color(weighted/total);
        }
        uint index=uint(cell.y)*params.width+uint(cell.x);
        float coverage=min(float(occupancy[2u*params.width*params.height+index])/65536.,1.);
        return packed_color(mix(unpacked_color(background),unpacked_color(foreground),coverage));
    }
    return background;
}

struct DensitySample {
    vec3 premultiplied;
    float coverage;
};
DensitySample material_density(ivec2 p) {
    DensitySample density_sample = DensitySample(vec3(0.0), 0.0);
    if (p.x < 0 || p.y < 0 || p.x >= int(params.width) ||
        p.y >= int(params.height)) return density_sample;
    uint page_width = (params.width + 63u) / 64u;
    uint page = pages[(uint(p.y) / 64u) * page_width + uint(p.x) / 64u];
    if (page == 0u) return density_sample;
    uint index = (page - 1u) * 4096u + (uint(p.y) % 64u) * 64u + uint(p.x) % 64u;
    uvec2 cell = chunk_cells[index];
    uint material = cell.x & 0xffffu;
    float solid = 0.0;
    vec3 solid_color = vec3(0.0);
    if (material == 2u || material == 4u || material == 5u || material == 6u || material == 10u) {
        uint first = (page - 1u) * 8192u + index % 4096u;
        float particle_mass = 0.0;
        for (uint layer = 0u; layer < 2u; ++layer) {
            Particle particle = particles[first + layer * 4096u];
            if (particle.mass_fp == 0u) continue;
            float mass = float(particle.mass_fp) / 65536.0;
            solid_color += mass * linear_color(material_color(particle.material,
                                                               particle.flags));
            particle_mass += mass;
        }
        if (particle_mass > 0.0) {
            solid = min(particle_mass, 1.0);
            solid_color /= particle_mass;
        } else {
            solid = 1.0;
            solid_color = linear_color(material_color(material, 0u));
        }
    } else if (material != 0u && material != 3u) {
        solid = 1.0;
        solid_color = linear_color(material_color(material, 0u));
    }
    float water = min(float(cell.y) / 65536.0, 1.0);
    if (params.mode == 2u && (params.brush_x >> 8) < 65535u) {
        float old_water = min(float(previous_mass[uint(p.y) * params.width +
                                                 uint(p.x)]) / 65536.0, 1.0);
        water = mix(old_water, water, float(params.brush_x >> 8) / 65535.0);
    }
    density_sample.coverage = water + solid * (1.0 - water);
    density_sample.premultiplied = water * linear_color(0xffd07030u) +
                           (1.0 - water) * solid * solid_color;
    if (params.brush_y != 4u && occupancy[uint(p.y) * params.width + uint(p.x)] != 0u) {
        density_sample.coverage = 1.0;
        density_sample.premultiplied = linear_color(0xff30c040u);
    }
    return density_sample;
}

uint cell_material_color(ivec2 p) {
    DensitySample density_sample = material_density(p);
    return pack_linear_color(density_sample.premultiplied +
                             (1.0 - density_sample.coverage) * linear_color(0xff181818u));
}

void main() {
    uvec2 display_cell = gl_GlobalInvocationID.xy;
    uvec2 p = display_cell;
    if (params.mode == 2u) p += uvec2(params.radius, params.color);
    if (params.mode == 4u) {
        ivec2 source = ivec2(display_cell) +
                       ivec2(params.brush_x, params.brush_y) - ivec2(8);
        if (source.x < 0 || source.y < 0) return;
        p = uvec2(source);
    }
    if (p.x >= params.width || p.y >= params.height) return;
    if (params.mode == 0u) {
        cells[p.y * params.width + p.x] = ((p.x + p.y) & 1u) == 0u
            ? 0xff202020u : 0xff4040c0u;
    } else if (params.mode == 1u) {
        int dx = int(p.x) - int(params.brush_x);
        int dy = int(p.y) - int(params.brush_y);
        int r = int(params.radius);
        if (dx * dx + dy * dy <= r * r)
            cells[p.y * params.width + p.x] = params.color;
    } else {
        uint page_width = (params.width + 63u) / 64u;
        uint page = pages[(p.y / 64u) * page_width + p.x / 64u];
        if (page == 0u) {
            cells[p.y * params.width + p.x] = 0xffff00ffu;
            return;
        }
        uint index = (page - 1u) * 4096u + (p.y % 64u) * 64u + p.x % 64u;
        if (params.mode == 2u && params.brush_y != 2u) {
            uint filtered = cell_material_color(ivec2(p));
            uint body_id=occupancy[p.y*params.width+p.x];
            if(!DRAW_SIMPLE && params.brush_y==4u && body_id!=0u)
                filtered=structural_pixel(ivec2(p),body_id,filtered);
            if(params.brush_y==3u && body_id!=0u)
                filtered=(body_id&1u)!=0u ? 0xff30c040u : 0xffe09040u;
            if ((params.brush_x & 1u) != 0u) {
                uint guide = marker_grid[index];
                if ((guide & 1u) != 0u) filtered = 0xffd040e0u;
                else if ((guide & 2u) != 0u) filtered = 0xff40e0d0u;
            }
            if (params.brush_y == 1u &&
                ((p.x % 64u) == 0u || (p.y % 64u) == 0u))
                filtered = 0xff30d030u;
            cells[p.y * params.width + p.x] = filtered;
            return;
        }
        uvec2 cell = chunk_cells[index];
        uint material = cell.x & 0xffffu;
        uint slot = page - 1u;
        uint local_index = index % 4096u;
        uint particle_index = slot * 8192u + local_index;
        uint secondary_index = particle_index + 4096u;
        bool mud = false;
        bool wet_sand = false;
        if (params.mode == 3u || params.mode == 4u) {
            int dx = int(p.x) - int(params.brush_x);
            int dy = int(p.y) - int(params.brush_y);
            int r = int(params.radius);
            if (dx * dx + dy * dy <= r * r) {
                uint old_cell_word=cell.x;
                uint old_water_mass=cell.y;
                material = params.color == 3u &&
                           (material == 2u || material == 4u || material == 5u || material == 6u || material == 10u)
                           ? material : params.color == 3u ? 0u : params.color;
                bool new_grain = material == 2u || material == 4u || material == 5u || material == 6u || material == 10u;
                if (!new_grain) {
                    if (particles[particle_index].mass_fp != 0u) {
                        particles[particle_index].mass_fp = 0u;
                        atomicAdd(particle_counts[slot], uint(-1));
                    }
                    if (particles[secondary_index].mass_fp != 0u) {
                        particles[secondary_index].mass_fp = 0u;
                        atomicAdd(particle_counts[slot], uint(-1));
                    }
                } else {
                    if (particles[particle_index].mass_fp == 0u &&
                        particles[secondary_index].mass_fp != 0u) {
                        particles[particle_index] = particles[secondary_index];
                        particles[secondary_index].mass_fp = 0u;
                    }
                    if (particles[particle_index].mass_fp == 0u) {
                        Particle particle;
                        particle.x_fp = int((p.x % 64u) * 65536u + 32768u);
                        particle.y_fp = int((p.y % 64u) * 65536u + 32768u);
                        particle.vx_fp = particle.vy_fp = 0;
                        particle.f00 = particle.f11 = 1.0;
                        particle.f01 = particle.f10 = 0.0;
                        particle.id_lo = local_index + 1u;
                        particle.id_hi = seeds[slot];
                        particle.mass_fp = grain_mass_fp(material);
                        particle.grain_fp = grain_radius_fp(material);
                        particle.material = material;
                        particle.flags = 0u;
                        particles[particle_index] = particle;
                        atomicAdd(particle_counts[slot], 1u);
                    } else {
                        bool full_stamp=params.color!=3u&&(particles[particle_index].material!=material||material==4u||material==5u);
                        if(full_stamp) {
                            particles[particle_index].mass_fp=grain_mass_fp(material);
                            particles[particle_index].f00=particles[particle_index].f11=1.;
                            particles[particle_index].f01=particles[particle_index].f10=0.;
                            if(particles[secondary_index].mass_fp!=0u) {
                                particles[secondary_index].mass_fp=0u;
                                atomicAdd(particle_counts[slot],uint(-1));
                            }
                        }
                        particles[particle_index].material = material;
                        particles[particle_index].grain_fp = grain_radius_fp(material);
                    }
                    if (particles[secondary_index].mass_fp != 0u) {
                        particles[secondary_index].material = material;
                        particles[secondary_index].grain_fp = grain_radius_fp(material);
                    }
                }
                if((cell.x&65535u)!=material) terrain_colors[index]=vec4(0);
                if(DC_CELL_COMPONENT_MEMBER(cell.x)&&!DC_CELL_COMPONENT_MEMBER(material))
                    release_edited_support(ivec2(p));
                cell.x = ((cell.x & 0xffffu)==material ? cell.x & 0xffff0000u : 0u) | material;
                if(old_cell_word!=cell.x&&(DC_CELL_COMPONENT_MEMBER(old_cell_word)||DC_CELL_COMPONENT_MEMBER(cell.x))) {
                    atomicOr(DC_BUFFER_DATA(structure_base()+STRUCTURAL_BRUSH_RESULT_WORD),2u);
                    atomicOr(DC_BUFFER_DATA(structure_base()+STRUCTURAL_COMPONENT_DIRTY_WORD),1u);
                }
                cell.y = params.color == 3u ? 65536u : new_grain ? cell.y : 0u;
                chunk_cells[index] = cell;
                if(params.color==3u) {
                    uint old_mass=min(old_water_mass,65536u);
                    if(water_colors[index].w>0. && old_mass<65536u)
                        water_colors[index]=vec4((water_colors[index].rgb*float(old_mass)+
                            vec3(.035,.193,.666)*float(65536u-old_mass))/65536.,1.);
                } else if(cell.y==0u) water_colors[index]=vec4(0);
            }
        }
        if (params.mode == 4u) return;
        if (params.mode == 2u) {
            if (particles[particle_index].mass_fp != 0u) {
                material = particles[particle_index].material;
                mud = (particles[particle_index].flags & 0x80000000u) != 0u;
                wet_sand = (particles[particle_index].flags & 0x00ffffffu) != 0u;
            } else if (particles[secondary_index].mass_fp != 0u) {
                material = particles[secondary_index].material;
                mud = (particles[secondary_index].flags & 0x80000000u) != 0u;
                wet_sand = (particles[secondary_index].flags & 0x00ffffffu) != 0u;
            }
        }
        uint color = 0xff181818u;
        if (material == 1u) color = 0xff707070u;
        else if (material == 2u) color = wet_sand ? 0xff368e9cu : 0xff40c8e0u;
        else if (material == 4u) color = mud ? 0xff29465bu : 0xff326495u;
        else if (material == 5u) color = 0xff808090u;
        else if (material == 9u || material == 10u) color = 0xff248228u;
        else if (material == 6u) color = 0xffa0a8b0u;
        if (cell.y > 0u) {
            uint fill = min(cell.y, 65536u) / 256u;
            uint red = 16u + 32u * fill / 256u;
            uint green = 32u + 80u * fill / 256u;
            uint blue = 64u + 144u * fill / 256u;
            color = 0xff000000u | (blue << 16) | (green << 8) | red;
        }
        if (params.mode == 3u && occupancy[p.y * params.width + p.x] != 0u)
            color = 0xff30c040u;
        if (params.mode == 2u && params.brush_y == 2u) {
            color = 0xff181818u;
            if (material == 1u) color = 0xff303030u;
            if (material == 2u) color = 0xff40c8e0u;
            if (cell.y > 0u) color = 0xffd08030u;
            if (occupancy[p.y * params.width + p.x] != 0u)
                color = 0xff30c040u;
            if (display_cell.y < 8u && display_cell.x < 8u)
                color = 0xff30c040u;
            else if (display_cell.y < 8u && display_cell.x < 16u)
                color = 0xffd08030u;
            else if (display_cell.y < 8u && display_cell.x < 24u)
                color = 0xff40c8e0u;
        }
        cells[p.y * params.width + p.x] = color;
    }
}
