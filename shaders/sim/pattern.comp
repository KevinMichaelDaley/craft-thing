#version 450
layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0, std430) buffer Cells { uint cells[]; };
layout(push_constant) uniform Params {
    uint width;
    uint height;
    uint mode;
    uint brush_x;
    uint brush_y;
    uint radius;
    uint color;
} params;

void main() {
    uvec2 p = gl_GlobalInvocationID.xy;
    if (p.x >= params.width || p.y >= params.height) return;
    if (params.mode == 0u) {
        cells[p.y * params.width + p.x] = ((p.x + p.y) & 1u) == 0u
            ? 0xff202020u : 0xff4040c0u;
    } else {
        int dx = int(p.x) - int(params.brush_x);
        int dy = int(p.y) - int(params.brush_y);
        int r = int(params.radius);
        if (dx * dx + dy * dy <= r * r)
            cells[p.y * params.width + p.x] = params.color;
    }
}
