#version 450
layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0, std430) buffer Cells { uint cells[]; };
layout(set = 0, binding = 1, std430) buffer ChunkCells { uvec2 chunk_cells[]; };
layout(set = 0, binding = 2, std430) readonly buffer PageTable { uint pages[]; };
layout(set = 0, binding = 3, std430) readonly buffer Occupancy { uint occupancy[]; };
layout(set = 0, binding = 16, std430) readonly buffer MarkerGrid { uint marker_grid[]; };
struct Particle {
    int x_fp, y_fp, vx_fp, vy_fp;
    float f00, f01, f10, f11;
    uint id_lo, id_hi, mass_fp, grain_fp;
    uint material, flags;
};
layout(set = 0, binding = 18, std430) readonly buffer SlotSeeds { uint seeds[]; };
layout(set = 0, binding = 19, std430) buffer Particles { Particle particles[]; };
layout(set = 0, binding = 20, std430) buffer ParticleCounts { uint particle_counts[]; };
layout(push_constant) uniform Params {
    uint width;
    uint height;
    uint mode;
    uint brush_x;
    uint brush_y;
    uint radius;
    uint color;
} params;

void main() {
    uvec2 display_cell = gl_GlobalInvocationID.xy;
    uvec2 p = display_cell;
    if (params.mode == 2u) p += uvec2(params.radius, params.color);
    if (p.x >= params.width || p.y >= params.height) return;
    if (params.mode == 0u) {
        cells[p.y * params.width + p.x] = ((p.x + p.y) & 1u) == 0u
            ? 0xff202020u : 0xff4040c0u;
    } else if (params.mode == 1u) {
        int dx = int(p.x) - int(params.brush_x);
        int dy = int(p.y) - int(params.brush_y);
        int r = int(params.radius);
        if (dx * dx + dy * dy <= r * r)
            cells[p.y * params.width + p.x] = params.color;
    } else {
        uint page_width = (params.width + 63u) / 64u;
        uint page = pages[(p.y / 64u) * page_width + p.x / 64u];
        if (page == 0u) {
            cells[p.y * params.width + p.x] = 0xffff00ffu;
            return;
        }
        uint index = (page - 1u) * 4096u + (p.y % 64u) * 64u + p.x % 64u;
        uvec2 cell = chunk_cells[index];
        uint material = cell.x & 0xffffu;
        uint slot = page - 1u;
        uint local_index = index % 4096u;
        uint particle_index = slot * 8192u + local_index;
        uint secondary_index = particle_index + 4096u;
        bool mud = false;
        if (params.mode == 3u) {
            int dx = int(p.x) - int(params.brush_x);
            int dy = int(p.y) - int(params.brush_y);
            int r = int(params.radius);
            if (dx * dx + dy * dy <= r * r) {
                material = params.color == 3u &&
                           (material == 2u || material == 4u || material == 5u)
                           ? material : params.color == 3u ? 0u : params.color;
                bool new_grain = material == 2u || material == 4u || material == 5u;
                if (!new_grain) {
                    if (particles[particle_index].mass_fp != 0u) {
                        particles[particle_index].mass_fp = 0u;
                        atomicAdd(particle_counts[slot], uint(-1));
                    }
                    if (particles[secondary_index].mass_fp != 0u) {
                        particles[secondary_index].mass_fp = 0u;
                        atomicAdd(particle_counts[slot], uint(-1));
                    }
                } else {
                    if (particles[particle_index].mass_fp == 0u &&
                        particles[secondary_index].mass_fp != 0u) {
                        particles[particle_index] = particles[secondary_index];
                        particles[secondary_index].mass_fp = 0u;
                    }
                    if (particles[particle_index].mass_fp == 0u) {
                        Particle particle;
                        particle.x_fp = int((p.x % 64u) * 65536u + 32768u);
                        particle.y_fp = int((p.y % 64u) * 65536u + 32768u);
                        particle.vx_fp = particle.vy_fp = 0;
                        particle.f00 = particle.f11 = 1.0;
                        particle.f01 = particle.f10 = 0.0;
                        particle.id_lo = local_index + 1u;
                        particle.id_hi = seeds[slot];
                        particle.mass_fp = 65536u;
                        particle.grain_fp = 32768u;
                        particle.material = material;
                        particle.flags = 0u;
                        particles[particle_index] = particle;
                        atomicAdd(particle_counts[slot], 1u);
                    } else particles[particle_index].material = material;
                    if (particles[secondary_index].mass_fp != 0u)
                        particles[secondary_index].material = material;
                }
                cell.x = (cell.x & 0xffff0000u) | material;
                cell.y = params.color == 3u ? 65536u : new_grain ? cell.y : 0u;
                chunk_cells[index] = cell;
            }
        }
        if (params.mode == 2u) {
            if (particles[particle_index].mass_fp != 0u) {
                material = particles[particle_index].material;
                mud = (particles[particle_index].flags & 0x80000000u) != 0u;
            } else if (particles[secondary_index].mass_fp != 0u) {
                material = particles[secondary_index].material;
                mud = (particles[secondary_index].flags & 0x80000000u) != 0u;
            }
        }
        uint color = 0xff181818u;
        if (material == 1u) color = 0xff707070u;
        else if (material == 2u) color = 0xff40c8e0u;
        else if (material == 4u) color = mud ? 0xff29465bu : 0xff326495u;
        else if (material == 5u) color = 0xff808090u;
        if (cell.y > 0u) {
            uint fill = min(cell.y, 65536u) / 256u;
            uint red = 16u + 32u * fill / 256u;
            uint green = 32u + 80u * fill / 256u;
            uint blue = 64u + 144u * fill / 256u;
            color = 0xff000000u | (blue << 16) | (green << 8) | red;
        }
        if (occupancy[p.y * params.width + p.x] != 0u) color = 0xff30c040u;
        if (params.mode == 2u && params.brush_x != 0u) {
            uint guide = marker_grid[index];
            if ((guide & 1u) != 0u) color = 0xffd040e0u;
            else if ((guide & 2u) != 0u) color = 0xff40e0d0u;
        }
        if (params.mode == 2u && params.brush_y == 1u &&
            ((p.x % 64u) == 0u || (p.y % 64u) == 0u))
            color = 0xff30d030u;
        if (params.mode == 2u && params.brush_y == 2u) {
            color = 0xff181818u;
            if (material == 1u) color = 0xff303030u;
            if (material == 2u) color = 0xff40c8e0u;
            if (cell.y > 0u) color = 0xffd08030u;
            if (occupancy[p.y * params.width + p.x] != 0u)
                color = 0xff30c040u;
            if (display_cell.y < 8u && display_cell.x < 8u)
                color = 0xff30c040u;
            else if (display_cell.y < 8u && display_cell.x < 16u)
                color = 0xffd08030u;
            else if (display_cell.y < 8u && display_cell.x < 24u)
                color = 0xff40c8e0u;
        }
        cells[p.y * params.width + p.x] = color;
    }
}
