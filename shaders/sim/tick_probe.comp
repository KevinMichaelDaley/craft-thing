#version 450
#extension GL_GOOGLE_include_directive : require
#include "rigid_body.glsl"
layout(local_size_x = 1, local_size_y = 1) in;

layout(set = 0, binding = 3, std430) readonly buffer Occupancy { uint occupancy[]; };
layout(set = 0, binding = 5, std430) buffer Trace { uint trace_values[]; };

#ifndef DC_RUNTIME_BODY_STORAGE
layout(set = 0, binding = 4, std430) readonly buffer Bodies { Body bodies[BODY_CAPACITY]; uint data[]; };
#endif
uint pixel_word_at(uint index) {return DC_PIXEL_WORD(index);}
layout(push_constant) uniform Params {
    uint width;
    uint height;
    uint mode;
    uint body_count;
    uint unused1;
    uint unused2;
    uint unused3;
} params;

void main() {
    if (params.mode == 0u) {
        uint seen = 0u;
        for (uint i = 0u; i < params.body_count; ++i) {
            Body body = DC_BODY(i);
            if (body.enabled == 0u || body.visible == 0u) continue;
            int x = body.x_fp >> 16;
            int y = body.y_fp >> 16;
            if (x >= 0 && y >= 0 && x < int(params.width) && y < int(params.height))
                seen = occupancy[uint(y) * params.width + uint(x)];
            break;
        }
        trace_values[0] = seen;
        trace_values[1] = seen + 1u;
    } else {
        trace_values[2] = trace_values[1] + 1u;
    }
}
