#version 450
layout(local_size_x = 1, local_size_y = 1) in;

layout(set = 0, binding = 3, std430) readonly buffer Occupancy { uint occupancy[]; };
layout(set = 0, binding = 5, std430) buffer Trace { uint trace_values[]; };

struct Body {
    int x_fp;
    int y_fp;
    int vx_fp;
    int vy_fp;
    uint width;
    uint height;
    uint id;
    uint enabled;
    int previous_x_fp;
    int previous_y_fp;
    uint reserved0;
    uint reserved1;
    uvec2 chunk_x;
    uvec2 chunk_y;
    ivec2 local_fp;
    uint visible;
    uint reserved_world;
};
layout(set = 0, binding = 4, std430) readonly buffer Bodies { Body bodies[]; };
layout(push_constant) uniform Params {
    uint width;
    uint height;
    uint mode;
    uint body_count;
    uint unused1;
    uint unused2;
    uint unused3;
} params;

void main() {
    if (params.mode == 0u) {
        uint seen = 0u;
        for (uint i = 0u; i < params.body_count; ++i) {
            Body body = bodies[i];
            if (body.enabled == 0u || body.visible == 0u) continue;
            int x = body.x_fp >> 16;
            int y = body.y_fp >> 16;
            if (x >= 0 && y >= 0 && x < int(params.width) && y < int(params.height))
                seen = occupancy[uint(y) * params.width + uint(x)];
            break;
        }
        trace_values[0] = seen;
        trace_values[1] = seen + 1u;
    } else {
        trace_values[2] = trace_values[1] + 1u;
    }
}
