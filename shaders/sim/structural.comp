#version 450
#extension GL_GOOGLE_include_directive : require
#include "rigid_body.glsl"
#include "rigid_shape.glsl"
#ifndef DC_STRUCTURAL_LANES
#define DC_STRUCTURAL_LANES 32
#endif
layout(local_size_x=DC_STRUCTURAL_LANES) in;
layout(constant_id=0) const uint STRUCTURAL_PHASE=0u;
layout(set=0,binding=1,std430) buffer Cells { uvec2 cells[]; };
layout(set=0,binding=2,std430) readonly buffer Pages { uint pages[]; };
#ifndef DC_RUNTIME_BODY_STORAGE
layout(set=0,binding=4,std430) buffer Storage { Body bodies[BODY_CAPACITY]; uint data[]; };
#endif
layout(set=0,binding=28,std430) buffer FractureLabels {uint fracture_labels[];};
layout(set=0,binding=29,std430) buffer FractureQueue {uint fracture_queue[];};
uint pixel_word_at(uint index) {return DC_PIXEL_WORD(index);}
layout(push_constant) uniform Params { uint width,height,mode,body_count; uvec2 origin_x,origin_y; } params;
const uint GRAPH_WORDS=2320u,NODES=16u,MEMBERS=400u,JOINTS=528u,ANCHORS=1552u;
#include "structural_load.glsl"
shared uint label[32],next_label[32],cold[32],roots[32];
uint base() {
    uint w=(params.width+63u)/64u+2u,h=(params.height+63u)/64u+2u;
    return 8u+2u*w*h+DC_LAYOUT_PAIR_CAPACITY*8u+12u+DC_LAYOUT_CONTACT_CAPACITY*32u+16u+64u*32u+DC_LAYOUT_CONTACT_CAPACITY*16u;
}
uint graph() { uint s=base();return s+32u+DC_DATA(s+1u)*8u; }
#include "shape_colors.glsl"
uint state(uint i) { return graph()+2u*GRAPH_WORDS+i*12u; }
uvec2 pair(uint p) { return uvec2(DC_DATA(p),DC_DATA(p+1u)); }
int node_index(uint g,uint id) {
    for(uint i=0u;i<DC_DATA(g);i++) if(DC_DATA(g+NODES+i*12u)==id) return int(i);
    return -1;
}
bool view_point(uvec2 cx,uvec2 cy,ivec2 local,out ivec2 p) {
    int x,y;
    if(!relative_chunk(cx,params.origin_x,x)||!relative_chunk(cy,params.origin_y,y)) return false;
    if(abs(x)>32767 || abs(y)>32767) return false;
    p=ivec2(x,y)*64+local;return true;
}
bool cell_ref(ivec2 p,out uint index) {
    if(any(lessThan(p,ivec2(0))) || any(greaterThanEqual(p,ivec2(params.width,params.height)))) return false;
    uint page=pages[uint(p.y/64)*((params.width+63u)/64u)+uint(p.x/64)];
    if(page==0u || page>DC_DATA(base()+1u)) return false;
    uint slot=base()+32u+(page-1u)*8u;uvec2 x,y;
    if(!shifted_chunk(params.origin_x,p.x/64,x)||!shifted_chunk(params.origin_y,p.y/64,y)) return false;
    if(DC_DATA(slot+5u)==0u || any(notEqual(pair(slot),x)) || any(notEqual(pair(slot+2u),y))) return false;
    index=(page-1u)*4096u+uint(p.y%64)*64u+uint(p.x%64);return true;
}
bool place_pose(inout Body b) {
    int x,y;
    if(!relative_chunk(b.chunk_x,params.origin_x,x)||!relative_chunk(b.chunk_y,params.origin_y,y) || abs(x)>1000 || abs(y)>1000) return false;
    b.x_fp=x*(64<<16)+b.local_fp.x;b.y_fp=y*(64<<16)+b.local_fp.y;
    body_properties(b);return true;
}
bool separated(Body a,Body b) {
    vec2 pa=vec2(a.x_fp,a.y_fp)/65536.0,pb=vec2(b.x_fp,b.y_fp)/65536.0;
    for(uint p=0u;p<body_pieces(a);p++) for(uint q=0u;q<body_pieces(b);q++) {
        if(piece_vertices(a,p)==0u || piece_vertices(b,q)==0u) continue;
        bool apart=false;
        for(uint side=0u;side<2u;side++) {
            Body c=side==0u?a:b;uint piece=side==0u?p:q;
            for(uint i=0u;i<piece_vertices(c,piece);i++) {
                vec2 edge=piece_vertex(c,piece,(i+1u)%piece_vertices(c,piece))-piece_vertex(c,piece,i);
                vec2 n=vec2(-edge.y,edge.x);float amin=1e30,amax=-1e30,bmin=1e30,bmax=-1e30;
                for(uint v=0u;v<piece_vertices(a,p);v++) {float t=dot(n,pa+piece_vertex(a,p,v));amin=min(amin,t);amax=max(amax,t);}
                for(uint v=0u;v<piece_vertices(b,q);v++) {float t=dot(n,pb+piece_vertex(b,q,v));bmin=min(bmin,t);bmax=max(bmax,t);}
                if(amax<=bmin+0.00001 || bmax<=amin+0.00001) apart=true;
            }
        }
        if(!apart) return false;
    }
    return true;
}
#include "structural_identity.glsl"
void transaction() {
    uint s=base(),st=graph()+GRAPH_WORDS;DC_DATA(s+2u)=0u;
    for(uint i=0u;i<DC_DATA(st+1u);i++) {
        uint m=st+MEMBERS+i*8u,slot=DC_DATA(m+7u);Body b=DC_BODY(slot);
        if(!place_pose(b)) return;
        vec2 lo,hi;body_bounds(b,lo,hi);vec2 pos=vec2(b.x_fp,b.y_fp)/65536.0;
        ivec2 low=ivec2(floor(pos+lo)),high=ivec2(ceil(pos+hi));
        for(int y=low.y;y<high.y;y++) for(int x=low.x;x<high.x;x++) if(convex_cell_overlap(b,ivec2(x,y))) {
            uint c;if(!cell_ref(ivec2(x,y),c)) return;
            uint expected=(DC_DATA(m+6u)&1u)!=0u?1u:0u;
            if((cells[c].x&65535u)!=expected || cells[c].y!=0u) return;
        }
        for(uint j=0u;j<params.body_count;j++) {
            if(j==slot || (DC_BODY(j).enabled==0u && DC_BODY(j).reserved0!=0x53545231u)) continue;
            Body other=DC_BODY(j);if(!place_pose(other)) continue;
            if(!separated(b,other)) return;
        }
    }
    identity_stage(st);
    /* Every source cell and every output slot is validated before ownership transfer. */
    for(uint i=0u;i<DC_DATA(st+1u);i++) {
        uint m=st+MEMBERS+i*8u,slot=DC_DATA(m+7u);Body b=DC_BODY(slot);place_pose(b);
        if((DC_DATA(m+6u)&1u)!=0u) {
            ivec2 low=ivec2(b.x_fp,b.y_fp)>>16;
            for(uint y=0u;y<b.height;y++) for(uint x=0u;x<b.width;x++) {
                uint c;cell_ref(low+ivec2(x,y),c);cells[c].x=0u;
            }
        }
        b.enabled=1u;DC_BODY(slot)=b;DC_DATA(m+6u)=0u;
    }
    for(uint i=0u;i<GRAPH_WORDS;i++) DC_DATA(graph()+i)=DC_DATA(st+i);
    identity_commit();
    DC_DATA(s)=uint(DC_DATA(st+1u)!=0u);DC_DATA(s+2u)=1u;DC_DATA(s+3u)++;
}
bool member_footprint_resident(uint member) {
    uint m=graph()+MEMBERS+member*8u,slot=DC_DATA(m+7u);
    if(slot>=BODY_CAPACITY) return false;
    Body b=DC_BODY(slot);if(!place_pose(b)) return false;
    vec2 lo,hi;body_bounds(b,lo,hi);vec2 origin=vec2(b.x_fp,b.y_fp)/65536.0;
    ivec2 begin=ivec2(floor(origin+lo)),end=ivec2(ceil(origin+hi));
    for(int y=begin.y;y<end.y;y++) for(int x=begin.x;x<end.x;x++) {
        uint cell;
        if(convex_cell_overlap(b,ivec2(x,y))&&!cell_ref(ivec2(x,y),cell)) return false;
    }
    return true;
}
void topology() {
    uint g=graph(),i=gl_LocalInvocationID.x,ns=g+NODES+i*12u,unused;
    bool dirty=DC_DATA(base()+4u)!=DC_DATA(base()+3u);
    bool live=i<DC_DATA(g)&&DC_DATA(ns+8u)==0u;
    label[i]=live?(dirty?DC_DATA(ns):DC_DATA(state(i)+1u)):0xffffffffu;cold[i]=0u;roots[i]=0u;
    if(!live&&i<DC_DATA(g)) {
        uint st=state(i);DC_DATA(st)=DC_DATA(ns);DC_DATA(st+1u)=0xffffffffu;
        DC_DATA(st+2u)=5u;DC_DATA(st+5u)=DC_DATA(ns+1u);
        DC_DATA(st+3u)=0u;DC_DATA(st+4u)=0u;
        for(uint word=6u;word<12u;word++) DC_DATA(st+word)=0u;
    }
    if(live) {
        ivec2 p;bool resident=view_point(pair(ns+2u),pair(ns+4u),ivec2(int(DC_DATA(ns+6u))>>16,int(DC_DATA(ns+7u))>>16),p)&&cell_ref(p,unused);
        cold[i]=resident?0u:1u;
        for(uint a=0u;a<DC_DATA(g+3u);a++) {
            uint an=g+ANCHORS+a*24u;if(DC_DATA(an+2u)!=DC_DATA(ns)) continue;
            if(DC_DATA(an+22u)!=0u) continue;
            bool unknown=false,valid=true;
            for(uint y=0u;y<DC_DATA(an+11u);y++) for(uint x=0u;x<DC_DATA(an+10u);x++) {
                ivec2 ap;uint c;
                if(!view_point(pair(an+4u),pair(an+6u),ivec2(DC_DATA(an+8u)+x,DC_DATA(an+9u)+y),ap)||!cell_ref(ap,c)) unknown=true;
                else if((cells[c].x&65535u)!=DC_DATA(an+12u)) valid=false;
            }
            cold[i]+=uint(unknown);roots[i]+=uint(valid&&!unknown);
        }
    }
    barrier();
    if(i<DC_DATA(g+1u)&&(DC_DATA(g+MEMBERS+i*8u+6u)&2u)==0u&&!member_footprint_resident(i)) {
        uint m=g+MEMBERS+i*8u;
        atomicOr(cold[uint(node_index(g,DC_DATA(m+2u)))],1u);
        atomicOr(cold[uint(node_index(g,DC_DATA(m+3u)))],1u);
    }
    barrier();
    for(uint iteration=0u;dirty && iteration<32u;iteration++) {
        uint best=label[i];
        if(i<DC_DATA(g)) {
            for(uint e=0u;e<DC_DATA(g+1u)+DC_DATA(g+2u);e++) {
                uint r=e<DC_DATA(g+1u)?g+MEMBERS+e*8u:g+JOINTS+(e-DC_DATA(g+1u))*16u;
                if(e<DC_DATA(g+1u)&&(DC_DATA(r+6u)&2u)!=0u) continue;
                if(e>=DC_DATA(g+1u)&&DC_DATA(r+14u)!=0u) continue;
                int a=node_index(g,DC_DATA(r+2u)),b=node_index(g,DC_DATA(r+3u));
                if(a==int(i) && b>=0) best=min(best,label[b]);if(b==int(i)&&a>=0) best=min(best,label[a]);
            }
        }
        next_label[i]=best;barrier();label[i]=next_label[i];barrier();
    }
    if(i==0u) DC_DATA(base()+4u)=DC_DATA(base()+3u);
    DC_DATA(g+28200u+i)=0u;
    for(uint j=i;j<64u;j+=32u) DC_DATA(g+28232u+j)=0u;
    if(live) {
        uint all_cold=0u,all_roots=0u;
        for(uint n=0u;n<DC_DATA(g);n++) if(label[n]==label[i]) {all_cold+=cold[n];all_roots+=roots[n];}
        uint st=state(i);DC_DATA(st)=DC_DATA(ns);DC_DATA(st+1u)=label[i];
        /* Connectivity alone does not establish mechanical equilibrium. */
        DC_DATA(st+2u)=all_cold!=0u||all_roots!=0u?3u:2u;
        DC_DATA(st+3u)=all_roots;DC_DATA(st+4u)=all_cold;DC_DATA(st+5u)=DC_DATA(ns+1u);
        for(uint v=6u;v<12u;v++) DC_DATA(st+v)=0u;
        if(DC_DATA(ns)==label[i]) {
            uint cs=g+24400u+i*16u;
            for(uint word=0u;word<16u;word++) DC_DATA(cs+word)=0u;
            DC_DATA(cs)=DC_DATA(ns);DC_DATA(cs+1u)=DC_DATA(st+2u);
            for(uint n=0u;n<DC_DATA(g);n++) DC_DATA(cs+2u)+=uint(label[n]==label[i]);
            DC_DATA(cs+3u)=all_cold!=0u?1u:all_roots==0u?16u:0u;
        }
    }
    if(i<DC_DATA(g+1u)&&(DC_DATA(g+MEMBERS+i*8u+6u)&2u)==0u) {
        uint m=g+MEMBERS+i*8u,st=g+24000u+i*16u;
        int a=node_index(g,DC_DATA(m+2u));uint component=label[a],all_cold=0u,all_roots=0u;
        for(uint n=0u;n<DC_DATA(g);n++) if(label[n]==component) {all_cold+=cold[n];all_roots+=roots[n];}
        DC_DATA(st)=DC_DATA(m);DC_DATA(st+1u)=DC_DATA(m+1u);DC_DATA(st+2u)=component;
        DC_DATA(st+3u)=all_cold!=0u||all_roots!=0u?3u:2u;
    }
}
#include "structural_equilibrium.glsl"
#include "structural_failure.glsl"
#include "leaf_debris.glsl"
#include "structural_impact.glsl"
#ifdef DC_CARVE_MODULE
#include "body_carve.glsl"
void main() {carve_bodies();}
#else
void main() {
    if(STRUCTURAL_PHASE==0u) {if(gl_LocalInvocationID.x==0u) transaction();return;}
    if(STRUCTURAL_PHASE==2u) {
        uint lane=gl_LocalInvocationID.x;
        if(lane==0u) {DC_DATA(base()+16u)=0u;DC_DATA(base()+17u)=(params.height+15u)/16u;DC_DATA(base()+18u)=1u;}
        for(uint p=lane;p<96u;p+=32u) DC_DATA(structural_loads()+p)=0u;
        DC_DATA(structural_bad()+lane)=0u;
        for(uint p=lane;p<BODY_CAPACITY;p+=32u) {
            DC_BODY_DEPENDENCIES(p)=0u;DC_BODY_CLIPPED(p)=0u;
            uint impact=body_impact_pending(p);
            if(DC_SOLVER_DATA(impact+3u)!=DC_BODY(p).id) {
                DC_SOLVER_DATA(impact)=0u;DC_SOLVER_DATA(impact+1u)=0u;DC_SOLVER_DATA(impact+2u)=0u;
                DC_SOLVER_DATA(impact+3u)=DC_BODY(p).id;
            }
        }
        for(uint p=lane;p<16u*17u*3u;p+=32u) DC_DATA(structural_bins()+p)=0u;
        return;
    }
    if(STRUCTURAL_PHASE==5u) fracture_impacts();
    else if(STRUCTURAL_PHASE==4u) failure();
    else if(STRUCTURAL_PHASE==3u) equilibrium();else topology();
}
#endif
